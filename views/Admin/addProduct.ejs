<!DOCTYPE html>

<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>Add New Product | Luxe Obsidian</title>
    <!-- Tailwind CSS CDN with plugins -->
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <!-- Google Fonts: Manrope -->
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700&amp;display=swap"
        rel="stylesheet" />
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Manrope', 'sans-serif'],
                    },
                    colors: {
                        'luxe-obsidian': '#1A1C1E',
                        'luxe-slate': '#F8FAFC',
                        'luxe-border': '#E2E8F0',
                        'luxe-accent': '#334155',
                        'luxe-muted': '#64748B'
                    },
                    borderRadius: {
                        'luxe': '12px',
                    }
                }
            }
        }
    </script>
    <style data-purpose="layout-styles">
        body {
            background-color: #F1F5F9;
            color: #1A1C1E;
        }

        .custom-scrollbar::-webkit-scrollbar {
            width: 4px;
        }

        .custom-scrollbar::-webkit-scrollbar-track {
            background: transparent;
        }

        .custom-scrollbar::-webkit-scrollbar-thumb {
            background: #CBD5E1;
            border-radius: 2px;
        }

        /* Minimalist input styling */
        input,
        select,
        textarea {
            background-color: #F8FAFC !important;
            border: 1px solid #E2E8F0 !important;
            border-radius: 8px !important;
            font-size: 0.875rem !important;
        }

        input:focus,
        select:focus,
        textarea:focus {
            outline: none !important;
            border-color: #1A1C1E !important;
            box-shadow: none !important;
        }
    </style>
</head>

<body class="font-sans antialiased bg-[#F1F5F9]">
    <!-- Top Header -->
    <header class="bg-white border-b border-luxe-border sticky top-0 z-50">
        <div class="max-w-7xl mx-auto px-6 py-4 flex items-center gap-4">
            <a href="/admin/product-management"
                class="w-8 h-8 rounded-full bg-[#F1F5F9] hover:bg-luxe-border flex items-center justify-center text-luxe-obsidian transition-colors"
                title="Back to Products">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 19l-7-7 7-7"></path>
                </svg>
            </a>
            <h1 class="text-lg font-bold text-luxe-obsidian">Add New Product</h1>
        </div>
    </header>

    <div class="min-h-screen bg-[#F1F5F9]">
        <!-- BEGIN: Main Content Area -->
        <main class="max-w-7xl mx-auto px-6 py-8">
            <div class="grid grid-cols-12 gap-8">
                <!-- Left Column: Primary Product Data -->
                <div class="col-span-8 space-y-6">
                    <!-- Section: Product Information -->
                    <section class="bg-white p-8 rounded-luxe border border-luxe-border shadow-sm"
                        data-purpose="product-information">
                        <h3 class="text-sm font-bold uppercase tracking-wider mb-6 text-luxe-obsidian">Product
                            Information</h3>
                        <div class="space-y-6">
                            <div>
                                <label
                                    class="block text-[10px] font-bold text-luxe-muted uppercase mb-1 tracking-tight">Product
                                    Name</label>
                                <input class="w-full px-3 py-2" placeholder='e.g. UltraWide Curved Gaming Monitor 34"'
                                    type="text" />
                            </div>
                            <div>
                                <label
                                    class="block text-[10px] font-bold text-luxe-muted uppercase mb-1 tracking-tight">categories</label>
                                <select class="w-full px-3 py-2">
                                    <% if(locals.categories) { %>
                                        <% categories.forEach(category=>{ %>
                                            <% if(category.status){ %>
                                                <option>
                                                    <%= category.categoryName%>
                                                </option>
                                                <% } %>
                                                    <% }) %>
                                                        <% } else { %>
                                                            <option>fetching data not wroking or something went wrong
                                                            </option>
                                                            <% }%>
                                </select>
                            </div>
                            <div id="summaryContainer" class="space-y-3">
                                <!-- existing two rows stay here -->
                                <div class="grid grid-cols-2 gap-4">
                                    <input class="w-full px-3 py-2" placeholder="Response Time" type="text"
                                        name="summaryKey[]" />
                                    <input class="w-full px-3 py-2 font-semibold" type="text" placeholder="0.03ms (GtG)"
                                        name="summaryValue[]" />
                                </div>
                                <div class="grid grid-cols-2 gap-4">
                                    <input class="w-full px-3 py-2" placeholder="HDR Format" type="text"
                                        name="summaryKey[]" />
                                    <input class="w-full px-3 py-2 font-semibold" type="text"
                                        placeholder="Dolby Vision, HDR10+" name="summaryValue[]" />
                                </div>
                            </div>
                            <button type="button" id="addSummaryBtn"
                                class="flex items-center gap-2 text-[10px] font-bold uppercase border border-luxe-border px-4 py-2 rounded-luxe hover:bg-luxe-slate transition-colors mt-3">
                                <svg class="w-3 h-3" fill="none" stroke="currentColor" viewbox="0 0 24 24">
                                    <path d="M12 4v16m8-8H4" stroke-linecap="round" stroke-linejoin="round"
                                        stroke-width="2"></path>
                                </svg>
                                Add Summary
                            </button>
                            <div>
                                <label
                                    class="block text-[10px] font-bold text-luxe-muted uppercase mb-1 tracking-tight">Description</label>
                                <textarea class="w-full px-3 py-2"
                                    placeholder="Highlight the key features and luxury specs..." rows="4"></textarea>
                            </div>
                            <div class="pt-4 border-t border-luxe-border">
                                <div class="flex justify-between items-center mb-4">
                                </div>
                            </div>
                        </div>
                    </section>
                    <!-- Section: Product Images -->
                    <section class="bg-white p-8 rounded-luxe border border-luxe-border shadow-sm"
                        data-purpose="product-images">
                        <div class="flex justify-between items-center mb-6">
                            <h3 class="text-sm font-bold uppercase tracking-wider text-luxe-obsidian">Product Images
                            </h3>
                            <span class="text-[10px] text-luxe-muted uppercase">Max 5 images • JPEG, PNG</span>
                        </div>
                        <div class="flex gap-4">
                            <div
                                class="w-64 h-48 border-2 border-dashed border-luxe-border rounded-luxe flex flex-col items-center justify-center bg-luxe-slate hover:bg-white transition-colors cursor-pointer group">
                                <div
                                    class="p-3 bg-white border border-luxe-border rounded-full mb-3 group-hover:shadow-md">
                                    <svg class="w-5 h-5 text-luxe-muted" fill="none" stroke="currentColor"
                                        viewbox="0 0 24 24">
                                        <path
                                            d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"
                                            stroke-linecap="round" stroke-linejoin="round" stroke-width="2"></path>
                                    </svg>
                                </div>
                                <p class="text-[10px] font-bold uppercase text-luxe-obsidian">Drop images here</p>
                                <p class="text-[9px] text-luxe-muted">or click to browse</p>
                            </div>
                            <div
                                class="w-24 h-24 rounded-luxe border border-luxe-border overflow-hidden relative group">
                                <img alt="Product Preview" class="w-full h-full object-cover opacity-20 grayscale"
                                    src="https://lh3.googleusercontent.com/aida-public/AB6AXuAf_od-3Q15PBcWfirbV2j5W8CIjK779LW3gSuoREMwW-yx9SKEGqPahRatvRI0C8VfOBY703bbuSBNqV4U82YclcHocQQPUmDXR8JG_yXzaXTSs3MDWdMgbcCSILuJv4TWPDq6bG8fm_IFtuIvxGUTyYFHmPMWv-pREzd4hTSsMEG-5Y9BWcjQ5EFyPB_uh-ARJy0a8mIBGuW77QG8AFEx0EuNP0udNIRTXZRGNw2A0kTmgztqSlFWw1PQ79_U5ydEp2kNA7prYO6G" />
                                <div class="absolute inset-0 flex items-center justify-center">
                                    <img alt="Placeholder" class="w-16 h-16 object-cover rounded shadow-lg"
                                        src="https://lh3.googleusercontent.com/aida-public/AB6AXuCz4Ol3oHHoNh31HXbvokF13SRle5tsFLZ9JppVAAVQgv4nWtQvlLtINK7n9b8nupy4P373gM_cgDWMocgtvprNHCR4kfCxwCOnrn4O3VZvk9YjkAiEuI3Qtmmzww-5sli0WD7F5dbmepVEwSc4SAtkhxIFGIWFBf6Clrxl7hMaSPefsgdu86Kog9udNMBqMM02dcb5WNGT2WGF4Bmje83HypdHMzjy-uqfcvfULuuAF8IdqR-XiVIfKMQVdjdJt7oToD2fn64Z7v2y" />
                                </div>
                            </div>
                        </div>
                    </section>
                    <!-- Section: Variants & Stock -->
                    <section class="bg-white p-8 rounded-luxe border border-luxe-border shadow-sm"
                        data-purpose="variants-stock">

                        <!-- Header row -->
                        <div class="flex justify-between items-center mb-8">
                            <h3 class="text-[22px] font-bold tracking-tight text-luxe-obsidian"
                                style="font-family:'Manrope',sans-serif;">Variants &amp; Stock</h3>
                            <button id="addVariantsBtn" type="button"
                                class="flex items-center gap-2.5 text-[11px] font-bold uppercase bg-[#F1F5F9] hover:bg-luxe-border px-5 py-2.5 rounded-full transition-colors text-luxe-obsidian tracking-widest"
                                style="font-family:'Manrope',sans-serif; letter-spacing:0.08em;">
                                <span
                                    class="w-4 h-4 rounded-full bg-luxe-obsidian inline-flex items-center justify-center flex-shrink-0"></span>
                                Add Variants
                            </button>
                        </div>

                        <div id="variantsContainer" class="space-y-9">

                            <!-- SIZE & STOCK INVENTORY -->
                            <div>
                                <p class="text-[10px] font-bold uppercase text-luxe-muted mb-4 tracking-[0.14em]"
                                    style="font-family:'Manrope',sans-serif;">Size &amp; Stock Inventory</p>
                                <div class="grid grid-cols-3 gap-4">

                                    <!-- Card macro: just repeat 3 times -->
                                    <div class="variant-card border border-[#DDE3EC] rounded-[12px] p-5"
                                        style="background:#E8EDF5;">
                                        <p class="text-[10px] font-bold uppercase text-[#1A1C1E] tracking-[0.06em] mb-4"
                                            style="font-family:'Manrope',sans-serif;">27-Inch Display</p>
                                        <div class="flex items-center gap-0 mb-2.5">
                                            <input type="number" value="0"
                                                class="flex-1 h-[40px] rounded-[8px] border border-[#DDE3EC] bg-white px-3 text-[14px] font-medium text-[#1A1C1E]"
                                                style="min-width:0;" />
                                            <span class="w-14 text-right text-[13px] text-[#94A3B8] font-medium pl-2.5"
                                                style="font-family:'Manrope',sans-serif;">Units</span>
                                        </div>
                                        <div class="flex items-center gap-0">
                                            <input type="number" value="0"
                                                class="flex-1 h-[40px] rounded-[8px] border border-[#DDE3EC] bg-white px-3 text-[14px] font-medium text-[#1A1C1E]"
                                                style="min-width:0;" />
                                            <span class="w-14 text-right text-[13px] text-[#94A3B8] font-medium pl-2.5"
                                                style="font-family:'Manrope',sans-serif;">Price</span>
                                        </div>
                                    </div>

                                    <div class="variant-card border border-[#DDE3EC] rounded-[12px] p-5"
                                        style="background:#E8EDF5;">
                                        <p class="text-[10px] font-bold uppercase text-[#1A1C1E] tracking-[0.06em] mb-4"
                                            style="font-family:'Manrope',sans-serif;">32-Inch Display</p>
                                        <div class="flex items-center gap-0 mb-2.5">
                                            <input type="number" value="0"
                                                class="flex-1 h-[40px] rounded-[8px] border border-[#DDE3EC] bg-white px-3 text-[14px] font-medium text-[#1A1C1E]"
                                                style="min-width:0;" />
                                            <span class="w-14 text-right text-[13px] text-[#94A3B8] font-medium pl-2.5"
                                                style="font-family:'Manrope',sans-serif;">Units</span>
                                        </div>
                                        <div class="flex items-center gap-0">
                                            <input type="number" value="0"
                                                class="flex-1 h-[40px] rounded-[8px] border border-[#DDE3EC] bg-white px-3 text-[14px] font-medium text-[#1A1C1E]"
                                                style="min-width:0;" />
                                            <span class="w-14 text-right text-[13px] text-[#94A3B8] font-medium pl-2.5"
                                                style="font-family:'Manrope',sans-serif;">Price</span>
                                        </div>
                                    </div>

                                    <div class="variant-card border border-[#DDE3EC] rounded-[12px] p-5"
                                        style="background:#E8EDF5;">
                                        <p class="text-[10px] font-bold uppercase text-[#1A1C1E] tracking-[0.06em] mb-4"
                                            style="font-family:'Manrope',sans-serif;">34-Inch Display</p>
                                        <div class="flex items-center gap-0 mb-2.5">
                                            <input type="number" value="0"
                                                class="flex-1 h-[40px] rounded-[8px] border border-[#DDE3EC] bg-white px-3 text-[14px] font-medium text-[#1A1C1E]"
                                                style="min-width:0;" />
                                            <span class="w-14 text-right text-[13px] text-[#94A3B8] font-medium pl-2.5"
                                                style="font-family:'Manrope',sans-serif;">Units</span>
                                        </div>
                                        <div class="flex items-center gap-0">
                                            <input type="number" value="0"
                                                class="flex-1 h-[40px] rounded-[8px] border border-[#DDE3EC] bg-white px-3 text-[14px] font-medium text-[#1A1C1E]"
                                                style="min-width:0;" />
                                            <span class="w-14 text-right text-[13px] text-[#94A3B8] font-medium pl-2.5"
                                                style="font-family:'Manrope',sans-serif;">Price</span>
                                        </div>
                                    </div>

                                </div>
                            </div>

                            <!-- HZ & STOCK INVENTORY -->
                            <div>
                                <p class="text-[10px] font-bold uppercase text-luxe-muted mb-4 tracking-[0.14em]"
                                    style="font-family:'Manrope',sans-serif;">Hz &amp; Stock Inventory</p>
                                <div class="grid grid-cols-3 gap-4">

                                    <div class="variant-card border border-[#DDE3EC] rounded-[12px] p-5"
                                        style="background:#E8EDF5;">
                                        <p class="text-[10px] font-bold uppercase text-[#1A1C1E] tracking-[0.06em] mb-4"
                                            style="font-family:'Manrope',sans-serif;">144-Hz Display</p>
                                        <div class="flex items-center gap-0 mb-2.5">
                                            <input type="number" value="0"
                                                class="flex-1 h-[40px] rounded-[8px] border border-[#DDE3EC] bg-white px-3 text-[14px] font-medium text-[#1A1C1E]"
                                                style="min-width:0;" />
                                            <span class="w-14 text-right text-[13px] text-[#94A3B8] font-medium pl-2.5"
                                                style="font-family:'Manrope',sans-serif;">Units</span>
                                        </div>
                                        <div class="flex items-center gap-0">
                                            <input type="number" value="0"
                                                class="flex-1 h-[40px] rounded-[8px] border border-[#DDE3EC] bg-white px-3 text-[14px] font-medium text-[#1A1C1E]"
                                                style="min-width:0;" />
                                            <span class="w-14 text-right text-[13px] text-[#94A3B8] font-medium pl-2.5"
                                                style="font-family:'Manrope',sans-serif;">Price</span>
                                        </div>
                                    </div>

                                    <div class="variant-card border border-[#DDE3EC] rounded-[12px] p-5"
                                        style="background:#E8EDF5;">
                                        <p class="text-[10px] font-bold uppercase text-[#1A1C1E] tracking-[0.06em] mb-4"
                                            style="font-family:'Manrope',sans-serif;">180-Hz Display</p>
                                        <div class="flex items-center gap-0 mb-2.5">
                                            <input type="number" value="0"
                                                class="flex-1 h-[40px] rounded-[8px] border border-[#DDE3EC] bg-white px-3 text-[14px] font-medium text-[#1A1C1E]"
                                                style="min-width:0;" />
                                            <span class="w-14 text-right text-[13px] text-[#94A3B8] font-medium pl-2.5"
                                                style="font-family:'Manrope',sans-serif;">Units</span>
                                        </div>
                                        <div class="flex items-center gap-0">
                                            <input type="number" value="0"
                                                class="flex-1 h-[40px] rounded-[8px] border border-[#DDE3EC] bg-white px-3 text-[14px] font-medium text-[#1A1C1E]"
                                                style="min-width:0;" />
                                            <span class="w-14 text-right text-[13px] text-[#94A3B8] font-medium pl-2.5"
                                                style="font-family:'Manrope',sans-serif;">Price</span>
                                        </div>
                                    </div>

                                </div>
                            </div>

                    </section>
                </div>

                <!-- Right Column: Pricing & Organization -->
                <aside class="col-span-4 space-y-6">
                    <!-- Section: Pricing -->
                    <section class="bg-white p-6 rounded-luxe border border-luxe-border shadow-sm"
                        data-purpose="pricing">
                        <h3 class="text-[10px] font-bold uppercase tracking-widest mb-6 text-luxe-obsidian">Pricing</h3>
                        <div class="space-y-4">
                            <div>
                                <label class="block text-[9px] font-bold text-luxe-muted uppercase mb-1">Base
                                    Price</label>
                                <div class="relative">
                                    <span
                                        class="absolute left-3 top-1/2 -translate-y-1/2 text-xs text-luxe-muted">₹</span>
                                    <input class="w-full pl-7 py-2 font-medium" type="text" placeholder="0.00" />
                                </div>
                            </div>
                            <div>
                                <label class="block text-[9px] font-bold text-luxe-muted uppercase mb-1">Discounted
                                    Price</label>
                                <div class="relative">
                                    <span
                                        class="absolute left-3 top-1/2 -translate-y-1/2 text-xs text-luxe-muted">₹</span>
                                    <input class="w-full pl-7 py-2 font-medium" type="text" placeholder="0.00" />
                                </div>
                            </div>
                        </div>
                    </section>
                    <!-- Section: Organization -->
                    <section class="bg-white p-6 rounded-luxe border border-luxe-border shadow-sm"
                        data-purpose="organization">
                        <h3 class="text-[10px] font-bold uppercase tracking-widest mb-6 text-luxe-obsidian">Organization
                        </h3>
                        <div class="space-y-4">
                            <div>
                                <label class="block text-[9px] font-bold text-luxe-muted uppercase mb-1">SKU / Product
                                    Code</label>
                                <input class="w-full px-3 py-2 font-medium" type="text" placeholder="LX-MON-34-CURV" />
                            </div>
                            <div>
                                <label class="block text-[9px] font-bold text-luxe-muted uppercase mb-1">Status</label>
                                <select class="w-full px-3 py-2 font-medium">
                                    <option>InStock</option>
                                    <option>Out of Stock</option>
                                </select>
                            </div>
                        </div>
                    </section>
                    <!-- Action Buttons -->
                    <div class="space-y-2">
                        <button
                            class="w-full bg-luxe-accent hover:bg-luxe-obsidian text-white font-bold py-3 text-xs uppercase tracking-widest rounded-luxe transition-all shadow-lg shadow-slate-200">
                            Save Product
                        </button>
                        <a href="/admin/product-management" class="block w-full">
                            <button type="button"
                                class="w-full bg-white hover:bg-luxe-slate text-luxe-obsidian border border-luxe-border font-bold py-3 text-xs uppercase tracking-widest rounded-luxe transition-all">
                                Cancel
                            </button>
                        </a>
                    </div>
                    <!-- Security Notice -->
                    <div class="bg-luxe-slate p-4 rounded-luxe border border-luxe-border flex gap-3">
                        <div class="text-luxe-accent mt-0.5">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewbox="0 0 24 24">
                                <path
                                    d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"
                                    stroke-linecap="round" stroke-linejoin="round" stroke-width="2"></path>
                            </svg>
                        </div>
                        <div class="space-y-1">
                            <p class="text-[10px] font-bold uppercase tracking-tight text-luxe-obsidian">Secure Portal
                            </p>
                            <p class="text-[9px] leading-relaxed text-luxe-muted">Changes made here are logged and
                                synchronized across global warehouses in real-time.</p>
                        </div>
                    </div>
                </aside>
            </div>
        </main>
        <!-- END: Main Content Area -->
    </div>
   
    <!-- Modal Overlay -->
    <div id="modalOverlay" class="fixed inset-0 bg-black/50 backdrop-blur-sm z-50 hidden transition-opacity duration-300"></div>

    <!-- Variant Modal -->
    <div id="variantModal" class="fixed inset-0 z-50 flex items-center justify-center hidden p-4">
        <div class="bg-white rounded-luxe border border-luxe-border w-full max-w-md p-6 shadow-2xl">
            <div class="flex justify-between items-center mb-5">
                <h3 class="text-xs font-bold text-luxe-obsidian uppercase tracking-wider" style="font-family:'Manrope',sans-serif;">Add Variant Group</h3>
                <button id="closeModal" type="button" class="text-luxe-muted hover:text-luxe-obsidian transition-colors">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                    </svg>
                </button>
            </div>
            <div class="space-y-4 mb-6">
                <div>
                    <label class="block text-[10px] font-bold text-luxe-muted uppercase mb-1.5 tracking-wider" style="font-family:'Manrope',sans-serif;">Group Name</label>
                    <input id="groupName" type="text" class="w-full px-3 py-2 bg-luxe-slate border border-luxe-border rounded-lg text-sm text-luxe-obsidian focus:border-luxe-obsidian focus:ring-0" placeholder="e.g. Color" />
                </div>
                <div>
                    <label class="block text-[10px] font-bold text-luxe-muted uppercase mb-1.5 tracking-wider" style="font-family:'Manrope',sans-serif;">Options (Comma Separated)</label>
                    <input id="groupOptions" type="text" class="w-full px-3 py-2 bg-luxe-slate border border-luxe-border rounded-lg text-sm text-luxe-obsidian focus:border-luxe-obsidian focus:ring-0" placeholder="e.g. Black, White, Silver" />
                </div>
            </div>
            <div class="flex gap-3 justify-end">
                <button id="cancelModalBtn" type="button" class="px-4 py-2 border border-luxe-border text-luxe-obsidian hover:bg-luxe-slate rounded-lg text-xs font-bold uppercase tracking-wider transition-colors" style="font-family:'Manrope',sans-serif;">
                    Cancel
                </button>
                <button id="addVariantGroup" type="button" class="px-4 py-2 bg-luxe-accent hover:bg-luxe-obsidian text-white rounded-lg text-xs font-bold uppercase tracking-wider transition-colors" style="font-family:'Manrope',sans-serif;">
                    Add Group
                </button>
            </div>
        </div>
    </div>

    <script>
        const addSummaryBtn = document.getElementById('addSummaryBtn');
        const summaryContainer = document.getElementById('summaryContainer');

        addSummaryBtn.addEventListener('click', () => {
            const row = document.createElement('div');
            row.classList.add('grid', 'grid-cols-2', 'gap-4', 'mt-3');
            row.innerHTML = `
            <input 
                class="w-full px-3 py-2" 
                type="text" 
                placeholder="e.g. Panel Type" 
                name="summaryKey[]" 
            />
            <div class="flex items-center gap-2">
                <input 
                    class="w-full px-3 py-2" 
                    type="text" 
                    placeholder="e.g. OLED" 
                    name="summaryValue[]" 
                />
                <button type="button" class="removeRow text-black-400 hover:text-black-600 text-lg font-bold">✕</button>
            </div>
        `;
            summaryContainer.appendChild(row);

            
            row.querySelector('.removeRow').addEventListener('click', () => {
                row.remove();
            });
        });

        const addVariantsBtn = document.getElementById('addVariantsBtn');
        const variantsContainer = document.getElementById('variantsContainer');
        const variantModal = document.getElementById('variantModal');
        const modalOverlay = document.getElementById('modalOverlay');

        // Open modal
        addVariantsBtn.addEventListener('click', () => {
            variantModal.classList.remove('hidden');
            modalOverlay.classList.remove('hidden');
        });

        // Close modal
        document.getElementById('closeModal').addEventListener('click', closeModal);
        document.getElementById('cancelModalBtn').addEventListener('click', closeModal);
        modalOverlay.addEventListener('click', closeModal);

        function closeModal() {
            variantModal.classList.add('hidden');
            modalOverlay.classList.add('hidden');
            document.getElementById('groupName').value = '';
            document.getElementById('groupOptions').value = '';
        }

        // Add variant group
        document.getElementById('addVariantGroup').addEventListener('click', () => {
            const groupName = document.getElementById('groupName').value.trim();
            const optionsRaw = document.getElementById('groupOptions').value.trim();

            if (!groupName || !optionsRaw) return alert('Fill both fields');

            const options = optionsRaw.split(',').map(o => o.trim()).filter(Boolean);

            const section = document.createElement('div');
            section.classList.add('variant-group', 'border-t', 'border-luxe-border', 'pt-6');
            section.innerHTML = `
                <div class="flex justify-between items-center mb-4">
                    <h4 class="text-[10px] font-bold uppercase text-[#64748B] tracking-[0.14em]" style="font-family:'Manrope',sans-serif;">
                        ${groupName} &amp; Stock Inventory
                    </h4>
                    <button type="button" class="text-[10px] text-red-500 hover:text-red-700 font-bold uppercase tracking-wider flex items-center gap-1"
                        onclick="this.closest('.variant-group').remove()">
                        &minus; Remove Group
                    </button>
                </div>
                <div class="grid grid-cols-3 gap-4">
                    ${options.map(option => `
                        <div class="border border-[#DDE3EC] rounded-[12px] p-5" style="background:#E8EDF5;">
                            <p class="text-[10px] font-bold uppercase text-[#1A1C1E] tracking-[0.06em] mb-4" style="font-family:'Manrope',sans-serif;">
                                ${option}
                            </p>
                            <div class="flex items-center gap-0 mb-2.5">
                                <input type="number" value="0"
                                    name="variant_${groupName}_${option}_units"
                                    class="flex-1 h-[40px] rounded-[8px] border border-[#DDE3EC] bg-white px-3 text-[14px] font-medium"
                                    style="min-width:0;" />
                                <span class="w-14 text-right text-[13px] text-[#94A3B8] font-medium pl-2.5" style="font-family:'Manrope',sans-serif;">Units</span>
                            </div>
                            <div class="flex items-center gap-0">
                                <input type="number" value="0"
                                    name="variant_${groupName}_${option}_price"
                                    class="flex-1 h-[40px] rounded-[8px] border border-[#DDE3EC] bg-white px-3 text-[14px] font-medium"
                                    style="min-width:0;" />
                                <span class="w-14 text-right text-[13px] text-[#94A3B8] font-medium pl-2.5" style="font-family:'Manrope',sans-serif;">Price</span>
                            </div>
                        </div>
                    `).join('')}
                </div>
            `;
            variantsContainer.appendChild(section);
            closeModal();
        });
    </script>


</body>

</html>