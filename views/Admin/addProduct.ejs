<!DOCTYPE html>

<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>Add New Product | Luxe Obsidian</title>
    <!-- Tailwind CSS CDN with plugins -->
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <!-- Google Fonts: Manrope -->
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700&amp;display=swap"
        rel="stylesheet" />
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Manrope', 'sans-serif'],
                    },
                    colors: {
                        'luxe-obsidian': '#1A1C1E',
                        'luxe-slate': '#F8FAFC',
                        'luxe-border': '#E2E8F0',
                        'luxe-accent': '#334155',
                        'luxe-muted': '#64748B'
                    },
                    borderRadius: {
                        'luxe': '4px',
                    }
                }
            }
        }
    </script>
    <style data-purpose="layout-styles">
        body {
            background-color: #F1F5F9;
            color: #1A1C1E;
        }

        .custom-scrollbar::-webkit-scrollbar {
            width: 4px;
        }

        .custom-scrollbar::-webkit-scrollbar-track {
            background: transparent;
        }

        .custom-scrollbar::-webkit-scrollbar-thumb {
            background: #CBD5E1;
            border-radius: 2px;
        }

        /* Minimalist input styling */
        input,
        select,
        textarea {
            background-color: #F8FAFC !important;
            border: 1px solid #E2E8F0 !important;
            border-radius: 4px !important;
            font-size: 0.875rem !important;
        }

        input:focus,
        select:focus,
        textarea:focus {
            outline: none !important;
            border-color: #1A1C1E !important;
            box-shadow: none !important;
        }
    </style>
</head>

<body class="font-sans antialiased">
   
    <div class="flex min-h-screen">
        <!-- BEGIN: Main Content Area -->
        <main class="flex-1 ml-64 p-8 overflow-y-auto">
            <!-- Top Header -->
            <div class="flex items-center gap-4 mb-8" data-purpose="content-header">
                <h2 class="text-xl font-bold">Add New Product</h2>
            </div>
            <div class="grid grid-cols-12 gap-8">
                <!-- Left Column: Primary Product Data -->
                <div class="col-span-8 space-y-6">
                    <!-- Section: Product Information -->
                    <section class="bg-white p-8 rounded-luxe border border-luxe-border shadow-sm"
                        data-purpose="product-information">
                        <h3 class="text-sm font-bold uppercase tracking-wider mb-6 text-luxe-obsidian">Product
                            Information</h3>
                        <div class="space-y-6">
                            <div>
                                <label
                                    class="block text-[10px] font-bold text-luxe-muted uppercase mb-1 tracking-tight">Product
                                    Name</label>
                                <input class="w-full px-3 py-2" placeholder='e.g. UltraWide Curved Gaming Monitor 34"'
                                    type="text" />
                            </div>
                            <div>
                                <label
                                    class="block text-[10px] font-bold text-luxe-muted uppercase mb-1 tracking-tight">Category</label>
                                <select class="w-full px-3 py-2">
                                    <option>Select Category</option>
                                    <option>Monitors</option>
                                    <option>Laptops</option>
                                    <option>Accessories</option>
                                </select>
                            </div>
                            <div class="grid grid-cols-2 gap-4">
                                <div>
                                    <label
                                        class="block text-[10px] font-bold text-luxe-muted uppercase mb-1 tracking-tight">Technical
                                        Summary</label>
                                    <input class="w-full px-3 py-2 mb-2" placeholder="Response Time" type="text" />
                                    <input class="w-full px-3 py-2" placeholder="HDR Format" type="text" />
                                </div>
                                <div class="flex flex-col justify-end gap-2">
                                    <input class="w-full px-3 py-2 font-semibold" type="text" value="0.03ms (GtG)" />
                                    <input class="w-full px-3 py-2 font-semibold" type="text"
                                        value="Dolby Vision, HDR10+" />
                                </div>
                            </div>
                            <button
                                class="flex items-center gap-2 text-[10px] font-bold uppercase border border-luxe-border px-4 py-2 rounded-luxe hover:bg-luxe-slate transition-colors">
                                <svg class="w-3 h-3" fill="none" stroke="currentColor" viewbox="0 0 24 24">
                                    <path d="M12 4v16m8-8H4" stroke-linecap="round" stroke-linejoin="round"
                                        stroke-width="2"></path>
                                </svg>
                                Add Summary
                            </button>
                            <div>
                                <label
                                    class="block text-[10px] font-bold text-luxe-muted uppercase mb-1 tracking-tight">Description</label>
                                <textarea class="w-full px-3 py-2"
                                    placeholder="Highlight the key features and luxury specs..." rows="4"></textarea>
                            </div>
                            <div class="pt-4 border-t border-luxe-border">
                                <div class="flex justify-between items-center mb-4">
                                    <label
                                        class="text-[10px] font-bold text-luxe-muted uppercase tracking-tight">Product
                                        Details</label>
                                    <button class="p-1 rounded bg-luxe-obsidian text-white"><svg class="w-3 h-3"
                                            fill="none" stroke="currentColor" viewbox="0 0 24 24">
                                            <path d="M12 4v16m8-8H4" stroke-linecap="round" stroke-linejoin="round"
                                                stroke-width="2"></path>
                                        </svg></button>
                                </div>
                                <div class="grid grid-cols-3 gap-4">
                                    <!-- Specs Columns -->
                                    <div class="space-y-2">
                                        <div class="text-[9px] text-luxe-muted font-bold px-1">PANEL TECHNOLOGY</div>
                                        <div class="bg-luxe-accent text-white p-2 text-[10px] rounded-luxe">
                                            Architecture: <br />OLED Pro Next Gen</div>
                                        <div class="bg-luxe-accent/70 text-white p-2 text-[10px] rounded-luxe">Color
                                            Accuracy: <br />DCI-P3 99% Near-Gen</div>
                                        <button
                                            class="w-full text-white bg-black py-2 text-[9px] font-bold uppercase flex items-center justify-center gap-1 rounded-luxe"><svg
                                                class="w-3 h-3" fill="none" stroke="currentColor" viewbox="0 0 24 24">
                                                <path d="M12 4v16m8-8H4" stroke-linecap="round" stroke-linejoin="round"
                                                    stroke-width="2"></path>
                                            </svg> Add Specification</button>
                                    </div>
                                    <div class="space-y-2">
                                        <div class="text-[9px] text-luxe-muted font-bold px-1">PIXEL TECHNOLOGY</div>
                                        <div class="bg-luxe-accent text-white p-2 text-[10px] rounded-luxe">
                                            Architecture: <br />OLED Eco Next Gen</div>
                                        <div class="bg-luxe-accent/70 text-white p-2 text-[10px] rounded-luxe">Pixel
                                            Accuracy: <br />OLED Eco Next Gen</div>
                                        <button
                                            class="w-full text-white bg-black py-2 text-[9px] font-bold uppercase flex items-center justify-center gap-1 rounded-luxe"><svg
                                                class="w-3 h-3" fill="none" stroke="currentColor" viewbox="0 0 24 24">
                                                <path d="M12 4v16m8-8H4" stroke-linecap="round" stroke-linejoin="round"
                                                    stroke-width="2"></path>
                                            </svg> Add Specification</button>
                                    </div>
                                    <div class="space-y-2">
                                        <div class="text-[9px] text-luxe-muted font-bold px-1">PANEL TECHNOLOGY</div>
                                        <div class="bg-luxe-accent text-white p-2 text-[10px] rounded-luxe">
                                            Architecture: <br />OLED Eco Next Gen</div>
                                        <div class="bg-luxe-accent/70 text-white p-2 text-[10px] rounded-luxe">Pixel
                                            Accuracy: <br />OLED Emission Gen</div>
                                        <button
                                            class="w-full text-white bg-black py-2 text-[9px] font-bold uppercase flex items-center justify-center gap-1 rounded-luxe"><svg
                                                class="w-3 h-3" fill="none" stroke="currentColor" viewbox="0 0 24 24">
                                                <path d="M12 4v16m8-8H4" stroke-linecap="round" stroke-linejoin="round"
                                                    stroke-width="2"></path>
                                            </svg> Add Specification</button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </section>
                    <!-- Section: Product Images -->
                    <section class="bg-white p-8 rounded-luxe border border-luxe-border shadow-sm"
                        data-purpose="product-images">
                        <div class="flex justify-between items-center mb-6">
                            <h3 class="text-sm font-bold uppercase tracking-wider text-luxe-obsidian">Product Images
                            </h3>
                            <span class="text-[10px] text-luxe-muted uppercase">Max 5 images • JPEG, PNG</span>
                        </div>
                        <div class="flex gap-4">
                            <div
                                class="w-64 h-48 border-2 border-dashed border-luxe-border rounded-luxe flex flex-col items-center justify-center bg-luxe-slate hover:bg-white transition-colors cursor-pointer group">
                                <div
                                    class="p-3 bg-white border border-luxe-border rounded-full mb-3 group-hover:shadow-md">
                                    <svg class="w-5 h-5 text-luxe-muted" fill="none" stroke="currentColor"
                                        viewbox="0 0 24 24">
                                        <path
                                            d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"
                                            stroke-linecap="round" stroke-linejoin="round" stroke-width="2"></path>
                                    </svg>
                                </div>
                                <p class="text-[10px] font-bold uppercase text-luxe-obsidian">Drop images here</p>
                                <p class="text-[9px] text-luxe-muted">or click to browse</p>
                            </div>
                            <div
                                class="w-24 h-24 rounded-luxe border border-luxe-border overflow-hidden relative group">
                                <img alt="Product Preview" class="w-full h-full object-cover opacity-20 grayscale"
                                    src="https://lh3.googleusercontent.com/aida-public/AB6AXuAf_od-3Q15PBcWfirbV2j5W8CIjK779LW3gSuoREMwW-yx9SKEGqPahRatvRI0C8VfOBY703bbuSBNqV4U82YclcHocQQPUmDXR8JG_yXzaXTSs3MDWdMgbcCSILuJv4TWPDq6bG8fm_IFtuIvxGUTyYFHmPMWv-pREzd4hTSsMEG-5Y9BWcjQ5EFyPB_uh-ARJy0a8mIBGuW77QG8AFEx0EuNP0udNIRTXZRGNw2A0kTmgztqSlFWw1PQ79_U5ydEp2kNA7prYO6G" />
                                <div class="absolute inset-0 flex items-center justify-center">
                                    <img alt="Placeholder" class="w-16 h-16 object-cover rounded shadow-lg"
                                        src="https://lh3.googleusercontent.com/aida-public/AB6AXuCz4Ol3oHHoNh31HXbvokF13SRle5tsFLZ9JppVAAVQgv4nWtQvlLtINK7n9b8nupy4P373gM_cgDWMocgtvprNHCR4kfCxwCOnrn4O3VZvk9YjkAiEuI3Qtmmzww-5sli0WD7F5dbmepVEwSc4SAtkhxIFGIWFBf6Clrxl7hMaSPefsgdu86Kog9udNMBqMM02dcb5WNGT2WGF4Bmje83HypdHMzjy-uqfcvfULuuAF8IdqR-XiVIfKMQVdjdJt7oToD2fn64Z7v2y" />
                                </div>
                            </div>
                        </div>
                    </section>
                    <!-- Section: Variants & Stock -->
                    <section class="bg-white p-8 rounded-luxe border border-luxe-border shadow-sm"
                        data-purpose="variants-stock">
                        <div class="flex justify-between items-center mb-8">
                            <h3 class="text-sm font-bold uppercase tracking-wider text-luxe-obsidian">Variants &amp;
                                Stock</h3>
                            <button
                                class="flex items-center gap-2 text-[10px] font-bold uppercase bg-luxe-slate px-3 py-1.5 rounded-luxe border border-luxe-border">
                                <div class="w-2 h-2 rounded-full bg-luxe-obsidian"></div>
                                Add Variants
                            </button>
                        </div>
                        <!-- Size Grid -->
                        <div class="space-y-8">
                            <div>
                                <h4 class="text-[10px] font-bold uppercase text-luxe-muted mb-4 tracking-widest">Size
                                    &amp; Stock Inventory</h4>
                                <div class="grid grid-cols-3 gap-4">
                                    <div class="bg-luxe-slate p-3 rounded-luxe border border-luxe-border">
                                        <span
                                            class="text-[9px] font-bold uppercase text-luxe-obsidian block mb-3">27-inch
                                            Display</span>
                                        <div class="flex items-center justify-between gap-2 mb-2">
                                            <input class="w-16 h-8 text-center bg-white" type="number" value="0" />
                                            <span class="text-[9px] text-luxe-muted font-bold">Units</span>
                                        </div>
                                        <div class="flex items-center justify-between gap-2">
                                            <input class="w-16 h-8 text-center bg-white" type="number" value="0" />
                                            <span class="text-[9px] text-luxe-muted font-bold">Price</span>
                                        </div>
                                    </div>
                                    <div class="bg-luxe-slate p-3 rounded-luxe border border-luxe-border">
                                        <span
                                            class="text-[9px] font-bold uppercase text-luxe-obsidian block mb-3">32-inch
                                            Display</span>
                                        <div class="flex items-center justify-between gap-2 mb-2">
                                            <input class="w-16 h-8 text-center bg-white" type="number" value="0" />
                                            <span class="text-[9px] text-luxe-muted font-bold">Units</span>
                                        </div>
                                        <div class="flex items-center justify-between gap-2">
                                            <input class="w-16 h-8 text-center bg-white" type="number" value="0" />
                                            <span class="text-[9px] text-luxe-muted font-bold">Price</span>
                                        </div>
                                    </div>
                                    <div class="bg-luxe-slate p-3 rounded-luxe border border-luxe-border">
                                        <span
                                            class="text-[9px] font-bold uppercase text-luxe-obsidian block mb-3">34-inch
                                            Display</span>
                                        <div class="flex items-center justify-between gap-2 mb-2">
                                            <input class="w-16 h-8 text-center bg-white" type="number" value="0" />
                                            <span class="text-[9px] text-luxe-muted font-bold">Units</span>
                                        </div>
                                        <div class="flex items-center justify-between gap-2">
                                            <input class="w-16 h-8 text-center bg-white" type="number" value="0" />
                                            <span class="text-[9px] text-luxe-muted font-bold">Price</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <!-- Refresh Rate Grid -->
                            <div>
                                <h4 class="text-[10px] font-bold uppercase text-luxe-muted mb-4 tracking-widest">Hz
                                    &amp; Stock Inventory</h4>
                                <div class="grid grid-cols-3 gap-4">
                                    <div class="bg-luxe-slate p-3 rounded-luxe border border-luxe-border">
                                        <span
                                            class="text-[9px] font-bold uppercase text-luxe-obsidian block mb-3">144-Hz
                                            Display</span>
                                        <div class="flex items-center justify-between gap-2 mb-2">
                                            <input class="w-16 h-8 text-center bg-white" type="number" value="0" />
                                            <span class="text-[9px] text-luxe-muted font-bold">Units</span>
                                        </div>
                                        <div class="flex items-center justify-between gap-2">
                                            <input class="w-16 h-8 text-center bg-white" type="number" value="0" />
                                            <span class="text-[9px] text-luxe-muted font-bold">Price</span>
                                        </div>
                                    </div>
                                    <div class="bg-luxe-slate p-3 rounded-luxe border border-luxe-border">
                                        <span
                                            class="text-[9px] font-bold uppercase text-luxe-obsidian block mb-3">180-Hz
                                            Display</span>
                                        <div class="flex items-center justify-between gap-2 mb-2">
                                            <input class="w-16 h-8 text-center bg-white" type="number" value="0" />
                                            <span class="text-[9px] text-luxe-muted font-bold">Units</span>
                                        </div>
                                        <div class="flex items-center justify-between gap-2">
                                            <input class="w-16 h-8 text-center bg-white" type="number" value="0" />
                                            <span class="text-[9px] text-luxe-muted font-bold">Price</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </section>
                </div>
                <!-- Right Column: Pricing & Organization -->
                <aside class="col-span-4 space-y-6">
                    <!-- Section: Pricing -->
                    <section class="bg-white p-6 rounded-luxe border border-luxe-border shadow-sm"
                        data-purpose="pricing">
                        <h3 class="text-[10px] font-bold uppercase tracking-widest mb-6 text-luxe-obsidian">Pricing</h3>
                        <div class="space-y-4">
                            <div>
                                <label class="block text-[9px] font-bold text-luxe-muted uppercase mb-1">Base
                                    Price</label>
                                <div class="relative">
                                    <span
                                        class="absolute left-3 top-1/2 -translate-y-1/2 text-xs text-luxe-muted">₹</span>
                                    <input class="w-full pl-7 py-2 font-medium" type="text" value="0.00" />
                                </div>
                            </div>
                            <div>
                                <label class="block text-[9px] font-bold text-luxe-muted uppercase mb-1">Discounted
                                    Price</label>
                                <div class="relative">
                                    <span
                                        class="absolute left-3 top-1/2 -translate-y-1/2 text-xs text-luxe-muted">₹</span>
                                    <input class="w-full pl-7 py-2 font-medium" type="text" value="0.00" />
                                </div>
                            </div>
                        </div>
                    </section>
                    <!-- Section: Organization -->
                    <section class="bg-white p-6 rounded-luxe border border-luxe-border shadow-sm"
                        data-purpose="organization">
                        <h3 class="text-[10px] font-bold uppercase tracking-widest mb-6 text-luxe-obsidian">Organization
                        </h3>
                        <div class="space-y-4">
                            <div>
                                <label class="block text-[9px] font-bold text-luxe-muted uppercase mb-1">SKU / Product
                                    Code</label>
                                <input class="w-full px-3 py-2 font-medium" type="text" value="LX-MON-34-CURV" />
                            </div>
                            <div>
                                <label class="block text-[9px] font-bold text-luxe-muted uppercase mb-1">Status</label>
                                <select class="w-full px-3 py-2 font-medium">
                                    <option>InStock</option>
                                    <option>Out of Stock</option>
                                    <option>Draft</option>
                                </select>
                            </div>
                        </div>
                    </section>
                    <!-- Action Buttons -->
                    <div class="space-y-2">
                        <button
                            class="w-full bg-luxe-accent hover:bg-luxe-obsidian text-white font-bold py-3 text-xs uppercase tracking-widest rounded-luxe transition-all shadow-lg shadow-slate-200">
                            Save Product
                        </button>
                        <button
                            class="w-full bg-white hover:bg-luxe-slate text-luxe-obsidian border border-luxe-border font-bold py-3 text-xs uppercase tracking-widest rounded-luxe transition-all">
                            Cancel
                        </button>
                    </div>
                    <!-- Security Notice -->
                    <div class="bg-luxe-slate p-4 rounded-luxe border border-luxe-border flex gap-3">
                        <div class="text-luxe-accent mt-0.5">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewbox="0 0 24 24">
                                <path
                                    d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"
                                    stroke-linecap="round" stroke-linejoin="round" stroke-width="2"></path>
                            </svg>
                        </div>
                        <div class="space-y-1">
                            <p class="text-[10px] font-bold uppercase tracking-tight text-luxe-obsidian">Secure Portal
                            </p>
                            <p class="text-[9px] leading-relaxed text-luxe-muted">Changes made here are logged and
                                synchronized across global warehouses in real-time.</p>
                        </div>
                    </div>
                </aside>
            </div>
        </main>
        <!-- END: Main Content Area -->
    </div>
    <!-- END: Main Dashboard Layout -->
</body>

</html>