<!DOCTYPE html>
<html class="light" lang="en">
<head>
    <meta charset="utf-8"/>
    <meta content="width=device-width, initial-scale=1.0" name="viewport"/>
    <title>Sales Reports | Luxe Tech Admin</title>
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@200;300;400;500;600;700;800&amp;family=Inter:wght@300;400;500;600&amp;display=swap" rel="stylesheet"/>
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet"/>
    <script id="tailwind-config">
      tailwind.config = {
        darkMode: "class",
        theme: {
          extend: {
            colors: {
              "tertiary": "#526072",
              "on-primary": "#f7f7fa",
              "error-container": "#fe8983",
              "on-error": "#fff7f6",
              "tertiary-fixed-dim": "#cddbf0",
              "surface-container": "#eaeff1",
              "on-tertiary-fixed": "#364455",
              "on-tertiary-fixed-variant": "#526072",
              "secondary-fixed": "#cae6fd",
              "on-primary-container": "#505254",
              "primary": "#5d5e61",
              "on-tertiary-container": "#485668",
              "on-secondary-fixed-variant": "#445f72",
              "primary-fixed": "#e2e2e5",
              "secondary-fixed-dim": "#bcd8ef",
              "tertiary-container": "#dbe9ff",
              "on-secondary-container": "#3a5568",
              "on-primary-fixed": "#3e3f42",
              "outline": "#737c7f",
              "surface-container-highest": "#dbe4e7",
              "outline-variant": "#abb3b7",
              "inverse-primary": "#f9f9fc",
              "secondary-dim": "#3b5669",
              "on-background": "#2b3437",
              "inverse-on-surface": "#9b9d9e",
              "error-dim": "#4e0309",
              "secondary-container": "#cae6fd",
              "on-surface-variant": "#586064",
              "on-secondary-fixed": "#274254",
              "tertiary-fixed": "#dbe9ff",
              "surface-container-low": "#f1f4f6",
              "primary-dim": "#515255",
              "primary-fixed-dim": "#d4d4d7",
              "on-tertiary": "#f7f9ff",
              "surface-container-lowest": "#ffffff",
              "surface-container-high": "#e3e9ec",
              "secondary": "#476275",
              "surface-variant": "#dbe4e7",
              "surface-tint": "#5d5e61",
              "on-secondary": "#f5f9ff",
              "on-error-container": "#752121",
              "on-surface": "#2b3437",
              "error": "#9f403d",
              "surface-dim": "#d1dce0",
              "on-primary-fixed-variant": "#5a5c5e",
              "surface": "#f8f9fa",
              "tertiary-dim": "#465465",
              "background": "#f8f9fa",
              "primary-container": "#e2e2e5",
              "surface-bright": "#f8f9fa",
              "inverse-surface": "#0c0f10"
            },
            fontFamily: {
              "headline": ["Manrope"],
              "body": ["Inter"],
              "label": ["Inter"]
            },
            borderRadius: {"DEFAULT": "0.125rem", "lg": "0.25rem", "xl": "0.5rem", "full": "0.75rem"},
          },
        },
      }
    </script>
    <style>
        .material-symbols-outlined {
            font-variation-settings: 'FILL' 0, 'wght' 300, 'GRAD' 0, 'opsz' 24;
            vertical-align: middle;
        }
        body {
            font-family: 'Inter', sans-serif;
            background-color: #f8f9fa;
            color: #2b3437;
        }
        .editorial-shadow {
            box-shadow: 0 20px 40px rgba(43, 52, 55, 0.04);
        }
        .luxe-gradient {
            background: linear-gradient(135deg, #5d5e61 0%, #476275 100%);
        }
    </style>
</head>
<body class="bg-background text-on-surface selection:bg-secondary-container selection:text-on-secondary-container">

    <!-- Shared Layout (Sidebar and Header) -->
    <%- include('../partials/admin/layout', { activePage: 'analytics' }) %>

    <!-- Main Content Canvas -->
    <main class="ml-0 lg:ml-64 pt-20 lg:pt-16 min-h-screen bg-surface">
        <div class="max-w-[1400px] mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12 space-y-12">
            <!-- Header & Filter Actions -->
            <div class="flex flex-col md:flex-row md:items-end justify-between gap-8">
                <div>
                    <span class="label-sm font-label text-[0.6875rem] uppercase tracking-[0.2em] text-secondary font-semibold mb-2 block">Analytics &amp; Insights</span>
                    <h2 class="text-4xl md:text-5xl font-headline font-extrabold tracking-tighter text-on-surface">Sales Reports</h2>
                </div>
                <div class="flex flex-wrap items-center gap-4">
                    <div class="bg-surface-container-low p-1.5 rounded-lg flex items-center gap-0.5">
                        <% const periods = [['all','All Time'],['day','Today'],['week','Last 7D'],['year','This Year']]; %>
                        <% periods.forEach(function(p) { %>
                            <a href="/admin/analytics?period=<%= p[0] %>"
                               class="px-4 py-1.5 rounded-md text-xs font-bold font-label uppercase tracking-widest transition-colors
                                      <%= period === p[0] ? 'bg-surface-container-lowest shadow-sm text-on-surface' : 'text-on-surface-variant hover:text-on-surface hover:bg-surface-container' %>">
                                <%= p[1] %>
                            </a>
                        <% }); %>
                    </div>
                </div>
            </div>

            <!-- Key Metrics Grid -->
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 sm:gap-8 lg:gap-10 pt-4">
                <div class="space-y-2">
                    <p class="text-[0.6875rem] font-label uppercase tracking-widest text-on-surface-variant">Total Revenue</p>
                    <div class="flex items-baseline gap-3">
                        <span class="text-4xl font-headline font-bold text-on-surface tracking-tighter">₹<%= totalRevenue.toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></span>
                    </div>
                </div>
                <div class="space-y-2">
                    <p class="text-[0.6875rem] font-label uppercase tracking-widest text-on-surface-variant">Total Orders</p>
                    <div class="flex items-baseline gap-3">
                        <span class="text-4xl font-headline font-bold text-on-surface tracking-tighter"><%= totalOrders.toLocaleString('en-IN') %></span>
                    </div>
                </div>
                <div class="space-y-2">
                    <p class="text-[0.6875rem] font-label uppercase tracking-widest text-on-surface-variant">Avg. Order Value</p>
                    <div class="flex items-baseline gap-3">
                        <span class="text-4xl font-headline font-bold text-on-surface tracking-tighter">₹<%= avgValuePerOrder.toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></span>
                    </div>
                </div>
                <div class="space-y-2">
                    <p class="text-[0.6875rem] font-label uppercase tracking-widest text-on-surface-variant">Conversion Rate</p>
                    <div class="flex items-baseline gap-3">
                        <span class="text-4xl font-headline font-bold text-on-surface tracking-tighter"><%= conversionRate.toFixed(2) %>%</span>
                    </div>
                </div>
            </div>

            <!-- Sales Overview Section: Chart Canvas -->
            <section class="bg-surface-container-low p-4 sm:p-8 md:p-12 rounded-3xl space-y-8">
                <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
                    <h3 class="text-xl font-headline font-bold tracking-tight">Revenue Trends</h3>
                    <div class="flex gap-4 flex-wrap">
                        <div class="flex items-center gap-2">
                            <span class="w-3 h-3 rounded-full bg-secondary"></span>
                            <span class="text-[0.6875rem] font-label uppercase tracking-widest text-on-surface-variant">Gross Revenue</span>
                        </div>
                        <div class="flex items-center gap-2">
                            <span class="w-3 h-3 rounded-full bg-primary/20"></span>
                            <span class="text-[0.6875rem] font-label uppercase tracking-widest text-on-surface-variant">Net Profit</span>
                        </div>
                    </div>
                </div>
                <!-- Line Chart using dynamic SVGs -->
                <% 
                  const trendVals = revenueTrend.values;
                  const trendLabels = revenueTrend.labels;
                  const maxVal = Math.max(...trendVals, 100);
                  const points = [];
                  const n = trendVals.length;
                  for (let i = 0; i < n; i++) {
                      const x = Math.round((i / (n - 1)) * 1000);
                      const y = Math.round(260 - (trendVals[i] / maxVal) * 200);
                      points.push({ x, y, value: trendVals[i], label: trendLabels[i] });
                  }
                  let linePath = '';
                  let fillPath = '';
                  if (points.length > 0) {
                      linePath = `M ${points[0].x},${points[0].y}`;
                      for (let i = 1; i < points.length; i++) {
                          linePath += ` L ${points[i].x},${points[i].y}`;
                      }
                      fillPath = `${linePath} L ${points[points.length - 1].x},260 L ${points[0].x},260 Z`;
                  }
                %>
                <div class="h-80 w-full relative group">
                    <svg class="w-full h-full" preserveAspectRatio="none" viewBox="0 0 1000 320">
                        <!-- Grid Lines -->
                        <line opacity="0.1" stroke="#abb3b7" stroke-dasharray="8,8" stroke-width="0.5" x1="0" x2="1000" y1="80" y2="80"></line>
                        <line opacity="0.1" stroke="#abb3b7" stroke-dasharray="8,8" stroke-width="0.5" x1="0" x2="1000" y1="160" y2="160"></line>
                        <line opacity="0.1" stroke="#abb3b7" stroke-dasharray="8,8" stroke-width="0.5" x1="0" x2="1000" y1="240" y2="240"></line>
                        
                        <% if (points.length > 0) { %>
                            <!-- Gradient Area -->
                            <path d="<%= fillPath %>" fill="url(#grad1)" opacity="0.08"></path>
                            <!-- Primary Line -->
                            <path d="<%= linePath %>" fill="none" stroke="#476275" stroke-linecap="round" stroke-width="3"></path>
                            <!-- Interactive Dots -->
                            <% points.forEach(function(pt) { %>
                                <circle cx="<%= pt.x %>" cy="<%= pt.y %>" r="5" fill="#476275" stroke="#ffffff" stroke-width="2" class="cursor-pointer hover:scale-150 transition-transform">
                                    <title><%= pt.label %>: ₹<%= pt.value.toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></title>
                                </circle>
                            <% }); %>
                        <% } %>
                        
                        <defs>
                            <linearGradient id="grad1" x1="0%" x2="0%" y1="0%" y2="100%">
                                <stop offset="0%" style="stop-color:#476275;stop-opacity:1"></stop>
                                <stop offset="100%" style="stop-color:#476275;stop-opacity:0"></stop>
                            </linearGradient>
                        </defs>
                    </svg>
                    <!-- X-Axis Labels -->
                    <div class="absolute bottom-0 w-full flex justify-between pt-4 px-2 text-[10px] font-label uppercase tracking-widest text-on-surface-variant">
                        <% trendLabels.forEach(function(lbl) { %>
                            <span><%= lbl %></span>
                        <% }); %>
                    </div>
                </div>
            </section>

            <!-- Bottom Layout: Category & Products (60/40 Asymmetric Split) -->
            <div class="grid grid-cols-1 lg:grid-cols-10 gap-12">
                <!-- Category Performance -->
                <div class="lg:col-span-6 space-y-8">
                    <div class="border-b-0 border-outline-variant/15 pb-4">
                        <h3 class="text-xl font-headline font-bold tracking-tight">Category Performance</h3>
                        <p class="text-xs text-on-surface-variant mt-1">Revenue distribution by main equipment types</p>
                    </div>
                    <div class="space-y-6">
                        <% categoryPerformance.forEach(function(item) { %>
                            <div class="space-y-2">
                                <div class="flex justify-between text-xs font-label uppercase tracking-widest">
                                    <span class="text-on-surface font-semibold"><%= item.category %></span>
                                    <span class="text-on-surface-variant">₹<%= item.sales.toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %> (<%= item.percentage %>%)</span>
                                </div>
                                <div class="h-1.5 w-full bg-surface-container-highest rounded-full overflow-hidden">
                                    <div class="h-full bg-secondary rounded-full" style="width: <%= item.percentage %>%"></div>
                                </div>
                            </div>
                        <% }); %>
                    </div>
                </div>

                <!-- Top Selling Products -->
                <div class="lg:col-span-4 bg-surface-container-low p-6 sm:p-8 rounded-3xl self-start">
                    <h3 class="text-xl font-headline font-bold tracking-tight mb-8">Top Products</h3>
                    <div class="space-y-6">
                        <% topProducts.forEach(function(item) { %>
                            <div class="flex items-center gap-4">
                                <div class="w-12 h-12 bg-surface-container-lowest rounded-lg overflow-hidden p-1 flex items-center justify-center">
                                    <img class="w-full h-full object-contain" alt="<%= item.name %>" src="<%= item.image %>"/>
                                </div>
                                <div class="flex-1 min-w-0">
                                    <p class="text-sm font-bold text-on-surface truncate"><%= item.name %></p>
                                    <p class="text-[10px] text-on-surface-variant uppercase tracking-widest"><%= item.categoryName %></p>
                                </div>
                                <div class="text-right">
                                    <p class="text-sm font-bold text-on-surface">₹<%= item.sales.toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></p>
                                </div>
                            </div>
                        <% }); %>
                    </div>
                </div>
            </div>

            <!-- Bottom Space for Padding -->
            <div class="h-24"></div>
        </div>
    </main>

    <!-- FAB for Quick Actions -->
    <div class="fixed bottom-8 right-8 z-50">
        <button class="luxe-gradient w-14 h-14 rounded-full flex items-center justify-center text-on-primary shadow-xl scale-100 hover:scale-110 active:scale-95 transition-transform">
            <span class="material-symbols-outlined">add</span>
        </button>
    </div>
</body>
</html>
