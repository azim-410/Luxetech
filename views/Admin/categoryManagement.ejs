<!DOCTYPE html>

<html class="light" lang="en">

<head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>Categories Overview | Luxe Tech Admin</title>
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link
        href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;600;700;800&amp;family=Inter:wght@400;500;600&amp;display=swap"
        rel="stylesheet" />
    <link
        href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap"
        rel="stylesheet" />
    <link
        href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap"
        rel="stylesheet" />
    <script id="tailwind-config">
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    colors: {
                        "primary": "#5d5e61",
                        "on-primary-fixed": "#3e3f42",
                        "primary-fixed": "#e2e2e5",
                        "on-primary-fixed-variant": "#5a5c5e",
                        "on-secondary-container": "#3a5568",
                        "inverse-surface": "#0c0f10",
                        "on-primary": "#f7f7fa",
                        "on-tertiary-container": "#485668",
                        "surface-container-low": "#f1f4f6",
                        "on-tertiary": "#f7f9ff",
                        "error-container": "#fe8983",
                        "surface-container-high": "#e3e9ec",
                        "surface-bright": "#f8f9fa",
                        "on-surface": "#2b3437",
                        "surface-container": "#eaeff1",
                        "tertiary-container": "#dbe9ff",
                        "on-primary-container": "#505254",
                        "inverse-on-surface": "#9b9d9e",
                        "error": "#9f403d",
                        "surface-container-highest": "#dbe4e7",
                        "on-surface-variant": "#586064",
                        "surface-dim": "#d1dce0",
                        "on-background": "#2b3437",
                        "surface": "#f8f9fa",
                        "secondary-dim": "#3b5669",
                        "tertiary": "#526072",
                        "tertiary-dim": "#465465",
                        "surface-container-lowest": "#ffffff",
                        "secondary-fixed-dim": "#bcd8ef",
                        "inverse-primary": "#f9f9fc",
                        "secondary-fixed": "#cae6fd",
                        "primary-fixed-dim": "#d4d4d7",
                        "secondary": "#476275",
                        "on-tertiary-fixed": "#364455",
                        "on-secondary-fixed-variant": "#445f72",
                        "on-error": "#fff7f6",
                        "outline-variant": "#abb3b7",
                        "outline": "#737c7f",
                        "on-error-container": "#752121",
                        "tertiary-fixed": "#dbe9ff",
                        "secondary-container": "#cae6fd",
                        "primary-dim": "#515255",
                        "error-dim": "#4e0309",
                        "primary-container": "#e2e2e5",
                        "on-tertiary-fixed-variant": "#526072",
                        "background": "#f8f9fa",
                        "surface-variant": "#dbe4e7",
                        "tertiary-fixed-dim": "#cddbf0",
                        "surface-tint": "#5d5e61",
                        "on-secondary-fixed": "#274254",
                        "on-secondary": "#f5f9ff"
                    },
                    fontFamily: {
                        "headline": ["Manrope"],
                        "body": ["Inter"],
                        "label": ["Inter"]
                    },
                    borderRadius: { "DEFAULT": "0.125rem", "lg": "0.25rem", "xl": "0.5rem", "full": "0.75rem" },
                },
            },
        }
    </script>
    <style>
        body {
            font-family: 'Inter', sans-serif;
        }

        h1,
        h2,
        h3 {
            font-family: 'Manrope', sans-serif;
        }

        .material-symbols-outlined {
            font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
        }
    </style>
</head>

<body class="bg-surface text-on-surface">
    <%- include('../partials/admin/layout', { activePage: 'categories' }) %>

        <!-- Main Content Canvas -->
        <main class="ml-64 pt-16 min-h-screen flex flex-col">
            <!-- Page Header Section -->
            <section class="px-12 py-10 flex justify-between items-end">
                <div>
                    <nav
                        class="flex items-center gap-2 text-[10px] uppercase tracking-[0.1em] text-outline mb-2 font-bold">
                        <span>Admin</span>
                        <span class="material-symbols-outlined text-[12px]">chevron_right</span>
                        <span class="text-secondary">Categories</span>
                    </nav>
                    <h2 class="text-4xl font-headline font-extrabold text-on-surface tracking-tight">Categories Overview
                    </h2>
                    <p class="text-on-surface-variant mt-1 font-body text-sm">Manage product taxonomy and collection
                        hierarchies.</p>
                </div>
                <button onclick="openCategoryModal(true)"
                    class="flex items-center gap-2 px-6 py-3 bg-gradient-to-br from-primary to-secondary text-on-primary rounded-md font-label font-semibold text-sm shadow-md hover:-translate-y-0.5 transition-all">
                    <span class="material-symbols-outlined text-sm" data-icon="add">add</span>
                    Add New Category
                </button>
            </section>
            <!-- Category Table Container -->
            <section class="px-12 pb-20 flex-1">
                <div class="bg-surface-container-lowest rounded-xl shadow-[0_2px_40px_rgba(43,52,55,0.06)] overflow-hidden">
                    <div class="px-8 py-6 flex items-center justify-between border-b border-outline-variant/15">
                        <div class="flex items-center gap-8">
                            <h3 class="font-headline font-bold text-on-surface">All Categories</h3>
                            <div class="flex items-center gap-2">
                                <span class="w-2 h-2 rounded-full bg-secondary"></span>
                                <span class="text-xs font-label text-on-surface-variant uppercase tracking-wider">
                                    <%= locals.totalActive || 0 %> Active Collections
                                </span>
                            </div>
                        </div>
                        <div class="flex items-center gap-3">
                            <!-- Static search bar -->
                            <div class="flex items-center gap-2 px-3 py-2 bg-surface-container border border-outline-variant/20 rounded-full w-56 group">
                                <span class="material-symbols-outlined text-[16px] text-outline shrink-0">search</span>
                                <input
                                     id="searchInput"
                                    type="text"
                                    placeholder="Search categories…"
                                    class="bg-transparent border-0 text-xs text-on-surface placeholder:text-outline/50 outline-none focus:outline-none focus:ring-0 focus:border-0 w-full"
                                     />
                                <button
                                    id="clearSearch"
                                    type="button"
                                    class="hidden shrink-0 w-4 h-4 items-center justify-center rounded-full bg-outline/20 hover:bg-outline/40 text-outline transition-colors"
                                    title="Clear search">
                                    <span class="material-symbols-outlined text-[11px] leading-none">close</span>
                                </button>
                            </div>
                            <!-- Filter / Sort dropdown -->
                            <div class="relative" id="sortDropdownWrapper">
                                <button id="sortBtn"
                                    class="flex items-center gap-2 px-3 py-1.5 text-xs font-medium text-on-surface-variant bg-surface-container border border-outline-variant/20 hover:bg-surface-container-high transition-colors rounded-lg">
                                    <span class="material-symbols-outlined text-sm">filter_list</span>
                                    Filter
                                </button>
                                <div id="sortDropdown"
                                    class="hidden absolute right-0 mt-1 w-44 bg-surface-container-lowest border border-outline-variant/15 rounded-lg shadow-lg overflow-hidden z-20">
                                    <p class="px-4 pt-3 pb-1 text-[10px] font-bold uppercase tracking-widest text-outline">Sort by</p>
                                    <% const sortOptions = [['latest','Latest First'],['oldest','Oldest First'],['a-z','Name A → Z'],['z-a','Name Z → A']]; %>
                                    <% sortOptions.forEach(([val, label]) => { %>
                                        <button
                                            class="sort-option w-full text-left px-4 py-2.5 text-xs font-medium transition-colors
                                                   <%= (locals.sort || 'latest') === val ? 'bg-secondary/10 text-secondary font-bold' : 'text-on-surface-variant hover:bg-surface-container' %>"
                                            data-sort="<%= val %>">
                                            <%= label %>
                                        </button>
                                    <% }); %>
                                    <div class="h-2"></div>
                                </div>
                            </div>
                            <button
                                class="flex items-center gap-2 px-3 py-1.5 text-xs font-medium text-on-surface-variant bg-surface-container border border-outline-variant/20 hover:bg-surface-container-high transition-colors rounded-lg">
                                <span class="material-symbols-outlined text-sm">download</span>
                                Export
                            </button>
                        </div>
                    </div>
                    <div class="overflow-x-auto">
                        <table class="w-full text-left border-collapse">
                            <thead>
                                <tr class="bg-surface-container-low/50">
                                    <th
                                        class="px-8 py-4 text-[11px] font-label font-bold uppercase tracking-widest text-on-surface-variant">
                                        Category Name</th>
                                    <th
                                        class="px-8 py-4 text-[11px] font-label font-bold uppercase tracking-widest text-on-surface-variant">
                                        Slug</th>
                                    <th
                                        class="px-8 py-4 text-[11px] font-label font-bold uppercase tracking-widest text-on-surface-variant">
                                        Total Products</th>
                                    <th
                                        class="px-8 py-4 text-[11px] font-label font-bold uppercase tracking-widest text-on-surface-variant">
                                        Visibility</th>
                                    <th
                                        class="px-8 py-4 text-[11px] font-label font-bold uppercase tracking-widest text-on-surface-variant">
                                        Status</th>
                                    <th
                                        class="px-8 py-4 text-[11px] font-label font-bold uppercase tracking-widest text-on-surface-variant text-right">
                                        Actions</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-outline-variant/10" id="categoryTableBody">
                                     <% if (locals.categories && locals.categories.length > 0) { %>
                                    <% locals.categories.forEach((category)=> { %>
                                        <tr class="hover:bg-surface-container-low/30 transition-colors group <%= category.status === false ? 'opacity-60' : '' %>">
                                            <!-- Category Name -->
                                            <td class="px-8 py-5">
                                                <div class="flex items-center gap-4">
                                                    <div
                                                        class="w-10 h-10 rounded bg-surface-container-high flex items-center justify-center overflow-hidden">
                                                        <% if (category.image) { %>
                                                            <img src="<%= category.image %>"
                                                                alt="<%= category.categoryName %>"
                                                                class="w-full h-full object-cover" />
                                                            <% } else { %>
                                                                <span
                                                                    class="material-symbols-outlined text-secondary">category</span>
                                                                <% } %>
                                                    </div>
                                                    <div>
                                                        <p class="font-headline font-bold text-on-surface text-sm">
                                                            <%= category.categoryName %>
                                                        </p>
                                                        <% if (category.description) { %>
                                                            <p class="text-[10px] text-on-surface-variant">
                                                                <%= category.description %>
                                                            </p>
                                                            <% } %>
                                                    </div>
                                                </div>
                                            </td>
                                            <!-- Slug -->
                                            <td class="px-8 py-5">
                                                <% if (category.slug) { %>
                                                    <code
                                                        class="text-xs bg-surface-container px-2 py-1 rounded text-secondary font-medium"><%= category.slug %></code>
                                                    <% } else { %>
                                                        <span class="text-xs text-on-surface-variant">-</span>
                                                        <% } %>
                                            </td>
                                            <!-- Total Products -->
                                            <td class="px-8 py-5 font-headline font-semibold text-on-surface">
                                                <%= (typeof category.totalProducts !=='undefined' &&
                                                    category.totalProducts !==null) ? category.totalProducts : '-' %>
                                            </td>
                                            <!-- Visibility -->
                                            <td class="px-8 py-5">
                                                <% if (category.status === false) { %>
                                                    <span class="text-xs text-on-surface-variant/50">—</span>
                                                <% } else { %>
                                                    <span
                                                        class="inline-flex items-center gap-1 px-2 py-0.5 rounded text-[10px] font-bold uppercase tracking-wide
                                                               <%= category.isHidden ? 'bg-outline/15 text-outline' : 'bg-secondary-container/60 text-on-secondary-container' %>">
                                                        <span class="material-symbols-outlined text-[11px]"><%= category.isHidden ? 'visibility_off' : 'visibility' %></span>
                                                        <%= category.isHidden ? 'Hidden' : 'Visible' %>
                                                    </span>
                                                <% } %>
                                            </td>
                                            <!-- Status -->
                                            <td class="px-8 py-5">
                                                <% if (category.status === true) { %>
                                                    <span class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-bold uppercase tracking-wide bg-tertiary-container text-on-tertiary-container">Active</span>
                                                <% } else { %>
                                                    <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded text-[10px] font-bold uppercase tracking-wide bg-error-container/20 text-error">
                                                        <span class="material-symbols-outlined text-[11px]">block</span>
                                                        Inactive
                                                    </span>
                                                <% } %>
                                            </td>
                                            <!-- Actions -->
                                            <td class="px-8 py-5 text-right">
                                                <div class="flex items-center justify-end gap-1">
                                                    <% if (category.status === false) { %>
                                                        <!-- Edit disabled -->
                                                        <button
                                                            class="p-2 text-outline/30 rounded-md cursor-not-allowed"
                                                            title="Cannot edit an inactive category"
                                                            disabled>
                                                            <span class="material-symbols-outlined text-lg">edit</span>
                                                        </button>
                                                        <!-- Delete disabled -->
                                                        <button
                                                            class="p-2 text-outline/30 rounded-md cursor-not-allowed"
                                                            title="Category is already inactive"
                                                            disabled>
                                                            <span class="material-symbols-outlined text-lg">delete</span>
                                                        </button>
                                                    <% } else { %>
                                                        <button
                                                            class="p-2 text-on-surface-variant hover:text-primary hover:bg-surface-container rounded-md transition-all"
                                                            title="Edit"
                                                            onclick="openEditModal('<%= category._id %>', '<%= category.categoryName.replace(/'/g, "\\'") %>', '<%= (category.description || '').replace(/'/g, "\\'") %>', '<%= category.image || '' %>', '<%= category.isHidden ? 'true' : 'false' %>')">
                                                            <span class="material-symbols-outlined text-lg">edit</span>
                                                        </button>
                                                        <button
                                                            class="p-2 text-on-surface-variant hover:text-error hover:bg-surface-container rounded-md transition-all"
                                                            title="Deactivate"
                                                            onclick="openDeleteModal('<%= category._id %>', '<%= category.categoryName.replace(/'/g, "\\'") %>')">
                                                            <span class="material-symbols-outlined text-lg">delete</span>
                                                        </button>
                                                    <% } %>
                                                </div>
                                            </td>
                                        </tr>
                                        <% }); %>
                                            <% } else { %>
                                                <tr>
                                                    <td colspan="5"
                                                        class="px-8 py-12 text-center text-sm text-on-surface-variant">
                                                        No categories found
                                                    </td>
                                                </tr>
                                                <% } %>
                            </tbody>
                        </table>
                    </div>
                    <!-- Pagination -->
                    <div class="px-8 py-6 border-t border-outline-variant/15 flex items-center justify-between">
                        <p class="text-xs font-label text-on-surface-variant uppercase tracking-tighter">
                            Showing <%= locals.categories?.length ?? 0 %> of <%= locals.totalCategories ?? 0 %>
                                    categories
                        </p>
                        <div class="flex items-center gap-2">
                            <% if (locals.currentPage > 1) { %>
                                <a href="/admin/category-management?page=<%= locals.currentPage - 1 %>"
                                    class="flex items-center gap-1 px-4 py-2 border border-outline-variant/15 text-xs font-bold uppercase tracking-widest text-on-surface rounded-md hover:bg-surface-container transition-colors">
                                    <span class="material-symbols-outlined text-sm">chevron_left</span>
                                    Previous
                                </a>
                            <% } else { %>
                                <span
                                    class="flex items-center gap-1 px-4 py-2 border border-outline-variant/15 text-xs font-bold uppercase tracking-widest text-on-surface rounded-md opacity-50 cursor-not-allowed">
                                    <span class="material-symbols-outlined text-sm">chevron_left</span>
                                    Previous
                                </span>
                            <% } %>

                            <% for (let i = 1; i <= (locals.totalPage || 1); i++) { %>
                                <% if (i === (locals.currentPage || 1)) { %>
                                    <span
                                        class="w-8 h-8 rounded border border-outline-variant/15 flex items-center justify-center bg-secondary text-on-secondary font-bold text-xs">
                                        <%= i %>
                                    </span>
                                <% } else { %>
                                    <a href="/admin/category-management?page=<%= i %>"
                                        class="w-8 h-8 rounded border border-outline-variant/15 flex items-center justify-center text-xs text-on-surface-variant hover:bg-surface-container-low transition-colors">
                                        <%= i %>
                                    </a>
                                <% } %>
                            <% } %>

                            <% if (locals.currentPage < (locals.totalPage || 1)) { %>
                                <a href="/admin/category-management?page=<%= locals.currentPage + 1 %>"
                                    class="flex items-center gap-1 px-4 py-2 border border-outline-variant/15 text-xs font-bold uppercase tracking-widest text-on-surface rounded-md hover:bg-surface-container transition-colors">
                                    Next
                                    <span class="material-symbols-outlined text-sm">chevron_right</span>
                                </a>
                            <% } else { %>
                                <span
                                    class="flex items-center gap-1 px-4 py-2 border border-outline-variant/15 text-xs font-bold uppercase tracking-widest text-on-surface rounded-md opacity-50 cursor-not-allowed">
                                    Next
                                    <span class="material-symbols-outlined text-sm">chevron_right</span>
                                </span>
                            <% } %>
                        </div>
                    </div>
                </div>
            </section>
        </main>

    <!-- Create Category Modal -->
    <div id="createCategoryModal"
        class="fixed inset-0 z-50 flex items-center justify-center bg-black/30 backdrop-blur-sm hidden">
        <div class="bg-surface-container-lowest rounded-xl shadow-2xl w-full max-w-md mx-4 overflow-hidden">

            <!-- Modal Header -->
            <div class="flex items-center justify-between px-6 py-5 border-b border-outline-variant/10">
                <h2 class="text-lg font-bold font-manrope text-on-surface">New Category</h2>
                <button onclick="closeCategoryModal()" class="text-outline hover:text-on-surface transition-colors">
                    <span class="material-symbols-outlined">close</span>
                </button>
            </div>

            <!-- Error Message Container -->
            <div id="categoryErrorContainer" class="mx-6 mt-4 px-4 py-3 bg-error-container/20 text-on-error-container text-sm rounded-lg <%= (typeof createError !== 'undefined' && createError) ? '' : 'hidden' %>">
                <span id="categoryErrorMessage"><%= (typeof createError !== 'undefined' && createError) ? createError : '' %></span>
            </div>

            <!-- Modal Form -->
            <form id="createCategoryForm" action="/admin/category-management/create" method="POST" enctype="multipart/form-data" class="px-6 py-6 flex flex-col gap-4">

                <div class="flex flex-col gap-1.5">
                    <label class="text-[11px] font-bold uppercase tracking-widest text-on-surface-variant">Category Name</label>
                    <input type="text" id="categoryNameInput" name="categoryName" placeholder="e.g. Smartphones" required
                        class="bg-surface-container border border-outline-variant/20 rounded-lg px-4 py-2.5 text-sm text-on-surface focus:outline-none focus:ring-1 focus:ring-secondary transition-all" />
                </div>

                <div class="flex flex-col gap-1.5">
                    <label class="text-[11px] font-bold uppercase tracking-widest text-on-surface-variant">Description</label>
                    <textarea id="categoryDescriptionInput" name="description" placeholder="Provide category details..." rows="3"
                        class="bg-surface-container border border-outline-variant/20 rounded-lg px-4 py-2.5 text-sm text-on-surface focus:outline-none focus:ring-1 focus:ring-secondary transition-all resize-none"></textarea>
                </div>

                <div class="flex flex-col gap-1.5">
                    <label class="text-[11px] font-bold uppercase tracking-widest text-on-surface-variant">Category Image</label>
                    <div class="flex items-center gap-3">
                        <div id="createImagePreviewContainer" class="w-12 h-12 rounded bg-surface-container flex items-center justify-center overflow-hidden border border-outline-variant/20 shrink-0">
                            <span id="createImagePlaceholder" class="material-symbols-outlined text-outline">image</span>
                            <img id="createImagePreview" class="w-full h-full object-cover hidden" />
                        </div>
                        <input type="file" id="categoryImageInput" name="image" accept="image/*"
                            class="bg-surface-container border border-outline-variant/20 rounded-lg px-4 py-2 text-xs text-on-surface focus:outline-none focus:ring-1 focus:ring-secondary transition-all file:mr-4 file:py-1 file:px-3 file:rounded-full file:border-0 file:text-xs file:font-semibold file:bg-secondary/15 file:text-secondary hover:file:bg-secondary/25 cursor-pointer flex-1" />
                    </div>
                </div>

                <!-- status is always active on create -->
                <input type="hidden" name="status" value="true" />

                <!-- Visibility -->
                <div class="flex flex-col gap-1.5">
                    <label class="text-[11px] font-bold uppercase tracking-widest text-on-surface-variant">Visibility</label>
                    <div class="relative">
                        <select id="categoryVisibilityInput" name="isHidden"
                            class="w-full appearance-none bg-surface-container border border-outline-variant/20 rounded-lg px-4 py-2.5 text-sm text-on-surface focus:outline-none focus:ring-1 focus:ring-secondary transition-all pr-10 cursor-pointer">
                            <option value="false">Visible — shown to customers</option>
                            <option value="true">Hidden — not shown to customers</option>
                        </select>
                        <span class="material-symbols-outlined text-outline absolute right-3 top-1/2 -translate-y-1/2 text-[16px] pointer-events-none">expand_more</span>
                    </div>
                </div>

                <!-- Actions -->
                <div class="flex items-center justify-end gap-3 pt-2">
                    <button type="button" onclick="closeCategoryModal()"
                        class="px-5 py-2.5 rounded-md text-sm font-semibold text-on-surface-variant hover:bg-surface-container-low transition-all">
                        Cancel
                    </button>
                    <button type="submit"
                        class="bg-gradient-to-br from-primary to-secondary text-on-primary px-5 py-2.5 rounded-md text-sm font-semibold hover:-translate-y-0.5 shadow-sm transition-all">
                        Create Category
                    </button>
                </div>

            </form>
        </div>
    </div>

    <!-- Edit Category Modal -->
    <div id="editCategoryModal"
        class="fixed inset-0 z-50 flex items-center justify-center bg-black/30 backdrop-blur-sm hidden">
        <div class="bg-surface-container-lowest rounded-xl shadow-2xl w-full max-w-md mx-4 overflow-hidden">

            <!-- Modal Header -->
            <div class="flex items-center justify-between px-6 py-5 border-b border-outline-variant/10">
                <h2 class="text-lg font-bold font-manrope text-on-surface">Edit Category</h2>
                <button onclick="closeEditModal()" class="text-outline hover:text-on-surface transition-colors">
                    <span class="material-symbols-outlined">close</span>
                </button>
            </div>

            <!-- Error Message Container -->
            <div id="editCategoryErrorContainer" class="mx-6 mt-4 px-4 py-3 bg-error-container/20 text-on-error-container text-sm rounded-lg hidden">
                <span id="editCategoryErrorMessage"></span>
            </div>

            <!-- Modal Form -->
            <form id="editCategoryForm" enctype="multipart/form-data" class="px-6 py-6 flex flex-col gap-4">
                <input type="hidden" id="editCategoryId" name="id" />

                <div class="flex flex-col gap-1.5">
                    <label class="text-[11px] font-bold uppercase tracking-widest text-on-surface-variant">Category Name</label>
                    <input type="text" id="editCategoryNameInput" name="categoryName" placeholder="e.g. Smartphones" required
                        class="bg-surface-container border border-outline-variant/20 rounded-lg px-4 py-2.5 text-sm text-on-surface focus:outline-none focus:ring-1 focus:ring-secondary transition-all" />
                </div>

                <div class="flex flex-col gap-1.5">
                    <label class="text-[11px] font-bold uppercase tracking-widest text-on-surface-variant">Description</label>
                    <textarea id="editCategoryDescriptionInput" name="description" placeholder="Provide category details..." rows="3"
                        class="bg-surface-container border border-outline-variant/20 rounded-lg px-4 py-2.5 text-sm text-on-surface focus:outline-none focus:ring-1 focus:ring-secondary transition-all resize-none"></textarea>
                </div>

                <div class="flex flex-col gap-1.5">
                    <label class="text-[11px] font-bold uppercase tracking-widest text-on-surface-variant">Category Image</label>
                    <div class="flex items-center gap-3">
                        <div class="relative group shrink-0">
                            <div id="editImagePreviewContainer" class="w-12 h-12 rounded bg-surface-container flex items-center justify-center overflow-hidden border border-outline-variant/20">
                                <span id="editImagePlaceholder" class="material-symbols-outlined text-outline">image</span>
                                <img id="editImagePreview" class="w-full h-full object-cover hidden" />
                            </div>
                            <!-- Delete overlay button, shown on hover if image exists -->
                            <button type="button" id="deleteImageOverlayBtn" title="Delete Image"
                                class="absolute inset-0 bg-black/60 flex items-center justify-center text-error opacity-0 group-hover:opacity-100 transition-opacity rounded hidden">
                                <span class="material-symbols-outlined text-sm">delete</span>
                            </button>
                        </div>
                        <input type="file" id="editCategoryImageInput" name="image" accept="image/*"
                            class="bg-surface-container border border-outline-variant/20 rounded-lg px-4 py-2 text-xs text-on-surface focus:outline-none focus:ring-1 focus:ring-secondary transition-all file:mr-4 file:py-1 file:px-3 file:rounded-full file:border-0 file:text-xs file:font-semibold file:bg-secondary/15 file:text-secondary hover:file:bg-secondary/25 cursor-pointer flex-1" />
                    </div>
                </div>

                <!-- Visibility -->
                <div class="flex flex-col gap-1.5">
                    <label class="text-[11px] font-bold uppercase tracking-widest text-on-surface-variant">Visibility</label>
                    <div class="relative">
                        <select id="editCategoryVisibilityInput" name="isHidden"
                            class="w-full appearance-none bg-surface-container border border-outline-variant/20 rounded-lg px-4 py-2.5 text-sm text-on-surface focus:outline-none focus:ring-1 focus:ring-secondary transition-all pr-10 cursor-pointer">
                            <option value="false">Visible &mdash; shown to customers</option>
                            <option value="true">Hidden &mdash; not shown to customers</option>
                        </select>
                        <span class="material-symbols-outlined text-outline absolute right-3 top-1/2 -translate-y-1/2 text-[16px] pointer-events-none">expand_more</span>
                    </div>
                </div>

                <!-- Actions -->
                <div class="flex items-center justify-end gap-3 pt-2">
                    <button type="button" onclick="closeEditModal()"
                        class="px-5 py-2.5 rounded-md text-sm font-semibold text-on-surface-variant hover:bg-surface-container-low transition-all">
                        Cancel
                    </button>
                    <button type="submit" id="editCategorySubmitBtn"
                        class="bg-gradient-to-br from-primary to-secondary text-on-primary px-5 py-2.5 rounded-md text-sm font-semibold hover:-translate-y-0.5 shadow-sm transition-all">
                        Save Changes
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- Delete Confirmation Modal -->
    <div id="deleteCategoryModal"
        class="fixed inset-0 z-50 flex items-center justify-center bg-black/30 backdrop-blur-sm hidden">
        <div class="bg-surface-container-lowest rounded-xl shadow-2xl w-full max-w-sm mx-4 overflow-hidden">

            <!-- Modal Header -->
            <div class="flex items-center justify-between px-6 py-5 border-b border-outline-variant/10">
                <div class="flex items-center gap-3">
                    <div class="w-9 h-9 rounded-lg bg-error-container/20 flex items-center justify-center">
                        <span class="material-symbols-outlined text-error text-lg">delete_forever</span>
                    </div>
                    <h2 class="text-lg font-bold font-manrope text-on-surface">Delete Category</h2>
                </div>
                <button onclick="closeDeleteModal()" class="text-outline hover:text-on-surface transition-colors">
                    <span class="material-symbols-outlined">close</span>
                </button>
            </div>

            <!-- Body -->
            <div class="px-6 py-6">
                <p class="text-sm text-on-surface-variant leading-relaxed">
                    You are about to deactivate
                    <span id="deleteCategoryName" class="font-bold text-on-surface"></span>.
                    It will be removed from the list and its status set to <span class="text-error font-semibold">inactive</span>.
                </p>

                <!-- Inline error -->
                <div id="deleteCategoryErrorContainer" class="mt-4 px-4 py-3 bg-error-container/20 text-on-error-container text-sm rounded-lg hidden">
                    <span id="deleteCategoryErrorMessage"></span>
                </div>

                <!-- Actions -->
                <div class="flex items-center justify-end gap-3 mt-6">
                    <button type="button" onclick="closeDeleteModal()"
                        class="px-5 py-2.5 rounded-md text-sm font-semibold text-on-surface-variant hover:bg-surface-container-low transition-all">
                        Cancel
                    </button>
                    <button id="deleteCategoryConfirmBtn"
                        class="flex items-center gap-2 px-5 py-2.5 rounded-md text-sm font-semibold bg-error text-on-error hover:-translate-y-0.5 shadow-sm transition-all">
                        <span class="material-symbols-outlined text-sm">delete_forever</span>
                        Delete
                    </button>
                </div>
            </div>
        </div>
    </div>

    <script>
        const categoryModal = document.getElementById('createCategoryModal');
        const categoryForm = document.getElementById('createCategoryForm');
        const categoryErrorContainer = document.getElementById('categoryErrorContainer');
        const categoryErrorMessage = document.getElementById('categoryErrorMessage');

        function openCategoryModal(isNew = false) {
            if (isNew) {
                categoryForm.reset();
                categoryErrorContainer.classList.add('hidden');
                categoryErrorMessage.textContent = '';
                if (window.location.search.includes('createError')) {
                    window.history.replaceState({}, document.title, window.location.pathname);
                }
                const previewImg = document.getElementById('createImagePreview');
                const placeholder = document.getElementById('createImagePlaceholder');
                previewImg.src = '';
                previewImg.classList.add('hidden');
                placeholder.classList.remove('hidden');
            }
            categoryModal.classList.remove('hidden');
        }

        function closeCategoryModal() {
            categoryModal.classList.add('hidden');
            // reset file input & preview
            document.getElementById('categoryImageInput').value = '';
            const previewImg = document.getElementById('createImagePreview');
            const placeholder = document.getElementById('createImagePlaceholder');
            previewImg.src = '';
            previewImg.classList.add('hidden');
            placeholder.classList.remove('hidden');
        }

        // close on backdrop click
        categoryModal.addEventListener('click', (e) => {
            if (e.target === categoryModal) closeCategoryModal();
        });

        // Add Create File input change preview listener
        document.getElementById('categoryImageInput').addEventListener('change', function(e) {
            const previewImg = document.getElementById('createImagePreview');
            const placeholder = document.getElementById('createImagePlaceholder');
            const file = e.target.files[0];
            if (file) {
                const reader = new FileReader();
                reader.onload = function(e) {
                    previewImg.src = e.target.result;
                    previewImg.classList.remove('hidden');
                    placeholder.classList.add('hidden');
                };
                reader.readAsDataURL(file);
            } else {
                previewImg.src = '';
                previewImg.classList.add('hidden');
                placeholder.classList.remove('hidden');
            }
        });

        // client-side validation
        categoryForm.addEventListener('submit', (e) => {
            const name = document.getElementById('categoryNameInput').value.trim();

            if (name.length < 3) {
                e.preventDefault();
                showCategoryError('Category Name must be at least 3 characters long');
                return;
            }

            // Only letters, numbers and spaces allowed
            const nameRegex = /^[A-Za-z0-9\s]+$/;
            if (!nameRegex.test(name)) {
                e.preventDefault();
                showCategoryError('Category Name must contain only alphanumeric characters and spaces');
                return;
            }
        });

        function showCategoryError(msg) {
            categoryErrorMessage.textContent = msg;
            categoryErrorContainer.classList.remove('hidden');
        }

        <% if (typeof createError !== 'undefined' && createError) { %>
            openCategoryModal(false);
        <% } %>

        // ── Edit Modal ────────────────────────────────────────────────
        const editModal             = document.getElementById('editCategoryModal');
        const editForm              = document.getElementById('editCategoryForm');
        const editErrorContainer    = document.getElementById('editCategoryErrorContainer');
        const editErrorMessage      = document.getElementById('editCategoryErrorMessage');
        const editIdInput           = document.getElementById('editCategoryId');
        const editNameInput         = document.getElementById('editCategoryNameInput');
        const editDescriptionInput  = document.getElementById('editCategoryDescriptionInput');
        const editSubmitBtn         = document.getElementById('editCategorySubmitBtn');

        // holds the values as they were when the modal opened
        let _originals = { name: '', description: '', isHidden: 'false' };

        function openEditModal(id, name, description, imageUrl, isHidden) {
            // pre-fill
            editIdInput.value           = id;
            editNameInput.value         = name;
            editDescriptionInput.value  = description;

            // Pre-fill visibility dropdown
            const visibilitySelect = document.getElementById('editCategoryVisibilityInput');
            visibilitySelect.value = (isHidden === 'true') ? 'true' : 'false';

            // Reset image file input
            const fileInput = document.getElementById('editCategoryImageInput');
            fileInput.value = '';

            // Handle preview
            const previewImg = document.getElementById('editImagePreview');
            const placeholder = document.getElementById('editImagePlaceholder');
            const deleteImageBtn = document.getElementById('deleteImageOverlayBtn');
            if (imageUrl && imageUrl.trim() !== '') {
                previewImg.src = imageUrl;
                previewImg.classList.remove('hidden');
                placeholder.classList.add('hidden');
                deleteImageBtn.classList.remove('hidden');
            } else {
                previewImg.src = '';
                previewImg.classList.add('hidden');
                placeholder.classList.remove('hidden');
                deleteImageBtn.classList.add('hidden');
            }

            // snapshot originals for change-detection
            _originals = { name: name.trim(), description: (description || '').trim(), isHidden: (isHidden === 'true') ? 'true' : 'false' };

            // reset error state
            editErrorContainer.classList.add('hidden');
            editErrorMessage.textContent = '';

            editModal.classList.remove('hidden');
        }

        function closeEditModal() {
            editModal.classList.add('hidden');
        }

        // close on backdrop click
        editModal.addEventListener('click', (e) => {
            if (e.target === editModal) closeEditModal();
        });

        // Add file input change preview listener
        document.getElementById('editCategoryImageInput').addEventListener('change', function(e) {
            const previewImg = document.getElementById('editImagePreview');
            const placeholder = document.getElementById('editImagePlaceholder');
            const deleteImageBtn = document.getElementById('deleteImageOverlayBtn');
            const file = e.target.files[0];
            if (file) {
                const reader = new FileReader();
                reader.onload = function(e) {
                    previewImg.src = e.target.result;
                    previewImg.classList.remove('hidden');
                    placeholder.classList.add('hidden');
                    deleteImageBtn.classList.add('hidden'); // Hide delete button for unsaved local preview
                };
                reader.readAsDataURL(file);
            }
        });

        // Click handler for delete image overlay button
        document.getElementById('deleteImageOverlayBtn').addEventListener('click', async (e) => {
            e.stopPropagation();
            const confirmed = confirm("Are you sure you want to delete this category image?");
            if (!confirmed) return;

            const id = editIdInput.value;
            try {
                const res = await fetch(`/admin/category-management/delete-image/${id}`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' }
                });
                const data = await res.json();
                if (res.ok && data.success) {
                    window.location.reload();
                } else {
                    showEditError(data.message || 'Failed to delete category image');
                }
            } catch (err) {
                showEditError('Network error. Failed to delete image.');
            }
        });

        function showEditError(msg) {
            editErrorMessage.textContent = msg;
            editErrorContainer.classList.remove('hidden');
        }

        editForm.addEventListener('submit', async (e) => {
            e.preventDefault();

            const name = editNameInput.value.trim();

            // client-side validation (mirrors create)
            if (name.length < 3) {
                showEditError('Category Name must be at least 3 characters long');
                return;
            }
            const nameRegex = /^[A-Za-z0-9\s]+$/;
            if (!nameRegex.test(name)) {
                showEditError('Category Name must contain only alphanumeric characters and spaces');
                return;
            }

            const fileInput = document.getElementById('editCategoryImageInput');

            // ── No-change guard ───────────────────────────────────────
            const currentDesc       = editDescriptionInput.value.trim();
            const currentVisibility = document.getElementById('editCategoryVisibilityInput').value;
            if (
                name              === _originals.name &&
                currentDesc       === _originals.description &&
                currentVisibility === _originals.isHidden &&
                !fileInput.files[0]
            ) {
                showEditError('No changes made. Please modify at least one field before saving.');
                return;
            }

            const id = editIdInput.value;
            editSubmitBtn.disabled   = true;
            editSubmitBtn.textContent = 'Saving…';

            try {
                const formData = new FormData();
                formData.append('categoryName', name);
                formData.append('description', editDescriptionInput.value.trim());
                formData.append('isHidden', document.getElementById('editCategoryVisibilityInput').value);
                if (fileInput.files[0]) {
                    formData.append('image', fileInput.files[0]);
                }

                const res = await fetch(`/admin/category-management/edit/${id}`, {
                    method: 'PATCH',
                    body: formData
                });

                const data = await res.json();

                if (res.ok && data.success) {
                    closeEditModal();
                    window.location.reload();
                } else {
                    showEditError(data.message || 'Failed to update category');
                }
            } catch (err) {
                showEditError('Network error. Please try again.');
            } finally {
                editSubmitBtn.disabled   = false;
                editSubmitBtn.textContent = 'Save Changes';
            }
        });

        // ── Delete Modal ───────────────────────────────────────────────
        const deleteModal        = document.getElementById('deleteCategoryModal');
        const deleteCatName      = document.getElementById('deleteCategoryName');
        const deleteErrContainer = document.getElementById('deleteCategoryErrorContainer');
        const deleteErrMessage   = document.getElementById('deleteCategoryErrorMessage');
        const deleteConfirmBtn   = document.getElementById('deleteCategoryConfirmBtn');
        let _deleteTargetId      = null;

        function openDeleteModal(id, name) {
            _deleteTargetId = id;
            deleteCatName.textContent = name;
            deleteErrContainer.classList.add('hidden');
            deleteErrMessage.textContent = '';
            deleteModal.classList.remove('hidden');
        }

        function closeDeleteModal() {
            deleteModal.classList.add('hidden');
            _deleteTargetId = null;
        }

        // close on backdrop click
        deleteModal.addEventListener('click', (e) => {
            if (e.target === deleteModal) closeDeleteModal();
        });

        deleteConfirmBtn.addEventListener('click', async () => {
            if (!_deleteTargetId) return;

            deleteConfirmBtn.disabled = true;
            deleteConfirmBtn.innerHTML = '<span class="material-symbols-outlined text-sm animate-spin">progress_activity</span> Deleting…';

            try {
                const res  = await fetch(`/admin/category-management/delete/${_deleteTargetId}`, {
                    method: 'PATCH',
                    headers: { 'Content-Type': 'application/json' }
                });
                const data = await res.json();

                if (res.ok && data.success) {
                    closeDeleteModal();
                    window.location.reload();
                } else {
                    deleteErrMessage.textContent = data.message || 'Failed to delete category.';
                    deleteErrContainer.classList.remove('hidden');
                }
            } catch (err) {
                deleteErrMessage.textContent = 'Network error. Please try again.';
                deleteErrContainer.classList.remove('hidden');
            } finally {
                deleteConfirmBtn.disabled = false;
                deleteConfirmBtn.innerHTML = '<span class="material-symbols-outlined text-sm">delete_forever</span> Delete';
            }
        });

    let debounceTimer;
    let currentSort = '<%= locals.sort || "latest" %>';
    const searchInput = document.getElementById('searchInput');
    const clearBtn    = document.getElementById('clearSearch');
    const sortBtn     = document.getElementById('sortBtn');
    const sortDropdown = document.getElementById('sortDropdown');

    // ── Sort dropdown toggle
    sortBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        sortDropdown.classList.toggle('hidden');
    });
    document.addEventListener('click', () => sortDropdown.classList.add('hidden'));

    // ── Sort option click
    sortDropdown.querySelectorAll('.sort-option').forEach(btn => {
        btn.addEventListener('click', () => {
            currentSort = btn.dataset.sort;
            // highlight active
            sortDropdown.querySelectorAll('.sort-option').forEach(b => {
                b.classList.remove('bg-secondary/10','text-secondary','font-bold');
                b.classList.add('text-on-surface-variant','hover:bg-surface-container');
            });
            btn.classList.add('bg-secondary/10','text-secondary','font-bold');
            btn.classList.remove('text-on-surface-variant','hover:bg-surface-container');
            sortDropdown.classList.add('hidden');
            fetchTable(searchInput.value.trim(), currentSort);
        });
    });

    // ── Search input
    searchInput.addEventListener('input', function () {
        clearTimeout(debounceTimer);
        clearBtn.classList.toggle('hidden', !this.value);
        clearBtn.classList.toggle('flex', !!this.value);
        debounceTimer = setTimeout(() => fetchTable(this.value.trim(), currentSort), 300);
    });

    clearBtn.addEventListener('click', function () {
        searchInput.value = '';
        clearBtn.classList.add('hidden');
        clearBtn.classList.remove('flex');
        fetchTable('', currentSort);
    });



    async function fetchTable(query, sort = 'latest') {
        try {
            const res = await fetch(`/admin/category-management?search=${encodeURIComponent(query)}&sort=${encodeURIComponent(sort)}`, {
                headers: { 'x-requested-with': 'XMLHttpRequest' }
            });
            const data = await res.json();
            const tbody = document.getElementById('categoryTableBody');

            if (!data.categories.length) {
                tbody.innerHTML = `<tr><td colspan="6" class="px-8 py-12 text-center text-sm text-on-surface-variant">No categories found</td></tr>`;
                return;
            }

            tbody.innerHTML = data.categories.map(c => {
                const isInactive = c.status === false;
                const statusBadge = isInactive
                    ? `<span class="inline-flex items-center gap-1 px-2 py-0.5 rounded text-[10px] font-bold uppercase tracking-wide bg-error-container/20 text-error">
                           <span class="material-symbols-outlined text-[11px]">block</span>Inactive
                       </span>`
                    : `<span class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-bold uppercase tracking-wide bg-tertiary-container text-on-tertiary-container">Active</span>`;

                const safeId    = c._id;
                const safeName  = (c.categoryName || '').replace(/'/g, "\\'");
                const safeDesc  = (c.description  || '').replace(/'/g, "\\'");
                const safeImage = c.image || '';
                const safeHidden = c.isHidden ? 'true' : 'false';

                const actionBtns = isInactive
                    ? `<button class="p-2 text-outline/30 rounded-md cursor-not-allowed" disabled title="Cannot edit an inactive category">
                           <span class="material-symbols-outlined text-lg">edit</span>
                       </button>
                       <button class="p-2 text-outline/30 rounded-md cursor-not-allowed" disabled title="Category is already inactive">
                           <span class="material-symbols-outlined text-lg">delete</span>
                       </button>`
                    : `<button class="p-2 text-on-surface-variant hover:text-primary hover:bg-surface-container rounded-md transition-all" title="Edit"
                           onclick="openEditModal('${safeId}','${safeName}','${safeDesc}','${safeImage}','${safeHidden}')">
                           <span class="material-symbols-outlined text-lg">edit</span>
                       </button>
                       <button class="p-2 text-on-surface-variant hover:text-error hover:bg-surface-container rounded-md transition-all" title="Deactivate"
                           onclick="openDeleteModal('${safeId}','${safeName}')">
                           <span class="material-symbols-outlined text-lg">delete</span>
                       </button>`;

                const imageHtml = c.image
                    ? `<img src="${c.image}" alt="${c.categoryName}" class="w-full h-full object-cover" />`
                    : `<span class="material-symbols-outlined text-secondary">category</span>`;

                const visibilityCell = isInactive
                    ? `<span class="text-xs text-on-surface-variant/50">&#8212;</span>`
                    : `<span class="inline-flex items-center gap-1 px-2 py-0.5 rounded text-[10px] font-bold uppercase tracking-wide ${c.isHidden ? 'bg-outline/15 text-outline' : 'bg-secondary-container/60 text-on-secondary-container'}">
                           <span class="material-symbols-outlined text-[11px]">${c.isHidden ? 'visibility_off' : 'visibility'}</span>
                           ${c.isHidden ? 'Hidden' : 'Visible'}
                       </span>`;

                return `
                <tr class="hover:bg-surface-container-low/30 transition-colors group ${isInactive ? 'opacity-60' : ''}">
                    <td class="px-8 py-5">
                        <div class="flex items-center gap-4">
                            <div class="w-10 h-10 rounded bg-surface-container-high flex items-center justify-center overflow-hidden">
                                ${imageHtml}
                            </div>
                            <div>
                                <p class="font-headline font-bold text-on-surface text-sm">${c.categoryName}</p>
                                ${c.description ? `<p class="text-[10px] text-on-surface-variant">${c.description}</p>` : ''}
                            </div>
                        </div>
                    </td>
                    <td class="px-8 py-5">
                        ${c.slug
                            ? `<code class="text-xs bg-surface-container px-2 py-1 rounded text-secondary font-medium">${c.slug}</code>`
                            : `<span class="text-xs text-on-surface-variant">-</span>`}
                    </td>
                    <td class="px-8 py-5 font-headline font-semibold text-on-surface">
                        ${c.totalProducts != null ? c.totalProducts : '-'}
                    </td>
                    <td class="px-8 py-5">${visibilityCell}</td>
                    <td class="px-8 py-5">${statusBadge}</td>
                    <td class="px-8 py-5 text-right">
                        <div class="flex items-center justify-end gap-1">${actionBtns}</div>
                    </td>
                </tr>`;
            }).join('');
        } catch (err) {
            console.error('Fetch error:', err);
        }
    }
    </script>
</body>

</html>