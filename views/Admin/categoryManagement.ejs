                                <!-- Delete overlay button, shown on hover if image exists -->
                                <button type="button" id="deleteImageOverlayBtn" title="Delete Image"
                                    class="absolute inset-0 bg-black/60 flex items-center justify-center text-error opacity-0 group-hover:opacity-100 transition-opacity rounded hidden">
                                    <span class="material-symbols-outlined text-sm">delete</span>
                                </button>
                            </div>
                            <input type="file" id="editCategoryImageInput" name="image" accept="image/*"
                                class="bg-surface-container border border-outline-variant/20 rounded-lg px-4 py-2 text-xs text-on-surface focus:outline-none focus:ring-1 focus:ring-secondary transition-all file:mr-4 file:py-1 file:px-3 file:rounded-full file:border-0 file:text-xs file:font-semibold file:bg-secondary/15 file:text-secondary hover:file:bg-secondary/25 cursor-pointer flex-1 min-w-0" />
                        </div>
                        <p id="editImageError" class="text-error text-xs hidden mt-1"></p>
                    </div>

                    <!-- Visibility -->
                    <div class="flex flex-col gap-1.5">
                        <label
                            class="text-[11px] font-bold uppercase tracking-widest text-on-surface-variant">Visibility</label>
                        <div class="relative">
                            <select id="editCategoryVisibilityInput" name="isHidden"
                                class="w-full appearance-none bg-surface-container border border-outline-variant/20 rounded-lg px-4 py-2.5 text-sm text-on-surface focus:outline-none focus:ring-1 focus:ring-secondary transition-all pr-10 cursor-pointer">
                                <option value="false">Visible &mdash; shown to customers</option>
                                <option value="true">Hidden &mdash; not shown to customers</option>
                            </select>
                            <span
                                class="material-symbols-outlined text-outline absolute right-3 top-1/2 -translate-y-1/2 text-[16px] pointer-events-none">expand_more</span>
                        </div>
                    </div>

                    <!-- Actions -->
                    <div class="flex flex-col sm:flex-row items-stretch sm:items-center justify-end gap-3 pt-4 mt-auto">
                        <button type="button" onclick="closeEditModal()"
                            class="w-full sm:w-auto px-5 py-3 sm:py-2.5 rounded-md text-sm font-semibold text-on-surface-variant hover:bg-surface-container-low transition-all text-center">
                            Cancel
                        </button>
                        <button type="submit" id="editCategorySubmitBtn"
                            class="w-full sm:w-auto bg-gradient-to-br from-primary to-secondary text-on-primary px-5 py-3 sm:py-2.5 rounded-md text-sm font-semibold hover:-translate-y-0.5 shadow-sm transition-all text-center">
                            Save Changes
                        </button>
                    </div>
                </form>
            </div>
        </div>

        <!-- Delete Confirmation Modal -->
        <div id="deleteCategoryModal"
            class="fixed inset-0 z-50 flex items-center justify-center bg-black/30 backdrop-blur-sm hidden p-0 sm:p-4">
            <div
                class="bg-surface-container-lowest rounded-none sm:rounded-xl shadow-2xl w-full h-full sm:h-auto sm:max-w-sm overflow-hidden flex flex-col justify-between sm:justify-start">

                <!-- Modal Header -->
                <div class="flex items-center justify-between px-6 py-5 border-b border-outline-variant/10 shrink-0">
                    <div class="flex items-center gap-3">
                        <div class="w-9 h-9 rounded-lg bg-error-container/20 flex items-center justify-center">
                            <span class="material-symbols-outlined text-error text-lg">delete_forever</span>
                        </div>
                        <h2 class="text-lg font-bold font-manrope text-on-surface">Delete Category</h2>
                    </div>
                    <button onclick="closeDeleteModal()" class="text-outline hover:text-on-surface transition-colors">
                        <span class="material-symbols-outlined">close</span>
                    </button>
                </div>

                <!-- Body -->
                <div class="px-6 py-6 overflow-y-auto flex-1 sm:flex-initial">
                    <p class="text-sm text-on-surface-variant leading-relaxed">
                        You are about to deactivate
                        <span id="deleteCategoryName" class="font-bold text-on-surface"></span>.
                        It will be removed from the list and its status set to <span
                            class="text-error font-semibold">inactive</span>.
                    </p>

                    <!-- Inline error -->
                    <div id="deleteCategoryErrorContainer"
                        class="mt-4 px-4 py-3 bg-error-container/20 text-on-error-container text-sm rounded-lg hidden">
                        <span id="deleteCategoryErrorMessage"></span>
                    </div>

                    <!-- Actions -->
                    <div
                        class="flex flex-col sm:flex-row items-stretch sm:items-center justify-end gap-3 mt-6 pt-4 border-t border-outline-variant/10 sm:border-t-0 mt-auto">
                        <button type="button" onclick="closeDeleteModal()"
                            class="w-full sm:w-auto px-5 py-3 sm:py-2.5 rounded-md text-sm font-semibold text-on-surface-variant hover:bg-surface-container-low transition-all text-center">
                            Cancel
                        </button>
                        <button id="deleteCategoryConfirmBtn"
                            class="w-full sm:w-auto flex items-center justify-center gap-2 px-5 py-3 sm:py-2.5 rounded-md text-sm font-semibold bg-error text-on-error hover:-translate-y-0.5 shadow-sm transition-all text-center">
                            <span class="material-symbols-outlined text-sm">delete_forever</span>
                            Delete
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <script>
            const categoryModal = document.getElementById('createCategoryModal');
            const categoryForm = document.getElementById('createCategoryForm');
            const categoryErrorContainer = document.getElementById('categoryErrorContainer');
            const categoryErrorMessage = document.getElementById('categoryErrorMessage');

            // Helpers for Field-Level Validation
            function clearFieldError(inputEl, errorEl) {
                if (inputEl) {
                    inputEl.classList.remove('border-error', 'focus:ring-error');
                }
                if (errorEl) {
                    errorEl.textContent = '';
                    errorEl.classList.add('hidden');
                }
            }

            function showFieldError(inputEl, errorEl, msg) {
                if (inputEl) {
                    inputEl.classList.add('border-error', 'focus:ring-error');
                }
                if (errorEl) {
                    errorEl.textContent = msg;
                    errorEl.classList.remove('hidden');
                }
            }

            function validateCategoryName(name) {
                if (!name || name.trim() === '') {
                    return 'Category Name is required';
                }
                if (name.trim().length < 3) {
                    return 'Category Name must be at least 3 characters';
                }
                if (name.trim().length > 30) {
                    return 'Category Name cannot exceed 30 characters';
                }
                const nameRegex = /^[A-Za-z0-9\s]+$/;
                if (!nameRegex.test(name.trim())) {
                    return 'Category Name must contain only alphanumeric characters and spaces';
                }
                return null;
            }

            function validateDescription(desc) {
                return null;
            }

            function validateImageFile(file) {
                if (file) {
                    if (!file.type.startsWith('image/')) {
                        return 'Only image files are allowed';
                    }
                    if (file.size > 5 * 1024 * 1024) { // 5MB limit
                        return 'Image size must be less than 5MB';
                    }
                }
                return null;
            }

            // Live validation listeners for Create
            document.getElementById('categoryNameInput').addEventListener('input', function() {
                const err = validateCategoryName(this.value);
                if (err) showFieldError(this, document.getElementById('createNameError'), err);
                else clearFieldError(this, document.getElementById('createNameError'));
            });

            document.getElementById('categoryDescriptionInput').addEventListener('input', function() {
                const err = validateDescription(this.value);
                if (err) showFieldError(this, document.getElementById('createDescError'), err);
                else clearFieldError(this, document.getElementById('createDescError'));
            });

            document.getElementById('categoryImageInput').addEventListener('change', function() {
                const err = validateImageFile(this.files[0]);
                if (err) showFieldError(this, document.getElementById('createImageError'), err);
                else clearFieldError(this, document.getElementById('createImageError'));
            });

            function openCategoryModal(isNew = false) {
                if (isNew) {
                    categoryForm.reset();
                    categoryErrorContainer.classList.add('hidden');
                    categoryErrorMessage.textContent = '';
                    if (window.location.search.includes('createError')) {
                        window.history.replaceState({}, document.title, window.location.pathname);
                    }
                    const previewImg = document.getElementById('createImagePreview');
                    const placeholder = document.getElementById('createImagePlaceholder');
                    previewImg.src = '';
                    previewImg.classList.add('hidden');
                    placeholder.classList.remove('hidden');

                    // Clear field-level errors
                    clearFieldError(document.getElementById('categoryNameInput'), document.getElementById('createNameError'));
                    clearFieldError(document.getElementById('categoryDescriptionInput'), document.getElementById('createDescError'));
                    clearFieldError(document.getElementById('categoryImageInput'), document.getElementById('createImageError'));
                }
                categoryModal.classList.remove('hidden');
            }

            function closeCategoryModal() {
                categoryModal.classList.add('hidden');
                // reset file input & preview
                document.getElementById('categoryImageInput').value = '';
                const previewImg = document.getElementById('createImagePreview');
                const placeholder = document.getElementById('createImagePlaceholder');
                previewImg.src = '';
                previewImg.classList.add('hidden');
                placeholder.classList.remove('hidden');
            }

            // close on backdrop click
            categoryModal.addEventListener('click', (e) => {
                if (e.target === categoryModal) closeCategoryModal();
            });

            // Add Create File input change preview listener
            document.getElementById('categoryImageInput').addEventListener('change', function (e) {
                const previewImg = document.getElementById('createImagePreview');
                const placeholder = document.getElementById('createImagePlaceholder');
                const file = e.target.files[0];
                if (file) {
                    const reader = new FileReader();
                    reader.onload = function (e) {
                        previewImg.src = e.target.result;
                        previewImg.classList.remove('hidden');
                        placeholder.classList.add('hidden');
                    };
                    reader.readAsDataURL(file);
                } else {
                    previewImg.src = '';
                    previewImg.classList.add('hidden');
                    placeholder.classList.remove('hidden');
                }
            });

            // AJAX Create submission
            categoryForm.addEventListener('submit', async (e) => {
                e.preventDefault();

                // Clear general error
                categoryErrorContainer.classList.add('hidden');
                categoryErrorMessage.textContent = '';

                // Elements
                const nameEl = document.getElementById('categoryNameInput');
                const descEl = document.getElementById('categoryDescriptionInput');
                const imageEl = document.getElementById('categoryImageInput');
                const nameErrEl = document.getElementById('createNameError');
                const descErrEl = document.getElementById('createDescError');
                const imageErrEl = document.getElementById('createImageError');

                const name = nameEl.value;
                const desc = descEl.value;
                const image = imageEl.files[0];

                const nameErrText = validateCategoryName(name);
                const descErrText = validateDescription(desc);
                const imageErrText = validateImageFile(image);

                let hasError = false;
                if (nameErrText) {
                    showFieldError(nameEl, nameErrEl, nameErrText);
                    hasError = true;
                } else {
                    clearFieldError(nameEl, nameErrEl);
                }

                if (descErrText) {
                    showFieldError(descEl, descErrEl, descErrText);
                    hasError = true;
                } else {
                    clearFieldError(descEl, descErrEl);
                }

                if (imageErrText) {
                    showFieldError(imageEl, imageErrEl, imageErrText);
                    hasError = true;
                } else {
                    clearFieldError(imageEl, imageErrEl);
                }

                if (hasError) return;

                const submitBtn = categoryForm.querySelector('button[type="submit"]');
                submitBtn.disabled = true;
                submitBtn.textContent = 'Creating…';

                try {
                    const formData = new FormData(categoryForm);
                    const res = await fetch('/admin/category-management/create', {
                        method: 'POST',
                        body: formData
                    });
                    const data = await res.json();
                    if (res.ok && data.success) {
                        closeCategoryModal();
                        window.location.reload();
                    } else {
                        if (data.errors) {
                            // Show all errors from backend
                            if (data.errors.categoryName) {
                                showFieldError(nameEl, nameErrEl, data.errors.categoryName);
                            }
                            if (data.errors.description) {
                                showFieldError(descEl, descErrEl, data.errors.description);
                            }
                            if (data.errors.image) {
                                showFieldError(imageEl, imageErrEl, data.errors.image);
                            }
                            if (data.errors.general) {
                                categoryErrorMessage.textContent = data.errors.general;
                                categoryErrorContainer.classList.remove('hidden');
                            }
                        } else {
                            categoryErrorMessage.textContent = data.message || 'Failed to create category';
                            categoryErrorContainer.classList.remove('hidden');
                        }
                    }
                } catch (err) {
                    categoryErrorMessage.textContent = 'Network error. Please try again.';
                    categoryErrorContainer.classList.remove('hidden');
                } finally {
                    submitBtn.disabled = false;
                    submitBtn.textContent = 'Create Category';
                }
            });

        <% if (typeof createError !== 'undefined' && createError) { %>
                openCategoryModal(false);
        <% } %>

        // ── Edit Modal ────────────────────────────────────────────────
        const editModal = document.getElementById('editCategoryModal');
            const editForm = document.getElementById('editCategoryForm');
            const editErrorContainer = document.getElementById('editCategoryErrorContainer');
            const editErrorMessage = document.getElementById('editCategoryErrorMessage');
            const editIdInput = document.getElementById('editCategoryId');
            const editNameInput = document.getElementById('editCategoryNameInput');
            const editDescriptionInput = document.getElementById('editCategoryDescriptionInput');
            const editSubmitBtn = document.getElementById('editCategorySubmitBtn');

            // holds the values as they were when the modal opened
            let _originals = { name: '', description: '', isHidden: 'false' };

            // Live validation listeners for Edit
            document.getElementById('editCategoryNameInput').addEventListener('input', function() {
                const err = validateCategoryName(this.value);
                if (err) showFieldError(this, document.getElementById('editNameError'), err);
                else clearFieldError(this, document.getElementById('editNameError'));
            });

            document.getElementById('editCategoryDescriptionInput').addEventListener('input', function() {
                const err = validateDescription(this.value);
                if (err) showFieldError(this, document.getElementById('editDescError'), err);
                else clearFieldError(this, document.getElementById('editDescError'));
            });

            document.getElementById('editCategoryImageInput').addEventListener('change', function() {
                const err = validateImageFile(this.files[0]);
                if (err) showFieldError(this, document.getElementById('editImageError'), err);
                else clearFieldError(this, document.getElementById('editImageError'));
            });

            function openEditModal(id, name, description, imageUrl, isHidden) {
                // pre-fill
                editIdInput.value = id;
                editNameInput.value = name;
                editDescriptionInput.value = description;

                // Pre-fill visibility dropdown
                const visibilitySelect = document.getElementById('editCategoryVisibilityInput');
                visibilitySelect.value = (isHidden === 'true') ? 'true' : 'false';

                // Reset image file input
                const fileInput = document.getElementById('editCategoryImageInput');
                fileInput.value = '';

                // Handle preview
                const previewImg = document.getElementById('editImagePreview');
                const placeholder = document.getElementById('editImagePlaceholder');
                const deleteImageBtn = document.getElementById('deleteImageOverlayBtn');
                if (imageUrl && imageUrl.trim() !== '') {
                    previewImg.src = imageUrl;
                    previewImg.classList.remove('hidden');
                    placeholder.classList.add('hidden');
                    deleteImageBtn.classList.remove('hidden');
                } else {
                    previewImg.src = '';
                    previewImg.classList.add('hidden');
                    placeholder.classList.remove('hidden');
                    deleteImageBtn.classList.add('hidden');
                }

                // snapshot originals for change-detection
                _originals = { name: name.trim(), description: (description || '').trim(), isHidden: (isHidden === 'true') ? 'true' : 'false' };

                // reset error state
                editErrorContainer.classList.add('hidden');
                editErrorMessage.textContent = '';

                // Clear field-level errors
                clearFieldError(editNameInput, document.getElementById('editNameError'));
                clearFieldError(editDescriptionInput, document.getElementById('editDescError'));
                clearFieldError(fileInput, document.getElementById('editImageError'));

                editModal.classList.remove('hidden');
            }

            function closeEditModal() {
                editModal.classList.add('hidden');
            }

            // close on backdrop click
            editModal.addEventListener('click', (e) => {
                if (e.target === editModal) closeEditModal();
            });

            // Add file input change preview listener
            document.getElementById('editCategoryImageInput').addEventListener('change', function (e) {
                const previewImg = document.getElementById('editImagePreview');
                const placeholder = document.getElementById('editImagePlaceholder');
                const deleteImageBtn = document.getElementById('deleteImageOverlayBtn');
                const file = e.target.files[0];
                if (file) {
                    const reader = new FileReader();
                    reader.onload = function (e) {
                        previewImg.src = e.target.result;
                        previewImg.classList.remove('hidden');
                        placeholder.classList.add('hidden');
                        deleteImageBtn.classList.add('hidden'); // Hide delete button for unsaved local preview
                    };
                    reader.readAsDataURL(file);
                }
            });

            // Click handler for delete image overlay button
            document.getElementById('deleteImageOverlayBtn').addEventListener('click', async (e) => {
                e.stopPropagation();
                const confirmed = confirm("Are you sure you want to delete this category image?");
                if (!confirmed) return;

                const id = editIdInput.value;
                try {
                    const res = await fetch(`/admin/category-management/delete-image/${id}`, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' }
                    });
                    const data = await res.json();
                    if (res.ok && data.success) {
                        window.location.reload();
                    } else {
                        showEditError(data.message || 'Failed to delete category image');
                    }
                } catch (err) {
                    showEditError('Network error. Failed to delete image.');
                }
            });

            function showEditError(msg) {
                editErrorMessage.textContent = msg;
                editErrorContainer.classList.remove('hidden');
            }

            editForm.addEventListener('submit', async (e) => {
                e.preventDefault();

                // Clear general error
                editErrorContainer.classList.add('hidden');
                editErrorMessage.textContent = '';

                // Elements
                const nameEl = document.getElementById('editCategoryNameInput');
                const descEl = document.getElementById('editCategoryDescriptionInput');
                const imageEl = document.getElementById('editCategoryImageInput');
                const nameErrEl = document.getElementById('editNameError');
                const descErrEl = document.getElementById('editDescError');
                const imageErrEl = document.getElementById('editImageError');

                const name = nameEl.value;
                const desc = descEl.value;
                const image = imageEl.files[0];

                const nameErrText = validateCategoryName(name);
                const descErrText = validateDescription(desc);
                const imageErrText = validateImageFile(image);

                let hasError = false;
                if (nameErrText) {
                    showFieldError(nameEl, nameErrEl, nameErrText);
                    hasError = true;
                } else {
                    clearFieldError(nameEl, nameErrEl);
                }

                if (descErrText) {
                    showFieldError(descEl, descErrEl, descErrText);
                    hasError = true;
                } else {
                    clearFieldError(descEl, descErrEl);
                }

                if (imageErrText) {
                    showFieldError(imageEl, imageErrEl, imageErrText);
                    hasError = true;
                } else {
                    clearFieldError(imageEl, imageErrEl);
                }

                if (hasError) return;

                // ── No-change guard ───────────────────────────────────────
                const currentDesc = desc.trim();
                const currentVisibility = document.getElementById('editCategoryVisibilityInput').value;
                if (
                    name.trim() === _originals.name &&
                    currentDesc === _originals.description &&
                    currentVisibility === _originals.isHidden &&
                    !imageEl.files[0]
                ) {
                    showEditError('No changes made. Please modify at least one field before saving.');
                    return;
                }

                const id = editIdInput.value;
                editSubmitBtn.disabled = true;
                editSubmitBtn.textContent = 'Saving…';

                try {
                    const formData = new FormData();
                    formData.append('categoryName', name.trim());
                    formData.append('description', currentDesc);
                    formData.append('isHidden', currentVisibility);
                    if (imageEl.files[0]) {
                        formData.append('image', imageEl.files[0]);
                    }

                    const res = await fetch(`/admin/category-management/edit/${id}`, {
                        method: 'PATCH',
                        body: formData
                    });

                    const data = await res.json();

                    if (res.ok && data.success) {
                        closeEditModal();
                        window.location.reload();
                    } else {
                        if (data.errors) {
                            // Show all errors from backend
                            if (data.errors.categoryName) {
                                showFieldError(nameEl, nameErrEl, data.errors.categoryName);
                            }
                            if (data.errors.description) {
                                showFieldError(descEl, descErrEl, data.errors.description);
                            }
                            if (data.errors.image) {
                                showFieldError(imageEl, imageErrEl, data.errors.image);
                            }
                            if (data.errors.general) {
                                editErrorMessage.textContent = data.errors.general;
                                editErrorContainer.classList.remove('hidden');
                            }
                        } else {
                            showEditError(data.message || 'Failed to update category');
                        }
                    }
                } catch (err) {
                    showEditError('Network error. Please try again.');
                } finally {
                    editSubmitBtn.disabled = false;
                    editSubmitBtn.textContent = 'Save Changes';
                }
            });

            // ── Delete Modal ───────────────────────────────────────────────
            const deleteModal = document.getElementById('deleteCategoryModal');
            const deleteCatName = document.getElementById('deleteCategoryName');
            const deleteErrContainer = document.getElementById('deleteCategoryErrorContainer');
            const deleteErrMessage = document.getElementById('deleteCategoryErrorMessage');
            const deleteConfirmBtn = document.getElementById('deleteCategoryConfirmBtn');
            let _deleteTargetId = null;

            function openDeleteModal(id, name) {
                _deleteTargetId = id;
                deleteCatName.textContent = name;
                deleteErrContainer.classList.add('hidden');
                deleteErrMessage.textContent = '';
                deleteModal.classList.remove('hidden');
            }

            function closeDeleteModal() {
                deleteModal.classList.add('hidden');
                _deleteTargetId = null;
            }

            // close on backdrop click
            deleteModal.addEventListener('click', (e) => {
                if (e.target === deleteModal) closeDeleteModal();
            });

            deleteConfirmBtn.addEventListener('click', async () => {
                if (!_deleteTargetId) return;

                deleteConfirmBtn.disabled = true;
                deleteConfirmBtn.innerHTML = '<span class="material-symbols-outlined text-sm animate-spin">progress_activity</span> Deleting…';

                try {
                    const res = await fetch(`/admin/category-management/delete/${_deleteTargetId}`, {
                        method: 'PATCH',
                        headers: { 'Content-Type': 'application/json' }
                    });
                    const data = await res.json();

                    if (res.ok && data.success) {
                        closeDeleteModal();
                        window.location.reload();
                    } else {
                        deleteErrMessage.textContent = data.message || 'Failed to delete category.';
                        deleteErrContainer.classList.remove('hidden');
                    }
                } catch (err) {
                    deleteErrMessage.textContent = 'Network error. Please try again.';
                    deleteErrContainer.classList.remove('hidden');
                } finally {
                    deleteConfirmBtn.disabled = false;
                    deleteConfirmBtn.innerHTML = '<span class="material-symbols-outlined text-sm">delete_forever</span> Delete';
                }
            });

            let debounceTimer;
            let currentSort = '<%= locals.sort || "latest" %>';
            const searchInput = document.getElementById('searchInput');
            const clearBtn = document.getElementById('clearSearch');
            const sortBtn = document.getElementById('sortBtn');
            const sortDropdown = document.getElementById('sortDropdown');

            // ── Sort dropdown toggle
            sortBtn.addEventListener('click', (e) => {
                e.stopPropagation();
                sortDropdown.classList.toggle('hidden');
            });
            document.addEventListener('click', () => sortDropdown.classList.add('hidden'));

            // ── Sort option click
            sortDropdown.querySelectorAll('.sort-option').forEach(btn => {
                btn.addEventListener('click', () => {
                    currentSort = btn.dataset.sort;
                    // highlight active
                    sortDropdown.querySelectorAll('.sort-option').forEach(b => {
                        b.classList.remove('bg-secondary/10', 'text-secondary', 'font-bold');
                        b.classList.add('text-on-surface-variant', 'hover:bg-surface-container');
                    });
                    btn.classList.add('bg-secondary/10', 'text-secondary', 'font-bold');
                    btn.classList.remove('text-on-surface-variant', 'hover:bg-surface-container');
                    sortDropdown.classList.add('hidden');
                    fetchTable(searchInput.value.trim(), currentSort);
                });
            });

            // ── Search input
            searchInput.addEventListener('input', function () {
                clearTimeout(debounceTimer);
                clearBtn.classList.toggle('hidden', !this.value);
                clearBtn.classList.toggle('flex', !!this.value);
                debounceTimer = setTimeout(() => fetchTable(this.value.trim(), currentSort), 300);
            });

            clearBtn.addEventListener('click', function () {
                searchInput.value = '';
                clearBtn.classList.add('hidden');
                clearBtn.classList.remove('flex');
                fetchTable('', currentSort);
            });



            async function fetchTable(query, sort = 'latest') {
                try {
                    const res = await fetch(`/admin/category-management?search=${encodeURIComponent(query)}&sort=${encodeURIComponent(sort)}`, {
                        headers: { 'x-requested-with': 'XMLHttpRequest' }
                    });
                    const data = await res.json();
                    const tbody = document.getElementById('categoryTableBody');

                    if (!data.categories.length) {
                        tbody.innerHTML = `<tr><td colspan="6" class="px-8 py-12 text-center text-sm text-on-surface-variant">No categories found</td></tr>`;
                        return;
                    }

                    tbody.innerHTML = data.categories.map(c => {
                        const isInactive = c.status === false;
                        const statusBadge = isInactive
                            ? `<span class="inline-flex items-center gap-1 px-2 py-0.5 rounded text-[10px] font-bold uppercase tracking-wide bg-error-container/20 text-error">
                           <span class="material-symbols-outlined text-[11px]">block</span>Inactive
                       </span>`
                            : `<span class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-bold uppercase tracking-wide bg-tertiary-container text-on-tertiary-container">Active</span>`;

                        const safeId = c._id;
                        const safeName = (c.categoryName || '').replace(/'/g, "\\'");
                        const safeDesc = (c.description || '').replace(/'/g, "\\'");
                        const safeImage = c.image || '';
                        const safeHidden = c.isHidden ? 'true' : 'false';

                        const actionBtns = isInactive
                            ? `<button class="p-2 text-outline/30 rounded-md cursor-not-allowed" disabled title="Cannot edit an inactive category">
                           <span class="material-symbols-outlined text-lg">edit</span>
                       </button>
                       <button class="p-2 text-outline/30 rounded-md cursor-not-allowed" disabled title="Category is already inactive">
                           <span class="material-symbols-outlined text-lg">delete</span>
                       </button>`
                            : `<button class="p-2 text-on-surface-variant hover:text-primary hover:bg-surface-container rounded-md transition-all" title="Edit"
                           onclick="openEditModal('${safeId}','${safeName}','${safeDesc}','${safeImage}','${safeHidden}')">
                           <span class="material-symbols-outlined text-lg">edit</span>
                       </button>
                       <button class="p-2 text-on-surface-variant hover:text-error hover:bg-surface-container rounded-md transition-all" title="Deactivate"
                           onclick="openDeleteModal('${safeId}','${safeName}')">
                           <span class="material-symbols-outlined text-lg">delete</span>
                       </button>`;

                        const imageHtml = c.image
                            ? `<img src="${c.image}" alt="${c.categoryName}" class="w-full h-full object-cover" />`
                            : `<span class="material-symbols-outlined text-secondary">category</span>`;

                        const visibilityCell = isInactive
                            ? `<span class="text-xs text-on-surface-variant/50">&#8212;</span>`
                            : `<span class="inline-flex items-center gap-1 px-2 py-0.5 rounded text-[10px] font-bold uppercase tracking-wide ${c.isHidden ? 'bg-outline/15 text-outline' : 'bg-secondary-container/60 text-on-secondary-container'}">
                           <span class="material-symbols-outlined text-[11px]">${c.isHidden ? 'visibility_off' : 'visibility'}</span>
                           ${c.isHidden ? 'Hidden' : 'Visible'}
                       </span>`;

                        return `
                <tr class="hover:bg-surface-container-low/30 transition-colors group ${isInactive ? 'opacity-60' : ''}">
                    <td class="px-8 py-5">
                        <div class="flex items-center gap-4">
                            <div class="w-10 h-10 rounded bg-surface-container-high flex items-center justify-center overflow-hidden">
                                ${imageHtml}
                            </div>
                            <div>
                                <p class="font-headline font-bold text-on-surface text-sm">${c.categoryName}</p>
                                ${c.description ? `<p class="text-[10px] text-on-surface-variant">${c.description}</p>` : ''}
                            </div>
                        </div>
                    </td>
                    <td class="px-8 py-5">
                        ${c.slug
                                ? `<code class="text-xs bg-surface-container px-2 py-1 rounded text-secondary font-medium">${c.slug}</code>`
                                : `<span class="text-xs text-on-surface-variant">-</span>`}
                    </td>
                    <td class="px-8 py-5 font-headline font-semibold text-on-surface">
                        ${c.totalProducts != null ? c.totalProducts : '-'}
                    </td>
                    <td class="px-8 py-5">${visibilityCell}</td>
                    <td class="px-8 py-5">${statusBadge}</td>
                    <td class="px-8 py-5 text-right">
                        <div class="flex items-center justify-end gap-1">${actionBtns}</div>
                    </td>
                </tr>`;
                    }).join('');
                } catch (err) {
                    console.error('Fetch error:', err);
                }
            }
        </script>
</body>

</html>