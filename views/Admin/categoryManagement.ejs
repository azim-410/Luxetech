                            <div class="relative group shrink-0">
                                <div id="editImagePreviewContainer"
                                    class="w-12 h-12 rounded bg-surface-container flex items-center justify-center overflow-hidden border border-outline-variant/20">
                                    <span id="editImagePlaceholder"
                                        class="material-symbols-outlined text-outline">image</span>
                                    <img id="editImagePreview" class="w-full h-full object-cover hidden" />
