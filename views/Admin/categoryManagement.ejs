                            <span
                                class="material-symbols-outlined text-outline absolute right-3 top-1/2 -translate-y-1/2 text-[16px] pointer-events-none">expand_more</span>
                        </div>
                    </div>

                    <!-- Actions -->
                    <div class="flex flex-col sm:flex-row items-stretch sm:items-center justify-end gap-3 pt-4 mt-auto">
                        <button type="button" onclick="closeCategoryModal()"
                            class="w-full sm:w-auto px-5 py-3 sm:py-2.5 rounded-md text-sm font-semibold text-on-surface-variant hover:bg-surface-container-low transition-all text-center">
                            Cancel
                        </button>
                        <button type="submit"
                            class="w-full sm:w-auto bg-gradient-to-br from-primary to-secondary text-on-primary px-5 py-3 sm:py-2.5 rounded-md text-sm font-semibold hover:-translate-y-0.5 shadow-sm transition-all text-center">
