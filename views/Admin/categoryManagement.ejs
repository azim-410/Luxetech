<!DOCTYPE html>

<html class="light" lang="en">

<head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>Categories Overview | Luxe Tech Admin</title>
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link
        href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;600;700;800&amp;family=Inter:wght@400;500;600&amp;display=swap"
        rel="stylesheet" />
    <link
        href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap"
        rel="stylesheet" />
    <link
        href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap"
        rel="stylesheet" />
    <script id="tailwind-config">
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    colors: {
                        "primary": "#5d5e61",
                        "on-primary-fixed": "#3e3f42",
                        "primary-fixed": "#e2e2e5",
                        "on-primary-fixed-variant": "#5a5c5e",
                        "on-secondary-container": "#3a5568",
                        "inverse-surface": "#0c0f10",
                        "on-primary": "#f7f7fa",
                        "on-tertiary-container": "#485668",
                        "surface-container-low": "#f1f4f6",
                        "on-tertiary": "#f7f9ff",
                        "error-container": "#fe8983",
                        "surface-container-high": "#e3e9ec",
                        "surface-bright": "#f8f9fa",
                        "on-surface": "#2b3437",
                        "surface-container": "#eaeff1",
                        "tertiary-container": "#dbe9ff",
                        "on-primary-container": "#505254",
                        "inverse-on-surface": "#9b9d9e",
                        "error": "#9f403d",
                        "surface-container-highest": "#dbe4e7",
                        "on-surface-variant": "#586064",
                        "surface-dim": "#d1dce0",
                        "on-background": "#2b3437",
                        "surface": "#f8f9fa",
                        "secondary-dim": "#3b5669",
                        "tertiary": "#526072",
                        "tertiary-dim": "#465465",
                        "surface-container-lowest": "#ffffff",
                        "secondary-fixed-dim": "#bcd8ef",
                        "inverse-primary": "#f9f9fc",
                        "secondary-fixed": "#cae6fd",
                        "primary-fixed-dim": "#d4d4d7",
                        "secondary": "#476275",
                        "on-tertiary-fixed": "#364455",
                        "on-secondary-fixed-variant": "#445f72",
                        "on-error": "#fff7f6",
                        "outline-variant": "#abb3b7",
                        "outline": "#737c7f",
                        "on-error-container": "#752121",
                        "tertiary-fixed": "#dbe9ff",
                        "secondary-container": "#cae6fd",
                        "primary-dim": "#515255",
                        "error-dim": "#4e0309",
                        "primary-container": "#e2e2e5",
                        "on-tertiary-fixed-variant": "#526072",
                        "background": "#f8f9fa",
                        "surface-variant": "#dbe4e7",
                        "tertiary-fixed-dim": "#cddbf0",
                        "surface-tint": "#5d5e61",
                        "on-secondary-fixed": "#274254",
                        "on-secondary": "#f5f9ff"
                    },
                    fontFamily: {
                        "headline": ["Manrope"],
                        "body": ["Inter"],
                        "label": ["Inter"]
                    },
                    borderRadius: { "DEFAULT": "0.125rem", "lg": "0.25rem", "xl": "0.5rem", "full": "0.75rem" },
                },
            },
        }
    </script>
    <style>
        body {
            font-family: 'Inter', sans-serif;
        }

        h1,
        h2,
        h3 {
            font-family: 'Manrope', sans-serif;
        }

        .material-symbols-outlined {
            font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
        }
    </style>
</head>

<body class="bg-surface text-on-surface">
    <%- include('../partials/admin/layout', { activePage: 'categories' }) %>

        <!-- Main Content Canvas -->
        <main class="ml-64 pt-16 min-h-screen flex flex-col">
            <!-- Page Header Section -->
            <section class="px-12 py-10 flex justify-between items-end">
                <div>
                    <nav
                        class="flex items-center gap-2 text-[10px] uppercase tracking-[0.1em] text-outline mb-2 font-bold">
                        <span>Admin</span>
                        <span class="material-symbols-outlined text-[12px]">chevron_right</span>
                        <span class="text-secondary">Categories</span>
                    </nav>
                    <h2 class="text-4xl font-headline font-extrabold text-on-surface tracking-tight">Categories Overview
                    </h2>
                    <p class="text-on-surface-variant mt-1 font-body text-sm">Manage product taxonomy and collection
                        hierarchies.</p>
                </div>
                <button onclick="openCategoryModal(true)"
                    class="flex items-center gap-2 px-6 py-3 bg-gradient-to-br from-primary to-secondary text-on-primary rounded-md font-label font-semibold text-sm shadow-md hover:-translate-y-0.5 transition-all">
                    <span class="material-symbols-outlined text-sm" data-icon="add">add</span>
                    Add New Category
                </button>
            </section>
            <!-- Category Table Container -->
            <section class="px-12 pb-20 flex-1">
                <div class="bg-surface-container-lowest rounded-xl shadow-[0_2Admin Portal
LUXURY CURATOR0px_40px_rgba(43,52,55,0.06)] overflow-hidden">
                    <div class="px-8 py-6 flex items-center justify-between border-b border-outline-variant/15">
                        <div class="flex items-center gap-8">
                            <h3 class="font-headline font-bold text-on-surface">All Categories</h3>
                            <div class="flex items-center gap-2">
                                <span class="w-2 h-2 rounded-full bg-secondary"></span>
                                <span class="text-xs font-label text-on-surface-variant uppercase tracking-wider">
                                    <%= (locals.totalCategories || []).filter(c=> c.status === true).length %> Active
                                        Collections
                                </span>
                            </div>
                        </div>
                        <div class="flex items-center gap-3">
                            <button
                                class="flex items-center gap-2 px-3 py-1.5 text-xs font-medium text-on-surface-variant hover:bg-surface-container transition-colors rounded">
                                <span class="material-symbols-outlined text-sm">filter_list</span>
                                Filter
                            </button>
                            <button
                                class="flex items-center gap-2 px-3 py-1.5 text-xs font-medium text-on-surface-variant hover:bg-surface-container transition-colors rounded">
                                <span class="material-symbols-outlined text-sm">download</span>
                                Export
                            </button>
                        </div>
                    </div>
                    <div class="overflow-x-auto">
                        <table class="w-full text-left border-collapse">
                            <thead>
                                <tr class="bg-surface-container-low/50">
                                    <th
                                        class="px-8 py-4 text-[11px] font-label font-bold uppercase tracking-widest text-on-surface-variant">
                                        Category Name</th>
                                    <th
                                        class="px-8 py-4 text-[11px] font-label font-bold uppercase tracking-widest text-on-surface-variant">
                                        Slug</th>
                                    <th
                                        class="px-8 py-4 text-[11px] font-label font-bold uppercase tracking-widest text-on-surface-variant">
                                        Total Products</th>
                                    <th
                                        class="px-8 py-4 text-[11px] font-label font-bold uppercase tracking-widest text-on-surface-variant">
                                        Status</th>
                                    <th
                                        class="px-8 py-4 text-[11px] font-label font-bold uppercase tracking-widest text-on-surface-variant text-right">
                                        Actions</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-outline-variant/10">
                                <% if (locals.categories && locals.categories.length> 0) { %>
                                    <% locals.categories.forEach((category)=> { %>
                                        <tr class="hover:bg-surface-container-low/30 transition-colors group">
                                            <!-- Category Name -->
                                            <td class="px-8 py-5">
                                                <div class="flex items-center gap-4">
                                                    <div
                                                        class="w-10 h-10 rounded bg-surface-container-high flex items-center justify-center overflow-hidden">
                                                        <% if (category.image) { %>
                                                            <img src="<%= category.image %>"
                                                                alt="<%= category.categoryName %>"
                                                                class="w-full h-full object-cover" />
                                                            <% } else { %>
                                                                <span
                                                                    class="material-symbols-outlined text-secondary">category</span>
                                                                <% } %>
                                                    </div>
                                                    <div>
                                                        <p class="font-headline font-bold text-on-surface text-sm">
                                                            <%= category.categoryName %>
                                                        </p>
                                                        <% if (category.description) { %>
                                                            <p class="text-[10px] text-on-surface-variant">
                                                                <%= category.description %>
                                                            </p>
                                                            <% } %>
                                                    </div>
                                                </div>
                                            </td>
                                            <!-- Slug -->
                                            <td class="px-8 py-5">
                                                <% if (category.slug) { %>
                                                    <code
                                                        class="text-xs bg-surface-container px-2 py-1 rounded text-secondary font-medium"><%= category.slug %></code>
                                                    <% } else { %>
                                                        <span class="text-xs text-on-surface-variant">-</span>
                                                        <% } %>
                                            </td>
                                            <!-- Total Products -->
                                            <td class="px-8 py-5 font-headline font-semibold text-on-surface">
                                                <%= (typeof category.totalProducts !=='undefined' &&
                                                    category.totalProducts !==null) ? category.totalProducts : '-' %>
                                            </td>
                                            <!-- Status -->
                                            <td class="px-8 py-5">
                                                <% if (category.status===true) { %>
                                                    <span
                                                        class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-bold uppercase tracking-wide bg-tertiary-container text-on-tertiary-container">Active</span>
                                                    <% } else { %>
                                                        <span
                                                            class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-bold uppercase tracking-wide bg-surface-container-highest text-on-surface-variant">Draft</span>
                                                        <% } %>
                                            </td>
                                            <!-- Actions -->
                                            <td class="px-8 py-5 text-right">
                                                <div class="flex items-center justify-end gap-1">
                                                    <button
                                                        class="p-2 text-on-surface-variant hover:text-primary hover:bg-surface-container rounded-md transition-all"
                                                        title="Edit">
                                                        <span class="material-symbols-outlined text-lg">edit</span>
                                                    </button>
                                                    <button
                                                        class="p-2 text-on-surface-variant hover:text-error hover:bg-surface-container rounded-md transition-all"
                                                        title="Delete">
                                                        <span class="material-symbols-outlined text-lg">delete</span>
                                                    </button>
                                                </div>
                                            </td>
                                        </tr>
                                        <% }); %>
                                            <% } else { %>
                                                <tr>
                                                    <td colspan="5"
                                                        class="px-8 py-12 text-center text-sm text-on-surface-variant">
                                                        No categories found
                                                    </td>
                                                </tr>
                                                <% } %>
                            </tbody>
                        </table>
                    </div>
                    <!-- Pagination -->
                    <div class="px-8 py-6 border-t border-outline-variant/15 flex items-center justify-between">
                        <p class="text-xs font-label text-on-surface-variant uppercase tracking-tighter">
                            Showing <%= locals.categories?.length ?? 0 %> of <%= locals.totalCategories?.length ?? 0 %>
                                    categories
                        </p>
                        <div class="flex items-center gap-2">
                            <% if (locals.currentPage > 1) { %>
                                <a href="/admin/category-management?page=<%= locals.currentPage - 1 %>"
                                    class="flex items-center gap-1 px-4 py-2 border border-outline-variant/15 text-xs font-bold uppercase tracking-widest text-on-surface rounded-md hover:bg-surface-container transition-colors">
                                    <span class="material-symbols-outlined text-sm">chevron_left</span>
                                    Previous
                                </a>
                            <% } else { %>
                                <span
                                    class="flex items-center gap-1 px-4 py-2 border border-outline-variant/15 text-xs font-bold uppercase tracking-widest text-on-surface rounded-md opacity-50 cursor-not-allowed">
                                    <span class="material-symbols-outlined text-sm">chevron_left</span>
                                    Previous
                                </span>
                            <% } %>

                            <% for (let i = 1; i <= (locals.totalPage || 1); i++) { %>
                                <% if (i === (locals.currentPage || 1)) { %>
                                    <span
                                        class="w-8 h-8 rounded border border-outline-variant/15 flex items-center justify-center bg-secondary text-on-secondary font-bold text-xs">
                                        <%= i %>
                                    </span>
                                <% } else { %>
                                    <a href="/admin/category-management?page=<%= i %>"
                                        class="w-8 h-8 rounded border border-outline-variant/15 flex items-center justify-center text-xs text-on-surface-variant hover:bg-surface-container-low transition-colors">
                                        <%= i %>
                                    </a>
                                <% } %>
                            <% } %>

                            <% if (locals.currentPage < (locals.totalPage || 1)) { %>
                                <a href="/admin/category-management?page=<%= locals.currentPage + 1 %>"
                                    class="flex items-center gap-1 px-4 py-2 border border-outline-variant/15 text-xs font-bold uppercase tracking-widest text-on-surface rounded-md hover:bg-surface-container transition-colors">
                                    Next
                                    <span class="material-symbols-outlined text-sm">chevron_right</span>
                                </a>
                            <% } else { %>
                                <span
                                    class="flex items-center gap-1 px-4 py-2 border border-outline-variant/15 text-xs font-bold uppercase tracking-widest text-on-surface rounded-md opacity-50 cursor-not-allowed">
                                    Next
                                    <span class="material-symbols-outlined text-sm">chevron_right</span>
                                </span>
                            <% } %>
                        </div>
                    </div>
                </div>
            </section>
        </main>

    <!-- Create Category Modal -->
    <div id="createCategoryModal"
        class="fixed inset-0 z-50 flex items-center justify-center bg-black/30 backdrop-blur-sm hidden">
        <div class="bg-surface-container-lowest rounded-xl shadow-2xl w-full max-w-md mx-4 overflow-hidden">

            <!-- Modal Header -->
            <div class="flex items-center justify-between px-6 py-5 border-b border-outline-variant/10">
                <h2 class="text-lg font-bold font-manrope text-on-surface">New Category</h2>
                <button onclick="closeCategoryModal()" class="text-outline hover:text-on-surface transition-colors">
                    <span class="material-symbols-outlined">close</span>
                </button>
            </div>

            <!-- Error Message Container -->
            <div id="categoryErrorContainer" class="mx-6 mt-4 px-4 py-3 bg-error-container/20 text-on-error-container text-sm rounded-lg <%= (typeof createError !== 'undefined' && createError) ? '' : 'hidden' %>">
                <span id="categoryErrorMessage"><%= (typeof createError !== 'undefined' && createError) ? createError : '' %></span>
            </div>

            <!-- Modal Form -->
            <form id="createCategoryForm" action="/admin/category-management/create" method="POST" class="px-6 py-6 flex flex-col gap-4">

                <div class="flex flex-col gap-1.5">
                    <label class="text-[11px] font-bold uppercase tracking-widest text-on-surface-variant">Category Name</label>
                    <input type="text" id="categoryNameInput" name="categoryName" placeholder="e.g. Smartphones" required
                        class="bg-surface-container border border-outline-variant/20 rounded-lg px-4 py-2.5 text-sm text-on-surface focus:outline-none focus:ring-1 focus:ring-secondary transition-all" />
                </div>

                <div class="flex flex-col gap-1.5">
                    <label class="text-[11px] font-bold uppercase tracking-widest text-on-surface-variant">Description</label>
                    <textarea id="categoryDescriptionInput" name="description" placeholder="Provide category details..." rows="3"
                        class="bg-surface-container border border-outline-variant/20 rounded-lg px-4 py-2.5 text-sm text-on-surface focus:outline-none focus:ring-1 focus:ring-secondary transition-all resize-none"></textarea>
                </div>

                <div class="flex flex-col gap-1.5">
                    <label class="text-[11px] font-bold uppercase tracking-widest text-on-surface-variant">Status</label>
                    <select id="categoryStatusInput" name="status"
                        class="bg-surface-container border border-outline-variant/20 rounded-lg px-4 py-2.5 text-sm text-on-surface focus:outline-none focus:ring-1 focus:ring-secondary transition-all">
                        <option value="true">Active</option>
                        <option value="false">Draft</option>
                    </select>
                </div>

                <!-- Actions -->
                <div class="flex items-center justify-end gap-3 pt-2">
                    <button type="button" onclick="closeCategoryModal()"
                        class="px-5 py-2.5 rounded-md text-sm font-semibold text-on-surface-variant hover:bg-surface-container-low transition-all">
                        Cancel
                    </button>
                    <button type="submit"
                        class="bg-gradient-to-br from-primary to-secondary text-on-primary px-5 py-2.5 rounded-md text-sm font-semibold hover:-translate-y-0.5 shadow-sm transition-all">
                        Create Category
                    </button>
                </div>

            </form>
        </div>
    </div>

    <script>
        const categoryModal = document.getElementById('createCategoryModal');
        const categoryForm = document.getElementById('createCategoryForm');
        const categoryErrorContainer = document.getElementById('categoryErrorContainer');
        const categoryErrorMessage = document.getElementById('categoryErrorMessage');

        function openCategoryModal(isNew = false) {
            if (isNew) {
                categoryForm.reset();
                categoryErrorContainer.classList.add('hidden');
                categoryErrorMessage.textContent = '';
                if (window.location.search.includes('createError')) {
                    window.history.replaceState({}, document.title, window.location.pathname);
                }
            }
            categoryModal.classList.remove('hidden');
        }

        function closeCategoryModal() {
            categoryModal.classList.add('hidden');
        }

        // close on backdrop click
        categoryModal.addEventListener('click', (e) => {
            if (e.target === categoryModal) closeCategoryModal();
        });

        // client-side validation
        categoryForm.addEventListener('submit', (e) => {
            const name = document.getElementById('categoryNameInput').value.trim();

            if (name.length < 3) {
                e.preventDefault();
                showCategoryError('Category Name must be at least 3 characters long');
                return;
            }

            // Only letters, numbers and spaces allowed
            const nameRegex = /^[A-Za-z0-9\s]+$/;
            if (!nameRegex.test(name)) {
                e.preventDefault();
                showCategoryError('Category Name must contain only alphanumeric characters and spaces');
                return;
            }
        });

        function showCategoryError(msg) {
            categoryErrorMessage.textContent = msg;
            categoryErrorContainer.classList.remove('hidden');
        }

        <% if (typeof createError !== 'undefined' && createError) { %>
            openCategoryModal(false);
        <% } %>
    </script>
</body>

</html>