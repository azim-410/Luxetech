<!DOCTYPE html>

<html class="light" lang="en">

<head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>Categories Overview | Luxe Tech Admin</title>
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link
        href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;600;700;800&amp;family=Inter:wght@400;500;600&amp;display=swap"
        rel="stylesheet" />
    <link
        href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap"
        rel="stylesheet" />
    <link
        href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap"
        rel="stylesheet" />
    <script id="tailwind-config">
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    colors: {
                        "primary": "#5d5e61",
                        "on-primary-fixed": "#3e3f42",
                        "primary-fixed": "#e2e2e5",
                        "on-primary-fixed-variant": "#5a5c5e",
                        "on-secondary-container": "#3a5568",
                        "inverse-surface": "#0c0f10",
                        "on-primary": "#f7f7fa",
                        "on-tertiary-container": "#485668",
                        "surface-container-low": "#f1f4f6",
                        "on-tertiary": "#f7f9ff",
                        "error-container": "#fe8983",
                        "surface-container-high": "#e3e9ec",
                        "surface-bright": "#f8f9fa",
                        "on-surface": "#2b3437",
                        "surface-container": "#eaeff1",
                        "tertiary-container": "#dbe9ff",
                        "on-primary-container": "#505254",
                        "inverse-on-surface": "#9b9d9e",
                        "error": "#9f403d",
                        "surface-container-highest": "#dbe4e7",
                        "on-surface-variant": "#586064",
                        "surface-dim": "#d1dce0",
                        "on-background": "#2b3437",
                        "surface": "#f8f9fa",
                        "secondary-dim": "#3b5669",
                        "tertiary": "#526072",
                        "tertiary-dim": "#465465",
                        "surface-container-lowest": "#ffffff",
                        "secondary-fixed-dim": "#bcd8ef",
                        "inverse-primary": "#f9f9fc",
                        "secondary-fixed": "#cae6fd",
                        "primary-fixed-dim": "#d4d4d7",
                        "secondary": "#476275",
                        "on-tertiary-fixed": "#364455",
                        "on-secondary-fixed-variant": "#445f72",
                        "on-error": "#fff7f6",
                        "outline-variant": "#abb3b7",
                        "outline": "#737c7f",
                        "on-error-container": "#752121",
                        "tertiary-fixed": "#dbe9ff",
                        "secondary-container": "#cae6fd",
                        "primary-dim": "#515255",
                        "error-dim": "#4e0309",
                        "primary-container": "#e2e2e5",
                        "on-tertiary-fixed-variant": "#526072",
                        "background": "#f8f9fa",
                        "surface-variant": "#dbe4e7",
                        "tertiary-fixed-dim": "#cddbf0",
                        "surface-tint": "#5d5e61",
                        "on-secondary-fixed": "#274254",
                        "on-secondary": "#f5f9ff"
                    },
                    fontFamily: {
                        "headline": ["Manrope"],
                        "body": ["Inter"],
                        "label": ["Inter"]
                    },
                    borderRadius: { "DEFAULT": "0.125rem", "lg": "0.25rem", "xl": "0.5rem", "full": "0.75rem" },
                },
            },
        }
    </script>
    <style>
        body {
            font-family: 'Inter', sans-serif;
        }

        h1,
        h2,
        h3 {
            font-family: 'Manrope', sans-serif;
        }

        .material-symbols-outlined {
            font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
        }

        .border-error {
            border-color: rgb(239, 68, 68) !important;
        }

        .focus\:ring-error:focus {
            --tw-ring-color: rgb(239, 68, 68) !important;
            border-color: rgb(239, 68, 68) !important;
        }
    </style>
</head>

<body class="bg-surface text-on-surface">
    <%- include('../partials/admin/layout', { activePage: 'categories' }) %>

        <!-- Main Content Canvas -->
        <main class="ml-0 md:ml-64 pt-16 min-h-screen flex flex-col">
            <!-- Page Header Section -->
            <section
                class="px-4 sm:px-12 py-6 sm:py-10 flex flex-col sm:flex-row justify-between items-start sm:items-end gap-6">
                <div>
                    <nav
                        class="flex items-center gap-2 text-[10px] uppercase tracking-[0.1em] text-outline mb-2 font-bold">
                        <span>Admin</span>
                        <span class="material-symbols-outlined text-[12px]">chevron_right</span>
                        <span class="text-secondary">Categories</span>
                    </nav>
                    <h2 class="text-3xl sm:text-4xl font-headline font-extrabold text-on-surface tracking-tight">
                        Categories Overview
                    </h2>
                    <p class="text-on-surface-variant mt-1 font-body text-sm">Manage product taxonomy and collection
                        hierarchies.</p>
                </div>
                <button onclick="openCategoryModal(true)"
                    class="w-full sm:w-auto flex items-center justify-center gap-2 px-6 py-3 bg-gradient-to-br from-primary to-secondary text-on-primary rounded-md font-label font-semibold text-sm shadow-md hover:-translate-y-0.5 transition-all">
                    <span class="material-symbols-outlined text-sm" data-icon="add">add</span>
                    Add New Category
                </button>
            </section>
            <!-- Category Table Container -->
            <section class="px-4 sm:px-12 pb-12 sm:pb-20 flex-1">
                <div
                    class="bg-surface-container-lowest rounded-xl shadow-[0_2px_40px_rgba(43,52,55,0.06)] overflow-hidden">
                    <div
                        class="px-4 sm:px-8 py-4 sm:py-6 flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-outline-variant/15">
                        <div class="flex items-center justify-between sm:justify-start gap-4 sm:gap-8 w-full sm:w-auto">
                            <h3 class="font-headline font-bold text-on-surface">All Categories</h3>
                            <div class="flex items-center gap-2">
                                <span class="w-2 h-2 rounded-full bg-secondary"></span>
                                <span class="text-xs font-label text-on-surface-variant uppercase tracking-wider">
                                    <%= locals.totalActive || 0 %> Active Collections
                                </span>
                            </div>
                        </div>
                        <div class="flex flex-wrap items-stretch sm:items-center gap-3 w-full sm:w-auto">
                            <!-- Static search bar -->
                            <div
                                class="flex items-center gap-2 px-3 py-2 bg-surface-container border border-outline-variant/20 rounded-full w-full sm:w-56 group">
                                <span class="material-symbols-outlined text-[16px] text-outline shrink-0">search</span>
                                <input id="searchInput" type="text" placeholder="Search categories…"
                                    class="bg-transparent border-0 text-xs text-on-surface placeholder:text-outline/50 outline-none focus:outline-none focus:ring-0 focus:border-0 w-full" />
                                <button id="clearSearch" type="button"
                                    class="hidden shrink-0 w-4 h-4 items-center justify-center rounded-full bg-outline/20 hover:bg-outline/40 text-outline transition-colors"
                                    title="Clear search">
                                    <span class="material-symbols-outlined text-[11px] leading-none">close</span>
                                </button>
                            </div>
                            <!-- Filter / Sort dropdown -->
                            <div class="relative flex-1 sm:flex-none" id="sortDropdownWrapper">
                                <button id="sortBtn"
                                    class="w-full sm:w-auto flex items-center justify-center gap-2 px-3 py-2 sm:py-1.5 text-xs font-medium text-on-surface-variant bg-surface-container border border-outline-variant/20 hover:bg-surface-container-high transition-colors rounded-lg">
                                    <span class="material-symbols-outlined text-sm">filter_list</span>
                                    Filter
                                </button>
                                <div id="sortDropdown"
                                    class="hidden absolute right-0 mt-1 w-full sm:w-44 bg-surface-container-lowest border border-outline-variant/15 rounded-lg shadow-lg overflow-hidden z-20">
                                    <p
                                        class="px-4 pt-3 pb-1 text-[10px] font-bold uppercase tracking-widest text-outline">
                                        Sort by</p>
                                    <% const sortOptions=[['latest','Latest First'],['oldest','Oldest First'],['a-z','Name A → Z'],['z-a','Name Z → A']]; %>
                                        <% sortOptions.forEach(([val, label])=> { %>
                                            <button
                                                class="sort-option w-full text-left px-4 py-2.5 text-xs font-medium transition-colors
                                                   <%= (locals.sort || 'latest') === val ? 'bg-secondary/10 text-secondary font-bold' : 'text-on-surface-variant hover:bg-surface-container' %>"
                                                data-sort="<%= val %>">
                                                <%= label %>
                                            </button>
                                            <% }); %>
                                                <div class="h-2"></div>
                                </div>
                            </div>
                            <button
                                class="flex-1 sm:flex-none flex items-center justify-center gap-2 px-3 py-2 sm:py-1.5 text-xs font-medium text-on-surface-variant bg-surface-container border border-outline-variant/20 hover:bg-surface-container-high transition-colors rounded-lg">
                                <span class="material-symbols-outlined text-sm">download</span>
                                Export
                            </button>
                        </div>
                    </div>
                    <div class="overflow-x-auto">
                        <table class="w-full text-left border-collapse block md:table">
                            <thead class="hidden md:table-header-group">
                                <tr class="bg-surface-container-low/50">
                                    <th
                                        class="px-8 py-4 text-[11px] font-label font-bold uppercase tracking-widest text-on-surface-variant">
                                        Category Name</th>
                                    <th
                                        class="px-8 py-4 text-[11px] font-label font-bold uppercase tracking-widest text-on-surface-variant">
                                        Slug</th>
                                    <th
                                        class="px-8 py-4 text-[11px] font-label font-bold uppercase tracking-widest text-on-surface-variant">
                                        Total Products</th>
                                    <th
                                        class="px-8 py-4 text-[11px] font-label font-bold uppercase tracking-widest text-on-surface-variant">
                                        Visibility</th>
                                    <th
                                        class="px-8 py-4 text-[11px] font-label font-bold uppercase tracking-widest text-on-surface-variant">
                                        Status</th>
                                    <th
                                        class="px-8 py-4 text-[11px] font-label font-bold uppercase tracking-widest text-on-surface-variant text-right">
                                        Actions</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-outline-variant/10 block md:table-row-group"
                                id="categoryTableBody">
                                <% if (locals.categories && locals.categories.length> 0) { %>
                                    <% locals.categories.forEach((category)=> { %>
                                        <tr
                                            class="hover:bg-surface-container-low/30 transition-colors group block md:table-row border-b border-outline-variant/10 md:border-b-0 py-3 md:py-0 <%= category.status === false ? 'opacity-60' : '' %>">
                                            <!-- Category Name -->
                                            <td class="px-4 md:px-8 py-4 md:py-5 block md:table-cell">
                                                <div class="flex items-center gap-4">
                                                    <div
                                                        class="w-10 h-10 rounded bg-surface-container-high flex items-center justify-center overflow-hidden">
                                                        <% if (category.image) { %>
                                                            <img src="<%= category.image %>"
                                                                alt="<%= category.categoryName %>"
                                                                class="w-full h-full object-cover" />
                                                            <% } else { %>
                                                                <span
                                                                    class="material-symbols-outlined text-secondary">category</span>
                                                                <% } %>
                                                    </div>
                                                    <div>
                                                        <p class="font-headline font-bold text-on-surface text-sm">
                                                            <%= category.categoryName %>
                                                        </p>
                                                        <% if (category.description) { %>
                                                            <p class="text-[10px] text-on-surface-variant">
                                                                <%= category.description %>
                                                            </p>
                                                            <% } %>
                                                    </div>
                                                </div>
                                            </td>
                                            <!-- Slug -->
                                            <td
                                                class="px-4 md:px-8 py-3 md:py-5 flex md:table-cell justify-between md:justify-start items-center">
                                                <span
                                                    class="inline-block md:hidden text-[10px] font-bold uppercase tracking-wider text-outline">Slug</span>
                                                <% if (category.slug) { %>
                                                    <code
                                                        class="text-xs bg-surface-container px-2 py-1 rounded text-secondary font-medium"><%= category.slug %></code>
                                                    <% } else { %>
                                                        <span class="text-xs text-on-surface-variant">-</span>
                                                        <% } %>
                                            </td>
                                            <!-- Total Products -->
                                            <td
                                                class="px-4 md:px-8 py-3 md:py-5 flex md:table-cell justify-between md:justify-start items-center font-headline font-semibold text-on-surface">
                                                <span
                                                    class="inline-block md:hidden text-[10px] font-bold uppercase tracking-wider text-outline">Total
                                                    Products</span>
                                                <span>
                                                    <%= (typeof category.totalProducts !=='undefined' &&
                                                        category.totalProducts !==null) ? category.totalProducts : '-'
                                                        %>
                                                </span>
                                            </td>
                                            <!-- Visibility -->
                                            <td
                                                class="px-4 md:px-8 py-3 md:py-5 flex md:table-cell justify-between md:justify-start items-center">
                                                <span
                                                    class="inline-block md:hidden text-[10px] font-bold uppercase tracking-wider text-outline">Visibility</span>
                                                <% if (category.status===false) { %>
                                                    <span class="text-xs text-on-surface-variant/50">—</span>
                                                    <% } else { %>
                                                        <span
                                                            class="inline-flex items-center gap-1 px-2 py-0.5 rounded text-[10px] font-bold uppercase tracking-wide
                                                               <%= category.isHidden ? 'bg-outline/15 text-outline' : 'bg-secondary-container/60 text-on-secondary-container' %>">
                                                            <span class="material-symbols-outlined text-[11px]">
                                                                <%= category.isHidden ? 'visibility_off' : 'visibility'
                                                                    %>
                                                            </span>
                                                            <%= category.isHidden ? 'Hidden' : 'Visible' %>
                                                        </span>
                                                        <% } %>
                                            </td>
                                            <!-- Status -->
                                            <td
                                                class="px-4 md:px-8 py-3 md:py-5 flex md:table-cell justify-between md:justify-start items-center">
                                                <span
                                                    class="inline-block md:hidden text-[10px] font-bold uppercase tracking-wider text-outline">Status</span>
                                                <% if (category.status===true) { %>
                                                    <span
                                                        class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-bold uppercase tracking-wide bg-tertiary-container text-on-tertiary-container">Active</span>
                                                    <% } else { %>
                                                        <span
                                                            class="inline-flex items-center gap-1 px-2 py-0.5 rounded text-[10px] font-bold uppercase tracking-wide bg-error-container/20 text-error">
                                                            <span
                                                                class="material-symbols-outlined text-[11px]">block</span>
                                                            Inactive
                                                        </span>
                                                        <% } %>
                                            </td>
                                            <!-- Actions -->
                                            <td
                                                class="px-4 md:px-8 py-3 md:py-5 flex md:table-cell justify-between md:justify-start items-center text-right md:text-right">
                                                <span
                                                    class="inline-block md:hidden text-[10px] font-bold uppercase tracking-wider text-outline">Actions</span>
                                                <div class="flex items-center justify-end gap-1">
                                                    <% if (category.status===false) { %>
                                                        <!-- Edit disabled -->
                                                        <button
                                                            class="p-2 text-outline/30 rounded-md cursor-not-allowed min-w-[44px] min-h-[44px] flex items-center justify-center"
                                                            title="Cannot edit an inactive category" disabled>
                                                            <span class="material-symbols-outlined text-lg">edit</span>
                                                        </button>
                                                        <!-- Delete disabled -->
                                                        <button
                                                            class="p-2 text-outline/30 rounded-md cursor-not-allowed min-w-[44px] min-h-[44px] flex items-center justify-center"
                                                            title="Category is already inactive" disabled>
                                                            <span
                                                                class="material-symbols-outlined text-lg">delete</span>
                                                        </button>
                                                        <% } else { %>
                                                            <button
                                                                class="p-2 text-on-surface-variant hover:text-primary hover:bg-surface-container rounded-md transition-all min-w-[44px] min-h-[44px] flex items-center justify-center"
                                                                title="Edit"
                                                                onclick="openEditModal('<%= category._id %>', '<%= category.categoryName.replace(/'/g, '\\\'') %>', '<%= (category.description || '').replace(/'/g, '\\\'') %>', '<%= category.image || '' %>', '<%= category.isHidden ? 'true' : 'false' %>')">
                                                                            <span
                                                                                class="material-symbols-outlined text-lg">edit</span>
                                                            </button>
                                                            <button
                                                                class="p-2 text-on-surface-variant hover:text-error hover:bg-surface-container rounded-md transition-all min-w-[44px] min-h-[44px] flex items-center justify-center"
                                                                title="Deactivate"
                                                                onclick="openDeleteModal('<%= category._id %>', '<%= category.categoryName.replace(/'/g, '\\\'') %>')">
                                                                  
                                                                <span
                                                                    class="material-symbols-outlined text-lg">delete</span>
                                                            </button>
                                                            <% } %>
                                                </div>
                                            </td>
                                        </tr>
                                        <% }); %>
                                            <% } else { %>
                                                <tr class="block md:table-row">
                                                    <td colspan="6"
                                                        class="px-8 py-12 text-center text-sm text-on-surface-variant block md:table-cell">
                                                        No categories found
                                                    </td>
                                                </tr>
                                                <% } %>
                            </tbody>
                        </table>
                    </div>
                    <!-- Pagination -->
                    <div
                        class="px-4 sm:px-8 py-4 sm:py-6 border-t border-outline-variant/15 flex flex-col sm:flex-row items-center justify-between gap-4">
                        <p
                            class="text-[10px] sm:text-xs font-label text-on-surface-variant uppercase tracking-tighter text-center sm:text-left">
                            Showing <%= locals.categories?.length ?? 0 %> of <%= locals.totalCategories ?? 0 %>
                                    categories
                        </p>
                        <div class="flex flex-wrap items-center justify-center gap-2">
                            <% if (locals.currentPage> 1) { %>
                                <a href="/admin/category-management?page=<%= locals.currentPage - 1 %>"
                                    class="flex items-center gap-1 px-4 py-2 border border-outline-variant/15 text-xs font-bold uppercase tracking-widest text-on-surface rounded-md hover:bg-surface-container transition-colors">
                                    <span class="material-symbols-outlined text-sm">chevron_left</span>
                                    Previous
                                </a>
                                <% } else { %>
                                    <span
                                        class="flex items-center gap-1 px-4 py-2 border border-outline-variant/15 text-xs font-bold uppercase tracking-widest text-on-surface rounded-md opacity-50 cursor-not-allowed">
                                        <span class="material-symbols-outlined text-sm">chevron_left</span>
                                        Previous
                                    </span>
                                    <% } %>

                                        <% for (let i=1; i <=(locals.totalPage || 1); i++) { %>
                                            <% if (i===(locals.currentPage || 1)) { %>
                                                <span
                                                    class="w-8 h-8 rounded border border-outline-variant/15 flex items-center justify-center bg-secondary text-on-secondary font-bold text-xs">
                                                    <%= i %>
                                                </span>
                                                <% } else { %>
                                                    <a href="/admin/category-management?page=<%= i %>"
                                                        class="w-8 h-8 rounded border border-outline-variant/15 flex items-center justify-center text-xs text-on-surface-variant hover:bg-surface-container-low transition-colors">
                                                        <%= i %>
                                                    </a>
                                                    <% } %>
                                                        <% } %>

                                                            <% if (locals.currentPage < (locals.totalPage || 1)) { %>
                                                                <a href="/admin/category-management?page=<%= locals.currentPage + 1 %>"
                                                                    class="flex items-center gap-1 px-4 py-2 border border-outline-variant/15 text-xs font-bold uppercase tracking-widest text-on-surface rounded-md hover:bg-surface-container transition-colors">
                                                                    Next
                                                                    <span
                                                                        class="material-symbols-outlined text-sm">chevron_right</span>
                                                                </a>
                                                                <% } else { %>
                                                                    <span
                                                                        class="flex items-center gap-1 px-4 py-2 border border-outline-variant/15 text-xs font-bold uppercase tracking-widest text-on-surface rounded-md opacity-50 cursor-not-allowed">
                                                                        Next
                                                                        <span
                                                                            class="material-symbols-outlined text-sm">chevron_right</span>
                                                                    </span>
                                                                    <% } %>
                        </div>
                    </div>
                </div>
            </section>
        </main>

        <!-- Create Category Modal -->
        <div id="createCategoryModal"
            class="fixed inset-0 z-50 flex items-center justify-center bg-black/30 backdrop-blur-sm hidden p-0 sm:p-4">
            <div
                class="bg-surface-container-lowest rounded-none sm:rounded-xl shadow-2xl w-full h-full sm:h-auto sm:max-w-md overflow-hidden flex flex-col justify-between sm:justify-start">

                <!-- Modal Header -->
                <div class="flex items-center justify-between px-6 py-5 border-b border-outline-variant/10 shrink-0">
                    <h2 class="text-lg font-bold font-manrope text-on-surface">New Category</h2>
                    <button onclick="closeCategoryModal()" class="text-outline hover:text-on-surface transition-colors">
                        <span class="material-symbols-outlined">close</span>
                    </button>
                </div>

                <!-- Error Message Container -->
                <div id="categoryErrorContainer"
                    class="mx-6 mt-4 px-4 py-3 bg-error-container/20 text-on-error-container text-sm rounded-lg <%= (typeof createError !== 'undefined' && createError) ? '' : 'hidden' %>">
                    <span id="categoryErrorMessage">
                        <%= (typeof createError !=='undefined' && createError) ? createError : '' %>
                    </span>
                </div>

                <!-- Modal Form -->
                <form id="createCategoryForm" action="/admin/category-management/create" method="POST"
                    enctype="multipart/form-data"
                    class="px-6 py-6 flex flex-col gap-4 overflow-y-auto flex-1 sm:flex-initial">

                    <div class="flex flex-col gap-1.5">
                        <label class="text-[11px] font-bold uppercase tracking-widest text-on-surface-variant">Category Name</label>
                        <input type="text" id="categoryNameInput" name="categoryName" placeholder="e.g. Smartphones"
                            class="bg-surface-container border border-outline-variant/20 rounded-lg px-4 py-2.5 text-sm text-on-surface focus:outline-none focus:ring-1 focus:ring-secondary transition-all" />
                        <p id="createNameError" class="text-error text-xs hidden mt-1"></p>
                    </div>

                    <div class="flex flex-col gap-1.5">
                        <label
                            class="text-[11px] font-bold uppercase tracking-widest text-on-surface-variant">Description</label>
                        <textarea id="categoryDescriptionInput" name="description"
                            placeholder="Provide category details..." rows="3"
                            class="bg-surface-container border border-outline-variant/20 rounded-lg px-4 py-2.5 text-sm text-on-surface focus:outline-none focus:ring-1 focus:ring-secondary transition-all resize-none"></textarea>
                        <p id="createDescError" class="text-error text-xs hidden mt-1"></p>
                    </div>

                    <div class="flex flex-col gap-1.5">
                        <label class="text-[11px] font-bold uppercase tracking-widest text-on-surface-variant">Category
                            Image</label>
                        <div class="flex items-center gap-3">
                            <div id="createImagePreviewContainer"
                                class="w-12 h-12 rounded bg-surface-container flex items-center justify-center overflow-hidden border border-outline-variant/20 shrink-0">
                                <span id="createImagePlaceholder"
                                    class="material-symbols-outlined text-outline">image</span>
                                <img id="createImagePreview" class="w-full h-full object-cover hidden" />
                            </div>
                            <input type="file" id="categoryImageInput" name="image" accept="image/*"
                                class="bg-surface-container border border-outline-variant/20 rounded-lg px-4 py-2 text-xs text-on-surface focus:outline-none focus:ring-1 focus:ring-secondary transition-all file:mr-4 file:py-1 file:px-3 file:rounded-full file:border-0 file:text-xs file:font-semibold file:bg-secondary/15 file:text-secondary hover:file:bg-secondary/25 cursor-pointer flex-1 min-w-0" />
                        </div>
                        <p id="createImageError" class="text-error text-xs hidden mt-1"></p>
                    </div>

                    <!-- status is always active on create -->
                    <input type="hidden" name="status" value="true" />

                    <!-- Visibility -->
                    <div class="flex flex-col gap-1.5">
                        <label
                            class="text-[11px] font-bold uppercase tracking-widest text-on-surface-variant">Visibility</label>
                        <div class="relative">
