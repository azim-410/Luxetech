<!DOCTYPE html>

<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>Edit Product | Luxe Obsidian</title>
    <!-- Tailwind CSS CDN with plugins -->
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <!-- Cropper.js CDN -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.5.13/cropper.min.css" />
    <script src="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.5.13/cropper.min.js"></script>
    <style>
        /* Custom styles to make Cropper.js handles larger and easy to grab */
        .cropper-point {
            width: 12px !important;
            height: 12px !important;
            background-color: #1A1C1E !important; /* matches luxe-obsidian */
            border: 2px solid #ffffff !important;
            border-radius: 50% !important;
            opacity: 1 !important;
        }
        /* Make edge lines thicker */
        .cropper-line {
            background-color: #1A1C1E !important;
            height: 2px !important;
        }
        .cropper-view-box {
            outline: 2px solid #1A1C1E !important;
            outline-color: #1A1C1E !important;
        }
    </style>
    <!-- Google Fonts: Manrope & Material Symbols -->
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700&amp;display=swap"
        rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap"
        rel="stylesheet" />
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Manrope', 'sans-serif'],
                    },
                    colors: {
                        'luxe-obsidian': '#1A1C1E',
                        'luxe-slate': '#F8FAFC',
                        'luxe-border': '#E2E8F0',
                        'luxe-accent': '#334155',
                        'luxe-muted': '#64748B'
                    },
                    borderRadius: {
                        'luxe': '12px',
                    }
                }
            }
        }
    </script>
    <style data-purpose="layout-styles">
        body {
            background-color: #F1F5F9;
            color: #1A1C1E;
        }

        .custom-scrollbar::-webkit-scrollbar {
            width: 4px;
        }

        .custom-scrollbar::-webkit-scrollbar-track {
            background: transparent;
        }

        .custom-scrollbar::-webkit-scrollbar-thumb {
            background: #CBD5E1;
            border-radius: 2px;
        }

        /* Minimalist input styling */
        input,
        select,
        textarea {
            background-color: #F8FAFC !important;
            border: 1px solid #E2E8F0 !important;
            border-radius: 8px !important;
            font-size: 0.875rem !important;
        }

        input:focus,
        select:focus,
        textarea:focus {
            outline: none !important;
            border-color: #1A1C1E !important;
            box-shadow: none !important;
        }
    </style>
</head>

<body class="font-sans antialiased bg-[#F1F5F9]">
    <%- include('../partials/admin/layout', { activePage: 'products' }) %>

    <!-- Main Content Canvas -->
    <main class="ml-0 md:ml-64 pt-16 min-h-screen flex flex-col">
        <!-- Inner page container matching Luxe Tech styling -->
        <div class="max-w-7xl mx-auto w-full px-4 sm:px-12 py-6 sm:py-8 flex-1">
            <!-- Breadcrumbs / Top Back bar -->
            <div class="flex items-center gap-4 mb-6">
                <a href="/admin/product-management"
                    class="w-8 h-8 rounded-full bg-white hover:bg-luxe-border flex items-center justify-center text-luxe-obsidian border border-luxe-border transition-colors"
                    title="Back to Products">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 19l-7-7 7-7"></path>
                    </svg>
                </a>
                <h1 class="text-lg font-bold text-luxe-obsidian">Edit Product</h1>
            </div>
            <!-- Error Banner Container (for both server-side and client-side validations) -->
            <div id="errorBannerContainer" class="max-w-7xl mx-auto px-6 mb-4 <%= locals.errorMessage ? '' : 'hidden' %>">
                <div class="bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-luxe text-sm font-medium" id="errorBannerText">
                    <%= locals.errorMessage || '' %>
                </div>
            </div>
            <form id="editProductForm" action="/admin/product-management/edit/<%= locals.product ? locals.product._id : '' %>" method="POST" enctype="multipart/form-data">
                <!-- Hidden inputs for custom arrays -->
                <input type="hidden" name="variantData" id="variantData" />
                <input type="hidden" name="removedImages" id="removedImagesInput" value="" />

                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-12 gap-8">
                    <!-- Left Column: Primary Product Data -->
                    <div class="col-span-1 md:col-span-1 lg:col-span-8 space-y-6">
                        <!-- Section: Product Information -->
                        <section class="bg-white p-8 rounded-luxe border border-luxe-border shadow-sm"
                            data-purpose="product-information">
                            <h3 class="text-sm font-bold uppercase tracking-wider mb-6 text-luxe-obsidian">Product
                                Information</h3>
                            <div class="space-y-6">
                                <div>
                                    <label
                                        class="block text-[10px] font-bold text-luxe-muted uppercase mb-1 tracking-tight">Product
                                        Name</label>
                                    <input class="w-full px-3 py-2" placeholder='e.g. UltraWide Curved Gaming Monitor 34"'
                                        type="text" name="productName" value="<%= locals.product ? locals.product.name : '' %>" />
                                    <p id="error-productName" class="text-xs text-red-600 mt-1 hidden"></p>
                                </div>
                                <div>
                                    <label
                                        class="block text-[10px] font-bold text-luxe-muted uppercase mb-1 tracking-tight">categories</label>
                                    <select class="w-full px-3 py-2" name="category">
                                        <option value="">Select a Category</option>
                                        <% if(locals.categories) { %>
                                            <% categories.forEach(category=>{ %>
                                                <% if(category.status){ %>
                                                    <option value="<%= category._id %>" <%= (locals.product && String(locals.product.category._id || locals.product.category) === String(category._id)) ? 'selected' : '' %>>
                                                        <%= category.categoryName%>
                                                    </option>
                                                <% } %>
                                            <% }) %>
                                        <% } else { %>
                                            <option>fetching data not working or something went wrong</option>
                                        <% }%>
                                    </select>
                                    <p id="error-category" class="text-xs text-red-600 mt-1 hidden"></p>
                                </div>
                                <div>
                                    <label class="block text-[10px] font-bold text-luxe-muted uppercase mb-1.5 tracking-tight">Technical Summary</label>
                                    <div id="summaryContainer" class="space-y-3">
                                        <% if (locals.product && locals.product.summary && locals.product.summary.length > 0) { %>
                                            <% locals.product.summary.forEach((item, i) => { %>
                                                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mt-3">
                                                    <input class="w-full px-3 py-2" type="text" placeholder="e.g. Panel Type" 
                                                        name="summaryKey[]" value="<%= item.key %>" />
                                                    <div class="flex items-center gap-2">
                                                        <input class="w-full px-3 py-2" type="text" placeholder="e.g. OLED" 
                                                            name="summaryValue[]" value="<%= item.value %>" />
                                                        <% if (i > 0) { %>
                                                            <button type="button" class="removeRow text-black-400 hover:text-black-600 text-lg font-bold">✕</button>
                                                        <% } %>
                                                    </div>
                                                </div>
                                            <% }) %>
                                        <% } else { %>
                                            <!-- default initial row -->
                                            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                                                <input class="w-full px-3 py-2" placeholder="Response Time" type="text"
                                                    name="summaryKey[]" />
                                                <input class="w-full px-3 py-2 font-semibold" type="text" placeholder="0.03ms (GtG)"
                                                    name="summaryValue[]" />
                                            </div>
                                        <% } %>
                                    </div>
                                    <button type="button" id="addSummaryBtn"
                                        class="flex items-center gap-2 text-[10px] font-bold uppercase border border-luxe-border px-4 py-2 rounded-luxe hover:bg-luxe-slate transition-colors mt-3">
                                        <svg class="w-3 h-3" fill="none" stroke="currentColor" viewbox="0 0 24 24">
                                            <path d="M12 4v16m8-8H4" stroke-linecap="round" stroke-linejoin="round"
                                                stroke-width="2"></path>
                                        </svg>
                                        Add Summary
                                    </button>
                                </div>
                                <div>
                                    <label
                                        class="block text-[10px] font-bold text-luxe-muted uppercase mb-1 tracking-tight">Description</label>
                                    <textarea class="w-full px-3 py-2"
                                        placeholder="Highlight the key features and luxury specs..." rows="4" name="description"><%= locals.product ? locals.product.description : '' %></textarea>
                                    <p id="error-description" class="text-xs text-red-600 mt-1 hidden"></p>
                                </div>
                                <div class="pt-4 border-t border-luxe-border">
                                    <div class="flex justify-between items-center mb-4">
                                    </div>
                                </div>
                            </div>
                        </section>
 
                        <!-- Section: Variants & Stock -->
                        <section class="bg-white p-8 rounded-luxe border border-luxe-border shadow-sm"
                            data-purpose="variants-stock">
 
                            <!-- Header row -->
                            <div class="flex justify-between items-center mb-8">
                                <h3 class="text-[22px] font-bold tracking-tight text-luxe-obsidian"
                                    style="font-family:'Manrope',sans-serif;">Variants &amp; Stock</h3>
                                <button id="addVariantsBtn" type="button"
                                    class="flex items-center gap-2.5 text-[11px] font-bold uppercase bg-[#F1F5F9] hover:bg-luxe-border px-5 py-2.5 rounded-full transition-colors text-luxe-obsidian tracking-widest"
                                    style="font-family:'Manrope',sans-serif; letter-spacing:0.08em;">
                                    <span
                                        class="w-4 h-4 rounded-full bg-luxe-obsidian inline-flex items-center justify-center flex-shrink-0"></span>
                                    Add Variants
                                </button>
                            </div>
                            <div id="variantsContainer" class="space-y-9"></div>
                            <p id="error-variants" class="text-xs text-red-600 mt-4 hidden"></p>
                        </section>
                    </div>
 
                    <!-- Right Column: Pricing & Organization -->
                    <aside class="col-span-1 md:col-span-1 lg:col-span-4 space-y-6">
                        <!-- Section: Pricing -->
                        <section class="bg-white p-6 rounded-luxe border border-luxe-border shadow-sm"
                            data-purpose="pricing">
                            <h3 class="text-[10px] font-bold uppercase tracking-widest mb-6 text-luxe-obsidian">Pricing</h3>
                            <div class="space-y-4">
                                <div>
                                    <label class="block text-[9px] font-bold text-luxe-muted uppercase mb-1">Base
                                        Price</label>
                                    <div class="relative">
                                        <span
                                            class="absolute left-3 top-1/2 -translate-y-1/2 text-xs text-luxe-muted">₹</span>
                                        <input class="w-full pl-7 py-2 font-medium" type="text" placeholder="0.00" name="basePrice" value="<%= locals.product ? locals.product.basePrice : '' %>" />
                                    </div>
                                    <p id="error-basePrice" class="text-xs text-red-600 mt-1 hidden"></p>
                                </div>
                                <div>
                                    <label class="block text-[9px] font-bold text-luxe-muted uppercase mb-1">Discounted
                                        Price</label>
                                    <div class="relative">
                                        <span
                                            class="absolute left-3 top-1/2 -translate-y-1/2 text-xs text-luxe-muted">₹</span>
                                        <input class="w-full pl-7 py-2 font-medium" type="text" placeholder="0.00" name="discountedPrice" value="<%= locals.product ? locals.product.discountedPrice : '' %>" />
                                    </div>
                                    <p id="error-discountedPrice" class="text-xs text-red-600 mt-1 hidden"></p>
                                </div>
                            </div>
                        </section>
                        <!-- Section: Organization -->
                        <section class="bg-white p-6 rounded-luxe border border-luxe-border shadow-sm"
                            data-purpose="organization">
                            <h3 class="text-[10px] font-bold uppercase tracking-widest mb-6 text-luxe-obsidian">Organization
                            </h3>
                            <div class="space-y-4">
                                <div>
                                    <label class="block text-[9px] font-bold text-luxe-muted uppercase mb-1">Status</label>
                                    <select class="w-full px-3 py-2 font-medium" name="status">
                                        <option value="InStock" <%= (locals.product && (locals.product.status === 'InStock' || locals.product.status === true)) ? 'selected' : '' %>>InStock</option>
                                        <option value="Out of Stock" <%= (locals.product && (locals.product.status === 'Out of Stock' || locals.product.status === false)) ? 'selected' : '' %>>Out of Stock</option>
                                    </select>
                                </div>
                                <div>
                                    <label class="block text-[9px] font-bold text-luxe-muted uppercase mb-1">Visibility</label>
                                    <select class="w-full px-3 py-2 font-medium" name="isHidden">
                                        <option value="false" <%= (locals.product && locals.product.isHidden === false) ? 'selected' : '' %>>Visible</option>
                                        <option value="true" <%= (locals.product && locals.product.isHidden === true) ? 'selected' : '' %>>Hidden</option>
                                    </select>
                                </div>
                            </div>
                        </section>
                        <!-- Action Buttons -->
                        <div class="space-y-2">
                            <button type="submit"
                                class="w-full bg-luxe-accent hover:bg-luxe-obsidian text-white font-bold py-3 text-xs uppercase tracking-widest rounded-luxe transition-all shadow-lg shadow-slate-200">
                                Update Product
                            </button>
                            <a href="/admin/product-management" class="block w-full">
                                <button type="button"
                                    class="w-full bg-white hover:bg-luxe-slate text-luxe-obsidian border border-luxe-border font-bold py-3 text-xs uppercase tracking-widest rounded-luxe transition-all">
                                    Cancel
                                </button>
                            </a>
                        </div>
                        <!-- Security Notice -->
                        <div class="bg-luxe-slate p-4 rounded-luxe border border-luxe-border flex gap-3">
                            <div class="text-luxe-accent mt-0.5">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewbox="0 0 24 24">
                                    <path
                                        d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"
                                        stroke-linecap="round" stroke-linejoin="round" stroke-width="2"></path>
                                </svg>
                            </div>
                            <div class="space-y-1">
                                <p class="text-[10px] font-bold uppercase tracking-tight text-luxe-obsidian">Secure Portal
                                </p>
                                <p class="text-[9px] leading-relaxed text-luxe-muted">Changes made here are logged and
                                    synchronized across global warehouses in real-time.</p>
                            </div>
                        </div>
                    </aside>
                </div>
            </form>
        </div>
    </main>
   
    <!-- Modal Overlay -->
    <div id="modalOverlay" class="fixed inset-0 bg-black/50 backdrop-blur-sm z-50 hidden transition-opacity duration-300"></div>

    <!-- Variant Modal -->
    <div id="variantModal" class="fixed inset-0 z-50 flex items-center justify-center hidden p-0 sm:p-4">
        <div class="bg-white rounded-none sm:rounded-luxe border border-luxe-border w-full h-full sm:h-auto sm:max-w-md p-6 shadow-2xl flex flex-col justify-between sm:justify-start">
            <div class="flex justify-between items-center mb-5">
                <h3 id="modalTitle" class="text-xs font-bold text-luxe-obsidian uppercase tracking-wider" style="font-family:'Manrope',sans-serif;">Add Variant Group</h3>
                <button id="closeModal" type="button" class="text-luxe-muted hover:text-luxe-obsidian transition-colors">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                    </svg>
                </button>
            </div>
            <div class="space-y-4 mb-6">
                <div>
                    <label class="block text-[10px] font-bold text-luxe-muted uppercase mb-1.5 tracking-wider" style="font-family:'Manrope',sans-serif;">Group Name</label>
                    <input id="groupName" type="text" class="w-full px-3 py-2 bg-luxe-slate border border-luxe-border rounded-lg text-sm text-luxe-obsidian focus:border-luxe-obsidian focus:ring-0" placeholder="e.g. Color" />
                </div>
                <div>
                    <label class="block text-[10px] font-bold text-luxe-muted uppercase mb-1.5 tracking-wider" style="font-family:'Manrope',sans-serif;">Options (Comma Separated)</label>
                    <input id="groupOptions" type="text" class="w-full px-3 py-2 bg-luxe-slate border border-luxe-border rounded-lg text-sm text-luxe-obsidian focus:border-luxe-obsidian focus:ring-0" placeholder="e.g. Black, White, Silver" />
                </div>
            </div>
            <div class="flex gap-3 justify-end">
                <button id="cancelModalBtn" type="button" class="px-4 py-2 border border-luxe-border text-luxe-obsidian hover:bg-luxe-slate rounded-lg text-xs font-bold uppercase tracking-wider transition-colors" style="font-family:'Manrope',sans-serif;">
                    Cancel
                </button>
                <button id="addVariantGroup" type="button" class="px-4 py-2 bg-luxe-accent hover:bg-luxe-obsidian text-white rounded-lg text-xs font-bold uppercase tracking-wider transition-colors" style="font-family:'Manrope',sans-serif;">
                    Add Group
                </button>
            </div>
        </div>
    </div>

    <!-- Crop Modal Overlay -->
    <div id="cropModalOverlay" class="fixed inset-0 bg-black/50 backdrop-blur-sm z-[60] hidden transition-opacity duration-300"></div>

    <!-- Crop Modal -->
    <div id="cropModal" class="fixed inset-0 z-[70] flex items-center justify-center hidden p-0 sm:p-4">
        <div class="bg-white rounded-none sm:rounded-luxe border border-luxe-border w-full h-full sm:h-auto sm:max-w-lg p-6 shadow-2xl flex flex-col justify-between sm:justify-start">
            <div class="flex justify-between items-center mb-4">
                <h3 class="text-xs font-bold text-luxe-obsidian uppercase tracking-wider" style="font-family:'Manrope',sans-serif;">Crop Image</h3>
                <button id="closeCropModal" type="button" class="text-luxe-muted hover:text-luxe-obsidian transition-colors">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                    </svg>
                </button>
            </div>
            
            <!-- Cropping Area -->
            <div class="overflow-hidden bg-slate-100 rounded-lg max-h-[400px] flex items-center justify-center mb-6">
                <img id="cropImage" class="max-w-full max-h-[350px]" src="" alt="To Crop" />
            </div>
            
            <div class="flex gap-3 justify-end">
                <button id="cancelCropBtn" type="button" class="px-4 py-2 border border-luxe-border text-luxe-obsidian hover:bg-luxe-slate rounded-lg text-xs font-bold uppercase tracking-wider transition-colors" style="font-family:'Manrope',sans-serif;">
                    Cancel
                </button>
                <button id="cropAndAddBtn" type="button" class="px-4 py-2 bg-luxe-accent hover:bg-luxe-obsidian text-white rounded-lg text-xs font-bold uppercase tracking-wider transition-colors" style="font-family:'Manrope',sans-serif;">
                    Crop &amp; Add
                </button>
            </div>
        </div>
    </div>

    <script>
        const product = <% if (locals.product) { %> <%- JSON.stringify(product).replace(/</g, '\\u003c') %> <% } else { %> null <% } %>;
        const preloadedVariants = <% if (locals.variants) { %> <%- JSON.stringify(variants).replace(/</g, '\\u003c') %> <% } else { %> [] <% } %>;

        const addSummaryBtn = document.getElementById('addSummaryBtn');
        const summaryContainer = document.getElementById('summaryContainer');

        // Event delegation for dynamically and statically rendered summary row removals
        summaryContainer.addEventListener('click', (e) => {
            if (e.target.classList.contains('removeRow')) {
                e.target.closest('.grid').remove();
            }
        });

        addSummaryBtn.addEventListener('click', () => {
            const row = document.createElement('div');
            row.classList.add('grid', 'grid-cols-1', 'sm:grid-cols-2', 'gap-4', 'mt-3');
            row.innerHTML = `
            <input 
                class="w-full px-3 py-2" 
                type="text" 
                placeholder="e.g. Panel Type" 
                name="summaryKey[]" 
            />
            <div class="flex items-center gap-2">
                <input 
                    class="w-full px-3 py-2" 
                    type="text" 
                    placeholder="e.g. OLED" 
                    name="summaryValue[]" 
                />
                <button type="button" class="removeRow text-black-400 hover:text-black-600 text-lg font-bold">✕</button>
            </div>
        `;
            summaryContainer.appendChild(row);

            row.querySelector('.removeRow').addEventListener('click', () => {
                row.remove();
            });
        });

        const addVariantsBtn = document.getElementById('addVariantsBtn');
        const variantsContainer = document.getElementById('variantsContainer');
        const variantModal = document.getElementById('variantModal');
        const modalOverlay = document.getElementById('modalOverlay');

        let editingGroupElement = null;

        // Image Management for Variants
        const existingVariantImages = {}; // key: `${groupName}_${option}`, value: Array of Cloudinary URLs
        const newVariantImages = {};      // key: `${groupName}_${option}`, value: Array of File objects
        const removedImages = [];         // Array of removed Cloudinary URLs

        let cropQueue = [];       // array of { file, groupName, option }
        let cropperInstance = null;

        // Pre-populate existing images cache from preloadedVariants
        preloadedVariants.forEach(variant => {
            const key = `${variant.groupName}_${variant.option}`;
            existingVariantImages[key] = variant.images || [];
            newVariantImages[key] = [];
        });

        function createOrUpdateGroup(groupName, options, elementToUpdate = null) {
            // Ensure variantImages arrays are initialized for each option
            options.forEach(option => {
                const key = `${groupName}_${option}`;
                if (!existingVariantImages[key]) {
                    existingVariantImages[key] = [];
                }
                if (!newVariantImages[key]) {
                    newVariantImages[key] = [];
                }
            });

            const escapedGroupName = groupName.replace(/'/g, "\\'");

            const innerHTML = `
                <div class="flex justify-between items-center mb-4">
                    <h4 class="text-[10px] font-bold uppercase text-[#64748B] tracking-[0.14em]" style="font-family:'Manrope',sans-serif;">
                        ${groupName} &amp; Stock Inventory
                    </h4>
                    <div class="flex gap-4">
                        <button type="button" class="edit-group-btn text-[10px] text-blue-500 hover:text-blue-700 font-bold uppercase tracking-wider flex items-center gap-1">
                            ✎ Edit Group
                        </button>
                        <button type="button" class="text-[10px] text-red-500 hover:text-red-700 font-bold uppercase tracking-wider flex items-center gap-1"
                            onclick="this.closest('.variant-group').remove()">
                            &minus; Remove Group
                        </button>
                    </div>
                </div>
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    ${options.map(option => {
                        const escapedOption = option.replace(/'/g, "\\'");
                        const idSuffix = `${groupName.replace(/[^a-zA-Z0-9]/g, '_')}_${option.replace(/[^a-zA-Z0-9]/g, '_')}`;
                        
                        const existingVariant = preloadedVariants.find(v => v.groupName === groupName && v.option === option);
                        const varId = existingVariant ? existingVariant._id : '';
                        const varUnits = existingVariant ? (existingVariant.stock !== undefined ? existingVariant.stock : existingVariant.units) : '0';
                        const varPrice = existingVariant ? (existingVariant.priceAdd !== undefined ? existingVariant.priceAdd : existingVariant.price) : '0';
                        const varSku = existingVariant ? (existingVariant.sku || '') : '';

                        return `
                            <div class="variant-card border border-[#DDE3EC] rounded-[12px] p-5" 
                                 style="background:#E8EDF5;"
                                 data-variant-id="${varId}"
                                 data-group-name="${groupName}"
                                 data-option="${option}">
                                <p class="text-[10px] font-bold uppercase text-[#1A1C1E] tracking-[0.06em] mb-4" style="font-family:'Manrope',sans-serif;">
                                    ${option}
                                </p>
                                <div class="flex items-center gap-0 mb-2.5">
                                    <input type="number" value="${varUnits}"
                                        name="variant_${groupName}_${option}_units"
                                        class="flex-1 h-[40px] rounded-[8px] border border-[#DDE3EC] bg-white px-3 text-[14px] font-medium"
                                        style="min-width:0;" />
                                    <span class="w-14 text-right text-[13px] text-[#94A3B8] font-medium pl-2.5" style="font-family:'Manrope',sans-serif;">Units</span>
                                </div>
                                <p id="error-variant_${groupName}_${option}_units" class="text-xs text-red-600 -mt-1 mb-2 hidden"></p>

                                <div class="flex items-center gap-0 mb-2.5">
                                    <input type="number" value="${varPrice}"
                                        name="variant_${groupName}_${option}_price"
                                        class="flex-1 h-[40px] rounded-[8px] border border-[#DDE3EC] bg-white px-3 text-[14px] font-medium"
                                        style="min-width:0;" />
                                    <span class="w-14 text-right text-[13px] text-[#94A3B8] font-medium pl-2.5" style="font-family:'Manrope',sans-serif;">Price</span>
                                </div>
                                <p id="error-variant_${groupName}_${option}_price" class="text-xs text-red-600 -mt-1 mb-2 hidden"></p>

                                <div class="flex items-center gap-0 mb-3">
                                    <input type="text" placeholder="SKU Code" value="${varSku}"
                                        name="variant_${groupName}_${option}_sku"
                                        class="flex-1 h-[40px] rounded-[8px] border border-[#DDE3EC] bg-white px-3 text-[14px] font-medium"
                                        style="min-width:0;" />
                                    <span class="w-14 text-right text-[13px] text-[#94A3B8] font-medium pl-2.5" style="font-family:'Manrope',sans-serif;">SKU</span>
                                </div>
                                <p id="error-variant_${groupName}_${option}_sku" class="text-xs text-red-600 -mt-2 mb-2 hidden"></p>

                                <div class="mt-3 pt-3 border-t border-[#DDE3EC]">
                                    <label class="block text-[10px] font-bold text-luxe-muted uppercase mb-2 tracking-wider" style="font-family:'Manrope',sans-serif;">Variant Images (Max 3)</label>
                                    <div class="flex flex-wrap gap-2 items-center">
                                        <div onclick="document.getElementById('input_${idSuffix}').click()"
                                             class="w-10 h-10 border border-dashed border-[#A0AEC0] hover:border-luxe-obsidian bg-white rounded-lg flex flex-col items-center justify-center cursor-pointer transition-colors"
                                             title="Upload Image">
                                            <svg class="w-4 h-4 text-luxe-muted" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
                                            </svg>
                                        </div>
                                        <input type="file" accept="image/*" multiple class="hidden" 
                                               id="input_${idSuffix}" 
                                               name="variant_${groupName}_${option}_images"
                                               onchange="handleVariantFiles(this, '${escapedGroupName}', '${escapedOption}')" />
                                        <div id="preview_${idSuffix}" class="flex flex-wrap gap-2"></div>
                                    </div>
                                    <p id="error-variant_${groupName}_${option}_images" class="text-xs text-red-600 mt-2 hidden"></p>
                                </div>
                            </div>
                        `;
                    }).join('')}
                </div>
            `;

            if (elementToUpdate) {
                elementToUpdate.setAttribute('data-group-name', groupName);
                elementToUpdate.setAttribute('data-options', options.join(','));
                elementToUpdate.innerHTML = innerHTML;
                bindEditEvent(elementToUpdate);
            } else {
                const section = document.createElement('div');
                section.classList.add('variant-group');
                section.setAttribute('data-group-name', groupName);
                section.setAttribute('data-options', options.join(','));
                section.innerHTML = innerHTML;
                variantsContainer.appendChild(section);
                bindEditEvent(section);
            }

            // Bind current images and file input arrays
            options.forEach(option => {
                renderVariantPreviews(groupName, option);
                updateVariantInputFiles(groupName, option);
            });
        }

        function bindEditEvent(groupEl) {
            const editBtn = groupEl.querySelector('.edit-group-btn');
            editBtn.addEventListener('click', () => {
                const groupName = groupEl.getAttribute('data-group-name');
                const options = groupEl.getAttribute('data-options');
                
                editingGroupElement = groupEl;
                
                document.getElementById('groupName').value = groupName;
                document.getElementById('groupOptions').value = options;
                
                document.getElementById('modalTitle').textContent = 'Edit Variant Group';
                document.getElementById('addVariantGroup').textContent = 'Save Changes';
                
                variantModal.classList.remove('hidden');
                modalOverlay.classList.remove('hidden');
            });
        }

        // Open modal
        addVariantsBtn.addEventListener('click', () => {
            editingGroupElement = null;
            document.getElementById('modalTitle').textContent = 'Add Variant Group';
            document.getElementById('addVariantGroup').textContent = 'Add Group';
            variantModal.classList.remove('hidden');
            modalOverlay.classList.remove('hidden');
        });

        // Close modal
        document.getElementById('closeModal').addEventListener('click', closeModal);
        document.getElementById('cancelModalBtn').addEventListener('click', closeModal);
        modalOverlay.addEventListener('click', closeModal);

        function closeModal() {
            variantModal.classList.add('hidden');
            modalOverlay.classList.add('hidden');
            document.getElementById('groupName').value = '';
            document.getElementById('groupOptions').value = '';
            document.getElementById('modalTitle').textContent = 'Add Variant Group';
            document.getElementById('addVariantGroup').textContent = 'Add Group';
            editingGroupElement = null;
        }

        // Add variant group
        document.getElementById('addVariantGroup').addEventListener('click', () => {
            const groupName = document.getElementById('groupName').value.trim();
            const optionsRaw = document.getElementById('groupOptions').value.trim();

            if (!groupName || !optionsRaw) return alert('Fill both fields');

            const options = optionsRaw.split(',').map(o => o.trim()).filter(Boolean);

            createOrUpdateGroup(groupName, options, editingGroupElement);
            closeModal();
        });

        // Group and render variants on load
        const groups = {}; // groupName -> array of options
        preloadedVariants.forEach(variant => {
            if (!groups[variant.groupName]) {
                groups[variant.groupName] = [];
            }
            if (!groups[variant.groupName].includes(variant.option)) {
                groups[variant.groupName].push(variant.option);
            }
        });

        const groupNames = Object.keys(groups);
        if (groupNames.length > 0) {
            groupNames.forEach(groupName => {
                createOrUpdateGroup(groupName, groups[groupName]);
            });
        } else {
            createOrUpdateGroup('Color', ['Black', 'White', 'Silver']);
        }

        // Variant Image Cropping & Management Logic
        window.handleVariantFiles = function(input, groupName, option) {
            const key = `${groupName}_${option}`;
            if (!newVariantImages[key]) {
                newVariantImages[key] = [];
            }
            if (!existingVariantImages[key]) {
                existingVariantImages[key] = [];
            }
            const currentCount = (existingVariantImages[key]?.length || 0) + (newVariantImages[key]?.length || 0);
            const newFiles = Array.from(input.files).filter(file => file.type.startsWith('image/'));
            
            if (currentCount + newFiles.length > 3) {
                alert('You can only upload up to 3 images per variant.');
                input.value = '';
                return;
            }
            
            newFiles.forEach(file => {
                cropQueue.push({ file, groupName, option });
            });
            
            input.value = ''; // Clear value to allow same-file selection triggers
            
            if (!cropperInstance && cropQueue.length > 0) {
                processNextInCropQueue();
            }
        };

        function processNextInCropQueue() {
            if (cropQueue.length === 0) {
                return;
            }

            const item = cropQueue[0];
            const reader = new FileReader();
            reader.onload = function(e) {
                const cropImage = document.getElementById('cropImage');
                cropImage.src = e.target.result;
                
                // Show crop modal
                document.getElementById('cropModalOverlay').classList.remove('hidden');
                document.getElementById('cropModal').classList.remove('hidden');
                
                // Destroy old cropper if exists
                if (cropperInstance) {
                    cropperInstance.destroy();
                }
                
                // Initialize Cropper.js (free crop aspect ratio)
                cropperInstance = new Cropper(cropImage, {
                    aspectRatio: NaN,
                    viewMode: 1,
                    dragMode: 'none',
                    autoCropArea: 0.85,
                    restore: false,
                    guides: true,
                    center: true,
                    highlight: false,
                    cropBoxMovable: true,
                    cropBoxResizable: true,
                    toggleDragModeOnDblclick: false,
                });
            };
            reader.readAsDataURL(item.file);
        }

        function closeCropModal() {
            document.getElementById('cropModalOverlay').classList.add('hidden');
            document.getElementById('cropModal').classList.add('hidden');
            if (cropperInstance) {
                cropperInstance.destroy();
                cropperInstance = null;
            }
        }

        document.getElementById('cropAndAddBtn').addEventListener('click', () => {
            if (!cropperInstance) return;
            
            const canvas = cropperInstance.getCroppedCanvas({
                maxWidth: 2048,
                maxHeight: 2048,
            });
            
            canvas.toBlob((blob) => {
                const currentItem = cropQueue[0];
                const croppedFile = new File([blob], currentItem.file.name, {
                    type: 'image/jpeg',
                    lastModified: Date.now()
                });
                
                const key = `${currentItem.groupName}_${currentItem.option}`;
                if (!newVariantImages[key]) {
                    newVariantImages[key] = [];
                }
                newVariantImages[key].push(croppedFile);
                
                renderVariantPreviews(currentItem.groupName, currentItem.option);
                updateVariantInputFiles(currentItem.groupName, currentItem.option);
                
                cropQueue.shift();
                closeCropModal();
                processNextInCropQueue();
            }, 'image/jpeg', 0.9);
        });

        const handleCropCancel = () => {
            cropQueue.shift();
            closeCropModal();
            processNextInCropQueue();
        };

        document.getElementById('cancelCropBtn').addEventListener('click', handleCropCancel);
        document.getElementById('closeCropModal').addEventListener('click', handleCropCancel);

        function renderVariantPreviews(groupName, option) {
            const key = `${groupName}_${option}`;
            const idSuffix = `${groupName.replace(/[^a-zA-Z0-9]/g, '_')}_${option.replace(/[^a-zA-Z0-9]/g, '_')}`;
            const container = document.getElementById(`preview_${idSuffix}`);
            if (!container) return;
            
            container.innerHTML = '';
            
            const escapedGroupName = groupName.replace(/'/g, "\\'");
            const escapedOption = option.replace(/'/g, "\\'");
            
            // 1. Render existing Cloudinary images
            const existingUrls = existingVariantImages[key] || [];
            existingUrls.forEach(url => {
                const previewCard = document.createElement('div');
                previewCard.className = 'w-10 h-10 rounded-lg border border-luxe-border overflow-hidden relative group shadow-sm bg-luxe-slate flex items-center justify-center';
                previewCard.innerHTML = `
                    <img src="${url}" alt="Preview" class="w-full h-full object-cover" />
                    <button type="button" class="absolute inset-0 bg-black/55 opacity-0 group-hover:opacity-100 flex items-center justify-center text-white text-[10px] font-bold transition-opacity duration-200" 
                        onclick="removeExistingImage('${escapedGroupName}', '${escapedOption}', '${url.replace(/'/g, "\\'")}')">✕</button>
                `;
                container.appendChild(previewCard);
            });

            // 2. Render new cropped images
            const newFiles = newVariantImages[key] || [];
            newFiles.forEach((file, index) => {
                const url = URL.createObjectURL(file);
                const previewCard = document.createElement('div');
                previewCard.className = 'w-10 h-10 rounded-lg border border-luxe-border overflow-hidden relative group shadow-sm bg-luxe-slate flex items-center justify-center';
                previewCard.innerHTML = `
                    <img src="${url}" alt="Preview" class="w-full h-full object-cover" />
                    <button type="button" class="absolute inset-0 bg-black/55 opacity-0 group-hover:opacity-100 flex items-center justify-center text-white text-[10px] font-bold transition-opacity duration-200" 
                        onclick="removeNewVariantImage('${escapedGroupName}', '${escapedOption}', ${index})">✕</button>
                `;
                container.appendChild(previewCard);
            });
        }

        function updateVariantInputFiles(groupName, option) {
            const key = `${groupName}_${option}`;
            const idSuffix = `${groupName.replace(/[^a-zA-Z0-9]/g, '_')}_${option.replace(/[^a-zA-Z0-9]/g, '_')}`;
            const input = document.getElementById(`input_${idSuffix}`);
            if (!input) return;
            
            const dataTransfer = new DataTransfer();
            const files = newVariantImages[key] || [];
            files.forEach(file => dataTransfer.items.add(file));
            input.files = dataTransfer.files;
        }

        window.removeNewVariantImage = function(groupName, option, index) {
            const key = `${groupName}_${option}`;
            if (newVariantImages[key]) {
                newVariantImages[key].splice(index, 1);
                renderVariantPreviews(groupName, option);
                updateVariantInputFiles(groupName, option);
            }
        };

        window.removeExistingImage = function(groupName, option, imageUrl) {
            const key = `${groupName}_${option}`;
            if (existingVariantImages[key]) {
                existingVariantImages[key] = existingVariantImages[key].filter(url => url !== imageUrl);
                removedImages.push(imageUrl);
                document.getElementById('removedImagesInput').value = removedImages.join(',');
                renderVariantPreviews(groupName, option);
            }
        };

        // Helpers for Field-Level Validation
        function clearFieldError(inputEl, errorEl) {
            if (inputEl) {
                inputEl.classList.remove('border-red-500', 'focus:border-red-500', 'focus:ring-red-500');
            }
            if (errorEl) {
                errorEl.textContent = '';
                errorEl.classList.add('hidden');
            }
        }

        function showFieldError(inputEl, errorEl, msg) {
            if (inputEl) {
                inputEl.classList.add('border-red-500', 'focus:border-red-500', 'focus:ring-red-500');
            }
            if (errorEl) {
                errorEl.textContent = msg;
                errorEl.classList.remove('hidden');
            }
        }

        function validateProductName(name) {
            if (!name || name.trim() === '') return 'Product Name is required.';
            if (name.length < 3) return 'Product Name must be at least 3 characters.';
            if (name.length > 100) return 'Product Name cannot exceed 100 characters.';
            const nameRegex = /^[a-zA-Z0-9\s.,&'"+()\[\]#-]+$/;
            if (!nameRegex.test(name)) return 'Product Name contains invalid characters.';
            return null;
        }

        // Form Submit Handler to package variant data array
        document.getElementById('editProductForm').addEventListener('submit', function(e) {
            // Clear all previous errors
            document.querySelectorAll('[id^="error-"]').forEach(el => {
                el.textContent = '';
                el.classList.add('hidden');
            });
            document.querySelectorAll('input, select, textarea').forEach(el => {
                el.classList.remove('border-red-500', 'focus:border-red-500', 'focus:ring-red-500');
            });
            const banner = document.getElementById('errorBannerContainer');
            const bannerText = document.getElementById('errorBannerText');
            banner.classList.add('hidden');
            bannerText.textContent = '';

            let clientErrors = {};

            // Client-side validations
            const prodName = document.querySelector('[name="productName"]').value;
            const prodNameErr = validateProductName(prodName);
            if (prodNameErr) clientErrors.productName = prodNameErr;
            
            const cards = document.querySelectorAll('.variant-card');
            const variantData = [];
            
            if (cards.length === 0) {
                clientErrors.variants = 'Please add at least one variant.';
            } else {
                const seenSku = new Set();
                cards.forEach(card => {
                    const id = card.getAttribute('data-variant-id') || null;
                    const groupName = card.getAttribute('data-group-name');
                    const option = card.getAttribute('data-option');
                    const prefix = `variant_${groupName}_${option}`;
                    
                    const unitsInput = card.querySelector(`[name="${prefix}_units"]`);
                    const unitsVal = unitsInput ? unitsInput.value.trim() : '';
                    if (unitsVal === '') {
                        clientErrors[`${prefix}_units`] = 'Units is required.';
                    } else {
                        const uNum = Number(unitsVal);
                        if (isNaN(uNum) || !Number.isInteger(uNum) || uNum < 0) {
                            clientErrors[`${prefix}_units`] = 'Units must be a non-negative integer.';
                        }
                    }

                    const priceInput = card.querySelector(`[name="${prefix}_price"]`);
                    const priceVal = priceInput ? priceInput.value.trim() : '';
                    if (priceVal === '') {
                        clientErrors[`${prefix}_price`] = 'Price is required.';
                    } else {
                        const pNum = Number(priceVal);
                        if (isNaN(pNum) || pNum < 0) {
                            clientErrors[`${prefix}_price`] = 'Price must be a non-negative number.';
                        }
                    }

                    const skuInput = card.querySelector(`[name="${prefix}_sku"]`);
                    const skuVal = skuInput ? skuInput.value.trim() : '';
                    if (!skuVal || skuVal.trim() === '') {
                        clientErrors[`${prefix}_sku`] = 'SKU is required.';
                    } else {
                        const skuTrimmed = skuVal.trim();
                        if (skuTrimmed.length < 3) {
                            clientErrors[`${prefix}_sku`] = 'SKU must be at least 3 characters.';
                        } else if (skuTrimmed.length > 30) {
                            clientErrors[`${prefix}_sku`] = 'SKU cannot exceed 30 characters.';
                        } else if (!/^[A-Za-z0-9\-\_]+$/.test(skuTrimmed)) {
                            clientErrors[`${prefix}_sku`] = 'SKU must be alphanumeric (hyphens and underscores allowed).';
                        } else if (seenSku.has(skuTrimmed.toLowerCase())) {
                            clientErrors[`${prefix}_sku`] = 'Duplicate SKU Code found within variants.';
                        } else {
                            seenSku.add(skuTrimmed.toLowerCase());
                        }
                    }
    
                    // Image validation
                    const key = `${groupName}_${option}`;
                    const existingCount = (existingVariantImages[key] || []).length;
                    const newCount = (newVariantImages[key] || []).length;
                    const totalCount = existingCount + newCount;
    
                    if (totalCount === 0) {
                        clientErrors[`${prefix}_images`] = 'At least one image is required.';
                    } else if (totalCount > 3) {
                        clientErrors[`${prefix}_images`] = 'Maximum 3 images allowed.';
                    }
                    
                    variantData.push({
                        _id: id ? id : null,
                        groupName: groupName,
                        option: option,
                        units: unitsVal ? parseFloat(unitsVal) : 0,
                        price: priceVal ? parseFloat(priceVal) : 0,
                        sku: skuVal
                    });
                });
            }
            
            if (Object.keys(clientErrors).length > 0) {
                e.preventDefault();
                // Display client-side errors
                for (const [field, msg] of Object.entries(clientErrors)) {
                    const errEl = document.getElementById(`error-${field}`);
                    const inputEl = document.querySelector(`[name="${field}"]`) || document.getElementById(`input_${field.replace(/^variant_/, '').replace(/_images$/, '')}`);
                    showFieldError(inputEl, errEl, msg);
                }
                bannerText.textContent = 'Please fix the errors indicated below.';
                banner.classList.remove('hidden');
                window.scrollTo({ top: 0, behavior: 'smooth' });
                return;
            }

            document.getElementById('variantData').value = JSON.stringify(variantData);

            // Sync newVariantImages to actual inputs prior to normal form submit
            cards.forEach(card => {
                const groupName = card.getAttribute('data-group-name');
                const option = card.getAttribute('data-option');
                updateVariantInputFiles(groupName, option);
            });
        });

        // Server-Side Error Render Logic on Page Load
        const serverErrors = <% if (locals.errors) { %> <%- JSON.stringify(errors).replace(/</g, '\\u003c') %> <% } else { %> null <% } %>;
        if (serverErrors) {
            for (const [field, msg] of Object.entries(serverErrors)) {
                const errEl = document.getElementById(`error-${field}`);
                const inputEl = document.querySelector(`[name="${field}"]`) || document.getElementById(`input_${field.replace(/^variant_/, '').replace(/_images$/, '')}`);
                showFieldError(inputEl, errEl, msg);
            }
        }
    </script>

</body>

</html>
