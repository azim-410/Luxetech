<script>
function saveEstimateDate() {
    const dateInput = document.getElementById('estimate-date-input');
    const selectedDate = dateInput.value;
    if (!selectedDate) {
        alert('Please select a date first.');
        return;
    }
    
    // Extract Order ID dynamically from the h2 element
    const orderHeader = document.querySelector('h2.text-4xl').textContent;
    const orderId = orderHeader.replace('Order #', '').trim();
    
    // Perform POST request
    fetch(`/orders/${orderId}/update-estimate`, {
        method: 'POST',
        headers: {
            'Content-Type': 'application/json'
        },
        body: JSON.stringify({ estimateDate: selectedDate })
    })
    .then(response => {
        if (response.ok) {
            alert('Estimate date saved successfully!');
        } else {
            alert('Failed to save estimate date.');
        }
    })
    .catch(error => {
        console.error('Error:', error);
        alert('An error occurred while saving the estimate date.');
    });
}

function toggleStatusDropdown(event) {
    event.stopPropagation();
    const menu = document.getElementById('status-dropdown-menu');
    menu.classList.toggle('hidden');
}

// Close dropdown when clicking outside
window.addEventListener('click', function(e) {
    const container = document.getElementById('status-dropdown-container');
    const menu = document.getElementById('status-dropdown-menu');
    if (container && !container.contains(e.target)) {
        menu.classList.add('hidden');
    }
});

function updateOrderStatus(status) {
    // Hide dropdown
    document.getElementById('status-dropdown-menu').classList.add('hidden');
    
    // Get Order ID
    const orderHeader = document.querySelector('h2.text-4xl').textContent;
    const orderId = orderHeader.replace('Order #', '').trim();
    
    // Perform POST request
    fetch(`/orders/${orderId}/update-status`, {
        method: 'POST',
        headers: {
            'Content-Type': 'application/json'
        },
        body: JSON.stringify({ status: status })
    })
    .then(response => {
        if (response.ok) {
            alert(`Order status updated to ${status} successfully!`);
            // Update badge on screen
            const badge = document.getElementById('order-status-badge');
            if (badge) {
                badge.textContent = status;
                // Adjust colors based on status
                let baseClass = "px-2 py-0.5 rounded-full text-[10px] font-bold uppercase tracking-wider ";
                if (status === 'Pending') {
                    badge.className = baseClass + "bg-amber-100 text-amber-800";
                } else if (status === 'Processing') {
                    badge.className = baseClass + "bg-secondary-container text-on-secondary-container";
                } else if (status === 'Shipped') {
                    badge.className = baseClass + "bg-purple-100 text-purple-800";
                } else if (status === 'Delivered') {
                    badge.className = baseClass + "bg-green-100 text-green-800";
                } else if (status === 'Cancelled') {
                    badge.className = baseClass + "bg-red-100 text-red-800";
                }
            }
        } else {
            alert('Failed to update order status.');
        }
    })
    .catch(error => {
        console.error('Error:', error);
        alert('An error occurred while updating the status.');
    });
}
</script>
