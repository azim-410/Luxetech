<!DOCTYPE html>

<html class="light" lang="en">

<head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>Order Details - Luxe Obsidian</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <!-- Google Fonts: Manrope & Inter -->
    <link
        href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&amp;family=Inter:wght@300;400;500;600&amp;display=swap"
        rel="stylesheet" />
    <!-- Material Symbols -->
    <link
        href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap"
        rel="stylesheet" />
    <script id="tailwind-config">
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    colors: {
                        "primary-fixed-dim": "#d4d4d7",
                        "secondary-fixed": "#cae6fd",
                        "on-primary-fixed": "#3e3f42",
                        "on-surface-variant": "#586064",
                        "on-secondary-container": "#3a5568",
                        "on-tertiary-fixed-variant": "#526072",
                        "secondary-fixed-dim": "#bcd8ef",
                        "primary-container": "#e2e2e5",
                        "inverse-on-surface": "#9b9d9e",
                        "error-dim": "#4e0309",
                        "surface-container": "#eaeff1",
                        "surface-tint": "#5d5e61",
                        "secondary-dim": "#3b5669",
                        "on-primary-container": "#505254",
                        "surface-container-high": "#e3e9ec",
                        "tertiary-fixed": "#dbe9ff",
                        "on-primary-fixed-variant": "#5a5c5e",
                        "outline-variant": "#abb3b7",
                        "tertiary-dim": "#465465",
                        "on-background": "#2b3437",
                        "inverse-surface": "#0c0f10",
                        "surface-variant": "#dbe4e7",
                        "on-secondary-fixed-variant": "#445f72",
                        "on-tertiary-container": "#485668",
                        "on-surface": "#2b3437",
                        "surface-dim": "#d1dce0",
                        "primary-fixed": "#e2e2e5",
                        "secondary-container": "#cae6fd",
                        "surface": "#f8f9fa",
                        "on-tertiary": "#f7f9ff",
                        "on-error-container": "#752121",
                        "error-container": "#fe8983",
                        "on-tertiary-fixed": "#364455",
                        "tertiary": "#526072",
                        "surface-container-lowest": "#ffffff",
                        "outline": "#737c7f",
                        "secondary": "#476275",
                        "surface-container-low": "#f1f4f6",
                        "primary-dim": "#515255",
                        "on-error": "#fff7f6",
                        "tertiary-container": "#dbe9ff",
                        "inverse-primary": "#f9f9fc",
                        "surface-bright": "#f8f9fa",
                        "on-primary": "#f7f7fa",
                        "primary": "#5d5e61",
                        "surface-container-highest": "#dbe4e7",
                        "on-secondary-fixed": "#274254",
                        "error": "#9f403d",
                        "background": "#f8f9fa"
                    },
                    fontFamily: {
                        "headline": ["Manrope"],
                        "body": ["Inter"],
                        "label": ["Inter"]
                    },
                    borderRadius: { "DEFAULT": "0.125rem", "lg": "0.25rem", "xl": "0.5rem", "full": "0.75rem" },
                },
            },
        }
    </script>
    <style>
        .material-symbols-outlined {
            font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
        }

        body {
            font-family: 'Inter', sans-serif;
            background-color: #f8f9fa;
            color: #2b3437;
        }

        h1,
        h2,
        h3,
        .font-headline {
            font-family: 'Manrope', sans-serif;
        }

        .glass-header {
            background: rgba(234, 239, 241, 0.8);
            backdrop-filter: blur(20px);
        }

        .cta-gradient {
            background: linear-gradient(135deg, #5d5e61 0%, #476275 100%);
        }
    </style>
</head>

<body class="bg-surface text-on-surface selection:bg-secondary-container flex min-h-screen">
    <%- include('../partials/admin/layout', { activePage: 'orders' }) %>
        <main class="ml-0 md:ml-64 flex-1 flex flex-col min-h-screen pt-16">
            <div class="px-4 sm:px-12 py-6 sm:py-10 space-y-6 sm:space-y-10 w-full flex-1">
                <!-- Page Header Section -->
                <div class="pb-0">
                    <div class="flex flex-col md:flex-row md:items-end justify-between gap-4 mb-8">
                        <div>
                            <nav
                                class="flex items-center gap-2 text-[10px] uppercase tracking-[0.1em] text-outline mb-2 font-bold">
                                <span>Admin</span>
                                <span class="material-symbols-outlined text-[12px]">chevron_right</span>
                                <a href="/admin/order-management" class="hover:text-secondary">Orders</a>
                                <span class="material-symbols-outlined text-[12px]">chevron_right</span>
                                <span class="text-secondary">Details</span>
                            </nav>
                            <div class="flex items-center gap-3 mb-2">
                                <% let badgeClass="bg-secondary-container text-on-secondary-container" ; if
                                    (order.orderStatus==='Pending' ) { badgeClass="bg-amber-100 text-amber-800" ; } else
                                    if (order.orderStatus==='Shipped' ) { badgeClass="bg-purple-100 text-purple-800" ; }
                                    else if (order.orderStatus==='Delivered' ) {
                                    badgeClass="bg-green-100 text-green-800" ; } else if
                                    (order.orderStatus==='Cancelled' || order.orderStatus==='Returned' ) {
                                    badgeClass="bg-red-100 text-red-800" ; } else if (order.orderStatus==='Replaced') {
                                    badgeClass="bg-blue-100 text-blue-800" ; } else if
                                    (order.orderStatus==='Return Requested' ) { badgeClass="bg-amber-100 text-amber-800"
                                    ; } else if (order.orderStatus==='Return Confirmed' ) {
                                    badgeClass="bg-orange-100 text-orange-800" ; } else if
                                    (order.orderStatus==='Replacement Confirmed' ) {
                                    badgeClass="bg-blue-100 text-blue-800" ; } %>
                                    <span id="order-status-badge"
                                        class="px-2 py-0.5 rounded-full text-[10px] font-bold uppercase tracking-wider <%= badgeClass %>">
                                        <%= order.orderStatus %>
                                    </span>
                                    <span class="text-on-surface-variant text-xs font-medium tracking-tight">Placed on
                                        <%= new Date(order.createdAt).toLocaleDateString('en-US', { month: 'short' ,
                                            day: 'numeric' , year: 'numeric' }) %>
                                    </span>
                            </div>
                            <h2 class="text-4xl font-extrabold tracking-tighter text-on-surface">Order # <%=
                                    order.orderId %>
                            </h2>
                        </div>
                        <div class="flex gap-3 items-center">
                            <div class="relative flex items-center">
                                <input type="text" id="estimate-date-input" placeholder="Estimate Date"
                                    onfocus="(this.type='date')" onblur="if(!this.value)this.type='text'"
                                    value="<%= order.estimateDate || '' %>"
                                    class="px-5 py-2.5 pr-10 rounded-md border border-outline-variant/15 bg-white text-on-surface text-xs font-semibold hover:bg-surface-container-low transition-all outline-none focus:ring-1 focus:ring-secondary/20 w-44" />
                                <button onclick="saveEstimateDate('<%= order._id %>')"
                                    class="absolute right-3 text-outline hover:text-secondary transition-colors flex items-center justify-center p-0.5"
                                    title="Save Estimate Date">
                                    <span class="material-symbols-outlined text-[20px]">check</span>
                                </button>
                            </div>
                            <button
                                class="px-5 py-2.5 rounded-md border border-outline-variant/15 text-on-surface text-xs font-semibold hover:bg-surface-container-low transition-all flex items-center gap-2">
                                <span class="material-symbols-outlined text-lg">print</span> Print Invoice
                            </button>
                            <% const isPendingValid=false; const isProcessingValid=(order.orderStatus==='Pending' );
                                const isShippedValid=(order.orderStatus==='Processing' ); const
                                isOutForDeliveryValid=(order.orderStatus==='Shipped' ); const
                                isDeliveredValid=(order.orderStatus==='Out for Delivery' ); const
                                isCancelledValid=['Pending', 'Processing' , 'Shipped' , 'Out for Delivery'
                                ].includes(order.orderStatus); %>
                                <div class="relative inline-block text-left" id="status-dropdown-container">
                                    <button onclick="toggleStatusDropdown(event)"
                                        class="px-5 py-2.5 rounded-md cta-gradient text-on-primary text-xs font-semibold shadow-lg shadow-primary/10 hover:-translate-y-0.5 transition-all flex items-center gap-2">
                                        Update Status <span class="material-symbols-outlined text-lg">expand_more</span>
                                    </button>
                                    <div id="status-dropdown-menu"
                                        class="hidden absolute right-0 mt-2 w-48 rounded-md bg-white shadow-xl ring-1 ring-black ring-opacity-5 focus:outline-none z-50 overflow-hidden border border-outline-variant/10">
                                        <div class="py-1" role="none">
                                            <!-- Pending Option -->
                                            <button <% if (isPendingValid) { %>
                                                onclick="updateOrderStatus('<%= order._id %>', 'Pending')"
                                                    class="w-full text-left px-4 py-2.5 text-xs font-semibold
                                                    text-on-surface hover:bg-surface-container-low transition-colors
                                                    flex items-center gap-2.5"
                                                    <% } else { %>
                                                        class="w-full text-left px-4 py-2.5 text-xs font-semibold
                                                        text-outline/40 cursor-not-allowed flex items-center gap-2.5
                                                        opacity-50"
                                                        disabled
                                                        <% } %>
                                                            >
                                                            <span
                                                                class="material-symbols-outlined text-[18px] <%= isPendingValid ? 'text-outline' : 'text-outline/40' %>">schedule</span>
                                                            Pending
                                            </button>

                                            <!-- Processing Option -->
                                            <button <% if (isProcessingValid) { %>
                                                onclick="updateOrderStatus('<%= order._id %>', 'Processing')"
                                                    class="w-full text-left px-4 py-2.5 text-xs font-semibold
                                                    text-on-surface hover:bg-surface-container-low transition-colors
                                                    flex items-center gap-2.5"
                                                    <% } else { %>
                                                        class="w-full text-left px-4 py-2.5 text-xs font-semibold
                                                        text-outline/40 cursor-not-allowed flex items-center gap-2.5
                                                        opacity-50"
                                                        disabled
                                                        <% } %>
                                                            >
                                                            <span
                                                                class="material-symbols-outlined text-[18px] <%= isProcessingValid ? 'text-primary' : 'text-outline/40' %>">package_2</span>
                                                            Processing
                                            </button>

                                            <!-- Shipped Option -->
                                            <button <% if (isShippedValid) { %>
                                                onclick="updateOrderStatus('<%= order._id %>', 'Shipped')"
                                                    class="w-full text-left px-4 py-2.5 text-xs font-semibold
                                                    text-on-surface hover:bg-surface-container-low transition-colors
                                                    flex items-center gap-2.5"
                                                    <% } else { %>
                                                        class="w-full text-left px-4 py-2.5 text-xs font-semibold
                                                        text-outline/40 cursor-not-allowed flex items-center gap-2.5
                                                        opacity-50"
                                                        disabled
                                                        <% } %>
                                                            >
                                                            <span
                                                                class="material-symbols-outlined text-[18px] <%= isShippedValid ? 'text-tertiary' : 'text-outline/40' %>">local_shipping</span>
                                                            Shipped
                                            </button>

                                            <!-- Out for Delivery Option -->
                                            <button <% if (isOutForDeliveryValid) { %>
                                                onclick="updateOrderStatus('<%= order._id %>', 'Out for Delivery')"
                                                    class="w-full text-left px-4 py-2.5 text-xs font-semibold
                                                    text-on-surface hover:bg-surface-container-low transition-colors
                                                    flex items-center gap-2.5"
                                                    <% } else { %>
                                                        class="w-full text-left px-4 py-2.5 text-xs font-semibold
                                                        text-outline/40 cursor-not-allowed flex items-center gap-2.5
                                                        opacity-50"
                                                        disabled
                                                        <% } %>
                                                            >
                                                            <span
                                                                class="material-symbols-outlined text-[18px] <%= isOutForDeliveryValid ? 'text-secondary' : 'text-outline/40' %>">departure_board</span>
                                                            Out for Delivery
                                            </button>

                                            <!-- Delivered Option -->
                                            <button <% if (isDeliveredValid) { %>
                                                onclick="updateOrderStatus('<%= order._id %>', 'Delivered')"
                                                    class="w-full text-left px-4 py-2.5 text-xs font-semibold
                                                    text-on-surface hover:bg-surface-container-low transition-colors
                                                    flex items-center gap-2.5"
                                                    <% } else { %>
                                                        class="w-full text-left px-4 py-2.5 text-xs font-semibold
                                                        text-outline/40 cursor-not-allowed flex items-center gap-2.5
                                                        opacity-50"
                                                        disabled
                                                        <% } %>
                                                            >
                                                            <span
                                                                class="material-symbols-outlined text-[18px] <%= isDeliveredValid ? 'text-secondary' : 'text-outline/40' %>">verified</span>
                                                            Delivered
                                            </button>
                                        </div>
                                    </div>
                                </div>
                        </div>
                    </div>

                    <!-- Dashboard Grid Layout -->
                    <div class="grid grid-cols-12 gap-8 items-start">
                        <!-- Left Column: Items & Timeline (60%) -->
                        <div class="col-span-12 lg:col-span-8 space-y-8 pb-12">
                            <!-- Order Items Card -->
                            <section class="bg-surface-container-low rounded-xl p-1 overflow-hidden">
                                <div class="bg-surface-container-lowest rounded-[10px] p-6 shadow-sm">
                                    <h3
                                        class="text-sm font-bold uppercase tracking-[0.15em] text-on-surface-variant mb-6">
                                        Order Items</h3>
                                    <div class="space-y-6">
                                        <% order.items.forEach(function(item) { %>
                                            <div class="flex flex-col gap-4 pb-6 border-b border-outline-variant/10 last:border-b-0 last:pb-0"
                                                id="item-row-<%= item._id %>">
                                                <div class="flex items-center gap-6 group">
                                                    <div
                                                        class="w-24 h-24 rounded-lg bg-surface-container overflow-hidden flex-shrink-0 <%= (item.status === 'Cancelled' || item.status === 'Returned' || item.status === 'Return Confirmed') ? 'opacity-40' : (item.status === 'Replacement Confirmed' || item.status === 'Replaced' ? 'opacity-80' : '') %>">
                                                        <img class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                                                            alt="<%= item.name %>"
                                                            src="<%= item.image || 'https://images.unsplash.com/photo-1523275335684-37898b6baf30?w=500' %>" />
                                                    </div>
                                                    <div class="flex-1">
                                                        <h4
                                                            class="font-headline font-bold text-lg text-on-surface flex items-center gap-2 flex-wrap">
                                                            <span
                                                                class="<%= (item.status === 'Cancelled' || item.status === 'Returned' || item.status === 'Return Confirmed') ? 'line-through text-on-surface-variant/60' : (item.status === 'Replacement Confirmed' || item.status === 'Replaced' ? 'opacity-80' : '') %>">
                                                                <%= item.name %>
                                                            </span>
                                                            <% if (item.status==='Cancelled' ) { %>
                                                                <span
                                                                    class="inline-block bg-red-100 text-red-800 text-[10px] px-2 py-0.5 rounded-full font-bold uppercase tracking-wider">Cancelled</span>
                                                                <% } else if (item.status==='Return Requested') { %>
                                                                    <span
                                                                        class="inline-block bg-amber-100 text-amber-800 text-[10px] px-2 py-0.5 rounded-full font-bold uppercase tracking-wider">Return Requested</span>
                                                                <% } else if (item.status==='Return Confirmed' ) { %>
                                                                        <span
                                                                            class="inline-block bg-orange-100 text-orange-800 text-[10px] px-2 py-0.5 rounded-full font-bold uppercase tracking-wider">Return
                                                                            Confirmed</span>
                                                                <% } else if (item.status==='Replacement Confirmed' ) { %>
                                                                            <span
                                                                                class="inline-block bg-blue-100 text-blue-800 text-[10px] px-2 py-0.5 rounded-full font-bold uppercase tracking-wider">Replacement
                                                                                Confirmed</span>
                                                                <% } else if (item.status==='Returned' ) { %>
                                                                            <span
                                                                                class="inline-block bg-green-100 text-green-800 text-[10px] px-2 py-0.5 rounded-full font-bold uppercase tracking-wider">Returned</span>
                                                                <% } else if (item.status==='Replaced' ) { %>
                                                                            <span
                                                                                class="inline-block bg-blue-100 text-blue-800 text-[10px] px-2 py-0.5 rounded-full font-bold uppercase tracking-wider">Replaced</span>
                                                                <% } %>
                                                        </h4>
                                                        <% if (item.variantName) { %>
                                                            <p
                                                                class="text-xs text-on-surface-variant mt-1 <%= (item.status === 'Cancelled' || item.status === 'Returned' || item.status === 'Return Confirmed') ? 'line-through text-on-surface-variant/40' : (item.status === 'Replacement Confirmed' || item.status === 'Replaced' ? 'opacity-80' : '') %>">
                                                                <%= item.variantName %>
                                                            </p>
                                                            <% } %>
                                                                <div class="mt-2 flex items-center gap-4">
                                                                    <span
                                                                        class="text-xs font-bold text-secondary <%= (item.status === 'Cancelled' || item.status === 'Returned' || item.status === 'Return Confirmed') ? 'line-through opacity-50' : (item.status === 'Replacement Confirmed' || item.status === 'Replaced' ? 'opacity-80' : '') %>">Qty:
                                                                        <%= String(item.quantity).padStart(2, '0' ) %>
                                                                    </span>
                                                                </div>
                                                                <% if (item.status === 'Cancelled' && item.cancellationReason) { %>
                                                                    <div class="mt-2 text-xs text-on-surface-variant flex flex-col gap-1">
                                                                        <span class="font-semibold text-outline text-red-600">Cancellation Reason: <span class="text-on-surface"><%= item.cancellationReason %></span></span>
                                                                        <% if (item.cancellationComments) { %>
                                                                            <span class="font-semibold text-outline text-[11px] italic">Comments: "<%= item.cancellationComments %>"</span>
                                                                        <% } %>
                                                                        <% if (item.cancelledDate) { %>
                                                                            <span class="font-semibold text-outline">Cancelled On: <span class="text-on-surface"><%= formatDate(item.cancelledDate) %></span></span>
                                                                        <% } %>
                                                                    </div>
                                                                <% } %>
                                                                <% if (item.returnReason) { %>
                                                                    <div class="mt-2 text-xs text-on-surface-variant flex flex-col gap-1 <%= (item.status === 'Returned' || item.status === 'Return Confirmed') ? 'opacity-50' : (item.status === 'Replacement Confirmed' || item.status === 'Replaced' ? 'opacity-80' : '') %>">
                                                                        <span class="font-semibold text-outline text-amber-600">Return Reason: <span class="text-on-surface"><%= item.returnReason %></span></span>
                                                                        <span class="font-semibold text-outline">Resolution: <span class="text-on-surface"><%= item.returnResolution %></span></span>
                                                                        <% if (item.returnComments) { %>
                                                                            <span class="font-semibold text-outline text-[11px] italic">Comments: "<%= item.returnComments %>"</span>
                                                                        <% } %>
                                                                        <% if (item.returnRequestDate) { %>
                                                                            <span class="font-semibold text-outline">Requested On: <span class="text-on-surface"><%= formatDate(item.returnRequestDate) %></span></span>
                                                                        <% } %>
                                                                        <% if (item.returnConfirmedDate && ['Return Confirmed', 'Replacement Confirmed', 'Returned', 'Replaced'].includes(item.status)) { %>
                                                                            <span class="font-semibold text-outline">Approved On: <span class="text-on-surface"><%= formatDate(item.returnConfirmedDate) %></span></span>
                                                                        <% } %>
                                                                        <% if (item.returnedDate && (item.status === 'Returned' || item.status === 'Replaced')) { %>
                                                                            <span class="font-semibold text-outline">Completed On: <span class="text-on-surface"><%= formatDate(item.returnedDate) %></span></span>
                                                                        <% } %>
                                                                    </div>
                                                                <% } %>
                                                                <% if (item.paymentReturned) { %>
                                                                    <div class="mt-2.5 flex items-center gap-1.5 text-xs text-green-700 font-bold bg-green-50 px-2 py-1 rounded w-fit border border-green-200">
                                                                        <span class="material-symbols-outlined text-[14px]">account_balance_wallet</span>
                                                                        Refunded to Wallet
                                                                    </div>
                                                                <% } %>
                                                    </div>
                                                    <div class="text-right">
                                                        <p
                                                            class="font-headline font-bold text-lg <%= (item.status === 'Cancelled' || item.status === 'Returned' || item.status === 'Return Confirmed') ? 'line-through text-on-surface-variant/60' : (item.status === 'Replacement Confirmed' || item.status === 'Replaced' ? 'opacity-80' : '') %>">
                                                            ₹<%= item.price.toFixed(2) %>
                                                        </p>
                                                        <% if (item.quantity> 1) { %>
                                                            <p
                                                                class="text-[10px] text-on-surface-variant font-medium <%= (item.status === 'Cancelled' || item.status === 'Returned' || item.status === 'Return Confirmed') ? 'line-through opacity-50' : (item.status === 'Replacement Confirmed' || item.status === 'Replaced' ? 'opacity-80' : '') %>">
                                                                ₹<%= item.subtotal.toFixed(2) %> total</p>
                                                            <% } %>
                                                    </div>
                                                </div>

                                                <% if (item.status === 'Return Requested') { %>
                                                    <div class="flex items-center gap-3 bg-surface-container-high/50 p-3 rounded-lg border border-outline-variant/10 self-start ml-24">
                                                        <span class="text-xs font-semibold text-on-surface-variant">Action Required:</span>
                                                        <div class="relative inline-block text-left" id="action-container-<%= item._id %>">
                                                            <button onclick="toggleActionDropdown('<%= item._id %>')" class="px-3 py-1.5 bg-surface-container text-on-surface text-xs font-bold rounded-lg border border-outline-variant/30 flex items-center gap-1.5 hover:bg-surface-container-high transition-colors">
                                                                <span>Select Resolution</span>
                                                                <span class="material-symbols-outlined text-sm">expand_more</span>
                                                            </button>
                                                            <div id="action-dropdown-<%= item._id %>" class="hidden absolute left-0 mt-1 w-44 rounded-lg bg-surface-container border border-outline-variant/30 shadow-lg z-20 overflow-hidden">
                                                                <button onclick="submitItemAction('<%= order._id %>', '<%= item._id %>', 'Return')" class="w-full text-left px-4 py-2.5 hover:bg-surface-container-high text-xs font-semibold text-red-600 flex items-center gap-2">
                                                                    <span class="material-symbols-outlined text-sm text-red-600">keyboard_return</span>
                                                                    Return
                                                                </button>
                                                                <button onclick="submitItemAction('<%= order._id %>', '<%= item._id %>', 'Replacement')" class="w-full text-left px-4 py-2.5 hover:bg-surface-container-high text-xs font-semibold text-blue-600 flex items-center gap-2">
                                                                    <span class="material-symbols-outlined text-sm text-blue-600">autorenew</span>
                                                                    Replacement
                                                                </button>
                                                            </div>
                                                        </div>
                                                    </div>
                                                <% } else if (item.status === 'Return Confirmed') { %>
                                                    <div class="flex items-center gap-3 bg-surface-container-high/50 p-3 rounded-lg border border-outline-variant/10 self-start ml-24">
                                                        <button onclick="submitItemAction('<%= order._id %>', '<%= item._id %>', 'MarkReturned')" class="px-3 py-1.5 bg-green-600 hover:bg-green-700 text-white text-xs font-bold rounded-lg transition-colors flex items-center gap-1.5">
                                                            <span class="material-symbols-outlined text-sm">check_circle</span>
                                                            <span>Mark as Returned</span>
                                                        </button>
                                                    </div>
                                                <% } else if (item.status === 'Replacement Confirmed') { %>
                                                    <div class="flex items-center gap-3 bg-surface-container-high/50 p-3 rounded-lg border border-outline-variant/10 self-start ml-24">
                                                        <button onclick="submitItemAction('<%= order._id %>', '<%= item._id %>', 'MarkReplaced')" class="px-3 py-1.5 bg-blue-600 hover:bg-blue-700 text-white text-xs font-bold rounded-lg transition-colors flex items-center gap-1.5">
                                                            <span class="material-symbols-outlined text-sm">published_with_changes</span>
                                                            <span>Mark as Replaced</span>
                                                        </button>
                                                    </div>
                                                <% } %>
                                                </div>
                                            <% }); %>
                                    </div>
                                    <!-- Summary Tray -->
                                    <div class="mt-10 pt-8 border-t border-outline-variant/10">
                                        <div class="max-w-xs ml-auto space-y-3">
                                            <% 
                                              let couponCodeToShow = order.couponCode || null;
                                              let couponDiscountAmt = 0;
                                              let productDiscountAmt = 0;

                                              if (typeof order.pricing.couponDiscount !== 'undefined') {
                                                  couponDiscountAmt = order.pricing.couponDiscount;
                                                  productDiscountAmt = order.pricing.productDiscount || 0;
                                              } else if (couponCodeToShow) {
                                                  couponDiscountAmt = order.pricing.discount || 0;
                                                  productDiscountAmt = 0;
                                              } else {
                                                  productDiscountAmt = order.pricing.discount || 0;
                                              }
                                            %>
                                            <div class="flex justify-between text-sm">
                                                <span class="text-on-surface-variant">Subtotal</span>
                                                <span class="font-semibold">₹<%= order.pricing.subtotal.toFixed(2) %>
                                                </span>
                                            </div>
                                            <% if (productDiscountAmt > 0) { %>
                                            <div class="flex justify-between text-sm">
                                                <span class="text-on-surface-variant">Offer Discount</span>
                                                <span class="font-semibold text-green-600">-₹<%= productDiscountAmt.toFixed(2) %></span>
                                            </div>
                                            <% } %>
                                            <% if (couponCodeToShow) { %>
                                            <div class="flex justify-between text-sm">
                                                <span class="text-on-surface-variant">Coupon Redeemed</span>
                                                <span class="font-semibold text-primary"><%= couponCodeToShow %></span>
                                            </div>
                                            <div class="flex justify-between text-sm">
                                                <span class="text-on-surface-variant">Coupon Discount</span>
                                                <span class="font-semibold text-green-600">-₹<%= couponDiscountAmt.toFixed(2) %></span>
                                            </div>
                                            <% } %>
                                            <div class="flex justify-between text-sm">
                                                <span class="text-on-surface-variant">Shipping</span>
                                                <span class="font-semibold text-secondary">
                                                    <%= order.pricing.shipping===0 ? 'FREE' : '₹' +
                                                        order.pricing.shipping.toFixed(2) %>
                                                </span>
                                            </div>
                                            <div class="flex justify-between text-sm">
                                                <span class="text-on-surface-variant">Tax (8%)</span>
                                                <span class="font-semibold">₹<%= order.pricing.tax.toFixed(2) %></span>
                                            </div>
                                            <div
                                                class="flex justify-between items-center pt-4 border-t border-outline-variant/10">
                                                <span
                                                    class="font-headline font-bold text-lg uppercase tracking-tight">Total</span>
                                                <span class="font-headline font-extrabold text-2xl text-on-surface">₹<%=
                                                        order.pricing.grandTotal.toFixed(2) %></span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </section>

                            <!-- Order Timeline Section -->
                            <% const isPendingDone=true; const returnStatuses=['Returned', 'Replaced', 'Return Requested'
                                , 'Return Confirmed' , 'Replacement Confirmed' ]; const
                                isProcessingDone=!!(order.processingDate || ['Processing', 'Shipped'
                                , 'Out for Delivery' , 'Delivered' , ...returnStatuses].includes(order.orderStatus));
                                const isShippedDone=!!(order.shippedDate || ['Shipped', 'Out for Delivery' , 'Delivered'
                                , ...returnStatuses].includes(order.orderStatus)); const
                                isOutForDeliveryDone=!!(order.outForDeliveryDate || ['Out for Delivery', 'Delivered' ,
                                ...returnStatuses].includes(order.orderStatus)); const
                                isDeliveredDone=!!(order.deliveredDate || ['Delivered',
                                ...returnStatuses].includes(order.orderStatus)); 
                                // Helper function to format Date object in EJS
                                function formatDate(dateVal) {
                                if (!dateVal) return '';
                                return new Date(dateVal).toLocaleDateString('en-US', {
                                month: 'short',
                                day: 'numeric',
                                hour: '2-digit',
                                minute: '2-digit'
                                });
                                }

                                // Fallback values for legacy orders
                                const getProcessingTime = () => {
                                if (order.processingDate) return formatDate(order.processingDate);
                                if (order.orderStatus === 'Processing') return formatDate(order.updatedAt);
                                // 1 hour after creation as fallback
                                return formatDate(new Date(new Date(order.createdAt).getTime() + 60*60*1000));
                                };

                                const getShippedTime = () => {
                                if (order.shippedDate) return formatDate(order.shippedDate);
                                if (order.orderStatus === 'Shipped') return formatDate(order.updatedAt);
                                // 1 day after creation as fallback
                                return formatDate(new Date(new Date(order.createdAt).getTime() + 24*60*60*1000));
                                };

                                const getOutForDeliveryTime = () => {
                                if (order.outForDeliveryDate) return formatDate(order.outForDeliveryDate);
                                if (order.orderStatus === 'Out for Delivery') return formatDate(order.updatedAt);
                                // 2 days after creation as fallback
                                return formatDate(new Date(new Date(order.createdAt).getTime() + 2*24*60*60*1000));
                                };

                                const getDeliveredTime = () => {
                                if (order.deliveredDate) return formatDate(order.deliveredDate);
                                return formatDate(order.updatedAt);
                                };
                                %>
                                <section class="bg-surface-container rounded-xl p-8">
                                    <h3
                                        class="text-sm font-bold uppercase tracking-[0.15em] text-on-surface-variant mb-8">
                                        Order Journey</h3>
                                    <div class="relative space-y-8">
                                        <!-- Timeline Line -->
                                        <div class="absolute left-[15px] top-2 bottom-2 w-px bg-outline-variant/20">
                                        </div>

                                        <!-- Step 1 (Pending) -->
                                        <div class="flex gap-6 relative">
                                            <div
                                                class="w-8 h-8 rounded-full bg-secondary text-white flex items-center justify-center z-10 shadow-lg shadow-secondary/20">
                                                <span class="material-symbols-outlined text-lg"
                                                    style="font-variation-settings: 'FILL' 1;">check_circle</span>
                                            </div>
                                            <div>
                                                <h4 class="font-bold text-on-surface">Order Placed</h4>
                                                <p class="text-xs text-on-surface-variant mt-0.5">Order verified and
                                                    waiting for confirmation.</p>
                                                <span
                                                    class="text-[10px] font-bold text-secondary uppercase tracking-widest mt-2 block">
                                                    <%= formatDate(order.createdAt) %>
                                                </span>
                                            </div>
                                        </div>

                                        <!-- Step 2 (Processing) -->
                                        <div class="flex gap-6 relative <%= isProcessingDone ? '' : 'opacity-50' %>">
                                            <div
                                                class="w-8 h-8 rounded-full <%= isProcessingDone ? 'bg-secondary text-white' : 'bg-surface-container-high text-on-surface-variant' %> flex items-center justify-center z-10">
                                                <span class="material-symbols-outlined text-lg">package_2</span>
                                            </div>
                                            <div>
                                                <h4 class="font-bold text-on-surface">Processing at Warehouse</h4>
                                                <p class="text-xs text-on-surface-variant mt-0.5">Your items are being
                                                    picked and carefully packaged.</p>
                                                <% if (isProcessingDone) { %>
                                                    <span
                                                        class="text-[10px] font-bold text-secondary uppercase tracking-widest mt-2 block">
                                                        VERIFIED & PACKAGED - <%= getProcessingTime() %>
                                                    </span>
                                                    <% } %>
                                            </div>
                                        </div>

                                        <!-- Step 3 (Shipped) -->
                                        <div class="flex gap-6 relative <%= isShippedDone ? '' : 'opacity-50' %>">
                                            <div
                                                class="w-8 h-8 rounded-full <%= isShippedDone ? 'bg-secondary text-white' : 'bg-surface-container-high text-on-surface-variant' %> flex items-center justify-center z-10">
                                                <span class="material-symbols-outlined text-lg">local_shipping</span>
                                            </div>
                                            <div>
                                                <h4 class="font-bold text-on-surface">Shipped</h4>
                                                <p class="text-xs text-on-surface-variant mt-0.5">Tracking details will
                                                    be provided once dispatched.</p>
                                                <% if (isShippedDone) { %>
                                                    <span
                                                        class="text-[10px] font-bold text-secondary uppercase tracking-widest mt-2 block">
                                                        SHIPPED - <%= getShippedTime() %>
                                                    </span>
                                                    <% } else if (order.estimateDate) { %>
                                                        <span
                                                            class="text-[10px] font-bold text-outline uppercase tracking-widest mt-2 block">
                                                            Estimated Delivery: <%= order.estimateDate %>
                                                        </span>
                                                        <% } %>
                                            </div>
                                        </div>

                                        <!-- Step 4 (Out for Delivery) -->
                                        <div
                                            class="flex gap-6 relative <%= isOutForDeliveryDone ? '' : 'opacity-50' %>">
                                            <div
                                                class="w-8 h-8 rounded-full <%= isOutForDeliveryDone ? 'bg-secondary text-white' : 'bg-surface-container-high text-on-surface-variant' %> flex items-center justify-center z-10">
                                                <span class="material-symbols-outlined text-lg">departure_board</span>
                                            </div>
                                            <div>
                                                <h4 class="font-bold text-on-surface">Out for Delivery</h4>
                                                <p class="text-xs text-on-surface-variant mt-0.5">The order is out with
                                                    our courier partner.</p>
                                                <% if (isOutForDeliveryDone) { %>
                                                    <span
                                                        class="text-[10px] font-bold text-secondary uppercase tracking-widest mt-2 block">
                                                        OUT FOR DELIVERY - <%= getOutForDeliveryTime() %>
                                                    </span>
                                                    <% } %>
                                            </div>
                                        </div>

                                        <!-- Step 5 (Delivered) -->
                                        <div class="flex gap-6 relative <%= isDeliveredDone ? '' : 'opacity-50' %>">
                                            <div
                                                class="w-8 h-8 rounded-full <%= isDeliveredDone ? 'bg-secondary text-white' : 'bg-surface-container-high text-on-surface-variant' %> flex items-center justify-center z-10">
                                                <span class="material-symbols-outlined text-lg">verified</span>
                                            </div>
                                            <div>
                                                <h4 class="font-bold text-on-surface">Delivered</h4>
                                                <p class="text-xs text-on-surface-variant mt-0.5">The order has been
                                                    signed for and delivered.</p>
                                                <% if (isDeliveredDone) { %>
                                                    <span
                                                        class="text-[10px] font-bold text-secondary uppercase tracking-widest mt-2 block">
                                                        DELIVERED - <%= getDeliveredTime() %>
                                                    </span>
                                                    <% } %>
                                            </div>
                                        </div>

                                        <!-- Step 6 (Cancelled) -->
                                        <% if (order.orderStatus==='Cancelled' ) { %>
                                            <div class="flex gap-6 relative">
                                                <div
                                                    class="w-8 h-8 rounded-full bg-red-600 text-white flex items-center justify-center z-10 shadow-lg shadow-red-600/20">
                                                    <span class="material-symbols-outlined text-lg">cancel</span>
                                                </div>
                                                <div>
                                                    <h4 class="font-bold text-on-surface">Order Cancelled</h4>
                                                    <p class="text-xs text-on-surface-variant mt-0.5">The order was
                                                        cancelled.</p>
                                                    <span
                                                        class="text-[10px] font-bold text-red-600 uppercase tracking-widest mt-2 block">
                                                        CANCELLED - <%= formatDate(order.cancelledDate ||
                                                            order.updatedAt) %>
                                                    </span>
                                                </div>
                                            </div>
                                            <% } %>

                                                <!-- Step 7 (Returned and Return/Replacement States) -->
                                                <% if (['Return Requested', 'Return Confirmed', 'Replacement Confirmed', 'Returned', 'Replaced'].includes(order.orderStatus)) { %>
                                                    <div class="flex gap-6 relative">
                                                        <div
                                                            class="w-8 h-8 rounded-full bg-amber-500 text-white flex items-center justify-center z-10 shadow-lg shadow-amber-500/20">
                                                            <span
                                                                class="material-symbols-outlined text-lg">assignment_return</span>
                                                        </div>
                                                        <div>
                                                            <h4 class="font-bold text-on-surface">Return Requested</h4>
                                                            <p class="text-xs text-on-surface-variant mt-0.5">A return request has been submitted by the customer.</p>
                                                            <span
                                                                class="text-[10px] font-bold text-amber-500 uppercase tracking-widest mt-2 block">
                                                                RETURN REQUESTED - <%= formatDate(order.returnRequestDate || order.updatedAt) %>
                                                            </span>
                                                        </div>
                                                    </div>
                                                <% } %>

                                                <% if (order.orderStatus === 'Return Confirmed' || (order.orderStatus === 'Returned' && order.paymentStatus === 'Refunded')) { %>
                                                    <div class="flex gap-6 relative">
                                                        <div
                                                            class="w-8 h-8 rounded-full bg-orange-600 text-white flex items-center justify-center z-10 shadow-lg shadow-orange-600/20">
                                                            <span
                                                                class="material-symbols-outlined text-lg">keyboard_return</span>
                                                        </div>
                                                        <div>
                                                            <h4 class="font-bold text-on-surface">Return Confirmed</h4>
                                                            <p class="text-xs text-on-surface-variant mt-0.5">The return has been approved and processed.</p>
                                                            <span
                                                                class="text-[10px] font-bold text-orange-600 uppercase tracking-widest mt-2 block">
                                                                RETURN CONFIRMED - <%= formatDate(order.returnConfirmedDate || order.updatedAt) %>
                                                            </span>
                                                        </div>
                                                    </div>
                                                <% } %>

                                                <% if (order.orderStatus === 'Replacement Confirmed' || order.orderStatus === 'Replaced' || (order.orderStatus === 'Returned' && order.paymentStatus !== 'Refunded')) { %>
                                                    <div class="flex gap-6 relative">
                                                        <div
                                                            class="w-8 h-8 rounded-full bg-blue-600 text-white flex items-center justify-center z-10 shadow-lg shadow-blue-600/20">
                                                            <span
                                                                class="material-symbols-outlined text-lg">autorenew</span>
                                                        </div>
                                                        <div>
                                                            <h4 class="font-bold text-on-surface">Replacement Confirmed</h4>
                                                            <p class="text-xs text-on-surface-variant mt-0.5">A replacement has been approved and ordered.</p>
                                                            <span
                                                                class="text-[10px] font-bold text-blue-600 uppercase tracking-widest mt-2 block">
                                                                REPLACEMENT CONFIRMED - <%= formatDate(order.returnConfirmedDate || order.updatedAt) %>
                                                            </span>
                                                        </div>
                                                    </div>
                                                <% } %>

                                                <% if (order.orderStatus === 'Returned' || order.orderStatus === 'Replaced') { %>
                                                    <div class="flex gap-6 relative">
                                                        <div
                                                            class="w-8 h-8 rounded-full <%= order.orderStatus === 'Returned' ? 'bg-orange-600 shadow-orange-600/20' : 'bg-blue-600 shadow-blue-600/20' %> text-white flex items-center justify-center z-10 shadow-lg">
                                                            <span
                                                                class="material-symbols-outlined text-lg"><%= order.orderStatus === 'Returned' ? 'assignment_return' : 'published_with_changes' %></span>
                                                        </div>
                                                        <div>
                                                            <h4 class="font-bold text-on-surface"><%= order.orderStatus === 'Returned' ? 'Order Returned' : 'Order Replaced' %></h4>
                                                            <p class="text-xs text-on-surface-variant mt-0.5"><%= order.orderStatus === 'Returned' ? 'The product return request has been processed.' : 'The replacement process has been completed successfully.' %></p>
                                                            <span
                                                                class="text-[10px] font-bold <%= order.orderStatus === 'Returned' ? 'text-orange-600' : 'text-blue-600' %> uppercase tracking-widest mt-2 block">
                                                                <%= order.orderStatus === 'Returned' ? 'RETURNED' : 'REPLACED' %> - <%= formatDate(order.returnedDate || order.updatedAt) %>
                                                            </span>
                                                        </div>
                                                    </div>
                                                <% } %>
                                    </div>
                                </section>
                        </div>

                        <!-- Right Column: Metadata (40%) -->
                        <div class="col-span-12 lg:col-span-4 space-y-6">
                            <!-- Customer Profile Card -->
                            <div class="bg-surface-container-low rounded-xl p-6">
                                <h3 class="text-[10px] font-bold uppercase tracking-[0.2em] text-outline mb-6">Customer
                                    Profile</h3>
                                <div class="flex items-center gap-4 mb-6">
                                    <div
                                        class="w-14 h-14 rounded-full overflow-hidden border-2 border-white shadow-sm flex items-center justify-center bg-surface-container-high">
                                        <% if (order.userId && (order.userId.profileImage || order.userId.avatar)) { %>
                                            <img class="w-full h-full object-cover"
                                                src="<%= order.userId.profileImage || order.userId.avatar %>"
                                                alt="Profile" />
                                            <% } else { %>
                                                <span
                                                    class="material-symbols-outlined text-3xl text-outline">person</span>
                                                <% } %>
                                    </div>
                                    <div>
                                        <h4 class="font-headline font-bold text-on-surface">
                                            <%= order.shippingAddress.fullName %>
                                        </h4>
                                        <p class="text-xs text-on-surface-variant">
                                            <%= order.userId ? order.userId.email : 'Guest Customer' %>
                                        </p>
                                    </div>
                                </div>
                                <div class="grid grid-cols-2 gap-4 py-4 border-y border-outline-variant/10">
                                    <div>
                                        <p class="text-[10px] text-outline uppercase font-semibold mb-1">Customer Phone
                                        </p>
                                        <p class="font-bold text-sm">
                                            <%= order.shippingAddress.phoneNumber %>
                                        </p>
                                    </div>
                                    <div>
                                        <p class="text-[10px] text-outline uppercase font-semibold mb-1">Created At</p>
                                        <p class="font-bold text-sm">
                                            <%= new Date(order.createdAt).toLocaleDateString('en-US', { month: 'short' ,
                                                year: 'numeric' }) %>
                                        </p>
                                    </div>
                                </div>
                            </div>

                            <!-- Shipping Address Card -->
                            <div class="bg-surface-container-low rounded-xl p-6">
                                <div class="flex justify-between items-start mb-4">
                                    <h3 class="text-[10px] font-bold uppercase tracking-[0.2em] text-outline">Shipping
                                        Address</h3>
                                </div>
                                <div class="text-sm leading-relaxed text-on-surface">
                                    <p class="font-bold">
                                        <%= order.shippingAddress.fullName %>
                                    </p>
                                    <p>
                                        <%= order.shippingAddress.streetAddress %>
                                    </p>
                                    <p>
                                        <%= order.shippingAddress.city %>, <%= order.shippingAddress.state %>
                                                <%= order.shippingAddress.zipCode %>
                                    </p>
                                    <p>
                                        <%= order.shippingAddress.country %>
                                    </p>
                                    <p class="mt-2 text-on-surface-variant flex items-center gap-2">
                                        <span class="material-symbols-outlined text-sm">call</span>
                                        <%= order.shippingAddress.phoneNumber %>
                                    </p>
                                </div>
                            </div>

                            <!-- Payment Information Card -->
                            <div class="bg-surface-container-low rounded-xl p-6">
                                <h3 class="text-[10px] font-bold uppercase tracking-[0.2em] text-outline mb-4">Payment
                                    Method</h3>
                                <div class="flex items-center justify-between mb-4">
                                    <div class="flex items-center gap-3">
                                        <div class="w-10 h-7 bg-on-surface rounded flex items-center justify-center">
                                            <span class="text-[10px] text-white font-black italic tracking-tighter">
                                                <%= order.paymentMethod %>
                                            </span>
                                        </div>
                                        <div>
                                            <p class="text-xs font-bold">
                                                <%= order.paymentMethod %>
                                            </p>
                                            <p class="text-[10px] text-on-surface-variant flex items-center gap-1.5">
                                                <span>Payment status:</span>
                                                <span class="font-semibold text-on-surface" id="payment-status-text">
                                                    <%= order.paymentStatus %>
                                                </span>
                                            </p>
                                        </div>
                                    </div>
                                    <% if (order.paymentMethod === 'COD') { %>
                                    <select onchange="updatePaymentStatus('<%= order._id %>', this.value)"
                                        class="text-[10px] font-bold pl-3 pr-7 py-1.5 rounded uppercase bg-tertiary-container text-on-tertiary-container border border-outline-variant/10 cursor-pointer outline-none transition-all hover:bg-tertiary-container/85 appearance-none bg-[url('data:image/svg+xml;charset=utf-8,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20viewBox%3D%220%200%2020%2020%22%20fill%3D%22none%22%3E%3Cpath%20d%3D%22M6%208l4%204%204-4%22%20stroke%3D%22%231e293b%22%20stroke-width%3D%222%22%20stroke-linecap%3D%22round%22%20stroke-linejoin%3D%22round%22%2F%3E%3C%2Fsvg%3E')] bg-[position:right_6px_center] bg-[size:14px_14px] bg-no-repeat">
                                        <option value="Pending" <%=order.paymentStatus==='Pending' ? 'selected' : '' %>>Pending</option>
                                        <option value="Paid" <%=order.paymentStatus==='Paid' ? 'selected' : '' %>>Paid</option>
                                        <option value="Failed" <%=order.paymentStatus==='Failed' ? 'selected' : '' %>>Failed</option>
                                        <option value="Refunded" <%=order.paymentStatus==='Refunded' ? 'selected' : '' %>>Refunded</option>
                                    </select>
                                    <% } %>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </main>

        <!-- Elegant Admin Alert/Error Modal -->
        <div id="alert-modal"
            class="fixed inset-0 z-50 flex items-center justify-center hidden opacity-0 transition-opacity duration-300">
            <!-- Backdrop -->
            <div class="absolute inset-0 bg-[#0C0F10]/60 backdrop-blur-sm transition-opacity duration-300"></div>
            <!-- Modal Card -->
            <div
                class="relative bg-white rounded-2xl max-w-sm w-full mx-4 p-8 shadow-2xl transform scale-95 transition-transform duration-300 border border-outline-variant/10">
                <div class="flex flex-col items-center text-center">
                    <div id="alert-modal-icon-container"
                        class="w-14 h-14 rounded-full bg-red-100 flex items-center justify-center text-red-600 mb-4">
                        <span id="alert-modal-icon" class="material-symbols-outlined text-3xl">warning</span>
                    </div>
                    <h3 id="alert-modal-title" class="text-lg font-bold font-headline text-on-surface mb-2">Attention
                    </h3>
                    <p id="alert-modal-message" class="text-on-surface-variant text-sm leading-relaxed mb-6"></p>
                    <button id="alert-close-btn"
                        class="w-full py-3 bg-[#111827] hover:bg-slate-800 text-white font-bold text-xs uppercase tracking-widest rounded-lg transition-colors">
                        Got it
                    </button>
                </div>
            </div>
        </div>

        <script>
            let currentOnClose = null;

            const showAlert = (message, title = "Attention", type = "error", onClose = null) => {
                const modal = document.getElementById('alert-modal');
                const modalTitle = document.getElementById('alert-modal-title');
                const modalMessage = document.getElementById('alert-modal-message');
                const modalIconContainer = document.getElementById('alert-modal-icon-container');
                const modalIcon = document.getElementById('alert-modal-icon');
                const modalButton = document.getElementById('alert-close-btn');

                modalTitle.innerText = title;
                modalMessage.innerText = message;
                currentOnClose = onClose;

                if (type === 'success') {
                    modalIconContainer.className = 'w-14 h-14 rounded-full bg-green-100 flex items-center justify-center text-green-600 mb-4';
                    modalIcon.innerText = 'check_circle';
                    modalButton.className = 'w-full py-3 bg-green-600 hover:bg-green-700 text-white font-bold text-xs uppercase tracking-widest rounded-lg transition-colors';
                } else {
                    modalIconContainer.className = 'w-14 h-14 rounded-full bg-red-100 flex items-center justify-center text-red-600 mb-4';
                    modalIcon.innerText = 'warning';
                    modalButton.className = 'w-full py-3 bg-[#111827] hover:bg-slate-800 text-white font-bold text-xs uppercase tracking-widest rounded-lg transition-colors';
                }

                modal.classList.remove('hidden');
                setTimeout(() => {
                    modal.classList.remove('opacity-0');
                    modal.querySelector('.relative').classList.remove('scale-95');
                }, 10);
            };

            const closeAlertModal = () => {
                const modal = document.getElementById('alert-modal');
                modal.classList.add('opacity-0');
                modal.querySelector('.relative').classList.add('scale-95');
                setTimeout(() => {
                    modal.classList.add('hidden');
                    if (currentOnClose) {
                        currentOnClose();
                        currentOnClose = null;
                    }
                }, 300);
            };

            const alertCloseBtn = document.getElementById('alert-close-btn');
            if (alertCloseBtn) {
                alertCloseBtn.addEventListener('click', closeAlertModal);
            }
            const alertModal = document.getElementById('alert-modal');
            if (alertModal) {
                const alertBackdrop = alertModal.querySelector('.absolute');
                if (alertBackdrop) {
                    alertBackdrop.addEventListener('click', closeAlertModal);
                }
            }

            function saveEstimateDate(orderId) {
                const dateInput = document.getElementById('estimate-date-input');
                const selectedDate = dateInput.value;
                if (!selectedDate) {
                    showAlert('Please select a date first.', 'Required Field', 'error');
                    return;
                }

                // Perform AJAX POST request
                const xhr = new XMLHttpRequest();
                xhr.open('POST', `/admin/order-management/details/${orderId}/update-estimate`, true);
                xhr.setRequestHeader('Content-Type', 'application/json');
                xhr.onreadystatechange = function () {
                    if (xhr.readyState === 4) {
                        if (xhr.status === 200) {
                            showAlert('Estimate date saved successfully!', 'Success', 'success', function () {
                                window.location.reload();
                            });
                        } else {
                            let errorMessage = 'Failed to save estimate date.';
                            try {
                                const response = JSON.parse(xhr.responseText);
                                errorMessage = response.message || errorMessage;
                            } catch (e) { }
                            showAlert(errorMessage, 'Validation Error', 'error');
                        }
                    }
                };
                xhr.send(JSON.stringify({ estimateDate: selectedDate }));
            }

            function toggleStatusDropdown(event) {
                event.stopPropagation();
                const menu = document.getElementById('status-dropdown-menu');
                if (menu) menu.classList.toggle('hidden');
            }

            // Close dropdown when clicking outside
            window.addEventListener('click', function (e) {
                const container = document.getElementById('status-dropdown-container');
                const menu = document.getElementById('status-dropdown-menu');
                if (container && !container.contains(e.target)) {
                    if (menu) menu.classList.add('hidden');
                }
            });

            function updateOrderStatus(orderId, status) {
                // Hide dropdown
                document.getElementById('status-dropdown-menu').classList.add('hidden');

                // Perform AJAX POST request
                const xhr = new XMLHttpRequest();
                xhr.open('POST', `/admin/order-management/details/${orderId}/update-status`, true);
                xhr.setRequestHeader('Content-Type', 'application/json');
                xhr.onreadystatechange = function () {
                    if (xhr.readyState === 4) {
                        if (xhr.status === 200) {
                            showAlert(`Order status updated to ${status} successfully!`, 'Success', 'success', function () {
                                window.location.reload();
                            });
                        } else {
                            let errorMessage = 'Failed to update order status.';
                            try {
                                const response = JSON.parse(xhr.responseText);
                                errorMessage = response.message || errorMessage;
                            } catch (e) { }
                            showAlert(errorMessage, 'Error', 'error');
                        }
                    }
                };
                xhr.send(JSON.stringify({ status: status }));
            }

            function updatePaymentStatus(orderId, paymentStatus) {
                // Perform AJAX POST request
                const xhr = new XMLHttpRequest();
                xhr.open('POST', `/admin/order-management/details/${orderId}/update-payment-status`, true);
                xhr.setRequestHeader('Content-Type', 'application/json');
                xhr.onreadystatechange = function () {
                    if (xhr.readyState === 4) {
                        if (xhr.status === 200) {
                            showAlert('Payment status updated successfully!', 'Success', 'success', function () {
                                window.location.reload();
                            });
                        } else {
                            let errorMessage = 'Failed to update payment status.';
                            try {
                                const response = JSON.parse(xhr.responseText);
                                errorMessage = response.message || errorMessage;
                            } catch (e) { }
                            showAlert(errorMessage, 'Error', 'error');
                        }
                    }
                };
                xhr.send(JSON.stringify({ paymentStatus: paymentStatus }));
            }

            function toggleActionDropdown(itemId) {
                const dropdown = document.getElementById(`action-dropdown-${itemId}`);
                if (dropdown) {
                    dropdown.classList.toggle('hidden');
                }
            }

            function submitItemAction(orderId, itemId, action) {
                const xhr = new XMLHttpRequest();
                xhr.open('POST', `/admin/order-management/details/${orderId}/item/${itemId}/action`, true);
                xhr.setRequestHeader('Content-Type', 'application/json');
                xhr.onreadystatechange = function () {
                    if (xhr.readyState === 4) {
                        if (xhr.status === 200) {
                            let message = '';
                            if (action === 'Return') {
                                message = 'Return request resolved as Return Confirmed!';
                            } else if (action === 'Replacement') {
                                message = 'Return request resolved as Replacement Confirmed!';
                            } else if (action === 'MarkReturned') {
                                message = 'Item marked as Returned!';
                            } else if (action === 'MarkReplaced') {
                                message = 'Item marked as Replaced!';
                            } else {
                                message = 'Action processed successfully!';
                            }
                            showAlert(message, 'Success', 'success', function () {
                                window.location.reload();
                            });
                        } else {
                            let errorMessage = 'Failed to process action.';
                            try {
                                const response = JSON.parse(xhr.responseText);
                                errorMessage = response.message || response.error || errorMessage;
                            } catch (e) { }
                            showAlert(errorMessage, 'Error', 'error');
                        }
                    }
                };
                xhr.send(JSON.stringify({ action: action }));
            }

            // Close all dropdowns when clicking outside
            window.addEventListener('click', function (e) {
                // 1. Status dropdown
                const container = document.getElementById('status-dropdown-container');
                const menu = document.getElementById('status-dropdown-menu');
                if (container && !container.contains(e.target)) {
                    if (menu) menu.classList.add('hidden');
                }

                // 2. Action dropdowns
                const dropdowns = document.querySelectorAll('[id^="action-dropdown-"]');
                dropdowns.forEach(menu => {
                    const itemId = menu.id.replace('action-dropdown-', '');
                    const container = document.getElementById(`action-container-${itemId}`);
                    if (container && !container.contains(e.target)) {
                        menu.classList.add('hidden');
                    }
                });
            });
        </script>
</body>

</html>