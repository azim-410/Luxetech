<!DOCTYPE html>

<html class="light" lang="en">

<head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>Luxe Tech | Orders Management</title>
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <!-- html2pdf.js for exporting PDF -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>
    <link
        href="https://fonts.googleapis.com/css2?family=Manrope:wght@200;300;400;500;600;700;800&amp;family=Inter:wght@300;400;500;600&amp;display=swap"
        rel="stylesheet" />
    <link
        href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap"
        rel="stylesheet" />
    <link
        href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap"
        rel="stylesheet" />
    <script id="tailwind-config">
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    colors: {
                        "tertiary-container": "#dbe9ff",
                        "surface-variant": "#dbe4e7",
                        "on-error-container": "#752121",
                        "on-primary-container": "#505254",
                        "on-tertiary-container": "#485668",
                        "error-dim": "#4e0309",
                        "surface-container-low": "#f1f4f6",
                        "primary-fixed": "#e2e2e5",
                        "tertiary-dim": "#465465",
                        "surface-bright": "#f8f9fa",
                        "outline-variant": "#abb3b7",
                        "on-surface": "#2b3437",
                        "on-primary-fixed": "#3e3f42",
                        "surface-container": "#eaeff1",
                        "on-tertiary-fixed": "#364455",
                        "tertiary": "#526072",
                        "background": "#f8f9fa",
                        "on-surface-variant": "#586064",
                        "tertiary-fixed-dim": "#cddbf0",
                        "surface": "#f8f9fa",
                        "inverse-primary": "#f9f9fc",
                        "on-tertiary-fixed-variant": "#526072",
                        "secondary-fixed-dim": "#bcd8ef",
                        "outline": "#737c7f",
                        "on-secondary-fixed-variant": "#445f72",
                        "on-primary-fixed-variant": "#5a5c5e",
                        "primary-dim": "#515255",
                        "tertiary-fixed": "#dbe9ff",
                        "surface-tint": "#5d5e61",
                        "primary": "#5d5e61",
                        "on-tertiary": "#f7f9ff",
                        "on-secondary": "#f5f9ff",
                        "surface-container-lowest": "#ffffff",
                        "primary-fixed-dim": "#d4d4d7",
                        "on-secondary-container": "#3a5568",
                        "surface-container-highest": "#dbe4e7",
                        "primary-container": "#e2e2e5",
                        "secondary-fixed": "#cae6fd",
                        "inverse-on-surface": "#9b9d9e",
                        "inverse-surface": "#0c0f10",
                        "secondary-container": "#cae6fd",
                        "on-secondary-fixed": "#274254",
                        "error": "#9f403d",
                        "secondary": "#476275",
                        "on-background": "#2b3437",
                        "surface-container-high": "#e3e9ec",
                        "on-primary": "#f7f7fa",
                        "on-error": "#fff7f6",
                        "error-container": "#fe8983",
                        "surface-dim": "#d1dce0",
                        "secondary-dim": "#3b5669"
                    },
                    fontFamily: {
                        "headline": ["Manrope"],
                        "body": ["Inter"],
                        "label": ["Inter"]
                    },
                    borderRadius: { "DEFAULT": "0.125rem", "lg": "0.25rem", "xl": "0.5rem", "full": "0.75rem" },
                },
            },
        }
    </script>
    <style>
        .material-symbols-outlined {
            font-variation-settings: 'FILL' 0, 'wght' 300, 'GRAD' 0, 'opsz' 24;
            vertical-align: middle;
        }

        body {
            font-family: 'Inter', sans-serif;
        }

        h1,
        h2,
        h3,
        .font-headline {
            font-family: 'Manrope', sans-serif;
        }
    </style>
</head>

<body class="bg-surface text-on-surface selection:bg-secondary-container flex min-h-screen">
    <%- include('../partials/admin/layout', { activePage: 'orders' }) %>
        <main class="ml-0 md:ml-64 flex-1 flex flex-col min-h-screen pt-16">
            <div class="px-4 sm:px-12 py-6 sm:py-10 space-y-6 sm:space-y-10 w-full flex-1">
                <div class="flex flex-col sm:flex-row justify-between items-start sm:items-end gap-4">
                    <div>
                        <nav
                            class="flex items-center gap-2 text-[10px] uppercase tracking-[0.1em] text-outline mb-2 font-bold">
                            <span>Admin</span>
                            <span class="material-symbols-outlined text-[12px]">chevron_right</span>
                            <span class="text-secondary">Orders</span>
                        </nav>
                        <h2 class="text-3xl font-extrabold tracking-tight text-on-surface">Order Management</h2>
                        <p class="text-sm text-outline font-body mt-2">Monitor and fulfill customer requests globally.
                        </p>
                    </div>
                    <button onclick="exportOrdersPDF(this)"
                        class="bg-gradient-to-br from-primary to-secondary text-on-primary px-6 py-2.5 rounded-md text-sm font-medium flex items-center gap-2 hover:-translate-y-0.5 transition-all shadow-sm">
                        <span class="material-symbols-outlined text-[18px]">file_download</span>
                        Export Orders
                    </button>
                </div>
                <!-- Data Table Container -->
                <div class="bg-surface-container-lowest rounded-xl shadow-[0_20px_40px_rgba(43,52,55,0.04)]">
                    <!-- Toolbar Section -->
                    <div class="p-6 space-y-6">
                        <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
                            <!-- Search -->
                            <div class="relative max-w-md w-full">
                                <span
                                    class="material-symbols-outlined absolute left-4 top-1/2 -translate-y-1/2 text-outline text-[20px]">search</span>
                                <input id="order-search-input"
                                    class="w-full pl-12 pr-10 py-3 bg-surface-container-highest rounded-lg text-sm border-none focus:ring-1 focus:ring-secondary/20 focus:bg-surface-container-lowest transition-all placeholder:text-outline/60"
                                    placeholder="Search orders, customers, or SKUs..." type="text" />
                                <button id="clear-search"
                                    class="hidden absolute right-3 top-1/2 -translate-y-1/2 text-outline hover:text-on-surface transition-colors">
                                    <span class="material-symbols-outlined text-[20px]">close</span>
                                </button>
                            </div>
                            <!-- Filters -->
                            <div class="flex gap-2">
                                <div class="relative inline-block text-left" id="date-range-container">
                                    <button onclick="toggleDateRangeDropdown(event)"
                                        class="px-4 py-2 bg-surface-container-low text-on-surface text-xs font-semibold rounded-full border border-outline-variant/10 hover:bg-surface-container transition-colors flex items-center gap-1.5">
                                        <span class="material-symbols-outlined text-[16px]">calendar_month</span> Date
                                        Range
                                    </button>
                                    <div id="date-range-dropdown"
                                        class="hidden absolute right-0 mt-2 p-4 w-72 rounded-md bg-white shadow-xl ring-1 ring-black ring-opacity-5 z-50 border border-outline-variant/10">
                                        <div class="space-y-4">
                                            <h4 class="text-xs font-bold text-on-surface uppercase tracking-wider">
                                                Select Date Range</h4>
                                            <div>
                                                <label
                                                    class="block text-[10px] font-bold text-outline uppercase mb-1">Start
                                                    Date</label>
                                                <input type="date" id="start-date-input"
                                                    class="w-full px-3 py-2 text-xs font-semibold rounded border border-outline-variant/20 bg-white text-on-surface focus:ring-1 focus:ring-secondary/20 outline-none" />
                                            </div>
                                            <div>
                                                <label
                                                    class="block text-[10px] font-bold text-outline uppercase mb-1">End
                                                    Date</label>
                                                <input type="date" id="end-date-input"
                                                    class="w-full px-3 py-2 text-xs font-semibold rounded border border-outline-variant/20 bg-white text-on-surface focus:ring-1 focus:ring-secondary/20 outline-none" />
                                            </div>
                                            <div class="flex justify-end gap-2 pt-2 border-t border-outline-variant/10">
                                                <button onclick="resetDateRange()"
                                                    class="px-3 py-1.5 text-xs font-semibold text-outline hover:text-on-surface transition-colors">Reset</button>
                                                <button onclick="applyDateRange()"
                                                    class="px-3 py-1.5 text-xs font-semibold bg-on-surface text-surface rounded hover:bg-on-surface/90 transition-colors">Apply</button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="relative inline-block text-left" id="sort-container">
                                    <button onclick="toggleSortDropdown(event)"
                                        class="px-4 py-2 bg-surface-container-low text-on-surface text-xs font-semibold rounded-full border border-outline-variant/10 hover:bg-surface-container transition-colors flex items-center gap-1.5">
                                        <span class="material-symbols-outlined text-[16px]">sort</span>
                                        Sort
                                    </button>
                                    <div id="sort-dropdown"
                                        class="hidden absolute right-0 mt-2 py-2 w-52 rounded-md bg-white shadow-xl ring-1 ring-black ring-opacity-5 z-50 border border-outline-variant/10">
                                        <div class="flex flex-col">
                                            <a href="/admin/order-management?page=<%= currentPage %>&sort=date-desc"
                                                class="px-4 py-2.5 text-xs font-semibold hover:bg-surface-container transition-colors flex items-center justify-between <%= sort === 'date-desc' ? 'text-secondary bg-surface-container/50' : 'text-on-surface' %>">
                                                <span>Date: Newest to Oldest</span>
                                                <% if (sort === 'date-desc') { %>
                                                    <span class="material-symbols-outlined text-[14px]">check</span>
                                                <% } %>
                                            </a>
                                            <a href="/admin/order-management?page=<%= currentPage %>&sort=date-asc"
                                                class="px-4 py-2.5 text-xs font-semibold hover:bg-surface-container transition-colors flex items-center justify-between <%= sort === 'date-asc' ? 'text-secondary bg-surface-container/50' : 'text-on-surface' %>">
                                                <span>Date: Oldest to Newest</span>
                                                <% if (sort === 'date-asc') { %>
                                                    <span class="material-symbols-outlined text-[14px]">check</span>
                                                <% } %>
                                            </a>
                                            <a href="/admin/order-management?page=<%= currentPage %>&sort=price-desc"
                                                class="px-4 py-2.5 text-xs font-semibold hover:bg-surface-container transition-colors flex items-center justify-between <%= sort === 'price-desc' ? 'text-secondary bg-surface-container/50' : 'text-on-surface' %>">
                                                <span>Price: High to Low</span>
                                                <% if (sort === 'price-desc') { %>
                                                    <span class="material-symbols-outlined text-[14px]">check</span>
                                                <% } %>
                                            </a>
                                            <a href="/admin/order-management?page=<%= currentPage %>&sort=price-asc"
                                                class="px-4 py-2.5 text-xs font-semibold hover:bg-surface-container transition-colors flex items-center justify-between <%= sort === 'price-asc' ? 'text-secondary bg-surface-container/50' : 'text-on-surface' %>">
                                                <span>Price: Low to High</span>
                                                <% if (sort === 'price-asc') { %>
                                                    <span class="material-symbols-outlined text-[14px]">check</span>
                                                <% } %>
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <!-- Status Tabs -->
                        <div class="flex items-center gap-8 border-b border-outline-variant/10">
                            <button
                                class="status-tab pb-4 text-sm font-semibold text-on-surface border-b-2 border-on-surface -mb-[1px]">All
                                Orders</button>
                            <button
                                class="status-tab pb-4 text-sm font-medium text-outline hover:text-on-surface transition-colors">Pending</button>
                            <button
                                class="status-tab pb-4 text-sm font-medium text-outline hover:text-on-surface transition-colors">Processing</button>
                            <button
                                class="status-tab pb-4 text-sm font-medium text-outline hover:text-on-surface transition-colors">Shipped</button>
                            <button
                                class="status-tab pb-4 text-sm font-medium text-outline hover:text-on-surface transition-colors">Delivered</button>
                            <button
                                class="status-tab pb-4 text-sm font-medium text-outline hover:text-on-surface transition-colors">Cancelled</button>
                            <button
                                class="status-tab pb-4 text-sm font-medium text-outline hover:text-on-surface transition-colors">Returned</button>
                            <button
                                class="status-tab pb-4 text-sm font-medium text-outline hover:text-on-surface transition-colors">Return Requested</button>
                            <button
                                class="status-tab pb-4 text-sm font-medium text-outline hover:text-on-surface transition-colors">Return Confirmed</button>
                        </div>
                    </div>
                    <!-- Table -->
                    <div class="overflow-x-auto rounded-b-xl">
                        <table class="w-full text-left border-collapse">
                            <thead>
                                <tr class="bg-surface-container-low/50">
                                    <th class="px-6 py-4 text-[11px] font-bold uppercase tracking-wider text-outline">
                                        Order ID</th>
                                    <th class="px-6 py-4 text-[11px] font-bold uppercase tracking-wider text-outline">
                                        Customer</th>
                                    <th class="px-6 py-4 text-[11px] font-bold uppercase tracking-wider text-outline">
                                        Date</th>
                                    <th class="px-6 py-4 text-[11px] font-bold uppercase tracking-wider text-outline">
                                        Payment Status</th>
                                    <th class="px-6 py-4 text-[11px] font-bold uppercase tracking-wider text-outline">
                                        Order Status</th>
                                    <th class="px-6 py-4 text-[11px] font-bold uppercase tracking-wider text-outline">
                                        Total</th>
                                    <th
                                        class="px-6 py-4 text-[11px] font-bold uppercase tracking-wider text-outline text-right">
                                        Actions</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-outline-variant/5">
                                <% let count = 0; %>
                                <% if (orders && orders.length> 0) { %>
                                    <% orders.forEach(function(order) { %>
                                        <% count++; %>
                                        <tr class="group hover:bg-surface-container-low/30 transition-colors">
                                            <td class="px-6 py-5">
                                                <a href="/admin/order-management/details/<%= order._id %>" class="text-sm font-semibold text-on-surface hover:text-secondary">#<%= order.orderId %></a>
                                            </td>
                                            <td class="px-6 py-5">
                                                <div class="flex flex-col">
                                                    <span class="text-sm font-medium text-on-surface">
                                                        <%= order.shippingAddress.fullName %>
                                                    </span>
                                                    <span class="text-xs text-outline font-body">
                                                        <%= order.userId ? order.userId.email : "" %>
                                                    </span>
                                                </div>
                                            </td>
                                            <td class="px-6 py-5 text-sm text-outline">
                                                <%= new Date(order.createdAt).toLocaleDateString('en-US', {
                                                    month: 'short' , day: 'numeric' , year: 'numeric' }) %>
                                            </td>
                                            <td class="px-6 py-5">
                                                <% if (order.paymentStatus==='Paid' ) { %>
                                                    <span
                                                        class="px-2.5 py-1 rounded-full text-[11px] font-bold uppercase tracking-wide bg-tertiary-container text-on-tertiary-container">Paid</span>
                                                    <% } else if (order.paymentStatus==='Pending' ) { %>
                                                        <span
                                                            class="px-2.5 py-1 rounded-full text-[11px] font-bold uppercase tracking-wide bg-surface-variant text-on-surface-variant">Pending</span>
                                                        <% } else if (order.paymentStatus==='Failed' ||
                                                            order.paymentStatus==='Refunded' ) { %>
                                                            <span
                                                                class="px-2.5 py-1 rounded-full text-[11px] font-bold uppercase tracking-wide bg-error-container/20 text-on-error-container">
                                                                <%= order.paymentStatus %>
                                                            </span>
                                                            <% } else { %>
                                                                <span
                                                                    class="px-2.5 py-1 rounded-full text-[11px] font-bold uppercase tracking-wide bg-surface-variant text-on-surface-variant">
                                                                    <%= order.paymentStatus %>
                                                                </span>
                                                                <% } %>
                                            </td>
                                            <td class="px-6 py-5">
                                                <% let dotColor='bg-outline' ; let textColor='text-outline' ; 
                                                    if (['Shipped', 'Delivered'].includes(order.orderStatus)) {
                                                        dotColor='bg-secondary' ; textColor='text-on-secondary-container' ;
                                                    } else if (['Cancelled', 'Returned', 'Return Confirmed'].includes(order.orderStatus)) {
                                                        dotColor='bg-error' ; textColor='text-error' ; 
                                                    } else if (order.orderStatus === 'Return Requested') {
                                                        dotColor='bg-amber-500' ; textColor='text-amber-700' ;
                                                    } else if (order.orderStatus === 'Replacement Confirmed') {
                                                        dotColor='bg-blue-500' ; textColor='text-blue-700' ;
                                                    } %>
                                                    <span
                                                        class="flex items-center gap-1.5 text-sm <%= textColor %> font-medium">
                                                        <span class="w-2 h-2 rounded-full <%= dotColor %>"></span>
                                                        <%= order.orderStatus %>
                                                    </span>
                                            </td>
                                            <td class="px-6 py-5 text-sm font-semibold text-on-surface">₹<%=
                                                    order.pricing.grandTotal.toFixed(2) %>
                                            </td>
                                            <td class="px-6 py-5 text-right">
                                                <a href="/admin/order-management/details/<%= order._id %>"
                                                    class="p-2 hover:bg-surface-container-highest rounded transition-colors inline-block">
                                                    <span
                                                        class="material-symbols-outlined text-[20px] text-outline">visibility</span>
                                                </a>
                                            </td>
                                        </tr>
                                        <% }); %>
                                            <% } else { %>
                                                <tr>
                                                    <td colspan="7"
                                                        class="px-6 py-10 text-center text-sm text-outline font-medium">
                                                        No orders found in the database.
                                                    </td>
                                                </tr>
                                                <% } %>
                            </tbody>
                        </table>
                    </div>
                    <!-- Pagination -->
                    <div class="px-6 py-6 border-t border-outline-variant/10 flex items-center justify-between">
                        <p class="text-[10px] sm:text-xs text-outline font-medium uppercase tracking-wider">
                            Showing <span id="visible-count" class="text-on-surface font-bold"><%= count %></span> of <span id="total-count" class="text-on-surface font-bold"><%= totalOrders || 0 %></span> results
                        </p>
                        <div class="flex gap-1.5 items-center">
                            <% if (currentPage > 1) { %>
                                <a href="/admin/order-management?page=<%= currentPage - 1 %>&status=<%= locals.status || 'all' %>&search=<%= locals.search || '' %>&sort=<%= locals.sort || 'date-desc' %>"
                                    class="w-8 h-8 flex items-center justify-center rounded border border-outline-variant/20 text-outline hover:bg-surface-container transition-all">
                                    <span class="material-symbols-outlined text-[18px]">chevron_left</span>
                                </a>
                                <% } else { %>
                                    <span
                                        class="w-8 h-8 flex items-center justify-center rounded border border-outline-variant/20 text-outline opacity-30 cursor-not-allowed">
                                        <span class="material-symbols-outlined text-[18px]">chevron_left</span>
                                    </span>
                                    <% } %>

                                        <% for (let i = 1; i <= (totalPage || 1); i++) { %>
                                            <% if (i === currentPage) { %>
                                                <span
                                                    class="w-8 h-8 flex items-center justify-center rounded bg-on-surface text-surface text-xs font-bold shadow-sm">
                                                    <%= i %>
                                                </span>
                                                <% } else { %>
                                                    <a href="/admin/order-management?page=<%= i %>&status=<%= locals.status || 'all' %>&search=<%= locals.search || '' %>&sort=<%= locals.sort || 'date-desc' %>"
                                                        class="w-8 h-8 flex items-center justify-center rounded border border-outline-variant/20 text-outline hover:bg-surface-container text-xs font-semibold transition-all">
                                                        <%= i %>
                                                    </a>
                                                    <% } %>
                                                        <% } %>

                                                            <% if (currentPage < totalPage) { %>
                                                                <a href="/admin/order-management?page=<%= currentPage + 1 %>&status=<%= locals.status || 'all' %>&search=<%= locals.search || '' %>&sort=<%= locals.sort || 'date-desc' %>"
                                                                    class="w-8 h-8 flex items-center justify-center rounded border border-outline-variant/20 text-outline hover:bg-surface-container transition-all">
                                                                    <span
                                                                        class="material-symbols-outlined text-[18px]">chevron_right</span>
                                                                </a>
                                                                <% } else { %>
                                                                    <span
                                                                        class="w-8 h-8 flex items-center justify-center rounded border border-outline-variant/20 text-outline opacity-30 cursor-not-allowed">
                                                                        <span
                                                                            class="material-symbols-outlined text-[18px]">chevron_right</span>
                                                                    </span>
                                                                    <% } %>
                        </div>
                    </div>
                </div>
            </div>
        </main>
        <script>
            /**
             * Luxe Tech - Order Management Filter & Search System
             * 
             * This script handles real-time search, date range filtering, and order status tabs.
             * It is written with detailed explanations to be beginner-friendly.
             */

            // 1. GLOBAL STATE VARIABLES FOR DATE RANGE FILTERING
            // These variables store the JavaScript Date objects selected by the user.
            // They are defined globally so they can be accessed by both the date buttons and the filter function.
            let startDateFilter = null;
            let endDateFilter = null;

            /**
             * Toggles the visibility of the Date Range dropdown menu.
             * @param {Event} event - The browser click event object.
             */
            function toggleDateRangeDropdown(event) {
                // Stop the click from bubbling up to the window (which would immediately close the dropdown)
                event.stopPropagation();

                const dropdown = document.getElementById('date-range-dropdown');
                const sortDropdown = document.getElementById('sort-dropdown');
                dropdown.classList.toggle('hidden');
                if (sortDropdown) sortDropdown.classList.add('hidden');
            }

            function toggleSortDropdown(event) {
                event.stopPropagation();

                const dropdown = document.getElementById('sort-dropdown');
                const dateDropdown = document.getElementById('date-range-dropdown');
                dropdown.classList.toggle('hidden');
                if (dateDropdown) dateDropdown.classList.add('hidden');
            }

            /**
             * Reads the start and end dates from the input fields, parses them,
             * and triggers the table filtering.
             */
            function applyDateRange() {
                // Get the string values from the HTML date inputs (e.g. "2023-10-12")
                const startVal = document.getElementById('start-date-input').value;
                const endVal = document.getElementById('end-date-input').value;

                // Convert string inputs into Date objects (or null if empty)
                startDateFilter = startVal ? new Date(startVal) : null;
                endDateFilter = endVal ? new Date(endVal) : null;

                // Adjust start date to the very beginning of that day (00:00:00)
                if (startDateFilter) {
                    startDateFilter.setHours(0, 0, 0, 0);
                }
                // Adjust end date to the very end of that day (23:59:59)
                if (endDateFilter) {
                    endDateFilter.setHours(23, 59, 59, 999);
                }

                // Hide the dropdown menu
                document.getElementById('date-range-dropdown').classList.add('hidden');

                // Run the main filter table function
                if (window.triggerFilterTable) {
                    window.triggerFilterTable();
                }
            }

            /**
             * Clears selected dates, resets the inputs, and updates the table.
             */
            function resetDateRange() {
                // Clear input fields in the UI
                document.getElementById('start-date-input').value = '';
                document.getElementById('end-date-input').value = '';

                // Reset the global filter variables
                startDateFilter = null;
                endDateFilter = null;

                // Hide the dropdown menu
                document.getElementById('date-range-dropdown').classList.add('hidden');

                // Run the main filter table function
                if (window.triggerFilterTable) {
                    window.triggerFilterTable();
                }
            }

            // 2. WINDOW-LEVEL CLICK LISTENER
            // This event listener detects clicks anywhere on the page.
            // If the user clicks outside the date range/sort buttons or dropdowns, we hide them.
            window.addEventListener('click', function (event) {
                const dateContainer = document.getElementById('date-range-container');
                const dateDropdown = document.getElementById('date-range-dropdown');
                const sortContainer = document.getElementById('sort-container');
                const sortDropdown = document.getElementById('sort-dropdown');

                // If the click happened outside the entire date range container, hide the dropdown
                if (dateContainer && !dateContainer.contains(event.target)) {
                    dateDropdown.classList.add('hidden');
                }
                // If the click happened outside the entire sort container, hide the dropdown
                if (sortContainer && !sortContainer.contains(event.target)) {
                    sortDropdown.classList.add('hidden');
                }
            });

            // 3. DOM CONTENT LOADED - RUNS WHEN PAGE IS FULLY LOADED
            document.addEventListener('DOMContentLoaded', () => {
                // Select essential DOM elements
                const searchInput = document.getElementById('order-search-input'); // The main text search input
                const clearSearchBtn = document.getElementById('clear-search');  // The 'X' clear search button
                const tableRows = document.querySelectorAll('tbody tr');          // All rows in the table body
                const statusTabs = document.querySelectorAll('.status-tab');      // All status tab buttons at the top

                // State variable to store the currently active status tab (defaults to "All Orders")
                let currentStatus = 'All Orders';

                /**
                 * Main Filtering Logic
                 * Loops through every table row and decides whether to show or hide it based on:
                 * 1. Search Query (Order ID, Name, Email)
                 * 2. Active Status Tab
                 * 3. Selected Date Range
                 */
                function filterTable() {
                    // Get the lowercase search query typed by the user, removing extra spaces
                    const query = searchInput.value.toLowerCase().trim();
                    let visibleCount = 0;

                    // Dynamically show or hide the 'X' clear button inside the search field
                    if (query) {
                        clearSearchBtn.classList.remove('hidden');
                    } else {
                        clearSearchBtn.classList.add('hidden');
                    }

                    // Loop through each table row (representing an order)
                    tableRows.forEach(row => {
                        // Get the cells (columns) in the current row
                        const orderIdCell = row.cells[0];
                        const customerCell = row.cells[1];
                        const dateCell = row.cells[2];
                        const statusCell = row.cells[4];

                        // If the row doesn't have the expected columns, skip it
                        if (!orderIdCell || !customerCell || !statusCell) return;

                        // Extract the values from the cells and convert to lowercase for comparison
                        const orderId = orderIdCell.textContent.toLowerCase();
                        const customerName = customerCell.querySelector('.text-sm')?.textContent.toLowerCase() || '';
                        const customerEmail = customerCell.querySelector('.text-xs')?.textContent.toLowerCase() || '';
                        const orderStatus = statusCell.textContent.trim();

                        // Check if row matches search query (checks Order ID, Name, and Email)
                        const matchesSearch = orderId.includes(query) ||
                            customerName.includes(query) ||
                            customerEmail.includes(query);

                        // Check if row matches the active status tab (e.g. "Pending", "Processing", etc.)
                        const matchesStatus = currentStatus === 'All Orders' ||
                            orderStatus.toLowerCase() === currentStatus.toLowerCase();

                        // Check if row matches the selected date range
                        let matchesDate = true;
                        if (dateCell && (startDateFilter || endDateFilter)) {
                            // Parse the order date (e.g., "Oct 12, 2023") into a JS Date object
                            const orderDate = new Date(dateCell.textContent.trim());

                            // If a start date is set and order date is before it, mark as non-match
                            if (startDateFilter && orderDate < startDateFilter) {
                                matchesDate = false;
                            }
                            // If an end date is set and order date is after it, mark as non-match
                            if (endDateFilter && orderDate > endDateFilter) {
                                matchesDate = false;
                            }
                        }

                        // If the row matches ALL active filters, show it. Otherwise, hide it.
                        if (matchesSearch && matchesStatus && matchesDate) {
                            row.style.display = ''; // empty string resets display to default (table-row)
                            visibleCount++;
                        } else {
                            row.style.display = 'none'; // hides the row
                        }
                    });

                    // Update the visible count in the UI
                    const visibleCountEl = document.getElementById('visible-count');
                    if (visibleCountEl) {
                        visibleCountEl.textContent = visibleCount;
                    }
                }

                // Expose the filter function to the global window object so global click handlers can trigger it
                window.triggerFilterTable = filterTable;

                // Listen for typing input inside the search bar
                if (searchInput) {
                    searchInput.addEventListener('input', filterTable);
                }

                // Listen for clicks on the clear search button ('X')
                if (clearSearchBtn) {
                    clearSearchBtn.addEventListener('click', () => {
                        searchInput.value = ''; // Empty the input field
                        filterTable();          // Re-run the filters
                        searchInput.focus();    // Re-focus the input cursor
                    });
                }

                // Set up click listeners for each of the Status Tabs (All, Pending, Processing, etc.)
                statusTabs.forEach(tab => {
                    tab.addEventListener('click', () => {
                        // 1. Reset styling for all tabs to the inactive state (gray text, no border)
                        statusTabs.forEach(t => {
                            t.className = "status-tab pb-4 text-sm font-medium text-outline hover:text-on-surface transition-colors";
                        });

                        // 2. Set current clicked tab to active state (semibold text, bottom border)
                        tab.className = "status-tab pb-4 text-sm font-semibold text-on-surface border-b-2 border-on-surface -mb-[1px]";

                        // 3. Update the current status filter value and run the table filtering
                        currentStatus = tab.textContent.replace(/\s+/g, ' ').trim();
                        filterTable();
                    });
                });
            });

            async function exportOrdersPDF(btn) {
                const originalHTML = btn.innerHTML;
                btn.disabled = true;
                btn.innerHTML = `
                    <span class="material-symbols-outlined text-sm animate-spin">sync</span>
                    Exporting...
                `;

                try {
                    const response = await fetch('/admin/order-management/export');
                    const orders = await response.json();

                    if (!orders || orders.length === 0) {
                        alert('No order data available to export.');
                        return;
                    }

                    // Create a virtual container for styling the PDF
                    const container = document.createElement('div');
                    container.style.fontFamily = "'Inter', sans-serif";
                    container.style.color = '#1e293b';
                    container.style.padding = '40px';
                    container.style.backgroundColor = '#ffffff';

                    // Format the download date and time
                    const downloadDateTime = new Date().toLocaleString('en-US', {
                        month: 'long',
                        day: 'numeric',
                        year: 'numeric',
                        hour: '2-digit',
                        minute: '2-digit',
                        second: '2-digit',
                        hour12: true
                    });

                    // Summary statistics
                    const totalRevenue = orders.reduce((acc, o) => acc + (o.pricing?.grandTotal || 0), 0);
                    const paidCount = orders.filter(o => o.paymentStatus === 'Paid').length;
                    const nonPaidCount = orders.filter(o => o.paymentStatus !== 'Paid').length;

                    container.innerHTML = `
                        <div style="display: flex; justify-content: space-between; align-items: flex-end; border-bottom: 1.5px solid #0f172a; padding-bottom: 15px; margin-bottom: 20px;">
                            <div>
                                <h1 style="font-family: 'Manrope', sans-serif; font-size: 20px; font-weight: 800; color: #0f172a; margin: 0; letter-spacing: -0.02em;">LUXE TECH</h1>
                                <p style="font-size: 8px; text-transform: uppercase; letter-spacing: 0.1em; color: #64748b; margin: 2px 0 0 0; font-weight: 600;">Global Order Directory</p>
                            </div>
                            <div style="text-align: right; font-size: 9px; color: #475569;">
                                <span style="font-weight: 700; color: #0f172a;">Exported:</span> ${downloadDateTime}
                            </div>
                        </div>

                        <div style="display: flex; gap: 20px; margin-bottom: 25px; font-size: 10px; color: #475569; border-bottom: 1px solid #f1f5f9; padding-bottom: 12px;">
                            <div>Total Orders: <span style="font-weight: 700; color: #0f172a;">${orders.length}</span></div>
                            <div style="color: #cbd5e1;">|</div>
                            <div>Paid Orders: <span style="font-weight: 700; color: #16a34a;">${paidCount}</span></div>
                            <div style="color: #cbd5e1;">|</div>
                            <div>Non-Paid: <span style="font-weight: 700; color: #b45309;">${nonPaidCount}</span></div>
                            <div style="color: #cbd5e1;">|</div>
                            <div>Gross Revenue: <span style="font-weight: 700; color: #0f172a;">₹${totalRevenue.toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}</span></div>
                        </div>

                        <table style="width: 100%; border-collapse: collapse; text-align: left;">
                            <thead>
                                <tr style="border-bottom: 1.5px solid #0f172a;">
                                    <th style="padding: 12px 10px; font-size: 9px; font-weight: 700; text-transform: uppercase; color: #0f172a; width: 15%; text-align: left;">Order ID</th>
                                    <th style="padding: 12px 10px; font-size: 9px; font-weight: 700; text-transform: uppercase; color: #0f172a; width: 25%; text-align: left;">Customer Name</th>
                                    <th style="padding: 12px 10px; font-size: 9px; font-weight: 700; text-transform: uppercase; color: #0f172a; width: 25%; text-align: left;">Email Address</th>
                                    <th style="padding: 12px 10px; font-size: 9px; font-weight: 700; text-transform: uppercase; color: #0f172a; text-align: center; width: 13%;">Order Date</th>
                                    <th style="padding: 12px 10px; font-size: 9px; font-weight: 700; text-transform: uppercase; color: #0f172a; text-align: center; width: 10%;">Payment</th>
                                    <th style="padding: 12px 10px; font-size: 9px; font-weight: 700; text-transform: uppercase; color: #0f172a; text-align: right; width: 12%;">Total</th>
                                </tr>
                            </thead>
                            <tbody>
                                ${orders.map((o, idx) => {
                                    const oDate = new Date(o.createdAt).toLocaleDateString('en-US', {
                                        month: 'short',
                                        day: 'numeric',
                                        year: 'numeric'
                                    });
                                    const custName = o.shippingAddress?.fullName || 'N/A';
                                    const custEmail = o.userId?.email || '';
                                    const paymentStatus = o.paymentStatus || 'Pending';
                                    const grandTotal = o.pricing?.grandTotal || 0;

                                    let paymentBg = '#cbd5e1';
                                    let paymentColor = '#1e293b';
                                    if (paymentStatus === 'Paid') {
                                        paymentBg = '#dcfce7';
                                        paymentColor = '#15803d';
                                    } else if (paymentStatus === 'Failed' || paymentStatus === 'Refunded') {
                                        paymentBg = '#fee2e2';
                                        paymentColor = '#b91c1c';
                                    }

                                    const rowBg = idx % 2 === 0 ? '#ffffff' : '#f8fafc';

                                    return `
                                        <tr style="background-color: ${rowBg}; border-bottom: 1px solid #f1f5f9; page-break-inside: avoid;">
                                            <td style="padding: 12px 10px; font-size: 11px; font-weight: 700; color: #0f172a;">
                                                #${o.orderId}
                                            </td>
                                            <td style="padding: 12px 10px; font-size: 11px; font-weight: 700; color: #0f172a;">
                                                ${custName}
                                            </td>
                                            <td style="padding: 12px 10px; font-size: 10px; color: #475569;">
                                                ${custEmail}
                                            </td>
                                            <td style="padding: 12px 10px; font-size: 10px; color: #475569; text-align: center;">
                                                ${oDate}
                                            </td>
                                            <td style="padding: 12px 10px; text-align: center;">
                                                <span style="display: inline-block; padding: 2px 8px; border-radius: 4px; font-size: 8px; font-weight: 700; text-transform: uppercase; background-color: ${paymentBg}; color: ${paymentColor};">
                                                    ${paymentStatus}
                                                </span>
                                            </td>
                                            <td style="padding: 12px 10px; text-align: right; font-size: 11px; font-weight: 700; color: #0f172a;">
                                                ₹${grandTotal.toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}
                                            </td>
                                        </tr>
                                    `;
                                }).join('')}
                            </tbody>
                        </table>

                        <div style="margin-top: 40px; border-top: 1px dashed #cbd5e1; padding-top: 15px; text-align: center; page-break-inside: avoid;">
                            <p style="font-size: 8px; color: #94a3b8; margin: 0; text-transform: uppercase; letter-spacing: 0.05em;">Confidential — Luxe Tech Administration Records</p>
                            <p style="font-size: 8px; color: #94a3b8; margin: 2px 0 0 0;">Report Ref: #LTOR-${Math.floor(100000 + Math.random() * 900000)} | Generated Automatically</p>
                        </div>
                    `;

                    const opt = {
                        margin:       [15, 15, 20, 15],
                        filename:     'LuxeTech_Orders_Report.pdf',
                        image:        { type: 'jpeg', quality: 0.98 },
                        html2canvas:  { scale: 2, useCORS: true, letterRendering: true },
                        jsPDF:        { unit: 'mm', format: 'a4', orientation: 'portrait' }
                    };

                    await html2pdf().set(opt).from(container).save();

                } catch (err) {
                    console.error('Error exporting order report PDF:', err);
                    alert('An error occurred while exporting the order management report.');
                } finally {
                    btn.disabled = false;
                    btn.innerHTML = originalHTML;
                }
            }
        </script>
</body>

</html>