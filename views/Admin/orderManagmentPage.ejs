<!DOCTYPE html>

<html class="light" lang="en">

<head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>Luxe Tech | Orders Management</title>
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link
        href="https://fonts.googleapis.com/css2?family=Manrope:wght@200;300;400;500;600;700;800&amp;family=Inter:wght@300;400;500;600&amp;display=swap"
        rel="stylesheet" />
    <link
        href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap"
        rel="stylesheet" />
    <link
        href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap"
        rel="stylesheet" />
    <script id="tailwind-config">
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    colors: {
                        "tertiary-container": "#dbe9ff",
                        "surface-variant": "#dbe4e7",
                        "on-error-container": "#752121",
                        "on-primary-container": "#505254",
                        "on-tertiary-container": "#485668",
                        "error-dim": "#4e0309",
                        "surface-container-low": "#f1f4f6",
                        "primary-fixed": "#e2e2e5",
                        "tertiary-dim": "#465465",
                        "surface-bright": "#f8f9fa",
                        "outline-variant": "#abb3b7",
                        "on-surface": "#2b3437",
                        "on-primary-fixed": "#3e3f42",
                        "surface-container": "#eaeff1",
                        "on-tertiary-fixed": "#364455",
                        "tertiary": "#526072",
                        "background": "#f8f9fa",
                        "on-surface-variant": "#586064",
                        "tertiary-fixed-dim": "#cddbf0",
                        "surface": "#f8f9fa",
                        "inverse-primary": "#f9f9fc",
                        "on-tertiary-fixed-variant": "#526072",
                        "secondary-fixed-dim": "#bcd8ef",
                        "outline": "#737c7f",
                        "on-secondary-fixed-variant": "#445f72",
                        "on-primary-fixed-variant": "#5a5c5e",
                        "primary-dim": "#515255",
                        "tertiary-fixed": "#dbe9ff",
                        "surface-tint": "#5d5e61",
                        "primary": "#5d5e61",
                        "on-tertiary": "#f7f9ff",
                        "on-secondary": "#f5f9ff",
                        "surface-container-lowest": "#ffffff",
                        "primary-fixed-dim": "#d4d4d7",
                        "on-secondary-container": "#3a5568",
                        "surface-container-highest": "#dbe4e7",
                        "primary-container": "#e2e2e5",
                        "secondary-fixed": "#cae6fd",
                        "inverse-on-surface": "#9b9d9e",
                        "inverse-surface": "#0c0f10",
                        "secondary-container": "#cae6fd",
                        "on-secondary-fixed": "#274254",
                        "error": "#9f403d",
                        "secondary": "#476275",
                        "on-background": "#2b3437",
                        "surface-container-high": "#e3e9ec",
                        "on-primary": "#f7f7fa",
                        "on-error": "#fff7f6",
                        "error-container": "#fe8983",
                        "surface-dim": "#d1dce0",
                        "secondary-dim": "#3b5669"
                    },
                    fontFamily: {
                        "headline": ["Manrope"],
                        "body": ["Inter"],
                        "label": ["Inter"]
                    },
                    borderRadius: { "DEFAULT": "0.125rem", "lg": "0.25rem", "xl": "0.5rem", "full": "0.75rem" },
                },
            },
        }
    </script>
    <style>
        .material-symbols-outlined {
            font-variation-settings: 'FILL' 0, 'wght' 300, 'GRAD' 0, 'opsz' 24;
            vertical-align: middle;
        }

        body {
            font-family: 'Inter', sans-serif;
        }

        h1,
        h2,
        h3,
        .font-headline {
            font-family: 'Manrope', sans-serif;
        }
    </style>
</head>

<body class="bg-surface text-on-surface selection:bg-secondary-container flex min-h-screen">
    <%- include('../partials/admin/layout', { activePage: 'orders' }) %>
        <main class="ml-0 md:ml-64 flex-1 flex flex-col min-h-screen pt-16">
            <div class="px-4 sm:px-12 py-6 sm:py-10 space-y-6 sm:space-y-10 w-full flex-1">
                <div class="flex flex-col sm:flex-row justify-between items-start sm:items-end gap-4">
                    <div>
                        <nav
                            class="flex items-center gap-2 text-[10px] uppercase tracking-[0.1em] text-outline mb-2 font-bold">
                            <span>Admin</span>
                            <span class="material-symbols-outlined text-[12px]">chevron_right</span>
                            <span class="text-secondary">Orders</span>
                        </nav>
                        <h2 class="text-3xl font-extrabold tracking-tight text-on-surface">Order Management</h2>
                        <p class="text-sm text-outline font-body mt-2">Monitor and fulfill customer requests globally.
                        </p>
                    </div>
                    <div class="relative inline-block text-left" id="export-container">
                        <button onclick="toggleExportDropdown(event)"
                            class="bg-gradient-to-br from-primary to-secondary text-on-primary px-6 py-2.5 rounded-md text-sm font-medium flex items-center gap-2 hover:-translate-y-0.5 transition-all shadow-sm">
                            <span class="material-symbols-outlined text-[18px]">file_download</span>
                            Export Orders
                            <span class="material-symbols-outlined text-[16px] ml-1">arrow_drop_down</span>
                        </button>
                        <div id="export-dropdown"
                            class="hidden absolute right-0 mt-2 py-1 w-48 rounded-md bg-white shadow-xl ring-1 ring-black ring-opacity-5 z-50 border border-outline-variant/10">
                            <button onclick="triggerExport('pdf')"
                                class="w-full text-left px-4 py-2.5 text-sm text-on-surface hover:bg-surface-container transition-colors flex items-center gap-2">
                                <span class="material-symbols-outlined text-[18px] text-primary">picture_as_pdf</span>
                                Export as PDF
                            </button>
                            <button onclick="triggerExport('excel')"
                                class="w-full text-left px-4 py-2.5 text-sm text-on-surface hover:bg-surface-container transition-colors flex items-center gap-2">
                                <span class="material-symbols-outlined text-[18px] text-green-600">table_view</span>
                                Export as Excel
                            </button>
                        </div>
                    </div>
                </div>
                <!-- Data Table Container -->
                <div class="bg-surface-container-lowest rounded-xl shadow-[0_20px_40px_rgba(43,52,55,0.04)]">
                    <!-- Toolbar Section -->
                    <div class="p-6 space-y-6">
                        <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
                            <!-- Search -->
                            <div class="relative max-w-md w-full">
                                <span
                                    class="material-symbols-outlined absolute left-4 top-1/2 -translate-y-1/2 text-outline text-[20px]">search</span>
                                <input id="order-search-input"
                                    class="w-full pl-12 pr-10 py-3 bg-surface-container-highest rounded-lg text-sm border-none focus:ring-1 focus:ring-secondary/20 focus:bg-surface-container-lowest transition-all placeholder:text-outline/60"
                                    placeholder="Search orders, customers, or SKUs..." type="text"
                                    value="<%= search %>" />
                                <button id="clear-search"
                                    class="<%= search ? '' : 'hidden' %> absolute right-3 top-1/2 -translate-y-1/2 text-outline hover:text-on-surface transition-colors">
                                    <span class="material-symbols-outlined text-[20px]">close</span>
                                </button>
                            </div>
                            <!-- Filters -->
                            <div class="flex gap-2">
                                <div class="relative inline-block text-left" id="date-range-container">
                                    <button onclick="toggleDateRangeDropdown(event)"
                                        class="px-4 py-2 bg-surface-container-low text-on-surface text-xs font-semibold rounded-full border border-outline-variant/10 hover:bg-surface-container transition-colors flex items-center gap-1.5">
                                        <span class="material-symbols-outlined text-[16px]">calendar_month</span> Date
                                        Range
                                    </button>
                                    <div id="date-range-dropdown"
                                        class="hidden absolute right-0 mt-2 p-4 w-72 rounded-md bg-white shadow-xl ring-1 ring-black ring-opacity-5 z-50 border border-outline-variant/10">
                                        <div class="space-y-4">
                                            <h4 class="text-xs font-bold text-on-surface uppercase tracking-wider">
                                                Select Date Range</h4>
                                            <div>
                                                <label
                                                    class="block text-[10px] font-bold text-outline uppercase mb-1">Start
                                                    Date</label>
                                                <input type="date" id="start-date-input"
                                                    value="<%= startDate %>"
                                                    class="w-full px-3 py-2 text-xs font-semibold rounded border border-outline-variant/20 bg-white text-on-surface focus:ring-1 focus:ring-secondary/20 outline-none" />
                                            </div>
                                            <div>
                                                <label
                                                    class="block text-[10px] font-bold text-outline uppercase mb-1">End
                                                    Date</label>
                                                <input type="date" id="end-date-input"
                                                    value="<%= endDate %>"
                                                    class="w-full px-3 py-2 text-xs font-semibold rounded border border-outline-variant/20 bg-white text-on-surface focus:ring-1 focus:ring-secondary/20 outline-none" />
                                            </div>
                                            <div class="flex justify-end gap-2 pt-2 border-t border-outline-variant/10">
                                                <button onclick="resetDateRange()"
                                                    class="px-3 py-1.5 text-xs font-semibold text-outline hover:text-on-surface transition-colors">Reset</button>
                                                <button onclick="applyDateRange()"
                                                    class="px-3 py-1.5 text-xs font-semibold bg-on-surface text-surface rounded hover:bg-on-surface/90 transition-colors">Apply</button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="relative inline-block text-left" id="sort-container">
                                    <button onclick="toggleSortDropdown(event)"
                                        class="px-4 py-2 bg-surface-container-low text-on-surface text-xs font-semibold rounded-full border border-outline-variant/10 hover:bg-surface-container transition-colors flex items-center gap-1.5">
                                        <span class="material-symbols-outlined text-[16px]">sort</span>
                                        Sort
                                    </button>
                                    <div id="sort-dropdown"
                                        class="hidden absolute right-0 mt-2 py-2 w-52 rounded-md bg-white shadow-xl ring-1 ring-black ring-opacity-5 z-50 border border-outline-variant/10">
                                        <div class="flex flex-col">
                                            <a href="javascript:void(0)" onclick="applyFilters({ sort: 'date-desc' })"
                                                class="px-4 py-2.5 text-xs font-semibold hover:bg-surface-container transition-colors flex items-center justify-between <%= sort === 'date-desc' ? 'text-secondary bg-surface-container/50' : 'text-on-surface' %>">
                                                <span>Date: Newest to Oldest</span>
                                                <% if (sort==='date-desc' ) { %>
                                                    <span class="material-symbols-outlined text-[14px]">check</span>
                                                    <% } %>
                                            </a>
                                            <a href="javascript:void(0)" onclick="applyFilters({ sort: 'date-asc' })"
                                                class="px-4 py-2.5 text-xs font-semibold hover:bg-surface-container transition-colors flex items-center justify-between <%= sort === 'date-asc' ? 'text-secondary bg-surface-container/50' : 'text-on-surface' %>">
                                                <span>Date: Oldest to Newest</span>
                                                <% if (sort==='date-asc' ) { %>
                                                    <span class="material-symbols-outlined text-[14px]">check</span>
                                                    <% } %>
                                            </a>
                                            <a href="javascript:void(0)" onclick="applyFilters({ sort: 'price-desc' })"
                                                class="px-4 py-2.5 text-xs font-semibold hover:bg-surface-container transition-colors flex items-center justify-between <%= sort === 'price-desc' ? 'text-secondary bg-surface-container/50' : 'text-on-surface' %>">
                                                <span>Price: High to Low</span>
                                                <% if (sort==='price-desc' ) { %>
                                                    <span class="material-symbols-outlined text-[14px]">check</span>
                                                    <% } %>
                                            </a>
                                            <a href="javascript:void(0)" onclick="applyFilters({ sort: 'price-asc' })"
                                                class="px-4 py-2.5 text-xs font-semibold hover:bg-surface-container transition-colors flex items-center justify-between <%= sort === 'price-asc' ? 'text-secondary bg-surface-container/50' : 'text-on-surface' %>">
                                                <span>Price: Low to High</span>
                                                <% if (sort==='price-asc' ) { %>
                                                    <span class="material-symbols-outlined text-[14px]">check</span>
                                                    <% } %>
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <!-- Status Tabs -->
                        <div class="flex items-center gap-8 border-b border-outline-variant/10">
                            <button onclick="applyFilters({ status: 'all' })"
                                class="status-tab pb-4 text-sm <%= status === 'all' ? 'font-semibold text-on-surface border-b-2 border-on-surface -mb-[1px]' : 'font-medium text-outline hover:text-on-surface transition-colors' %>">All
                                Orders</button>
                            <button onclick="applyFilters({ status: 'Pending' })"
                                class="status-tab pb-4 text-sm <%= status === 'Pending' ? 'font-semibold text-on-surface border-b-2 border-on-surface -mb-[1px]' : 'font-medium text-outline hover:text-on-surface transition-colors' %>">Pending</button>
                            <button onclick="applyFilters({ status: 'Processing' })"
                                class="status-tab pb-4 text-sm <%= status === 'Processing' ? 'font-semibold text-on-surface border-b-2 border-on-surface -mb-[1px]' : 'font-medium text-outline hover:text-on-surface transition-colors' %>">Processing</button>
                            <button onclick="applyFilters({ status: 'Shipped' })"
                                class="status-tab pb-4 text-sm <%= status === 'Shipped' ? 'font-semibold text-on-surface border-b-2 border-on-surface -mb-[1px]' : 'font-medium text-outline hover:text-on-surface transition-colors' %>">Shipped</button>
                            <button onclick="applyFilters({ status: 'Delivered' })"
                                class="status-tab pb-4 text-sm <%= status === 'Delivered' ? 'font-semibold text-on-surface border-b-2 border-on-surface -mb-[1px]' : 'font-medium text-outline hover:text-on-surface transition-colors' %>">Delivered</button>
                            <button onclick="applyFilters({ status: 'Cancelled' })"
                                class="status-tab pb-4 text-sm <%= status === 'Cancelled' ? 'font-semibold text-on-surface border-b-2 border-on-surface -mb-[1px]' : 'font-medium text-outline hover:text-on-surface transition-colors' %>">Cancelled</button>
                            <button onclick="applyFilters({ status: 'Returned' })"
                                class="status-tab pb-4 text-sm <%= status === 'Returned' ? 'font-semibold text-on-surface border-b-2 border-on-surface -mb-[1px]' : 'font-medium text-outline hover:text-on-surface transition-colors' %>">Returned</button>
                            <button onclick="applyFilters({ status: 'Return Requested' })"
                                class="status-tab pb-4 text-sm <%= status === 'Return Requested' ? 'font-semibold text-on-surface border-b-2 border-on-surface -mb-[1px]' : 'font-medium text-outline hover:text-on-surface transition-colors' %>">Return
                                Requested</button>
                            <button onclick="applyFilters({ status: 'Return Confirmed' })"
                                class="status-tab pb-4 text-sm <%= status === 'Return Confirmed' ? 'font-semibold text-on-surface border-b-2 border-on-surface -mb-[1px]' : 'font-medium text-outline hover:text-on-surface transition-colors' %>">Return
                                Confirmed</button>
                        </div>
                    </div>
                    <!-- Table -->
                    <div class="overflow-x-auto rounded-b-xl">
                        <table class="w-full text-left border-collapse">
                            <thead>
                                <tr class="bg-surface-container-low/50">
                                    <th class="px-6 py-4 text-[11px] font-bold uppercase tracking-wider text-outline">
                                        Order ID</th>
                                    <th class="px-6 py-4 text-[11px] font-bold uppercase tracking-wider text-outline">
                                        Customer</th>
                                    <th class="px-6 py-4 text-[11px] font-bold uppercase tracking-wider text-outline">
                                        Date</th>
                                    <th class="px-6 py-4 text-[11px] font-bold uppercase tracking-wider text-outline">
                                        Payment Status</th>
                                    <th class="px-6 py-4 text-[11px] font-bold uppercase tracking-wider text-outline">
                                        Order Status</th>
                                    <th class="px-6 py-4 text-[11px] font-bold uppercase tracking-wider text-outline">
                                        Total</th>
                                    <th
                                        class="px-6 py-4 text-[11px] font-bold uppercase tracking-wider text-outline text-right">
                                        Actions</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-outline-variant/5">
                                <% let count=0; %>
                                    <% if (orders && orders.length> 0) { %>
                                        <% orders.forEach(function(order) { %>
                                            <% count++; 
                                                let oRefunded = 0;
                                                order.items.forEach(function(item) {
                                                    if (item.status === 'Cancelled' || item.status === 'Return Confirmed' || item.status === 'Returned') {
                                                        oRefunded += item.subtotal;
                                                    }
                                                });
                                                let finalGrandTotal = order.pricing.grandTotal - oRefunded;
                                             %>
                                                <tr class="group hover:bg-surface-container-low/30 transition-colors">
                                                    <td class="px-6 py-5">
                                                        <a href="/admin/order-management/details/<%= order._id %>"
                                                            class="text-sm font-semibold text-on-surface hover:text-secondary">#
                                                            <%= order.orderId %></a>
                                                    </td>
                                                    <td class="px-6 py-5">
                                                        <div class="flex flex-col">
                                                            <span class="text-sm font-medium text-on-surface">
                                                                <%= order.shippingAddress.fullName %>
                                                            </span>
                                                            <span class="text-xs text-outline font-body">
                                                                <%= order.userId ? order.userId.email : "" %>
                                                            </span>
                                                        </div>
                                                    </td>
                                                    <td class="px-6 py-5 text-sm text-outline">
                                                        <%= new Date(order.createdAt).toLocaleDateString('en-US', {
                                                            month: 'short' , day: 'numeric' , year: 'numeric' }) %>
                                                    </td>
                                                    <td class="px-6 py-5">
                                                        <% if (order.paymentStatus==='Paid' ) { %>
                                                            <span
                                                                class="px-2.5 py-1 rounded-full text-[11px] font-bold uppercase tracking-wide bg-tertiary-container text-on-tertiary-container">Paid</span>
                                                            <% } else if (order.paymentStatus==='Pending' ) { %>
                                                                <span
                                                                    class="px-2.5 py-1 rounded-full text-[11px] font-bold uppercase tracking-wide bg-surface-variant text-on-surface-variant">Pending</span>
                                                                <% } else if (order.paymentStatus==='Failed' ||
                                                                    order.paymentStatus==='Refunded' ) { %>
                                                                    <span
                                                                        class="px-2.5 py-1 rounded-full text-[11px] font-bold uppercase tracking-wide bg-error-container/20 text-on-error-container">
                                                                        <%= order.paymentStatus %>
                                                                    </span>
                                                                    <% } else { %>
                                                                        <span
                                                                            class="px-2.5 py-1 rounded-full text-[11px] font-bold uppercase tracking-wide bg-surface-variant text-on-surface-variant">
                                                                            <%= order.paymentStatus %>
                                                                        </span>
                                                                        <% } %>
                                                    </td>
                                                    <td class="px-6 py-5">
                                                        <% let dotColor='bg-outline' ; let textColor='text-outline' ; if
                                                            (['Shipped', 'Delivered' ].includes(order.orderStatus)) {
                                                            dotColor='bg-secondary' ;
                                                            textColor='text-on-secondary-container' ; } else if
                                                            (['Cancelled', 'Returned' , 'Return Confirmed'
                                                            ].includes(order.orderStatus)) { dotColor='bg-error' ;
                                                            textColor='text-error' ; } else if
                                                            (order.orderStatus==='Return Requested' ) {
                                                            dotColor='bg-amber-500' ; textColor='text-amber-700' ; }
                                                            else if (order.orderStatus==='Replacement Confirmed' ) {
                                                            dotColor='bg-blue-500' ; textColor='text-blue-700' ; } %>
                                                            <span
                                                                class="flex items-center gap-1.5 text-sm <%= textColor %> font-medium">
                                                                <span
                                                                    class="w-2 h-2 rounded-full <%= dotColor %>"></span>
                                                                <%= order.orderStatus %>
                                                            </span>
                                                    </td>
                                                    <td class="px-6 py-5 text-sm font-semibold text-on-surface">₹<%=
                                                            finalGrandTotal.toFixed(2) %>
                                                    </td>
                                                    <td class="px-6 py-5 text-right">
                                                        <a href="/admin/order-management/details/<%= order._id %>"
                                                            class="p-2 hover:bg-surface-container-highest rounded transition-colors inline-block">
                                                            <span
                                                                class="material-symbols-outlined text-[20px] text-outline">visibility</span>
                                                        </a>
                                                    </td>
                                                </tr>
                                                <% }); %>
                                                    <% } else { %>
                                                        <tr>
                                                            <td colspan="7"
                                                                class="px-6 py-10 text-center text-sm text-outline font-medium">
                                                                No orders found in the database.
                                                            </td>
                                                        </tr>
                                                        <% } %>
                            </tbody>
                        </table>
                    </div>
                    <!-- Pagination -->
                    <div class="px-6 py-6 border-t border-outline-variant/10 flex items-center justify-between">
                        <p class="text-[10px] sm:text-xs text-outline font-medium uppercase tracking-wider">
                            Showing <span id="visible-count" class="text-on-surface font-bold">
                                <%= count %>
                            </span> of <span id="total-count" class="text-on-surface font-bold">
                                <%= totalOrders || 0 %>
                            </span> results
                        </p>
                        <div class="flex gap-1.5 items-center">
                            <% if (currentPage> 1) { %>
                                <a href="javascript:void(0)" onclick="applyFilters({ page: <%= currentPage - 1 %> })"
                                    class="w-8 h-8 flex items-center justify-center rounded border border-outline-variant/20 text-outline hover:bg-surface-container transition-all">
                                    <span class="material-symbols-outlined text-[18px]">chevron_left</span>
                                </a>
                                <% } else { %>
                                    <span
                                        class="w-8 h-8 flex items-center justify-center rounded border border-outline-variant/20 text-outline opacity-30 cursor-not-allowed">
                                        <span class="material-symbols-outlined text-[18px]">chevron_left</span>
                                    </span>
                                    <% } %>

                                        <% for (let i=1; i <=(totalPage || 1); i++) { %>
                                            <% if (i===currentPage) { %>
                                                <span
                                                    class="w-8 h-8 flex items-center justify-center rounded bg-on-surface text-surface text-xs font-bold shadow-sm">
                                                    <%= i %>
                                                </span>
                                                <% } else { %>
                                                    <a href="javascript:void(0)" onclick="applyFilters({ page: <%= i %> })"
                                                        class="w-8 h-8 flex items-center justify-center rounded border border-outline-variant/20 text-outline hover:bg-surface-container text-xs font-semibold transition-all">
                                                        <%= i %>
                                                    </a>
                                                    <% } %>
                                                        <% } %>

                                                            <% if (currentPage < totalPage) { %>
                                                                <a href="javascript:void(0)" onclick="applyFilters({ page: <%= currentPage + 1 %> })"
                                                                    class="w-8 h-8 flex items-center justify-center rounded border border-outline-variant/20 text-outline hover:bg-surface-container transition-all">
                                                                    <span
                                                                        class="material-symbols-outlined text-[18px]">chevron_right</span>
                                                                </a>
                                                                <% } else { %>
                                                                    <span
                                                                        class="w-8 h-8 flex items-center justify-center rounded border border-outline-variant/20 text-outline opacity-30 cursor-not-allowed">
                                                                        <span
                                                                            class="material-symbols-outlined text-[18px]">chevron_right</span>
                                                                    </span>
                                                                    <% } %>
                        </div>
                    </div>
                </div>
            </div>
        </main>
        <script>
            /**
             * Luxe Tech - Order Management Filter & Search System
             * 
            /**
             * Luxe Tech - Order Management Filter & Search System (Server-side)
             */
            function toggleExportDropdown(event) {
                event.stopPropagation();
                const dropdown = document.getElementById('export-dropdown');
                const dateDropdown = document.getElementById('date-range-dropdown');
                const sortDropdown = document.getElementById('sort-dropdown');
                dropdown.classList.toggle('hidden');
                if (dateDropdown) dateDropdown.classList.add('hidden');
                if (sortDropdown) sortDropdown.classList.add('hidden');
            }

            function toggleDateRangeDropdown(event) {
                event.stopPropagation();
                const dropdown = document.getElementById('date-range-dropdown');
                const sortDropdown = document.getElementById('sort-dropdown');
                const exportDropdown = document.getElementById('export-dropdown');
                dropdown.classList.toggle('hidden');
                if (sortDropdown) sortDropdown.classList.add('hidden');
                if (exportDropdown) exportDropdown.classList.add('hidden');
            }

            function toggleSortDropdown(event) {
                event.stopPropagation();
                const dropdown = document.getElementById('sort-dropdown');
                const dateDropdown = document.getElementById('date-range-dropdown');
                const exportDropdown = document.getElementById('export-dropdown');
                dropdown.classList.toggle('hidden');
                if (dateDropdown) dateDropdown.classList.add('hidden');
                if (exportDropdown) exportDropdown.classList.add('hidden');
            }

            window.addEventListener('click', function (event) {
                const dateContainer = document.getElementById('date-range-container');
                const dateDropdown = document.getElementById('date-range-dropdown');
                const sortContainer = document.getElementById('sort-container');
                const sortDropdown = document.getElementById('sort-dropdown');
                const exportContainer = document.getElementById('export-container');
                const exportDropdown = document.getElementById('export-dropdown');

                if (dateContainer && !dateContainer.contains(event.target)) {
                    dateDropdown.classList.add('hidden');
                }
                if (sortContainer && !sortContainer.contains(event.target)) {
                    sortDropdown.classList.add('hidden');
                }
                if (exportContainer && !exportContainer.contains(event.target)) {
                    exportDropdown.classList.add('hidden');
                }
            });

            function applyFilters(changes = {}) {
                const params = new URLSearchParams(window.location.search);
                
                if (changes.page !== undefined) {
                    if (changes.page === 1) {
                        params.delete('page');
                    } else {
                        params.set('page', changes.page);
                    }
                } else {
                    if (changes.status !== undefined || changes.search !== undefined || changes.startDate !== undefined || changes.endDate !== undefined) {
                        params.delete('page');
                    }
                }

                if (changes.status !== undefined) {
                    if (changes.status === 'all' || !changes.status) {
                        params.delete('status');
                    } else {
                        params.set('status', changes.status);
                    }
                }

                if (changes.sort !== undefined) {
                    if (changes.sort === 'date-desc' || !changes.sort) {
                        params.delete('sort');
                    } else {
                        params.set('sort', changes.sort);
                    }
                }

                if (changes.search !== undefined) {
                    if (!changes.search.trim()) {
                        params.delete('search');
                    } else {
                        params.set('search', changes.search.trim());
                    }
                }

                if (changes.startDate !== undefined) {
                    if (!changes.startDate) {
                        params.delete('startDate');
                    } else {
                        params.set('startDate', changes.startDate);
                    }
                }

                if (changes.endDate !== undefined) {
                    if (!changes.endDate) {
                        params.delete('endDate');
                    } else {
                        params.set('endDate', changes.endDate);
                    }
                }

                window.location.href = '/admin/order-management?' + params.toString();
            }

            function applyDateRange() {
                const startVal = document.getElementById('start-date-input').value;
                const endVal = document.getElementById('end-date-input').value;
                applyFilters({ startDate: startVal, endDate: endVal });
            }

            function resetDateRange() {
                applyFilters({ startDate: '', endDate: '' });
            }

            function triggerExport(format) {
                const params = new URLSearchParams(window.location.search);
                params.set('format', format);
                window.location.href = '/admin/order-management/export?' + params.toString();
                const dropdown = document.getElementById('export-dropdown');
                if (dropdown) dropdown.classList.add('hidden');
            }

            document.addEventListener('DOMContentLoaded', () => {
                const searchInput = document.getElementById('order-search-input');
                if (searchInput) {
                    searchInput.addEventListener('keypress', function(e) {
                        if (e.key === 'Enter') {
                            applyFilters({ search: this.value });
                        }
                    });
                }
                const clearSearchBtn = document.getElementById('clear-search');
                if (clearSearchBtn) {
                    clearSearchBtn.addEventListener('click', () => {
                        applyFilters({ search: '' });
                    });
                }
            });
        </script>
</body>

</html>