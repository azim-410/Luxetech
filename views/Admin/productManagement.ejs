                    <div class="flex items-end justify-between">
                        <h3 class="text-3xl font-extrabold font-headline text-error">12</h3>
                        <span class="material-symbols-outlined text-error text-xl">warning</span>
                    </div>
                </div>
                <div class="p-6 bg-surface-container-low rounded-xl border border-secondary/10">
                    <p class="text-[10px] font-bold uppercase tracking-widest text-on-surface-variant mb-1">Total
                        Inventory Value</p>
                    <div class="flex items-end justify-between">
                        <h3 class="text-3xl font-extrabold font-headline">$1.4M</h3>
                    </div>
                </div>
            </div>
        </div>
    </main>
</body>
</html>