    <style>
        .material-symbols-outlined {
            font-variation-settings: 'FILL' 0, 'wght' 300, 'GRAD' 0, 'opsz' 24;
            vertical-align: middle;
        }

        body {
            font-family: 'Inter', sans-serif;
        }

        h1,
        h2,
        h3,
        .font-headline {
            font-family: 'Manrope', sans-serif;
        }

        .glass-header {
            background: rgba(241, 244, 246, 0.8);
            backdrop-filter: blur(20px);
        }
    </style>
</head>

<body class="bg-surface text-on-surface flex min-h-screen">
    <!-- Main Content Area -->
    <main class="ml-64 flex-1 flex flex-col min-h-screen">
        
        <!-- Product Management Canvas -->
        <div class="p-8 max-w-7xl w-full mx-auto space-y-12">
            <!-- Hero Header Section -->
            <section class="flex flex-col md:flex-row md:items-end justify-between gap-6">
                <div>
                    <h1 class="text-4xl font-extrabold font-headline tracking-tighter text-on-background">Product
                        Inventory</h1>
                    <p class="text-on-surface-variant font-body mt-2 max-w-lg">Manage your high-end electronics catalog
                        with architectural precision. Control stock, pricing, and visibility from a single interface.
                    </p>
                </div>
                <div>
                    <button
                        class="bg-gradient-to-br from-primary to-secondary text-on-primary px-6 py-3 rounded-md font-manrope font-bold text-xs uppercase tracking-widest shadow-lg shadow-primary/10 hover:-translate-y-0.5 transition-all flex items-center gap-2">
                        <span class="material-symbols-outlined text-sm">add</span>
                        Add Product
                    </button>
                </div>
            </section>
            <!-- Table & Filters Container -->
            <div class="bg-surface-container-low rounded-xl p-1">
                <div
                    class="bg-surface-container-lowest rounded-lg shadow-[0_20px_40px_rgba(43,52,55,0.06)] overflow-hidden">
                    <!-- Internal Header/Filters -->
                    <div class="px-8 py-6 flex flex-wrap items-center justify-between gap-4">
                        <div class="flex items-center gap-4">
                            <div class="flex items-center bg-surface-container px-3 py-2 rounded-md">
                                <span
                                    class="text-[11px] font-bold uppercase tracking-widest text-on-surface-variant mr-3">Filter
                                    By:</span>
                                <select
                                    class="bg-transparent border-none text-xs font-medium focus:ring-0 p-0 pr-8 text-on-surface cursor-pointer">
                                    <option>All Categories</option>
                                    <option>Monitors</option>
                                    <option>Peripherals</option>
                                    <option>Audio</option>
                                </select>
                            </div>
                            <div class="flex items-center bg-surface-container px-3 py-2 rounded-md">
                                <span
                                    class="text-[11px] font-bold uppercase tracking-widest text-on-surface-variant mr-3">Status:</span>
                                <select
                                    class="bg-transparent border-none text-xs font-medium focus:ring-0 p-0 pr-8 text-on-surface cursor-pointer">
                                    <option>Any Status</option>
                                    <option>In Stock</option>
                                    <option>Low Stock</option>
                                    <option>Out of Stock</option>
                                </select>
                            </div>
                        </div>
                        <div class="flex items-center gap-2">
                            <span
                                class="text-[10px] font-medium text-on-surface-variant uppercase tracking-normal">Showing
                                4 of 128 Products</span>
                        </div>
                    </div>
                    <!-- Products Table -->
                    <div class="overflow-x-auto">
                        <table class="w-full text-left border-collapse">
                            <thead>
                                <tr class="bg-surface-container-low/50">
                                    <th
                                        class="px-8 py-4 text-[11px] font-bold uppercase tracking-widest text-on-surface-variant">
                                        Product</th>
                                    <th
                                        class="px-8 py-4 text-[11px] font-bold uppercase tracking-widest text-on-surface-variant">
                                        Category</th>
                                    <th
                                        class="px-8 py-4 text-[11px] font-bold uppercase tracking-widest text-on-surface-variant">
                                        Price</th>
                                    <th
                                        class="px-8 py-4 text-[11px] font-bold uppercase tracking-widest text-on-surface-variant">
                                        Stock Status</th>
                                    <th
                                        class="px-8 py-4 text-[11px] font-bold uppercase tracking-widest text-on-surface-variant text-right">
                                        Actions</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-outline-variant/10">
                                <!-- Product 1 -->
                                <tr class="hover:bg-surface-container-low/30 transition-colors group">
                                    <td class="px-8 py-5">
                                        <div class="flex items-center gap-4">
                                            <div
                                                class="w-12 h-12 rounded bg-surface-container overflow-hidden flex-shrink-0">
                                                <img alt="4K Gaming Monitor"
                                                    class="w-full h-full object-cover grayscale group-hover:grayscale-0 transition-all duration-500"
                                                    data-alt="High end ultra wide computer monitor"
                                                    src="https://lh3.googleusercontent.com/aida-public/AB6AXuAnMlJo8YhMEOgb9TkWzbMEtMoqrOA1Cgd-NRr3BVGrlm-paFHUOXpT0ANmWPqW52OvQ7dIINZ1F_KKcxJVvr71cGt_N0o1dj0Nve7Yo26oLoX0RM2VPUE3Rg78pGOv4s_tukUkTRorkzKgl_40yTwcb7zGaM3J_8RO1qX2OMRFTki-NrIp3YH7l32E0yoRATGLIIdrdyafaN2SYLWfuk4vstlVgrVGLnnmkmbOBOzxfmZWz_DxuiaD3kwlVjwFMHkOlYXMX-s7Cx7h" />
                                            </div>
                                            <div>
                                                <div class="text-sm font-bold font-manrope text-on-background">4K Gaming
                                                    Monitor</div>
                                                <div
                                                    class="text-[10px] font-mono text-outline uppercase tracking-wider">
                                                    SKU: MON-4K-G-001</div>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="px-8 py-5">
                                        <span class="text-xs font-medium text-secondary">Displays</span>
                                    </td>
                                    <td class="px-8 py-5">
                                        <span class="text-sm font-bold font-manrope">$899.00</span>
                                    </td>
                                    <td class="px-8 py-5">
                                        <span
                                            class="px-3 py-1 rounded-full text-[10px] font-bold uppercase tracking-wider bg-tertiary-container text-on-tertiary-container">In
                                            Stock</span>
                                    </td>
                                    <td class="px-8 py-5 text-right">
                                        <div class="flex items-center justify-end gap-2">
                                            <button
                                                class="p-2 text-outline hover:text-primary hover:bg-surface-container rounded transition-all">
                                                <span class="material-symbols-outlined text-lg">edit</span>
                                            </button>
                                            <button
                                                class="p-2 text-outline hover:text-error hover:bg-error/5 rounded transition-all">
                                                <span class="material-symbols-outlined text-lg">delete</span>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                                <!-- Product 2 -->
                                <tr class="hover:bg-surface-container-low/30 transition-colors group">
                                    <td class="px-8 py-5">
                                        <div class="flex items-center gap-4">
                                            <div
                                                class="w-12 h-12 rounded bg-surface-container overflow-hidden flex-shrink-0">
                                                <img alt="RGB Mechanical Keyboard"
                                                    class="w-full h-full object-cover grayscale group-hover:grayscale-0 transition-all duration-500"
                                                    data-alt="Backlit mechanical keyboard with aluminum frame"
                                                    src="https://lh3.googleusercontent.com/aida-public/AB6AXuACYM_KF9oDEKhYG-m_jzKItYnT8r6ok9QQJv4qrUDCINpy6BhqMif3sO6oe5Q96HTIFqHvwxccjwPb8rcmLo80bYAbX7YaOEXrmz5s5kujOuEocRuNdu50lS1dg9uQS0wqmcw8hCL-3qC0dbJeSHLRWa8scCjYCMNV1Z2efmiZFwD8I9IBt5NgZG7WcFeCu1g7Y620UoI5rjcpwydefAfbLR5cEu4j7oNATw0eQgRmo0fG9wxrEP8oSJOcVNr10O-kePmmRvlezu9U" />
                                            </div>
                                            <div>
                                                <div class="text-sm font-bold font-manrope text-on-background">RGB
                                                    Mechanical Keyboard</div>
                                                <div
                                                    class="text-[10px] font-mono text-outline uppercase tracking-wider">
                                                    SKU: KEY-MECH-RGB-04</div>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="px-8 py-5">
                                        <span class="text-xs font-medium text-secondary">Peripherals</span>
                                    </td>
                                    <td class="px-8 py-5">
                                        <span class="text-sm font-bold font-manrope">$159.99</span>
                                    </td>
                                    <td class="px-8 py-5">
                                        <span
                                            class="px-3 py-1 rounded-full text-[10px] font-bold uppercase tracking-wider bg-surface-container-highest text-on-surface-variant">Low
                                            Stock</span>
                                    </td>
                                    <td class="px-8 py-5 text-right">
                                        <div class="flex items-center justify-end gap-2">
                                            <button
                                                class="p-2 text-outline hover:text-primary hover:bg-surface-container rounded transition-all">
                                                <span class="material-symbols-outlined text-lg">edit</span>
                                            </button>
                                            <button
                                                class="p-2 text-outline hover:text-error hover:bg-error/5 rounded transition-all">
                                                <span class="material-symbols-outlined text-lg">delete</span>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                                <!-- Product 3 -->
                                <tr class="hover:bg-surface-container-low/30 transition-colors group">
                                    <td class="px-8 py-5">
                                        <div class="flex items-center gap-4">
                                            <div
                                                class="w-12 h-12 rounded bg-surface-container overflow-hidden flex-shrink-0">
                                                <img alt="Precision Laser Mouse"
                                                    class="w-full h-full object-cover grayscale group-hover:grayscale-0 transition-all duration-500"
                                                    data-alt="Matte black ergonomic computer mouse"
                                                    src="https://lh3.googleusercontent.com/aida-public/AB6AXuBYtWm3dCNCRZFX8mRMGTVNjcCw5BvpIHVZ_0iCOy68IdiUHZgkvx4t6SVGOPIC7ZibSAMyy3TeNchWHURytOhKDfRgqzD3Duq1bx7A5SDCu1qUOPIl-cY36mU0YE61PMchM6ZW9YC2LeppA0W_h8cOtAujqTro2pbR61lJFsyRMSjOcvfl4LPvzWNtxL1QwYAjjTvSFY-6Fv_VcZ8T6i9VHcAio2mcw9SU7K5PjZxhisl6k0sWtA5nEn37OXX40eqTok5dKd8brmBm" />
                                            </div>
                                            <div>
                                                <div class="text-sm font-bold font-manrope text-on-background">Precision
                                                    Laser Mouse</div>
                                                <div
                                                    class="text-[10px] font-mono text-outline uppercase tracking-wider">
                                                    SKU: MSE-PRC-LSR-88</div>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="px-8 py-5">
                                        <span class="text-xs font-medium text-secondary">Peripherals</span>
                                    </td>
                                    <td class="px-8 py-5">
                                        <span class="text-sm font-bold font-manrope">$79.50</span>
                                    </td>
                                    <td class="px-8 py-5">
                                        <span
                                            class="px-3 py-1 rounded-full text-[10px] font-bold uppercase tracking-wider bg-tertiary-container text-on-tertiary-container">In
                                            Stock</span>
                                    </td>
                                    <td class="px-8 py-5 text-right">
                                        <div class="flex items-center justify-end gap-2">
                                            <button
                                                class="p-2 text-outline hover:text-primary hover:bg-surface-container rounded transition-all">
                                                <span class="material-symbols-outlined text-lg">edit</span>
                                            </button>
                                            <button
                                                class="p-2 text-outline hover:text-error hover:bg-error/5 rounded transition-all">
                                                <span class="material-symbols-outlined text-lg">delete</span>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                                <!-- Product 4 -->
                                <tr class="hover:bg-surface-container-low/30 transition-colors group">
                                    <td class="px-8 py-5">
                                        <div class="flex items-center gap-4">
                                            <div
                                                class="w-12 h-12 rounded bg-surface-container overflow-hidden flex-shrink-0">
                                                <img alt="Noise-Cancelling Headset"
                                                    class="w-full h-full object-cover grayscale group-hover:grayscale-0 transition-all duration-500"
                                                    data-alt="Premium wireless headphones over ear"
                                                    src="https://lh3.googleusercontent.com/aida-public/AB6AXuDzSW36EQkXE-rXDNhpegYeNfiQhc3l1YG7v4vwmPhu02UN9nKMBIAJ3mpQalEKqvkqxJgQUSX4XchpeAu6OsJtOyKNFt6SKUDOHcvCgBElDBUXeNjEzELMcr6EHQOyiOolZLJvI03c_SPTBDAnWDnnNvvBlmWUcnhAvLeEzOZQUyvFQQIz8cPgmUn1Qu-YtwQunDkLZrQucYRrmoy_58BChaIrP7ssZy_w4dJyQ6Y_M-2WsR9IqNebZhE5pZ5ZbtC_QetaNx1kd4gR" />
                                            </div>
                                            <div>
                                                <div class="text-sm font-bold font-manrope text-on-background">
                                                    Noise-Cancelling Headset</div>
                                                <div
                                                    class="text-[10px] font-mono text-outline uppercase tracking-wider">
                                                    SKU: AUD-NCH-900-X</div>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="px-8 py-5">
                                        <span class="text-xs font-medium text-secondary">Audio</span>
                                    </td>
                                    <td class="px-8 py-5">
                                        <span class="text-sm font-bold font-manrope">$329.00</span>
                                    </td>
                                    <td class="px-8 py-5">
                                        <span
                                            class="px-3 py-1 rounded-full text-[10px] font-bold uppercase tracking-wider bg-error-container text-on-error-container">Out
                                            of Stock</span>
                                    </td>
                                    <td class="px-8 py-5 text-right">
                                        <div class="flex items-center justify-end gap-2">
                                            <button
                                                class="p-2 text-outline hover:text-primary hover:bg-surface-container rounded transition-all">
                                                <span class="material-symbols-outlined text-lg">edit</span>
                                            </button>
                                            <button
                                                class="p-2 text-outline hover:text-error hover:bg-error/5 rounded transition-all">
                                                <span class="material-symbols-outlined text-lg">delete</span>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                    <!-- Pagination -->
                    <div class="px-8 py-6 flex items-center justify-between border-t border-outline-variant/10">
                        <div class="text-xs text-on-surface-variant font-medium">
                            Showing <span class="text-on-surface font-bold">1 to 4</span> of <span
                                class="text-on-surface font-bold">128</span> entries
                        </div>
                        <div class="flex items-center gap-1">
                            <button
                                class="w-8 h-8 flex items-center justify-center rounded border border-outline-variant/20 text-outline hover:bg-surface-container-low">
                                <span class="material-symbols-outlined text-sm">chevron_left</span>
                            </button>
                            <button
                                class="w-8 h-8 flex items-center justify-center rounded bg-primary text-on-primary text-xs font-bold shadow-sm">1</button>
                            <button
                                class="w-8 h-8 flex items-center justify-center rounded border border-outline-variant/20 text-outline hover:bg-surface-container-low text-xs font-medium">2</button>
                                <button
                                class="w-8 h-8 flex items-center justify-center rounded border border-outline-variant/20 text-outline hover:bg-surface-container-low">
                                <span class="material-symbols-outlined text-sm">chevron_right</span>
                            </button> 
                        </div>
                    </div>
                </div>
            </div>
            <!-- Dashboard Analytics Quick-View (Bento Grid Style) -->
            <div class="grid grid-cols-1 md:grid-cols-3 gap-6 pb-12">
                <div class="p-6 bg-surface-container-low rounded-xl">
                    <p class="text-[10px] font-bold uppercase tracking-widest text-on-surface-variant mb-1">Total
                        Categories</p>
                    <div class="flex items-end justify-between">
                        <h3 class="text-3xl font-extrabold font-headline">24</h3>
                    </div>
                </div>
                <div class="p-6 bg-surface-container-low rounded-xl">
                    <p class="text-[10px] font-bold uppercase tracking-widest text-on-surface-variant mb-1">Low Stock
