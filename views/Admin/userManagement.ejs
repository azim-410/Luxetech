<!DOCTYPE html>

<html class="light" lang="en">

<head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>Customer List | Luxe Tech</title>
    <!-- html2pdf.js for exporting PDF -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>
    <!-- Google Fonts: Manrope & Inter -->
    <link
        href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&amp;family=Manrope:wght@600;700;800&amp;display=swap"
        rel="stylesheet" />
    <!-- Material Symbols Outlined -->
    <link
        href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap"
        rel="stylesheet" />
    <link
        href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap"
        rel="stylesheet" />
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <script id="tailwind-config">
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    colors: {
                        "inverse-on-surface": "#9b9d9e",
                        "tertiary-fixed": "#dbe9ff",
                        "tertiary-fixed-dim": "#cddbf0",
                        "on-secondary": "#f5f9ff",
                        "tertiary-container": "#dbe9ff",
                        "on-tertiary-container": "#485668",
                        "on-tertiary": "#f7f9ff",
                        "on-primary-fixed": "#3e3f42",
                        "error-dim": "#4e0309",
                        "surface": "#f8f9fa",
                        "secondary": "#476275",
                        "inverse-surface": "#0c0f10",
                        "on-background": "#2b3437",
                        "on-tertiary-fixed": "#364455",
                        "on-primary": "#f7f7fa",
                        "on-secondary-fixed": "#274254",
                        "on-secondary-fixed-variant": "#445f72",
                        "tertiary-dim": "#465465",
                        "outline": "#737c7f",
                        "surface-bright": "#f8f9fa",
                        "secondary-dim": "#3b5669",
                        "primary-container": "#e2e2e5",
                        "surface-container-lowest": "#ffffff",
                        "primary": "#5d5e61",
                        "secondary-fixed-dim": "#bcd8ef",
                        "outline-variant": "#abb3b7",
                        "secondary-container": "#cae6fd",
                        "surface-container-highest": "#dbe4e7",
                        "on-primary-container": "#505254",
                        "tertiary": "#526072",
                        "error": "#9f403d",
                        "on-tertiary-fixed-variant": "#526072",
                        "on-surface-variant": "#586064",
                        "background": "#f8f9fa",
                        "surface-tint": "#5d5e61",
                        "error-container": "#fe8983",
                        "on-error": "#fff7f6",
                        "surface-dim": "#d1dce0",
                        "surface-variant": "#dbe4e7",
                        "on-surface": "#2b3437",
                        "secondary-fixed": "#cae6fd",
                        "surface-container-low": "#f1f4f6",
                        "primary-fixed-dim": "#d4d4d7",
                        "surface-container-high": "#e3e9ec",
                        "primary-dim": "#515255",
                        "on-secondary-container": "#3a5568",
                        "inverse-primary": "#f9f9fc",
                        "on-primary-fixed-variant": "#5a5c5e",
                        "surface-container": "#eaeff1",
                        "on-error-container": "#752121",
                        "primary-fixed": "#e2e2e5"
                    },
                    fontFamily: {
                        "headline": ["Manrope"],
                        "body": ["Inter"],
                        "label": ["Inter"]
                    },
                    borderRadius: { "DEFAULT": "0.125rem", "lg": "0.25rem", "xl": "0.5rem", "full": "0.75rem" },
                },
            },
        }
    </script>
    <style>
        .material-symbols-outlined {
            font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
            vertical-align: middle;
        }

        body {
            font-family: 'Inter', sans-serif;
            background-color: #f8f9fa;
        }

        .font-manrope {
            font-family: 'Manrope', sans-serif;
        }
    </style>
</head>

<body class="text-on-surface">
    <%- include('../partials/admin/layout', { activePage: 'customers' }) %>
    <!-- Main Content -->
    <main class="md:ml-64 pt-24 px-8 pb-12 min-h-screen">
        <!-- Header Section -->
        <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-8">
            <div>
                <h1 class="text-4xl font-extrabold tracking-tight font-manrope text-on-surface mb-2">Customers</h1>
                <p class="text-on-surface-variant font-body">Manage your luxury client base and interaction history.</p>
            </div>
            <div class="flex items-center gap-3">
                <button onclick="exportCustomerListPDF(this)"
                    class="bg-surface-container-lowest text-on-surface border border-outline-variant/15 px-5 py-2.5 rounded-md text-sm font-semibold hover:bg-surface-container-low transition-all flex items-center gap-2">
                    <span class="material-symbols-outlined text-sm" data-icon="download">download</span>
                    Export List
                </button>
                <button onclick="openModal(true)"
                    class="bg-gradient-to-br from-primary to-secondary text-on-primary px-5 py-2.5 rounded-md text-sm font-semibold hover:-translate-y-0.5 shadow-sm transition-all flex items-center gap-2">
                    <span class="material-symbols-outlined text-sm">add</span>
                    New Client
                </button>
            </div>
        </div>

        <!-- Flash Messages -->
        <% if (locals.errorMessage) { %>
            <div
                class="mb-6 flex items-center gap-3 bg-error-container/20 border border-error-container text-on-error-container px-5 py-3.5 rounded-xl text-sm font-medium">
                <span class="material-symbols-outlined text-base">error</span>
                <%= locals.errorMessage %>
            </div>
            <% } %>
                <% if (locals.successMessage) { %>
                    <div
                        class="mb-6 flex items-center gap-3 bg-tertiary-container/30 border border-tertiary-container text-on-tertiary-container px-5 py-3.5 rounded-xl text-sm font-medium">
                        <span class="material-symbols-outlined text-base">check_circle</span>
                        <%= locals.successMessage %>
                    </div>
                    <% } %>
                        <!-- Metric Summary Cards (Bento Style Lite) -->
                        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-10">
                            <div class="bg-surface-container-low p-6 rounded-xl">
                                <span
                                    class="text-[10px] font-bold uppercase tracking-widest text-secondary-dim block mb-2">Total
                                    High-Value Clients</span>
                                <div class="flex items-baseline gap-2">
                                    <span class="text-3xl font-manrope font-bold text-on-surface">1,284</span>
                                    <span class="text-xs font-semibold text-green-600">+12%</span>
                                </div>
                            </div>
                            <div class="bg-surface-container-low p-6 rounded-xl">
                                <span
                                    class="text-[10px] font-bold uppercase tracking-widest text-secondary-dim block mb-2">Avg.
                                    Lifetime Value</span>
                                <div class="flex items-baseline gap-2">
                                    <span class="text-3xl font-manrope font-bold text-on-surface">$12,450</span>
                                    <span class="text-xs font-semibold text-secondary-dim">Steady</span>
                                </div>
                            </div>
                            <div class="bg-surface-container-low p-6 rounded-xl">
                                <span
                                    class="text-[10px] font-bold uppercase tracking-widest text-secondary-dim block mb-2">Active
                                    Sessions</span>
                                <div class="flex items-baseline gap-2">
                                    <span class="text-3xl font-manrope font-bold text-on-surface">42</span>
                                    <span class="text-xs font-semibold text-tertiary">Live</span>
                                </div>
                            </div>
                        </div>
                        <!-- Customer Table Section -->
                        <div class="mb-6 flex flex-col md:flex-row md:items-center md:justify-between gap-4">
                            <div>
                                <h2 class="text-lg font-semibold text-on-surface">Customer directory</h2>
                                <p class="text-sm text-on-surface-variant">Search, manage, and review your active
                                    customer list.</p>
                            </div>
                            <form action="/admin/user-management/search" method="GET" class="w-full md:w-auto">
                                <div class="relative w-full md:w-80">
                                    <span
                                        class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-outline text-sm">search</span>
                                    <input
                                        class="w-full bg-surface-container-highest border border-outline-variant/20 rounded-full pl-10 pr-4 py-2 text-sm focus:ring-1 focus:ring-secondary transition-all"
                                        placeholder="Search customers..." type="text" name="query"
                                        value="<%= typeof query !== 'undefined' ? query : '' %>" />
                                </div>
                            </form>
                        </div>
                        <div
                            class="bg-surface-container-lowest rounded-xl overflow-hidden shadow-[0_20px_40px_rgba(43,52,55,0.04)]">
                            <div class="overflow-x-auto">
                                <table class="w-full text-left border-collapse">
                                    <thead>
                                        <tr class="bg-surface-container-low">
                                            <th
                                                class="px-6 py-4 text-[10px] font-bold uppercase tracking-widest text-on-surface-variant">
                                                Customer</th>
                                            <th
                                                class="px-6 py-4 text-[10px] font-bold uppercase tracking-widest text-on-surface-variant">
                                                Contact</th>
                                            <th
                                                class="px-6 py-4 text-[10px] font-bold uppercase tracking-widest text-on-surface-variant">
                                                Orders</th>
                                            <th
                                                class="px-6 py-4 text-[10px] font-bold uppercase tracking-widest text-on-surface-variant">
                                                Total Spent</th>
                                            <th
                                                class="px-6 py-4 text-[10px] font-bold uppercase tracking-widest text-on-surface-variant">
                                                Status</th>
                                            <th
                                                class="px-6 py-4 text-[10px] font-bold uppercase tracking-widest text-on-surface-variant text-right">
                                                Actions</th>
                                        </tr>
                                    </thead>
                                    <tbody class="divide-y divide-outline-variant/5">
                                        <% if (!users?.length) { %>
                                            <tr>
                                                <td colspan="6"
                                                    class="px-6 py-12 text-center text-sm text-on-surface-variant">
                                                    No customers found
                                                </td>
                                            </tr>
                                            <% } else { %>
                                                <% users.forEach((user)=> { %>
                                                    <tr class="hover:bg-surface-container-low/30 transition-colors">

                                                        <!-- Customer -->
                                                        <td class="px-6 py-5">
                                                            <div class="flex items-center gap-4">
                                                                <div
                                                                    class="w-10 h-10 rounded-lg overflow-hidden flex-shrink-0 bg-surface-container-high flex items-center justify-center">
                                                                    <% if (user.profileImage) { %>
                                                                        <img src="<%= user.profileImage %>"
                                                                            alt="<%= user.name %>"
                                                                            class="w-full h-full object-cover" />
                                                                        <% } else { %>
                                                                            <span
                                                                                class="material-symbols-outlined text-outline">person</span>
                                                                            <% } %>
                                                                </div>
                                                                <div>
                                                                    <p class="text-sm font-semibold text-on-surface">
                                                                        <%= user.name %>
                                                                    </p>
                                                                    <p class="text-xs text-on-surface-variant">Joined
                                                                        <%= new
                                                                            Date(user.createdAt).toLocaleDateString('en-US',
                                                                            { month: 'short' , year: 'numeric' }) %>
                                                                    </p>
                                                                </div>
                                                            </div>
                                                        </td>

                                                        <!-- Contact -->
                                                        <td class="px-6 py-5">
                                                            <p class="text-sm text-on-surface-variant">
                                                                <%= user.email %>
                                                            </p>
                                                        </td>

                                                        <!-- Orders — placeholder until order model is ready -->
                                                        <td class="px-6 py-5">
                                                            <p class="text-sm font-medium text-on-surface"><%= user.ordersCount || 0 %></p>
                                                        </td>

                                                        <!-- Total Spent — placeholder -->
                                                        <td class="px-6 py-5">
                                                            <p class="text-sm font-semibold text-on-surface">₹<%= (user.totalSpend || 0).toFixed(2) %></p>
                                                        </td>

                                                        <!-- Status -->
                                                        <td class="px-6 py-5">
                                                            <% if (user.isBlocked) { %>
                                                                <span
                                                                    class="inline-flex items-center px-2.5 py-0.5 rounded-full text-[10px] font-bold uppercase bg-error-container/20 text-on-error-container">Blocked</span>
                                                                <% } else { %>
                                                                    <span
                                                                        class="inline-flex items-center px-2.5 py-0.5 rounded-full text-[10px] font-bold uppercase bg-tertiary-container text-on-tertiary-container">Active</span>
                                                                    <% } %>
                                                        </td>

                                                        <!-- Actions -->
                                                        <td class="px-6 py-5 text-right">
                                                            <div class="flex items-center justify-end gap-3">

                                                                <!-- Block / Unblock -->
                                                                <% if (user.isBlocked) { %>
                                                                    <form id="form-unblock-<%= user._id %>"
                                                                        action="/admin/user-management/<%= user._id %>/unblock"
                                                                        method="POST" style="display:inline">
                                                                        <button type="button"
                                                                            onclick="confirmAction('form-unblock-<%= user._id %>', '<%= user.name %>', 'unblock')"
                                                                            class="text-on-error-container hover:opacity-70 transition-opacity"
                                                                            title="Unblock">
                                                                            <span
                                                                                class="material-symbols-outlined text-lg">lock_open</span>
                                                                        </button>
                                                                    </form>
                                                                    <% } else { %>
                                                                        <form id="form-block-<%= user._id %>"
                                                                            action="/admin/user-management/<%= user._id %>/block"
                                                                            method="POST" style="display:inline">
                                                                            <button type="button"
                                                                                onclick="confirmAction('form-block-<%= user._id %>', '<%= user.name %>', 'block')"
                                                                                class="text-outline hover:text-error transition-colors"
                                                                                title="Block">
                                                                                <span
                                                                                    class="material-symbols-outlined text-lg">block</span>
                                                                            </button>
                                                                        </form>
                                                                        <% } %>

                                                                            <!-- Delete -->
                                                                            <form id="form-delete-<%= user._id %>"
                                                                                action="/admin/user-management/<%= user._id %>/delete"
                                                                                method="POST" style="display:inline">
                                                                                <button type="button"
                                                                                    onclick="confirmAction('form-delete-<%= user._id %>', '<%= user.name %>', 'delete')"
                                                                                    class="text-outline hover:text-error transition-colors"
                                                                                    title="Delete">
                                                                                    <span
                                                                                        class="material-symbols-outlined text-lg">delete</span>
                                                                                </button>
                                                                            </form>

                                                            </div>
                                                        </td>
                                                    </tr>
                                                    <% }) %>
                                                        <% } %>
                                    </tbody>
                                </table>
                            </div>
                            <!-- Table Footer/Pagination -->
                            <div class="px-6 py-4 flex items-center justify-between bg-surface-container-low/20">
                                <span class="text-xs text-on-surface-variant font-medium">
                                    Showing <%= users?.length ?? 0 %> of <%= locals.totalUsers ?? (users?.length ?? 0)
                                            %>
                                            customers
                                </span>

                                <div class="flex items-center gap-2">

                                    <%# Prev button %>
                                        <% if (locals.currentPage> 1) { %>
                                            <a href="/admin/user-management?page=<%= currentPage - 1 %>"
                                                class="w-8 h-8 rounded border border-outline-variant/15 flex items-center justify-center text-outline hover:bg-surface-container-low transition-colors">
                                                <span class="material-symbols-outlined text-sm">chevron_left</span>
                                            </a>
                                            <% } else { %>
                                                <span
                                                    class="w-8 h-8 rounded border border-outline-variant/15 flex items-center justify-center text-outline/30 cursor-not-allowed">
                                                    <span class="material-symbols-outlined text-sm">chevron_left</span>
                                                </span>
                                                <% } %>

                                                    <%# Page number buttons %>
                                                        <% for (let i=1; i <=(locals.totalPages || 1); i++) { %>
                                                            <% if (i===(locals.currentPage || 1)) { %>
                                                                <span
                                                                    class="w-8 h-8 rounded border border-outline-variant/15 flex items-center justify-center bg-secondary text-on-secondary font-bold text-xs">
                                                                    <%= i %>
                                                                </span>
                                                                <% } else { %>
                                                                    <a href="/admin/user-management?page=<%= i %>"
                                                                        class="w-8 h-8 rounded border border-outline-variant/15 flex items-center justify-center text-xs text-on-surface-variant hover:bg-surface-container-low transition-colors">
                                                                        <%= i %>
                                                                    </a>
                                                                    <% } %>
                                                                        <% } %>

                                                                            <%# Next button %>
                                                                                <% if (locals.currentPage <
                                                                                    locals.totalPages) { %>
                                                                                    <a href="/admin/user-management?page=<%= currentPage + 1 %>"
                                                                                        class="w-8 h-8 rounded border border-outline-variant/15 flex items-center justify-center text-outline hover:bg-surface-container-low transition-colors">
                                                                                        <span
                                                                                            class="material-symbols-outlined text-sm">chevron_right</span>
                                                                                    </a>
                                                                                    <% } else { %>
                                                                                        <span
                                                                                            class="w-8 h-8 rounded border border-outline-variant/15 flex items-center justify-center text-outline/30 cursor-not-allowed">
                                                                                            <span
                                                                                                class="material-symbols-outlined text-sm">chevron_right</span>
                                                                                        </span>
                                                                                        <% } %>
                                </div>
                            </div>
                        </div>
    </main>

    <!-- Create User Modal -->
    <div id="createModal"
        class="fixed inset-0 z-50 flex items-center justify-center bg-black/30 backdrop-blur-sm hidden">
        <div class="bg-surface-container-lowest rounded-xl shadow-2xl w-full max-w-md mx-4 overflow-hidden">

            <!-- Modal Header -->
            <div class="flex items-center justify-between px-6 py-5 border-b border-outline-variant/10">
                <h2 class="text-lg font-bold font-manrope text-on-surface">New Client</h2>
                <button onclick="closeModal()" class="text-outline hover:text-on-surface transition-colors">
                    <span class="material-symbols-outlined">close</span>
                </button>
            </div>

            <!-- Error Message Container -->
            <div id="modalErrorContainer" class="mx-6 mt-4 px-4 py-3 bg-error-container/20 text-on-error-container text-sm rounded-lg <%= (typeof createError !== 'undefined' && createError) ? '' : 'hidden' %>">
                <span id="modalErrorMessage"><%= (typeof createError !== 'undefined' && createError) ? createError : '' %></span>
            </div>

                    <!-- Modal Form -->
                    <form id="createUserForm" action="/admin/user-management/create" method="POST" class="px-6 py-6 flex flex-col gap-4">

                        <div class="flex flex-col gap-1.5">
                            <label class="text-[11px] font-bold uppercase tracking-widest text-on-surface-variant">Full
                                Name</label>
                            <input type="text" id="modalName" name="name" placeholder="John Doe" required
                                class="bg-surface-container border border-outline-variant/20 rounded-lg px-4 py-2.5 text-sm text-on-surface focus:outline-none focus:ring-1 focus:ring-secondary transition-all" />
                        </div>

                        <div class="flex flex-col gap-1.5">
                            <label class="text-[11px] font-bold uppercase tracking-widest text-on-surface-variant">Email
                                Address</label>
                            <input type="email" id="modalEmail" name="email" placeholder="client@example.com" required
                                class="bg-surface-container border border-outline-variant/20 rounded-lg px-4 py-2.5 text-sm text-on-surface focus:outline-none focus:ring-1 focus:ring-secondary transition-all" />
                        </div>

                        <div class="flex flex-col gap-1.5">
                            <label
                                class="text-[11px] font-bold uppercase tracking-widest text-on-surface-variant">Password</label>
                            <div class="relative">
                                <input id="modalPassword" type="password" name="password" placeholder="••••••••"
                                    required
                                    class="w-full bg-surface-container border border-outline-variant/20 rounded-lg px-4 py-2.5 text-sm text-on-surface focus:outline-none focus:ring-1 focus:ring-secondary transition-all" />
                                <button type="button" onclick="toggleModalPassword()"
                                    class="absolute right-3 top-1/2 -translate-y-1/2 text-outline hover:text-on-surface transition-colors">
                                    <span class="material-symbols-outlined text-sm"
                                        id="modalPasswordIcon">visibility</span>
                                </button>
                            </div>
                        </div>

                        <!-- Actions -->
                        <div class="flex items-center justify-end gap-3 pt-2">
                            <button type="button" onclick="closeModal()"
                                class="px-5 py-2.5 rounded-md text-sm font-semibold text-on-surface-variant hover:bg-surface-container-low transition-all">
                                Cancel
                            </button>
                            <button type="submit"
                                class="bg-gradient-to-br from-primary to-secondary text-on-primary px-5 py-2.5 rounded-md text-sm font-semibold hover:-translate-y-0.5 shadow-sm transition-all">
                                Create Client
                            </button>
                        </div>

                    </form>
        </div>
    </div>

    <!-- ── Confirmation Modal ─────────────────────────────── -->
    <div id="confirmModal"
        class="fixed inset-0 z-50 flex items-center justify-center bg-black/30 backdrop-blur-sm hidden"
        aria-modal="true" role="dialog">
        <div class="bg-surface-container-lowest rounded-xl shadow-2xl w-full max-w-sm mx-4 overflow-hidden
                    translate-y-4 opacity-0 transition-all duration-200" id="confirmModalBox">

            <!-- Icon + Header -->
            <div class="flex flex-col items-center pt-8 pb-4 px-6 gap-3">
                <div id="confirmIcon" class="w-14 h-14 rounded-full flex items-center justify-center">
                    <span id="confirmIconSymbol" class="material-symbols-outlined text-3xl"></span>
                </div>
                <h2 id="confirmTitle" class="text-lg font-bold font-manrope text-on-surface text-center"></h2>
                <p id="confirmMessage" class="text-sm text-on-surface-variant text-center leading-relaxed"></p>
            </div>

            <!-- Actions -->
            <div class="flex items-center justify-center gap-3 px-6 py-5 border-t border-outline-variant/10">
                <button onclick="closeConfirm()" class="px-5 py-2.5 rounded-md text-sm font-semibold text-on-surface-variant
                           hover:bg-surface-container-low transition-all">
                    Cancel
                </button>
                <button id="confirmBtn" onclick="submitConfirm()" class="px-5 py-2.5 rounded-md text-sm font-semibold text-on-primary
                           shadow-sm hover:-translate-y-0.5 transition-all">
                    Confirm
                </button>
            </div>
        </div>
    </div>

    <script>
        const modal = document.getElementById('createModal');
        const userForm = document.getElementById('createUserForm');
        const modalErrorContainer = document.getElementById('modalErrorContainer');
        const modalErrorMessage = document.getElementById('modalErrorMessage');

        function openModal(isNew = false) {
            if (isNew) {
                // Reset input values
                userForm.reset();
                // Clear and hide errors
                modalErrorContainer.classList.add('hidden');
                modalErrorMessage.textContent = '';
                // Clean up the createError query param from URL so refresh doesn't reopen it
                if (window.location.search.includes('createError')) {
                    window.history.replaceState({}, document.title, window.location.pathname);
                }
            }
            modal.classList.remove('hidden');
        }

        function closeModal() {
            modal.classList.add('hidden');
        }

        // close on backdrop click
        modal.addEventListener('click', (e) => {
            if (e.target === modal) closeModal();
        });

        // Add client-side validation logic
        userForm.addEventListener('submit', (e) => {
            const nameInput = document.getElementById('modalName').value.trim();
            const emailInput = document.getElementById('modalEmail').value.trim();
            const passwordInput = document.getElementById('modalPassword').value;

            // Name check: only letters and spaces, min length 3
            if (nameInput.length < 3) {
                e.preventDefault();
                showFormError('Name must be at least 3 characters');
                return;
            }
            const nameRegex = /^[A-Za-z\s]+$/;
            if (!nameRegex.test(nameInput)) {
                e.preventDefault();
                showFormError('Name must contain only letters and spaces');
                return;
            }

            // Email check: valid pattern
            const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
            if (!emailRegex.test(emailInput)) {
                e.preventDefault();
                showFormError('Please enter a valid email address');
                return;
            }

            // Password check: min length 6
            if (passwordInput.length < 6) {
                e.preventDefault();
                showFormError('Password must be at least 6 characters');
                return;
            }
        });

        function showFormError(msg) {
            modalErrorMessage.textContent = msg;
            modalErrorContainer.classList.remove('hidden');
        }

        function toggleModalPassword() {
            const input = document.getElementById('modalPassword');
            const icon = document.getElementById('modalPasswordIcon');
            if (input.type === 'password') {
                input.type = 'text';
                icon.textContent = 'visibility_off';
            } else {
                input.type = 'password';
                icon.textContent = 'visibility';
            }
        }

        // ── Confirmation modal logic ─────────────────────
        let _pendingFormId = null;
        const confirmModal = document.getElementById('confirmModal');
        const confirmModalBox = document.getElementById('confirmModalBox');

        const ACTION_CONFIG = {
            block: {
                icon: 'block',
                iconBg: 'bg-error-container/20',
                iconColor: 'text-on-error-container',
                btnBg: 'bg-error',
                title: (name) => `Block ${name}?`,
                message: (name) => `${name} will lose access to their account immediately. You can unblock them at any time.`
            },
            unblock: {
                icon: 'lock_open',
                iconBg: 'bg-tertiary-container/40',
                iconColor: 'text-on-tertiary-container',
                btnBg: 'bg-secondary',
                title: (name) => `Unblock ${name}?`,
                message: (name) => `${name} will regain full access to their account.`
            },
            delete: {
                icon: 'delete_forever',
                iconBg: 'bg-error-container/20',
                iconColor: 'text-on-error-container',
                btnBg: 'bg-error',
                title: (name) => `Delete ${name}?`,
                message: (name) => `This action is permanent. All data for ${name} will be removed and cannot be recovered.`
            }
        };

        function confirmAction(formId, userName, action) {
            _pendingFormId = formId;
            const cfg = ACTION_CONFIG[action];

            // Icon
            const iconWrap = document.getElementById('confirmIcon');
            const iconSymbol = document.getElementById('confirmIconSymbol');
            iconWrap.className = `w-14 h-14 rounded-full flex items-center justify-center ${cfg.iconBg}`;
            iconSymbol.className = `material-symbols-outlined text-3xl ${cfg.iconColor}`;
            iconSymbol.textContent = cfg.icon;

            // Text
            document.getElementById('confirmTitle').textContent = cfg.title(userName);
            document.getElementById('confirmMessage').textContent = cfg.message(userName);

            // Button colour
            const btn = document.getElementById('confirmBtn');
            btn.className = btn.className.replace(/bg-\S+/, '');
            btn.classList.add(cfg.btnBg, 'text-on-primary', 'px-5', 'py-2.5', 'rounded-md',
                'text-sm', 'font-semibold', 'shadow-sm', 'hover:-translate-y-0.5', 'transition-all');
            btn.textContent = action.charAt(0).toUpperCase() + action.slice(1);

            // Show
            confirmModal.classList.remove('hidden');
            requestAnimationFrame(() => {
                confirmModalBox.classList.remove('translate-y-4', 'opacity-0');
            });
        }

        function closeConfirm() {
            confirmModalBox.classList.add('translate-y-4', 'opacity-0');
            setTimeout(() => confirmModal.classList.add('hidden'), 200);
            _pendingFormId = null;
        }

        function submitConfirm() {
            if (_pendingFormId) {
                document.getElementById(_pendingFormId).submit();
            }
        }

        // Close on backdrop click
        confirmModal.addEventListener('click', (e) => {
            if (e.target === confirmModal) closeConfirm();
        });

        // Close on Escape key
        document.addEventListener('keydown', (e) => {
            if (e.key === 'Escape' && !confirmModal.classList.contains('hidden')) closeConfirm();
        });

  <% if (typeof createError !== 'undefined' && createError) { %>
            openModal(false);
  <% } %>

        async function exportCustomerListPDF(btn) {
            const originalHTML = btn.innerHTML;
            btn.disabled = true;
            btn.innerHTML = `
                <span class="material-symbols-outlined text-sm animate-spin">sync</span>
                Exporting...
            `;

            try {
                const response = await fetch('/admin/user-management/export');
                const data = await response.json();

                if (!data.success || !data.users || data.users.length === 0) {
                    alert('No customer data available to export.');
                    return;
                }

                const users = data.users;

                // Create a virtual container for styling the PDF
                const container = document.createElement('div');
                container.style.fontFamily = "'Inter', sans-serif";
                container.style.color = '#1e293b';
                container.style.padding = '40px';
                container.style.backgroundColor = '#ffffff';

                // Format the download date and time
                const downloadDateTime = new Date().toLocaleString('en-US', {
                    month: 'long',
                    day: 'numeric',
                    year: 'numeric',
                    hour: '2-digit',
                    minute: '2-digit',
                    second: '2-digit',
                    hour12: true
                });

                container.innerHTML = `
                    <div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 2px solid #0f172a; padding-bottom: 20px; margin-bottom: 30px;">
                        <div>
                            <h1 style="font-family: 'Manrope', sans-serif; font-size: 24px; font-weight: 800; color: #0f172a; margin: 0; letter-spacing: -0.02em;">LUXE TECH</h1>
                            <p style="font-size: 9px; text-transform: uppercase; letter-spacing: 0.1em; color: #64748b; margin: 4px 0 0 0; font-weight: 600;">Customer Directory & Analytics</p>
                        </div>
                        <div style="text-align: right;">
                            <p style="font-size: 10px; font-weight: 700; color: #0f172a; margin: 0;">Exported On:</p>
                            <p style="font-size: 10px; color: #475569; margin: 2px 0 0 0;">${downloadDateTime}</p>
                            <p style="font-size: 8px; color: #94a3b8; margin: 4px 0 0 0;">Report Ref: #LTCR-${Math.floor(100000 + Math.random() * 900000)}</p>
                        </div>
                    </div>

                    <div style="background-color: #f8fafc; border: 1px solid #e2e8f0; border-radius: 8px; padding: 15px; margin-bottom: 30px; display: flex; justify-content: space-between; font-size: 11px;">
                        <div>
                            <span style="color: #64748b; font-weight: 600;">Active Clients:</span>
                            <span style="font-weight: 700; color: #0f172a; margin-left: 5px;">${users.filter(u => !u.isBlocked).length}</span>
                        </div>
                        <div>
                            <span style="color: #64748b; font-weight: 600;">Total Clients:</span>
                            <span style="font-weight: 700; color: #0f172a; margin-left: 5px;">${users.length}</span>
                        </div>
                        <div>
                            <span style="color: #64748b; font-weight: 600;">Total Value Generated:</span>
                            <span style="font-weight: 700; color: #0f172a; margin-left: 5px;">₹${users.reduce((acc, u) => acc + (u.totalSpend || 0), 0).toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}</span>
                        </div>
                    </div>

                    <table style="width: 100%; border-collapse: collapse; text-align: left;">
                        <thead>
                            <tr style="background-color: #0f172a; border-bottom: 2px solid #0f172a;">
                                <th style="padding: 12px 10px; font-size: 9px; font-weight: 700; text-transform: uppercase; color: #ffffff; width: 30%;">Customer Name</th>
                                <th style="padding: 12px 10px; font-size: 9px; font-weight: 700; text-transform: uppercase; color: #ffffff; width: 30%;">Email Address</th>
                                <th style="padding: 12px 10px; font-size: 9px; font-weight: 700; text-transform: uppercase; color: #ffffff; text-align: center; width: 12%;">Orders</th>
                                <th style="padding: 12px 10px; font-size: 9px; font-weight: 700; text-transform: uppercase; color: #ffffff; text-align: center; width: 13%;">Status</th>
                                <th style="padding: 12px 10px; font-size: 9px; font-weight: 700; text-transform: uppercase; color: #ffffff; text-align: right; width: 15%;">Total Spend</th>
                            </tr>
                        </thead>
                        <tbody>
                            ${users.map(u => `
                                <tr style="border-bottom: 1px solid #e2e8f0; page-break-inside: avoid;">
                                    <td style="padding: 12px 10px; font-size: 11px; font-weight: 700; color: #0f172a;">
                                        ${u.name}
                                    </td>
                                    <td style="padding: 12px 10px; font-size: 10px; color: #475569;">
                                        ${u.email}
                                    </td>
                                    <td style="padding: 12px 10px; font-size: 10px; color: #475569; text-align: center; font-weight: 600;">
                                        ${u.ordersCount || 0}
                                    </td>
                                    <td style="padding: 12px 10px; text-align: center;">
                                        <span style="display: inline-block; padding: 2px 8px; border-radius: 4px; font-size: 8px; font-weight: 700; text-transform: uppercase; 
                                            ${!u.isBlocked ? 'background-color: #dcfce7; color: #15803d;' : 'background-color: #fee2e2; color: #b91c1c;'}">
                                            ${!u.isBlocked ? 'Active' : 'Blocked'}
                                        </span>
                                    </td>
                                    <td style="padding: 12px 10px; text-align: right; font-size: 11px; font-weight: 700; color: #0f172a;">
                                        ₹${(u.totalSpend || 0).toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}
                                    </td>
                                </tr>
                            `).join('')}
                        </tbody>
                    </table>

                    <div style="margin-top: 40px; border-top: 1px dashed #cbd5e1; padding-top: 20px; text-align: center; page-break-inside: avoid;">
                        <p style="font-size: 9px; color: #94a3b8; margin: 0;">This document contains sensitive client directory records. Unauthorized reproduction is strictly prohibited.</p>
                        <p style="font-size: 9px; color: #94a3b8; margin: 4px 0 0 0;">Luxe Tech Administration Portal | Generated automatically by system | © ${new Date().getFullYear()} Luxe Tech Inc.</p>
                    </div>
                `;

                const opt = {
                    margin:       [15, 15, 20, 15],
                    filename:     'LuxeTech_Customer_Directory.pdf',
                    image:        { type: 'jpeg', quality: 0.98 },
                    html2canvas:  { scale: 2, useCORS: true, letterRendering: true },
                    jsPDF:        { unit: 'mm', format: 'a4', orientation: 'portrait' }
                };

                await html2pdf().set(opt).from(container).save();

            } catch (err) {
                console.error('Error exporting client list PDF:', err);
                alert('An error occurred while exporting the customer directory.');
            } finally {
                btn.disabled = false;
                btn.innerHTML = originalHTML;
            }
        }
    </script>
</body>

</html>