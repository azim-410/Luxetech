<!DOCTYPE html>

<html class="light" lang="en">

<head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>Customer List | Luxe Tech</title>
    <!-- Google Fonts: Manrope & Inter -->
    <link
        href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&amp;family=Manrope:wght@600;700;800&amp;display=swap"
        rel="stylesheet" />
    <!-- Material Symbols Outlined -->
    <link
        href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap"
        rel="stylesheet" />
    <link
        href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap"
        rel="stylesheet" />
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <script id="tailwind-config">
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    colors: {
                        "inverse-on-surface": "#9b9d9e",
                        "tertiary-fixed": "#dbe9ff",
                        "tertiary-fixed-dim": "#cddbf0",
                        "on-secondary": "#f5f9ff",
                        "tertiary-container": "#dbe9ff",
                        "on-tertiary-container": "#485668",
                        "on-tertiary": "#f7f9ff",
                        "on-primary-fixed": "#3e3f42",
                        "error-dim": "#4e0309",
                        "surface": "#f8f9fa",
                        "secondary": "#476275",
                        "inverse-surface": "#0c0f10",
                        "on-background": "#2b3437",
                        "on-tertiary-fixed": "#364455",
                        "on-primary": "#f7f7fa",
                        "on-secondary-fixed": "#274254",
                        "on-secondary-fixed-variant": "#445f72",
                        "tertiary-dim": "#465465",
                        "outline": "#737c7f",
                        "surface-bright": "#f8f9fa",
                        "secondary-dim": "#3b5669",
                        "primary-container": "#e2e2e5",
                        "surface-container-lowest": "#ffffff",
                        "primary": "#5d5e61",
                        "secondary-fixed-dim": "#bcd8ef",
                        "outline-variant": "#abb3b7",
                        "secondary-container": "#cae6fd",
                        "surface-container-highest": "#dbe4e7",
                        "on-primary-container": "#505254",
                        "tertiary": "#526072",
                        "error": "#9f403d",
                        "on-tertiary-fixed-variant": "#526072",
                        "on-surface-variant": "#586064",
                        "background": "#f8f9fa",
                        "surface-tint": "#5d5e61",
                        "error-container": "#fe8983",
                        "on-error": "#fff7f6",
                        "surface-dim": "#d1dce0",
                        "surface-variant": "#dbe4e7",
                        "on-surface": "#2b3437",
                        "secondary-fixed": "#cae6fd",
                        "surface-container-low": "#f1f4f6",
                        "primary-fixed-dim": "#d4d4d7",
                        "surface-container-high": "#e3e9ec",
                        "primary-dim": "#515255",
                        "on-secondary-container": "#3a5568",
                        "inverse-primary": "#f9f9fc",
                        "on-primary-fixed-variant": "#5a5c5e",
                        "surface-container": "#eaeff1",
                        "on-error-container": "#752121",
                        "primary-fixed": "#e2e2e5"
                    },
                    fontFamily: {
                        "headline": ["Manrope"],
                        "body": ["Inter"],
                        "label": ["Inter"]
                    },
                    borderRadius: { "DEFAULT": "0.125rem", "lg": "0.25rem", "xl": "0.5rem", "full": "0.75rem" },
                },
            },
        }
    </script>
    <style>
        .material-symbols-outlined {
            font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
            vertical-align: middle;
        }

        body {
            font-family: 'Inter', sans-serif;
            background-color: #f8f9fa;
        }

        .font-manrope {
            font-family: 'Manrope', sans-serif;
        }
    </style>
</head>

<body class="text-on-surface">
    <!-- TopNavBar (Fixed) -->
    <nav
        class="fixed top-0 w-full z-50 bg-[#f1f4f6]/80 backdrop-blur-md flex justify-between items-center px-8 h-16 w-full shadow-sm">
        <div class="flex items-center gap-8">
            <span class="text-xl font-bold tracking-tighter text-[#2b3437] font-manrope">Luxe Tech</span>
        </div>
        <div class="flex items-center gap-6">
            <button class="text-[#5d5e61] hover:text-[#2b3437] transition-colors">
                <span class="material-symbols-outlined" data-icon="notifications">notifications</span>
            </button>
            <button class="text-[#5d5e61] hover:text-[#2b3437] transition-colors">
                <span class="material-symbols-outlined" data-icon="settings">settings</span>
            </button>
            <div class="w-8 h-8 rounded-full bg-secondary-container overflow-hidden">
                <img alt="User profile" class="w-full h-full object-cover"
                    data-alt="Close up portrait of a professional male administrator"
                    src="https://lh3.googleusercontent.com/aida-public/AB6AXuBXLtr6eZ2C7WQgF-rgHK35yDUS7uCUJrEJeUPJtMD8LJnsnMOIGGcIxDgD7h6ihjitM0hFSacWmZ8CvjOA-B5ECnBcW3W1cvZlKRfViMcUHWwLyAbwucJMlG0jnVVMVA6cawHlG2a29dgV133zWmFbo08BMsWmlO8b7POrZdKPiCAGY5LxVdAt-TiCdWXG8Fz_MmNFv3fJZZeJqxgX40TwGSGE-i8_r4KvzMkJe67up7yLxq1cxfMcsxRJ6gMn9PTDu886dZpusnKw" />
            </div>
        </div>
    </nav>
    <!-- SideNavBar -->
    <aside class="h-screen w-64 fixed left-0 top-0 bg-[#eaeff1] flex flex-col p-6 gap-y-4 pt-24 z-40 hidden md:flex">
        <div class="mb-6 px-2">
            <h2 class="text-lg font-manrope font-bold text-[#2b3437]">Admin Portal</h2>
            <p class="text-[10px] font-inter font-medium uppercase tracking-wider text-[#5d5e61]">Luxury Curator</p>
        </div>
        <nav class="flex flex-col gap-1">
            <a class="flex items-center gap-3 px-4 py-3 text-[#5d5e61] hover:bg-[#f8f9fa] rounded-lg transition-all scale-95 active:scale-100 font-inter text-sm font-medium uppercase tracking-wider"
                href="#">
                <span class="material-symbols-outlined" data-icon="dashboard">dashboard</span>
                Dashboard
            </a>
            <!-- Active State: Customers -->
            <a class="flex items-center gap-3 px-4 py-3 text-[#2b3437] font-bold bg-[#f8f9fa] rounded-lg transition-all scale-95 active:scale-100 font-inter text-sm font-medium uppercase tracking-wider"
                href="#">
                <span class="material-symbols-outlined" data-icon="group"
                    style="font-variation-settings: 'FILL' 1;">group</span>
                Customers
            </a>
            <a class="flex items-center gap-3 px-4 py-3 text-[#5d5e61] hover:bg-[#f8f9fa] rounded-lg transition-all scale-95 active:scale-100 font-inter text-sm font-medium uppercase tracking-wider"
                href="#">
                <span class="material-symbols-outlined" data-icon="inventory_2">inventory_2</span>
                Inventory
            </a>
            <a class="flex items-center gap-3 px-4 py-3 text-[#5d5e61] hover:bg-[#f8f9fa] rounded-lg transition-all scale-95 active:scale-100 font-inter text-sm font-medium uppercase tracking-wider"
                href="#">
                <span class="material-symbols-outlined" data-icon="shopping_cart">shopping_cart</span>
                Orders
            </a>
            <a class="flex items-center gap-3 px-4 py-3 text-[#5d5e61] hover:bg-[#f8f9fa] rounded-lg transition-all scale-95 active:scale-100 font-inter text-sm font-medium uppercase tracking-wider"
                href="#">
                <span class="material-symbols-outlined" data-icon="analytics">analytics</span>
                Analytics
            </a>
        </nav>
        <div class="mt-auto flex flex-col gap-1 border-t border-outline-variant/15 pt-4">
            <a class="flex items-center gap-3 px-4 py-3 text-[#5d5e61] hover:bg-[#f8f9fa] rounded-lg transition-all font-inter text-sm font-medium uppercase tracking-wider"
                href="#">
                <span class="material-symbols-outlined" data-icon="help">help</span>
                Support
            </a>
            <a class="flex items-center gap-3 px-4 py-3 text-[#5d5e61] hover:bg-[#f8f9fa] rounded-lg transition-all font-inter text-sm font-medium uppercase tracking-wider"
                href="/admin/logout">
                <span class="material-symbols-outlined" data-icon="logout">logout</span>
                Logout
            </a>
        </div>
    </aside>
    <!-- Main Content -->
    <main class="md:ml-64 pt-24 px-8 pb-12 min-h-screen">
        <!-- Header Section -->
        <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-8">
            <div>
                <h1 class="text-4xl font-extrabold tracking-tight font-manrope text-on-surface mb-2">Customers</h1>
                <p class="text-on-surface-variant font-body">Manage your luxury client base and interaction history.</p>
            </div>
            <div class="flex items-center gap-3">
                <button
                    class="bg-surface-container-lowest text-on-surface border border-outline-variant/15 px-5 py-2.5 rounded-md text-sm font-semibold hover:bg-surface-container-low transition-all flex items-center gap-2">
                    <span class="material-symbols-outlined text-sm" data-icon="download">download</span>
                    Export List
                </button>
                <button onclick="openModal()"
                    class="bg-gradient-to-br from-primary to-secondary text-on-primary px-5 py-2.5 rounded-md text-sm font-semibold hover:-translate-y-0.5 shadow-sm transition-all flex items-center gap-2">
                    <span class="material-symbols-outlined text-sm">add</span>
                    New Client
                </button>
            </div>
        </div>

        <!-- Flash Messages -->
        <% if (locals.errorMessage) { %>
            <div
                class="mb-6 flex items-center gap-3 bg-error-container/20 border border-error-container text-on-error-container px-5 py-3.5 rounded-xl text-sm font-medium">
                <span class="material-symbols-outlined text-base">error</span>
                <%= locals.errorMessage %>
            </div>
            <% } %>
                <% if (locals.successMessage) { %>
                    <div
                        class="mb-6 flex items-center gap-3 bg-tertiary-container/30 border border-tertiary-container text-on-tertiary-container px-5 py-3.5 rounded-xl text-sm font-medium">
                        <span class="material-symbols-outlined text-base">check_circle</span>
                        <%= locals.successMessage %>
                    </div>
                    <% } %>
                        <!-- Metric Summary Cards (Bento Style Lite) -->
                        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-10">
                            <div class="bg-surface-container-low p-6 rounded-xl">
                                <span
                                    class="text-[10px] font-bold uppercase tracking-widest text-secondary-dim block mb-2">Total
                                    High-Value Clients</span>
                                <div class="flex items-baseline gap-2">
                                    <span class="text-3xl font-manrope font-bold text-on-surface">1,284</span>
                                    <span class="text-xs font-semibold text-green-600">+12%</span>
                                </div>
                            </div>
                            <div class="bg-surface-container-low p-6 rounded-xl">
                                <span
                                    class="text-[10px] font-bold uppercase tracking-widest text-secondary-dim block mb-2">Avg.
                                    Lifetime Value</span>
                                <div class="flex items-baseline gap-2">
                                    <span class="text-3xl font-manrope font-bold text-on-surface">$12,450</span>
                                    <span class="text-xs font-semibold text-secondary-dim">Steady</span>
                                </div>
                            </div>
                            <div class="bg-surface-container-low p-6 rounded-xl">
                                <span
                                    class="text-[10px] font-bold uppercase tracking-widest text-secondary-dim block mb-2">Active
                                    Sessions</span>
                                <div class="flex items-baseline gap-2">
                                    <span class="text-3xl font-manrope font-bold text-on-surface">42</span>
                                    <span class="text-xs font-semibold text-tertiary">Live</span>
                                </div>
                            </div>
                        </div>
                        <!-- Customer Table Section -->
                        <div class="mb-6 flex flex-col md:flex-row md:items-center md:justify-between gap-4">
                            <div>
                                <h2 class="text-lg font-semibold text-on-surface">Customer directory</h2>
                                <p class="text-sm text-on-surface-variant">Search, manage, and review your active
                                    customer list.</p>
                            </div>
                            <form action="/admin/user-management/search" method="GET" class="w-full md:w-auto">
                                <div class="relative w-full md:w-80">
                                    <span
                                        class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-outline text-sm">search</span>
                                    <input
                                        class="w-full bg-surface-container-highest border border-outline-variant/20 rounded-full pl-10 pr-4 py-2 text-sm focus:ring-1 focus:ring-secondary transition-all"
                                        placeholder="Search customers..." type="text" name="query"
                                        value="<%= typeof query !== 'undefined' ? query : '' %>" />
                                </div>
                            </form>
                        </div>
                        <div
                            class="bg-surface-container-lowest rounded-xl overflow-hidden shadow-[0_20px_40px_rgba(43,52,55,0.04)]">
                            <div class="overflow-x-auto">
                                <table class="w-full text-left border-collapse">
                                    <thead>
                                        <tr class="bg-surface-container-low">
                                            <th
                                                class="px-6 py-4 text-[10px] font-bold uppercase tracking-widest text-on-surface-variant">
                                                Customer</th>
                                            <th
                                                class="px-6 py-4 text-[10px] font-bold uppercase tracking-widest text-on-surface-variant">
                                                Contact</th>
                                            <th
                                                class="px-6 py-4 text-[10px] font-bold uppercase tracking-widest text-on-surface-variant">
                                                Orders</th>
                                            <th
                                                class="px-6 py-4 text-[10px] font-bold uppercase tracking-widest text-on-surface-variant">
                                                Total Spent</th>
                                            <th
                                                class="px-6 py-4 text-[10px] font-bold uppercase tracking-widest text-on-surface-variant">
                                                Status</th>
                                            <th
                                                class="px-6 py-4 text-[10px] font-bold uppercase tracking-widest text-on-surface-variant text-right">
                                                Actions</th>
                                        </tr>
                                    </thead>
                                    <tbody class="divide-y divide-outline-variant/5">
                                        <% if (!users?.length) { %>
                                            <tr>
                                                <td colspan="6"
                                                    class="px-6 py-12 text-center text-sm text-on-surface-variant">
                                                    No customers found
                                                </td>
                                            </tr>
                                            <% } else { %>
                                                <% users.forEach((user)=> { %>
                                                    <tr class="hover:bg-surface-container-low/30 transition-colors">

                                                        <!-- Customer -->
                                                        <td class="px-6 py-5">
                                                            <div class="flex items-center gap-4">
                                                                <div
                                                                    class="w-10 h-10 rounded-lg overflow-hidden flex-shrink-0 bg-surface-container-high flex items-center justify-center">
                                                                    <% if (user.profileImage) { %>
                                                                        <img src="<%= user.profileImage %>"
                                                                            alt="<%= user.name %>"
                                                                            class="w-full h-full object-cover" />
                                                                        <% } else { %>
                                                                            <span
                                                                                class="material-symbols-outlined text-outline">person</span>
                                                                            <% } %>
                                                                </div>
                                                                <div>
                                                                    <p class="text-sm font-semibold text-on-surface">
                                                                        <%= user.name %>
                                                                    </p>
                                                                    <p class="text-xs text-on-surface-variant">Joined
                                                                        <%= new
                                                                            Date(user.createdAt).toLocaleDateString('en-US',
                                                                            { month: 'short' , year: 'numeric' }) %>
                                                                    </p>
                                                                </div>
                                                            </div>
                                                        </td>

                                                        <!-- Contact -->
                                                        <td class="px-6 py-5">
                                                            <p class="text-sm text-on-surface-variant">
                                                                <%= user.email %>
                                                            </p>
                                                        </td>

                                                        <!-- Orders — placeholder until order model is ready -->
                                                        <td class="px-6 py-5">
                                                            <p class="text-sm font-medium text-on-surface">—</p>
                                                        </td>

                                                        <!-- Total Spent — placeholder -->
                                                        <td class="px-6 py-5">
                                                            <p class="text-sm font-semibold text-on-surface">—</p>
                                                        </td>

                                                        <!-- Status -->
                                                        <td class="px-6 py-5">
                                                            <% if (user.isBlocked) { %>
                                                                <span
                                                                    class="inline-flex items-center px-2.5 py-0.5 rounded-full text-[10px] font-bold uppercase bg-error-container/20 text-on-error-container">Blocked</span>
                                                                <% } else { %>
                                                                    <span
                                                                        class="inline-flex items-center px-2.5 py-0.5 rounded-full text-[10px] font-bold uppercase bg-tertiary-container text-on-tertiary-container">Active</span>
                                                                    <% } %>
                                                        </td>

                                                        <!-- Actions -->
                                                        <td class="px-6 py-5 text-right">
                                                            <div class="flex items-center justify-end gap-3">

                                                                <!-- Block / Unblock -->
                                                                <% if (user.isBlocked) { %>
                                                                    <form
                                                                        action="/admin/user-management/<%= user._id %>/unblock"
                                                                        method="POST" style="display:inline">
                                                                        <button type="submit"
                                                                            class="text-on-error-container hover:opacity-70 transition-opacity"
                                                                            title="Unblock">
                                                                            <span
                                                                                class="material-symbols-outlined text-lg">lock_open</span>
                                                                        </button>
                                                                    </form>
                                                                    <% } else { %>
                                                                        <form
                                                                            action="/admin/user-management/<%= user._id %>/block"
                                                                            method="POST" style="display:inline">
                                                                            <button type="submit"
                                                                                class="text-outline hover:text-error transition-colors"
                                                                                title="Block">
                                                                                <span
                                                                                    class="material-symbols-outlined text-lg">block</span>
                                                                            </button>
                                                                        </form>
                                                                        <% } %>

                                                                            <!-- Delete -->
                                                                            <form
                                                                                action="/admin/user-management/<%= user._id %>/delete"
                                                                                method="POST" style="display:inline">
                                                                                <button type="submit"
                                                                                    class="text-outline hover:text-error transition-colors"
                                                                                    title="Delete">
                                                                                    <span
                                                                                        class="material-symbols-outlined text-lg">delete</span>
                                                                                </button>
                                                                            </form>

                                                            </div>
                                                        </td>
                                                    </tr>
                                                    <% }) %>
                                                        <% } %>
                                    </tbody>
                                </table>
                            </div>
                            <!-- Table Footer/Pagination -->
                            <div class="px-6 py-4 flex items-center justify-between bg-surface-container-low/20">
                                <span class="text-xs text-on-surface-variant font-medium">
                                    Showing <%= users?.length ?? 0 %> of <%= locals.totalUsers ?? (users?.length ?? 0) %>
                                            customer<%= (locals.totalUsers ?? 0) !==1 ? 's' : '' %>
                                </span>

                                <div class="flex items-center gap-2">

                                    <%# Prev button %>
                                        <% if (locals.currentPage> 1) { %>
                                            <a href="/admin/user-management?page=<%= currentPage - 1 %>"
                                                class="w-8 h-8 rounded border border-outline-variant/15 flex items-center justify-center text-outline hover:bg-surface-container-low transition-colors">
                                                <span class="material-symbols-outlined text-sm">chevron_left</span>
                                            </a>
                                            <% } else { %>
                                                <span
                                                    class="w-8 h-8 rounded border border-outline-variant/15 flex items-center justify-center text-outline/30 cursor-not-allowed">
                                                    <span class="material-symbols-outlined text-sm">chevron_left</span>
                                                </span>
                                                <% } %>

                                                    <%# Page number buttons %>
                                                        <% for (let i=1; i <=(locals.totalPages || 1); i++) { %>
                                                            <% if (i===(locals.currentPage || 1)) { %>
                                                                <span
                                                                    class="w-8 h-8 rounded border border-outline-variant/15 flex items-center justify-center bg-secondary text-on-secondary font-bold text-xs">
                                                                    <%= i %>
                                                                </span>
                                                                <% } else { %>
                                                                    <a href="/admin/user-management?page=<%= i %>"
                                                                        class="w-8 h-8 rounded border border-outline-variant/15 flex items-center justify-center text-xs text-on-surface-variant hover:bg-surface-container-low transition-colors">
                                                                        <%= i %>
                                                                    </a>
                                                                    <% } %>
                                                                        <% } %>

                                                                            <%# Next button %>
                                                                                <% if (locals.currentPage <
                                                                                    locals.totalPages) { %>
                                                                                    <a href="/admin/user-management?page=<%= currentPage + 1 %>"
                                                                                        class="w-8 h-8 rounded border border-outline-variant/15 flex items-center justify-center text-outline hover:bg-surface-container-low transition-colors">
                                                                                        <span
                                                                                            class="material-symbols-outlined text-sm">chevron_right</span>
                                                                                    </a>
                                                                                    <% } else { %>
                                                                                        <span
                                                                                            class="w-8 h-8 rounded border border-outline-variant/15 flex items-center justify-center text-outline/30 cursor-not-allowed">
                                                                                            <span
                                                                                                class="material-symbols-outlined text-sm">chevron_right</span>
                                                                                        </span>
                                                                                        <% } %>
                                </div>
                            </div>
                        </div>
    </main>
    <!-- Contextual Security Chip (Fixed Bottom Right) -->
    <div
        class="fixed bottom-6 right-8 bg-tertiary-container/80 backdrop-blur-md px-4 py-2 rounded-full flex items-center gap-2 shadow-lg">
        <span class="material-symbols-outlined text-on-tertiary-container text-sm"
            data-icon="verified_user">verified_user</span>
        <span class="text-[10px] font-bold uppercase tracking-widest text-on-tertiary-container">Encrypted
            Environment</span>
    </div>
    <!-- Create User Modal -->
    <div id="createModal"
        class="fixed inset-0 z-50 flex items-center justify-center bg-black/30 backdrop-blur-sm hidden">
        <div class="bg-surface-container-lowest rounded-xl shadow-2xl w-full max-w-md mx-4 overflow-hidden">

            <!-- Modal Header -->
            <div class="flex items-center justify-between px-6 py-5 border-b border-outline-variant/10">
                <h2 class="text-lg font-bold font-manrope text-on-surface">New Client</h2>
                <button onclick="closeModal()" class="text-outline hover:text-on-surface transition-colors">
                    <span class="material-symbols-outlined">close</span>
                </button>
            </div>

            <!-- Error Message -->
            <% if (typeof createError !=='undefined' && createError) { %>
                <div class="mx-6 mt-4 px-4 py-3 bg-error-container/20 text-on-error-container text-sm rounded-lg">
                    <%= createError %>
                </div>
                <% } %>

                    <!-- Modal Form -->
                    <form action="/admin/user-management/create" method="POST" class="px-6 py-6 flex flex-col gap-4">

                        <div class="flex flex-col gap-1.5">
                            <label class="text-[11px] font-bold uppercase tracking-widest text-on-surface-variant">Full
                                Name</label>
                            <input type="text" name="name" placeholder="John Doe" required
                                class="bg-surface-container border border-outline-variant/20 rounded-lg px-4 py-2.5 text-sm text-on-surface focus:outline-none focus:ring-1 focus:ring-secondary transition-all" />
                        </div>

                        <div class="flex flex-col gap-1.5">
                            <label class="text-[11px] font-bold uppercase tracking-widest text-on-surface-variant">Email
                                Address</label>
                            <input type="email" name="email" placeholder="client@example.com" required
                                class="bg-surface-container border border-outline-variant/20 rounded-lg px-4 py-2.5 text-sm text-on-surface focus:outline-none focus:ring-1 focus:ring-secondary transition-all" />
                        </div>

                        <div class="flex flex-col gap-1.5">
                            <label
                                class="text-[11px] font-bold uppercase tracking-widest text-on-surface-variant">Password</label>
                            <div class="relative">
                                <input id="modalPassword" type="password" name="password" placeholder="••••••••"
                                    required
                                    class="w-full bg-surface-container border border-outline-variant/20 rounded-lg px-4 py-2.5 text-sm text-on-surface focus:outline-none focus:ring-1 focus:ring-secondary transition-all" />
                                <button type="button" onclick="toggleModalPassword()"
                                    class="absolute right-3 top-1/2 -translate-y-1/2 text-outline hover:text-on-surface transition-colors">
                                    <span class="material-symbols-outlined text-sm"
                                        id="modalPasswordIcon">visibility</span>
                                </button>
                            </div>
                        </div>

                        <!-- Actions -->
                        <div class="flex items-center justify-end gap-3 pt-2">
                            <button type="button" onclick="closeModal()"
                                class="px-5 py-2.5 rounded-md text-sm font-semibold text-on-surface-variant hover:bg-surface-container-low transition-all">
                                Cancel
                            </button>
                            <button type="submit"
                                class="bg-gradient-to-br from-primary to-secondary text-on-primary px-5 py-2.5 rounded-md text-sm font-semibold hover:-translate-y-0.5 shadow-sm transition-all">
                                Create Client
                            </button>
                        </div>

                    </form>
        </div>
    </div>
    <script>
        const modal = document.getElementById('createModal');

        function openModal() {
            modal.classList.remove('hidden');
        }

        function closeModal() {
            modal.classList.add('hidden');
        }

        // close on backdrop click
        modal.addEventListener('click', (e) => {
            if (e.target === modal) closeModal();
        });

        function toggleModalPassword() {
            const input = document.getElementById('modalPassword');
            const icon = document.getElementById('modalPasswordIcon');
            if (input.type === 'password') {
                input.type = 'text';
                icon.textContent = 'visibility_off';
            } else {
                input.type = 'password';
                icon.textContent = 'visibility';
            }
        }

  
  <% if (typeof createError !== 'undefined' && createError) { %>
            openModal();
  <% } %>
    </script>
</body>

</html>