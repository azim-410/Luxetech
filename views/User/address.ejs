<!DOCTYPE html>

<html class="light" lang="en">

<head>
  <meta charset="utf-8" />
  <meta content="width=device-width, initial-scale=1.0" name="viewport" />
  <title>Luxe Tech - Saved Addresses</title>
  <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
  <link
    href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;600;700;800&amp;family=Inter:wght@400;500;600&amp;display=swap"
    rel="stylesheet" />
  <link
    href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap"
    rel="stylesheet" />
  <link href="/User/css/main-global.css" rel="stylesheet" />
  <link href="/User/css/loading-bar.css" rel="stylesheet" />
  <style>
    .material-symbols-outlined {
      font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
    }

    #addAddressModal .modal-scroll::-webkit-scrollbar {
      display: none;
    }

    #addAddressModal .modal-scroll {
      -ms-overflow-style: none;
      scrollbar-width: none;
    }
  </style>
  <script id="tailwind-config">
    tailwind.config = {
      darkMode: "class",
      theme: {
        extend: {
          colors: {
            "on-background": "#191c1e",
            "secondary-fixed-dim": "#afcbd8",
            "on-secondary": "#ffffff",
            "surface-container": "#eceef1",
            "on-tertiary-fixed-variant": "#7a3000",
            "on-surface": "#191c1e",
            "tertiary": "#000000",
            "surface-container-high": "#e6e8eb",
            "outline": "#74777d",
            "error-container": "#ffdad6",
            "surface-container-highest": "#e0e3e6",
            "on-tertiary-container": "#dc5d00",
            "on-tertiary": "#ffffff",
            "on-surface-variant": "#44474c",
            "error": "#ba1a1a",
            "surface-dim": "#d8dadd",
            "on-secondary-fixed-variant": "#304a55",
            "tertiary-container": "#341100",
            "on-error-container": "#93000a",
            "inverse-on-surface": "#eff1f4",
            "secondary-container": "#cbe7f5",
            "secondary": "#48626e",
            "primary-fixed": "#d9e2ff",
            "outline-variant": "#c4c6cc",
            "surface": "#f7f9fc",
            "inverse-surface": "#2d3133",
            "surface-variant": "#e0e3e6",
            "secondary-fixed": "#cbe7f5",
            "inverse-primary": "#b0c6ff",
            "primary-fixed-dim": "#b0c6ff",
            "on-primary-fixed-variant": "#00429c",
            "tertiary-fixed": "#ffdbcb",
            "surface-container-lowest": "#ffffff",
            "on-error": "#ffffff",
            "on-secondary-container": "#4e6874",
            "on-tertiary-fixed": "#341100",
            "surface-tint": "#2b5bb5",
            "primary-container": "#001945",
            "on-primary-fixed": "#001945",
            "primary": "#000000",
            "tertiary-fixed-dim": "#ffb692",
            "surface-bright": "#f7f9fc",
            "on-secondary-fixed": "#021f29",
            "on-primary-container": "#5781de",
            "surface-container-low": "#f2f4f7",
            "background": "#f7f9fc",
            "on-primary": "#ffffff"
          },
          fontFamily: {
            "headline": ["Manrope"],
            "body": ["Inter"],
            "label": ["Inter"]
          },
          borderRadius: { "DEFAULT": "0.125rem", "lg": "0.25rem", "xl": "0.5rem", "full": "0.75rem" },
        },
      },
    }
  </script>
</head>

<body class="bg-background text-on-background font-body">
  <%- include('../partials/loadingBar') %>
  <%- include('../partials/user/main-header', { user }) %>

    <% const dummyImgUrl = 'https://lh3.googleusercontent.com/aida-public/AB6AXuCjFumsIfpKweThkz0kigWDz4L3U_MlZOYAOjJqVe_fiTnzYV-LTpbevhNkCABEs92MYz-pOz4nfaNJ_ZaH-gt9q4BgY9RjUl8a828prR07HQSp1jOu-01gXC4efDLIQQTWkL40yxC7rdOXkerc1MPXQoaKtayglB0j0wCAVLobeEwrXuTSCDjMvdBsRuuTYFfuc2Tle7m9vQt41ZLWCIXDiTNkVuMlCqY4vlUjmcXOrGqfc269b-Zh8a-6CX3Ib2OtsJuKe0UHik0'; %>
      <div class="flex min-h-screen">
        <%- include('../partials/user/profile-sidebar', { user, dummyImgUrl }) %>
          <!-- Main Content -->
          <main class="profile-main flex-1 lg:ml-64 p-6 lg:p-12">
            <div class="max-w-5xl mx-auto">
              <header class="mb-12 flex flex-col md:flex-row md:items-end justify-between gap-6">
                <div>
                  <h1 class="font-headline text-4xl font-extrabold tracking-tight text-on-background">Saved Addresses
                  </h1>
                  <p class="text-on-surface-variant mt-2 max-w-lg">Manage your delivery destinations for seamless
                    precision ordering.</p>
                </div>
                <button data-open="addAddress"
                  class="bg-primary-container text-on-primary-container hover:bg-black hover:text-white px-6 py-3 rounded-md font-label text-sm font-bold uppercase tracking-wider flex items-center gap-2 transition-all active:scale-95">
                  <span class="material-symbols-outlined text-sm">add</span>
                  Add New Address
                </button>
              </header>
              <!-- Address Grid: Bento Style -->
              <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-6">
                <% if(address && address.length> 0){%>
                  <% address.forEach(address=>{ %>
                    <div
                      class="bg-surface-container-lowest p-8 rounded-xl border border-outline-variant/15 group hover:border-surface-tint transition-all duration-300 shadow-sm">
                      <div class="flex justify-between items-start mb-6">
                        <div
                          class="bg-secondary-container text-on-secondary-container px-3 py-1 rounded-full text-[10px] font-bold uppercase tracking-widest flex items-center gap-1">
                          <span class="material-symbols-outlined text-sm">
                            <%= address.type === 'office' ? 'work' : address.type === 'other' ? 'location_on' : 'home' %>
                          </span>
                          <%= address.type || 'home' %>
                        </div>
                        <div class="flex gap-2">
                          <button
                            class="edit-address-btn flex items-center gap-1.5 px-3 py-1.5 hover:bg-surface-container-high rounded-md text-on-surface-variant transition-colors text-xs font-semibold"
                            title="Edit"
                            data-id="<%= address._id %>"
                            data-fullname="<%= address.fullName %>"
                            data-street="<%= address.streetAddress %>"
                            data-city="<%= address.city %>"
                            data-zip="<%= address.zipCode %>"
                            data-state="<%= address.state %>"
                            data-country="<%= address.country %>"
                            data-phone="<%= address.phoneNumber %>"
                            data-type="<%= address.type %>"
                            data-default="<%= address.isDefault %>">
                            <span class="material-symbols-outlined text-base">edit</span>
                            Edit
                          </button>
                          <button
                            class="delete-address-btn flex items-center gap-1.5 px-3 py-1.5 hover:bg-error-container hover:text-error rounded-md text-on-surface-variant transition-colors text-xs font-semibold"
                            data-id="<%= address._id %>" title="Delete">
                            <span class="material-symbols-outlined text-base">delete</span>
                            Remove
                          </button>
                        </div>
                      </div>
                      <div class="space-y-4">
                        <div>
                          <h3 class="font-headline text-xl font-bold text-on-background">
                            <%= address.fullName %>
                          </h3>
                        </div>
                        <div class="text-on-surface leading-relaxed">
                          <p>
                            <%= address.streetAddress %>
                          </p>
                          <p>
                            <%= address.city %>, <%= address.state %>
                          </p>
                          <p>
                            <%= address.zipCode %>, <%= address.country %>
                          </p>
                        </div>
                        <div
                          class="pt-4 border-t border-outline-variant/10 flex items-center gap-2 text-on-surface-variant text-sm">
                          <span class="material-symbols-outlined text-base">call</span>
                          <%= address.phoneNumber %>
                        </div>
                      </div>
                    </div>

                    <% }) %>
                      <% } else { %>
                        <div class="col-span-full text-center py-16 text-on-surface-variant">
                          <span class="material-symbols-outlined text-5xl mb-4 block">location_off</span>
                          <p class="font-headline font-bold text-lg">No addresses saved yet</p>
                          <p class="text-sm mt-1">Click "Add New Address" to get started.</p>
                        </div>
                        <% } %>
              </div>
            </div><!-- /.max-w-5xl -->
          </main>
          <%- include('../partials/user/profile-mobile-nav') %>
      </div>
      <!-- Delete Address Confirmation Modal -->
      <div id="deleteAddressModal" class="fixed inset-0 z-[300] hidden items-center justify-center p-4">
        <div class="absolute inset-0 bg-black/40 backdrop-blur-sm"></div>
        <div class="relative bg-white rounded-2xl shadow-2xl w-full max-w-sm p-8 z-10 text-center">

          <!-- Icon -->
          <div class="w-14 h-14 bg-error-container rounded-full flex items-center justify-center mx-auto mb-4">
            <span class="material-symbols-outlined text-2xl text-error">delete</span>
          </div>

          <h3 class="font-headline text-lg font-extrabold tracking-tight mb-2">Remove Address?</h3>
          <p class="text-xs text-on-surface-variant mb-8">This address will be permanently removed from your saved
            locations.</p>

          <div class="flex gap-3">
            <button type="button" id="cancelDeleteAddressBtn"
              class="flex-1 px-6 py-2.5 border border-outline-variant text-on-surface-variant text-xs font-bold uppercase tracking-wider rounded-md hover:bg-surface-container transition-all">
              Cancel
            </button>
            <button type="button" id="confirmDeleteAddressBtn"
              class="flex-1 px-6 py-2.5 bg-primary text-white text-xs font-bold uppercase tracking-wider rounded-md hover:bg-slate-800 transition-all active:scale-95">
              Remove
            </button>
          </div>
        </div>
      </div>
      <!-- Add Address Modal -->
      <div id="addAddressModal" class="fixed inset-0 z-[300] hidden items-end sm:items-center justify-center sm:py-8 sm:px-4">
        <div class="absolute inset-0 bg-black/40 backdrop-blur-sm"></div>
        <div
          class="relative bg-white rounded-t-2xl sm:rounded-2xl shadow-2xl w-full sm:w-[90%] sm:max-w-xl z-10 max-h-[92vh] sm:max-h-[85vh] overflow-y-auto modal-scroll">
          <!-- Drag handle (mobile only) -->
          <div class="flex justify-center pt-3 pb-1 sm:hidden">
            <div class="w-10 h-1 bg-outline-variant rounded-full"></div>
          </div>
          <!-- Header -->
          <div class="px-5 pt-3 pb-0 sm:p-8 sm:pb-0">
            <div class="flex items-start justify-between mb-2">
              <div>
                <h2 id="addressModalTitle" class="font-headline text-2xl font-extrabold tracking-tight">Create new Address</h2>
                <p id="addressModalSubtitle" class="text-xs text-on-surface-variant mt-1">Provide your delivery information below to ensure your
                  precision instruments arrive safely and on time.</p>
              </div>
              <button id="closeAddAddressBtn" type="button"
                class="w-8 h-8 flex items-center justify-center rounded-full hover:bg-surface-container transition-colors ml-4 mt-1">
                <span class="material-symbols-outlined text-sm">close</span>
              </button>
            </div>
          </div>

         <form id="addAddressForm" action="/address/add" method="POST" class="px-5 py-4 sm:p-8 space-y-4 sm:space-y-5">

            <%# ── Top-level error banner (uses locals for safety) ── %>
            <% const _errors = locals.errors || locals.editErrors || {}; %>
            <% const _formData = locals.formData || locals.editFormData || {}; %>
            <% if (Object.keys(_errors).length > 0) { %>
              <div class="flex items-start gap-3 bg-error-container text-on-error-container rounded-lg px-4 py-3 text-xs">
                <span class="material-symbols-outlined text-base shrink-0 mt-0.5">error</span>
                <div>
                  <p class="font-bold">Please fix <%= Object.keys(_errors).length %> error<%= Object.keys(_errors).length > 1 ? 's' : '' %> below</p>
                  <p class="font-normal mt-0.5 opacity-80">Check the highlighted fields and try again.</p>
                </div>
              </div>
            <% } %>

            <!-- Full Name -->
            <div class="space-y-1.5">
              <label class="text-[11px] font-bold uppercase tracking-widest text-on-surface-variant">Full Name</label>
              <input type="text" name="fullName" placeholder="E.g. Alexander Vance"
                value="<%= _formData.fullName || '' %>"
                class="w-full bg-surface-container-low rounded-lg px-4 py-3 text-sm border <%= _errors.fullName ? 'border-error' : 'border-outline-variant/30' %> focus:ring-2 focus:ring-primary focus:outline-none transition-all" />
              <% if (_errors.fullName) { %>
                  <p class="text-[10px] text-error mt-1"><%= _errors.fullName %></p>
              <% } %>
            </div>

            <!-- Street Address (Fixed name) -->
            <div class="space-y-1.5">
              <label class="text-[11px] font-bold uppercase tracking-widest text-on-surface-variant">Street Address</label>
              <input type="text" name="streetAddress" placeholder="123 Precision Way"
                value="<%= _formData.streetAddress || '' %>"
                class="w-full bg-surface-container-low rounded-lg px-4 py-3 text-sm border <%= _errors.streetAddress ? 'border-error' : 'border-outline-variant/30' %> focus:ring-2 focus:ring-primary focus:outline-none transition-all" />
              <% if (_errors.streetAddress) { %>
                  <p class="text-[10px] text-error mt-1"><%= _errors.streetAddress %></p>
              <% } %>
            </div>

            <!-- City + ZIP -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div class="space-y-1.5">
                <label class="text-[11px] font-bold uppercase tracking-widest text-on-surface-variant">City</label>
                <input type="text" name="city" placeholder="San Francisco"
                  value="<%= _formData.city || '' %>"
                  class="w-full bg-surface-container-low rounded-lg px-4 py-3 text-sm border <%= _errors.city ? 'border-error' : 'border-outline-variant/30' %> focus:ring-2 focus:ring-primary focus:outline-none transition-all" />
                <% if (_errors.city) { %>
                    <p class="text-[10px] text-error mt-1"><%= _errors.city %></p>
                <% } %>
              </div>
              <div class="space-y-1.5">
                <label class="text-[11px] font-bold uppercase tracking-widest text-on-surface-variant">ZIP / Postal Code</label>
                <input type="text" name="zipCode" placeholder="94103"
                  value="<%= _formData.zipCode || '' %>"
                  class="w-full bg-surface-container-low rounded-lg px-4 py-3 text-sm border <%= _errors.zipCode ? 'border-error' : 'border-outline-variant/30' %> focus:ring-2 focus:ring-primary focus:outline-none transition-all" />
                <% if (_errors.zipCode) { %>
                    <p class="text-[10px] text-error mt-1"><%= _errors.zipCode %></p>
                <% } %>
              </div>
            </div>

            <!-- State + Country -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div class="space-y-1.5">
                <label class="text-[11px] font-bold uppercase tracking-widest text-on-surface-variant">State / Province</label>
                <input type="text" name="state" placeholder="California"
                  value="<%= _formData.state || '' %>"
                  class="w-full bg-surface-container-low rounded-lg px-4 py-3 text-sm border <%= _errors.state ? 'border-error' : 'border-outline-variant/30' %> focus:ring-2 focus:ring-primary focus:outline-none transition-all" />
                <% if (_errors.state) { %>
                    <p class="text-[10px] text-error mt-1"><%= _errors.state %></p>
                <% } %>
              </div>
              <div class="space-y-1.5">
                <label class="text-[11px] font-bold uppercase tracking-widest text-on-surface-variant">Country</label>
                <input type="text" name="country" placeholder="India"
                  value="<%= _formData.country || '' %>"
                  class="w-full bg-surface-container-low rounded-lg px-4 py-3 text-sm border <%= _errors.country ? 'border-error' : 'border-outline-variant/30' %> focus:ring-2 focus:ring-primary focus:outline-none transition-all" />
                <% if (_errors.country) { %>
                    <p class="text-[10px] text-error mt-1"><%= _errors.country %></p>
                <% } %>
              </div>
            </div>

            <!-- Phone (Fixed name) -->
            <div class="space-y-1.5">
              <label class="text-[11px] font-bold uppercase tracking-widest text-on-surface-variant">Phone Number</label>
              <input type="text" name="phoneNumber" placeholder="+1 (555) 000-0000"
                value="<%= _formData.phoneNumber || '' %>"
                class="w-full bg-surface-container-low rounded-lg px-4 py-3 text-sm border <%= _errors.phoneNumber ? 'border-error' : 'border-outline-variant/30' %> focus:ring-2 focus:ring-primary focus:outline-none transition-all" />
              <% if (_errors.phoneNumber) { %>
                  <p class="text-[10px] text-error mt-1"><%= _errors.phoneNumber %></p>
              <% } %>
            </div>

            <!-- Address Type -->
            <div class="space-y-1.5">
              <label class="text-[11px] font-bold uppercase tracking-widest text-on-surface-variant">Address Type</label>
              <select id="addressTypeSelect" name="type"
                class="w-full bg-surface-container-low rounded-lg px-4 py-3 text-sm border border-outline-variant/30 focus:ring-2 focus:ring-primary focus:outline-none transition-all">
                <option value="home" <%= _formData.type === 'home' ? 'selected' : '' %>>Home</option>
                <option value="office" <%= _formData.type === 'office' ? 'selected' : '' %>>Office</option>
                <option value="other" <%= _formData.type === 'other' ? 'selected' : '' %>>Other</option>
              </select>
            </div>

            <!-- Default toggle -->
            <div class="flex items-center justify-between bg-surface-container-low rounded-lg px-4 py-3 border border-outline-variant/30">
              <div>
                <p class="text-xs font-bold uppercase tracking-widest">Set as Default Address</p>
                <p class="text-[10px] text-on-surface-variant mt-0.5">Used for faster checkout</p>
              </div>
              <label class="relative inline-flex items-center cursor-pointer">
                <input id="addressIsDefaultChk" type="checkbox" name="isDefault" value="true" class="sr-only peer" <%= _formData.isDefault ? 'checked' : '' %> />
                <div class="w-10 h-6 bg-outline-variant rounded-full peer peer-checked:bg-primary transition-colors"></div>
                <div class="absolute left-1 top-1 w-4 h-4 bg-white rounded-full transition-transform peer-checked:translate-x-4"></div>
              </label>
            </div>

            <!-- Actions -->
            <div class="flex gap-3 pt-2">
              <button id="addressModalSubmitBtn" type="submit"
                class="flex-1 py-3 bg-primary text-white text-xs font-bold uppercase tracking-wider rounded-md hover:bg-slate-800 transition-all active:scale-95">
                Save Address
              </button>
              <a href="/address" id="cancelAddAddressBtn"
                class="flex-1 py-3 border border-outline-variant text-on-surface-variant text-xs font-bold uppercase tracking-wider rounded-md hover:bg-surface-container transition-all text-center">
                Cancel
              </a>
            </div>
          </form>


          <!-- Footer -->
          <div class="px-5 sm:px-8 pb-6 flex items-center justify-center gap-6 text-[10px] text-on-surface-variant">
            <div class="flex items-center gap-1">
              <span class="material-symbols-outlined text-sm">lock</span>
              Secure Encryption
            </div>
            <div class="flex items-center gap-1">
              <span class="material-symbols-outlined text-sm">sync</span>
              Instant Sync
            </div>
          </div>

        </div>
      </div>

      <script>

        // ── Grab references ────────────────────────────────────────────
        const modal          = document.getElementById('addAddressModal');
        const modalForm      = document.getElementById('addAddressForm');
        const modalTitle     = document.getElementById('addressModalTitle');
        const modalSubtitle  = document.getElementById('addressModalSubtitle');
        const modalSubmitBtn = document.getElementById('addressModalSubmitBtn');
        const typeSelect     = document.getElementById('addressTypeSelect');
        const isDefaultChk   = document.getElementById('addressIsDefaultChk');

        // All plain text inputs inside the form (by name)
        function field(name) { return modalForm.querySelector(`[name="${name}"]`); }

        // ── Open / Close helpers ───────────────────────────────────────
        function openModal() {
          modal.classList.remove('hidden');
          modal.classList.add('flex');
        }
        function closeModal() {
          clearErrors();
          modal.classList.add('hidden');
          modal.classList.remove('flex');
        }

        // ── Clear all server-rendered validation errors inside the form ─
        function clearErrors() {
          // Remove the top-level error banner
          const banner = modalForm.querySelector('.bg-error-container');
          if (banner) banner.remove();

          // Remove all per-field error messages
          modalForm.querySelectorAll('p.text-error').forEach(el => el.remove());

          // Reset all red-bordered inputs back to normal border
          modalForm.querySelectorAll('input.border-error, select.border-error').forEach(el => {
            el.classList.remove('border-error');
            el.classList.add('border-outline-variant\\/30');
          });
        }

        // ── Reset modal back to "Add" mode ─────────────────────────────
        function setAddMode() {
          clearErrors();
          modalForm.action       = '/address/add';
          modalTitle.textContent = 'Create new Address';
          modalSubtitle.textContent = 'Provide your delivery information below to ensure your precision instruments arrive safely and on time.';
          modalSubmitBtn.textContent = 'Save Address';
          // Clear all fields
          ['fullName','streetAddress','city','zipCode','state','country','phoneNumber'].forEach(n => field(n).value = '');
          typeSelect.value    = 'home';
          isDefaultChk.checked = false;
        }

        // ── "Add New Address" button ───────────────────────────────────
        const addAddressBtn = document.querySelector('[data-open="addAddress"]');
        addAddressBtn.addEventListener('click', () => {
          setAddMode();
          openModal();
        });

        // ── Close buttons ──────────────────────────────────────────────
        document.getElementById('closeAddAddressBtn').addEventListener('click', closeModal);
        document.getElementById('cancelAddAddressBtn').addEventListener('click', closeModal);

        // Close on backdrop click
        const modalBackdrop = modal.querySelector('.absolute.inset-0');
        if (modalBackdrop) modalBackdrop.addEventListener('click', closeModal);

        // Close on Escape key
        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape') closeModal();
        });

        // ── Edit buttons — switch to "Edit" mode ───────────────────────
        document.querySelectorAll('.edit-address-btn').forEach(btn => {
          btn.addEventListener('click', () => {
            clearErrors();
            // Change modal to Edit mode
            modalForm.action       = `/address/edit/${btn.dataset.id}`;
            modalTitle.textContent = 'Edit Address';
            modalSubtitle.textContent = 'Update your delivery information below.';
            modalSubmitBtn.textContent = 'Save Changes';

            // Pre-fill fields with this address's data
            field('fullName').value      = btn.dataset.fullname;
            field('streetAddress').value = btn.dataset.street;
            field('city').value          = btn.dataset.city;
            field('zipCode').value       = btn.dataset.zip;
            field('state').value         = btn.dataset.state;
            field('country').value       = btn.dataset.country;
            field('phoneNumber').value   = btn.dataset.phone;
            typeSelect.value             = btn.dataset.type || 'home';
            isDefaultChk.checked         = (btn.dataset.default === 'true');

            openModal();
          });
        });

        // ── Auto-open on server-side validation errors ─────────────────
        <% if (locals.errors && Object.keys(errors).length > 0) { %>
        // Add errors: modal stays in Add mode (form action is already /address/add from HTML)
        openModal();
        <% } %>

        <% if (locals.editErrors && Object.keys(editErrors).length > 0) { %>
        // Edit errors: switch to Edit mode then open
        modalForm.action           = `/address/edit/<%= locals.editAddressId %>`;
        modalTitle.textContent     = 'Edit Address';
        modalSubtitle.textContent  = 'Update your delivery information below.';
        modalSubmitBtn.textContent = 'Save Changes';
        openModal();
        <% } %>

        // ── Client-side form validation ───────────────────────────────
        function showFieldError(name, message) {
          const input = field(name);
          if (input) {
            input.classList.remove('border-outline-variant/30', 'border-outline-variant\\/30');
            input.classList.add('border-error');
            
            const errP = document.createElement('p');
            errP.className = 'text-[10px] text-error mt-1';
            errP.textContent = message;
            input.parentNode.appendChild(errP);
          }
        }

        function showTopBanner(form, message) {
          const container = document.createElement('div');
          container.className = 'flex items-start gap-3 bg-error-container text-on-error-container rounded-lg px-4 py-3 text-xs';
          container.innerHTML = `
            <span class="material-symbols-outlined text-base shrink-0 mt-0.5">error</span>
            <div>
              <p class="font-bold">${message}</p>
            </div>
          `;
          form.insertBefore(container, form.firstChild);
        }

        modalForm.addEventListener('submit', (e) => {
          clearErrors();
          let hasError = false;

          const fullName = field('fullName').value.trim();
          const streetAddress = field('streetAddress').value.trim();
          const city = field('city').value.trim();
          const zipCode = field('zipCode').value.trim();
          const state = field('state').value.trim();
          const country = field('country').value.trim();
          const phoneNumber = field('phoneNumber').value.trim();

          if (!fullName) {
            showFieldError('fullName', 'Full name is required.');
            hasError = true;
          } else if (fullName.length < 3) {
            showFieldError('fullName', 'Full name must be at least 3 characters.');
            hasError = true;
          }

          if (!streetAddress) {
            showFieldError('streetAddress', 'Street address is required.');
            hasError = true;
          }

          if (!city) {
            showFieldError('city', 'City is required.');
            hasError = true;
          }

          if (!zipCode) {
            showFieldError('zipCode', 'Zip code is required.');
            hasError = true;
          }

          if (!state) {
            showFieldError('state', 'State is required.');
            hasError = true;
          }

          if (!country) {
            showFieldError('country', 'Country is required.');
            hasError = true;
          }

          if (!phoneNumber) {
            showFieldError('phoneNumber', 'Phone number is required.');
            hasError = true;
          } else if (!/^[0-9]{10}$/.test(phoneNumber)) {
            showFieldError('phoneNumber', 'Phone number must be exactly 10 digits (no spaces or dashes).');
            hasError = true;
          } else if (/^(\d)\1{9}$/.test(phoneNumber)) {
            showFieldError('phoneNumber', 'Phone number cannot consist of the same digit repeated.');
            hasError = true;
          }

          if (hasError) {
            e.preventDefault();
            showTopBanner(modalForm, 'Please fix the highlighted errors below.');
          }
        });

        // ── Delete modal ───────────────────────────────────────────────
        const deleteModal    = document.getElementById('deleteAddressModal');
        const cancelDeleteBtn  = document.getElementById('cancelDeleteAddressBtn');
        const confirmDeleteBtn = document.getElementById('confirmDeleteAddressBtn');
        let deleteTargetId = null;

        document.querySelectorAll('.delete-address-btn').forEach(btn => {
          btn.addEventListener('click', () => {
            deleteTargetId = btn.dataset.id;
            deleteModal.classList.remove('hidden');
            deleteModal.classList.add('flex');
          });
        });

        cancelDeleteBtn.addEventListener('click', () => {
          deleteModal.classList.add('hidden');
          deleteModal.classList.remove('flex');
          deleteTargetId = null;
        });

        confirmDeleteBtn.addEventListener('click', () => {
          if (!deleteTargetId) return;
          const form = document.createElement('form');
          form.method = 'POST';
          form.action = `/address/delete/${deleteTargetId}`;
          document.body.appendChild(form);
          form.submit();
        });

        deleteModal.addEventListener('click', (e) => {
          if (e.target === deleteModal) {
            deleteModal.classList.add('hidden');
            deleteModal.classList.remove('flex');
            deleteTargetId = null;
          }
        });

      </script>
      <script src="/User/js/loading-bar.js"></script>
</body>

</html>