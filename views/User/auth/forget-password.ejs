<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Forgot Password | Luxe Tech</title>
  <link rel="stylesheet" href="/User/css/auth-global.css">
  <link rel="stylesheet" href="/User/css/forget-password.css">
</head>

<body>

  <!-- <header class="header">
    <div class="header-container">
      <div class="logo">TechLens</div>
      <button class="nav-icon-btn">
        <span class="material-symbols-outlined">help_outline</span>
      </button>
    </div>
  </header> -->
  <%- include("../../partials/user/auth-header.ejs") %>
  <div class="decor-background">
    <div class="blob blob-top-right"></div>
    <div class="blob blob-bottom-left"></div>
  </div>

  <main class="viewport-center">
    <div class="auth-wrapper">
      <div class="auth-card animate-in">

        <div class="card-intro">
          <div class="icon-circle">
            <span class="material-symbols-outlined text-primary text-3xl">key</span>
          </div>
          <h1>Forgot Password?</h1>
          <p>No worries. Enter your email and we'll send you a precision recovery code to reset your account access.</p>
        </div>

        <form class="auth-form" action="/forget-password" method="POST">
          <div class="input-stack">
            <label for="email">Email</label>
            <div class="input-relative">
              <input type="email" id="email" name="email" placeholder="name@gmail.com" required>
              <span class="material-symbols-outlined input-icon">alternate_email</span>
            </div>
          </div>
          
          <% if (locals.errorMessage) { %>
            <div class="general-error" role="alert">
              <span class="material-symbols-outlined" style="font-size:1rem;vertical-align:middle;margin-right:6px;">error</span>
              <%= errorMessage %>
            </div>
          <% } %>
          
          <div class="action-stack">
            <button type="submit" class="btn-main">Send Code</button>
            <a href="login" class="back-link">
              <span class="material-symbols-outlined">arrow_back</span>
              Back to Login
            </a>
          </div>
        </form>
        
        <div class="trust-footer">
          <div class="trust-badge">
            <span class="material-symbols-outlined">verified_user</span>
            <span>Secure Entry</span>
          </div>
          <div class="trust-badge">
            <span class="material-symbols-outlined">encrypted</span>
            <span>SSL Encrypted</span>
          </div>
        </div>
      </div>
      
      <p class="support-text">
        If you no longer have access to this email, please contact our
        <a href="#" class="text-link">Precision Support</a> team.
      </p>
    </div>
  </main>

  <!-- <footer class="footer">
    <div class="footer-container">
      <div class="footer-brand">TechLens</div>
      <div class="legal">© 2024 TechLens Precision. All rights reserved.</div>
      <div class="footer-links">
        <a href="#">Privacy Policy</a>
        <a href="#">Terms of Service</a>
        <a href="#">Support</a>
      </div>
    </div>
  </footer> -->
   <%- include("../../partials/user/auth-footer.ejs") %>
</body>

</html>