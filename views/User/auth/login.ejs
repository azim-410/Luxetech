<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Login | LUXE TECH</title>
  <link rel="stylesheet" href="/User/css/auth-global.css">
  <link rel="stylesheet" href="/User/css/login.css">
</head>

<body>

  <!-- <nav class="header">
    <div class="header-content">
      <div class="logo">LUXE TECH</div>
    </div>
  </nav> -->
  <%- include("../../partials/user/auth-header.ejs") %>
    <main class="viewport-center">
      <div class="login-card animate-in">
        <header class="card-intro">
          <h1>Welcome Back</h1>
          <p>Enter your credentials to access your account</p>
        </header>

        <form class="login-form" action="/login" method="POST">
          <% if (locals.successMessage) { %>
            <div class="general-success">✓ <%= locals.successMessage %>
            </div>
          <% } %>
          <% if (locals.errorField==='global' || locals.errorField==='general' ) { %>
            <div class="general-error">⚠ <%= locals.errorMessage %>
            </div>
            <% } %>

              <div class="input-stack">
                <label>Email Address</label>
                <input type="email" name="email" placeholder="name@company.com"
                  value="<%= locals.formData?.email || '' %>">
                <% if (locals.errorField==='email' ) { %>
                  <p class="field-error">
                    <%= locals.errorMessage %>
                  </p>
                  <% } %>
              </div>

              <div class="input-stack">
                <div class="split-label">
                  <label>Password</label>
                  <a href="forget-password" class="text-link small">Forgot Password?</a>
                </div>
                <div class="password-wrapper">
                  <input type="password" name="password" id="password" placeholder="••••••••"
                    value="<%= locals.formData?.password || '' %>">
                  <button type="button" id="togglePassword" class="eye-btn">
                    <span class="material-symbols-outlined" id="eyeIcon">visibility</span>
                  </button>
                </div>
                <% if (locals.errorField==='password' ) { %>
                  <p class="field-error">
                    <%= locals.errorMessage %>
                  </p>
                  <% } %>
              </div>
              <button type="submit" class="btn-main">Sign In</button>
        </form>

        <div class="divider">
          <span>Or continue with</span>
        </div>

        <!-- Just wrap your existing button with this anchor tag -->
        <a href="/auth/google" style="text-decoration: none;">
          <button class="btn-google-dark">
            <svg class="white-icon" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
              <path
                d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"
                fill="#4285F4" />
              <path
                d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"
                fill="#34A853" />
              <path
                d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"
                fill="#FBBC05" />
              <path
                d="M12 5.38c1.62 0 3.06.56 4.21 1.66l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"
                fill="#EA4335" />
            </svg>
            <span>Continue with Google</span>
          </button>
        </a>

        <p class="signup-prompt">
          Don't have an account? <a href="register" class="text-link bold">Create account</a>
        </p>
      </div>
    </main>

    <!-- <footer class="footer">
    <div class="footer-content-wrap">
      <div class="footer-brand">LUXE TECH</div>
      <div class="footer-links">
