<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Verify Your Identity | TechLens</title>

    <link rel="stylesheet" href="/User/css/auth-global.css" />
    <link rel="stylesheet" href="/User/css/otp-verification.css" />
</head>

<body>
    <!-- <header class="top-nav">
        <div class="nav-container">
            <div class="brand">TechLens</div>
            <button class="help-btn" aria-label="Help">
                <span class="material-symbols-outlined">help_outline</span>
            </button>
        </div>
    </header> -->
    <%- include("../../partials/user/auth-header.ejs") %>
        <main class="content-area">
            <div class="card-wrapper">
                <div class="decor-circle decor-top-left"></div>
                <div class="decor-circle decor-bottom-right"></div>

                <div class="card animate-in">

                    <div class="card-header">
                        <div class="icon-container">
                            <span class="material-symbols-outlined icon-vibration">vibration</span>
                        </div>
                        <h1>Two-Step Verification</h1>
                        <p>Enter the 6-digit code sent to <span class="email-highlight"><%= locals.email || 'your email' %></span></p>
                        <% if (locals.errorMessage) { %>
                            <p style="color: red; font-size: 0.85rem; margin-top: 10px; text-align: center;">
                                <%= locals.errorMessage %>
                            </p>
                            <% } %>
                                <% if (locals.successMessage) { %>
                                    <p
                                        style="color: #27ae60; font-size: 0.85rem; margin-top: 10px; text-align: center;">
                                        <%= locals.successMessage %>
                                    </p>
                                    <% } %>
                                        <p id="client-error-message"
                                            style="display:none; color: red; font-size: 0.85rem; margin-top: 10px; text-align: center;">
                                        </p>
                    </div>

                    <form class="verification-form" action="<%= locals.actionUrl || '/verify-otp' %>" method="POST">
                        <div class="otp-inputs">
                            <input type="text" name="otp1" maxlength="1" inputmode="numeric" aria-label="Digit 1"
                                autofocus />
                            <input type="text" name="otp2" maxlength="1" inputmode="numeric" aria-label="Digit 2" />
                            <input type="text" name="otp3" maxlength="1" inputmode="numeric" aria-label="Digit 3" />
                            <input type="text" name="otp4" maxlength="1" inputmode="numeric" aria-label="Digit 4" />
                            <input type="text" name="otp5" maxlength="1" inputmode="numeric" aria-label="Digit 5" />
                            <input type="text" name="otp6" maxlength="1" inputmode="numeric" aria-label="Digit 6" />
                        </div>

                        <div class="form-actions">
                            <button type="submit" class="btn-primary">
                                Verify Identity
                                <span class="material-symbols-outlined btn-icon">arrow_forward</span>
                            </button>

                            <div class="resend-section">
                                <div class="resend-text">
                                    <span>Didn't receive the code?</span>
                                    <button type="button" class="btn-resend">Resend Code</button>
                                </div>

                                <div class="timer-badge">
                                    <span class="material-symbols-outlined timer-icon">timer</span>
                                    <span class="timer-display">Expires in</span>
                                </div>
                            </div>
                        </div>
                    </form>

                    <div class="trust-indicators">
                        <div class="trust-item">
                            <span class="material-symbols-outlined">verified_user</span>
                            <span>Secure Cloud</span>
                        </div>
                        <div class="trust-dot"></div>
                        <div class="trust-item">
                            <span class="material-symbols-outlined">encrypted</span>
                            <span>AES-256</span>
                        </div>
                    </div>

                </div>
            </div>
        </main>

        <!-- <footer class="bottom-footer">
        <div class="footer-container">
            <div class="footer-brand">TechLens</div>
            <div class="footer-links">
                <a href="#">Privacy Policy</a>
                <a href="#">Terms of Service</a>
                <a href="#">Support</a>
            </div>
            <p class="footer-copyright">© 2026 TechLens Precision. All rights reserved.</p>
        </div>
    </footer> -->
        <%- include("../../partials/user/auth-footer.ejs") %>
            <script>
                document.addEventListener('DOMContentLoaded', () => {

                    const inputs = document.querySelectorAll('.otp-inputs input');
                    const resendBtn = document.querySelector('.btn-resend');
                    const timerDisplay = document.querySelector('.timer-display');
                    const verifyBtn = document.querySelector('.btn-primary');
                    const form = document.querySelector('.verification-form');
                    const clientErrEl = document.querySelector('#client-error-message');

                    // ── Server-injected values ─────────────────────────────────────────
                    // Both are calculated fresh on every page request (including refresh).
                    let timeLeft = parseInt("<%= typeof remainingSeconds     !== 'undefined' ? remainingSeconds     : 0 %>") || 0;
                    let resendCooldown = parseInt("<%= typeof resendCooldownSeconds !== 'undefined' ? resendCooldownSeconds : 0 %>") || 0;

                    // ── Helpers ───────────────────────────────────────────────────────
                    const setClientError = (msg) => {
                        if (!clientErrEl) return;
                        clientErrEl.textContent = msg;
                        clientErrEl.style.display = msg ? 'block' : 'none';
                    };

                    const formatTime = (secs) => {
                        const m = Math.floor(secs / 60);
                        const s = secs % 60;
                        return `${m}:${s.toString().padStart(2, '0')}`;
                    };

                    // ── Render OTP expiry display & verify button ──────────────────────
                    const renderOtpTimer = () => {
                        if (timeLeft <= 0) {
                            timerDisplay.textContent = 'OTP Expired';
                            timerDisplay.style.color = 'red';
                            verifyBtn.disabled = true;
                            verifyBtn.style.opacity = '0.4';
                        } else {
                            timerDisplay.textContent = `Expires in ${formatTime(timeLeft)}`;
                            timerDisplay.style.color = '';
                            verifyBtn.disabled = false;
                            verifyBtn.style.opacity = '1';
                        }
                    };

                    // ── Render resend button (independent 60s cooldown) ───────────────
                    const renderResendBtn = () => {
                        if (timeLeft <= 0) {
                            // OTP expired → always enable resend regardless of cooldown
                            resendBtn.disabled = false;
                            resendBtn.style.opacity = '1';
                            resendBtn.style.cursor = 'pointer';
                            resendBtn.textContent = 'Request New OTP';
                        } else if (resendCooldown > 0) {
                            resendBtn.disabled = true;
                            resendBtn.style.opacity = '0.4';
                            resendBtn.style.cursor = 'not-allowed';
                            resendBtn.textContent = `Resend in ${resendCooldown}s`;
                        } else {
                            resendBtn.disabled = false;
                            resendBtn.style.opacity = '1';
                            resendBtn.style.cursor = 'pointer';
                            resendBtn.textContent = 'Resend Code';
                        }
                    };

                    // ── Initial render ────────────────────────────────────────────────
                    renderOtpTimer();
                    renderResendBtn();

                    // ── OTP expiry countdown (ticks every second) ─────────────────────
                    let otpIntervalId = null;
                    if (timeLeft > 0) {
                        otpIntervalId = setInterval(() => {
                            timeLeft--;
                            renderOtpTimer();
                            renderResendBtn(); // re-check in case OTP just expired
                            if (timeLeft <= 0) clearInterval(otpIntervalId);
                        }, 1000);
                    }

                    // ── Resend cooldown countdown (ticks every second, stops at 0) ────
                    let resendIntervalId = null;
                    if (resendCooldown > 0) {
                        resendIntervalId = setInterval(() => {
                            resendCooldown--;
                            renderResendBtn();
                            if (resendCooldown <= 0) clearInterval(resendIntervalId);
                        }, 1000);
                    }

                    // ── OTP input behaviour ───────────────────────────────────────────
                    inputs.forEach((input, index) => {
                        input.addEventListener('input', (e) => {
                            e.target.value = e.target.value.replace(/[^0-9]/g, '');
                            if (clientErrEl && clientErrEl.style.display === 'block') setClientError('');
                            if (e.target.value !== '' && index < inputs.length - 1) {
                                inputs[index + 1].focus();
                            }
                        });

                        input.addEventListener('keydown', (e) => {
                            if (e.key === 'Backspace' && e.target.value === '' && index > 0) {
                                inputs[index - 1].focus();
                            }
                        });

                        input.addEventListener('paste', (e) => {
                            e.preventDefault();
                            const pasted = e.clipboardData.getData('text').replace(/[^0-9]/g, '').slice(0, inputs.length);
                            pasted.split('').forEach((char, i) => {
                                inputs[i].value = char;
                                if (i < inputs.length - 1) inputs[i + 1].focus();
                                else inputs[i].focus();
                            });
                        });
                    });

                    // ── Form submit guard ─────────────────────────────────────────────
                    form.addEventListener('submit', (e) => {
                        const otpValue = Array.from(inputs).map(i => i.value.trim()).join('');
                        if (!/^[0-9]{6}$/.test(otpValue)) {
                            e.preventDefault();
                            setClientError('Please enter the full 6-digit verification code.');
                            return;
                        }
                        if (timeLeft <= 0) {
                            e.preventDefault();
                            setClientError('OTP has expired. Please request a new code.');
                        }
                    });

                    // ── Resend button ─────────────────────────────────────────────────
                    resendBtn.addEventListener('click', () => {
                        if (otpIntervalId) clearInterval(otpIntervalId);
                        if (resendIntervalId) clearInterval(resendIntervalId);
                        // Redirect to the GET resend route
                        const resendUrl = '<%= typeof resendUrl !== "undefined" ? resendUrl : "/resend-otp" %>';
                        window.location.href = resendUrl;
                    });

                });
            </script>
</body>

</html>