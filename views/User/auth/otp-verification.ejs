<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Verify Your Identity | TechLens</title>

    <link rel="stylesheet" href="/User/css/auth-global.css" />
    <link rel="stylesheet" href="/User/css/otp-verification.css" />
</head>

<body>
