<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Create Account | Luxe Tech Precision</title>
    <link rel="stylesheet" href="/User/css/auth-global.css" />
    <link rel="stylesheet" href="/User/css/register.css" />
</head>

<body>
    <!-- <header class="site-header">
        <div class="header-container">
            <span class="brand-logo">LUXE TECH</span>
        </div>
    </header> -->

    <%- include("../../partials/user/auth-header.ejs") %>

    
        <main class="main-content">
            <div class="signup-card animate-in">
                <section class="hero-column"
                    style="background-image: url('https://lh3.googleusercontent.com/aida-public/AB6AXuCon0eNmaajDcVddUCqiLNe33O-STtlr9UQcqc-7jXckH92QsKxj001M_D9Siu4C1BpRnd30FolVwdqxkkUkjg-CDC-hIocYQyXwlp_Ojfb7uuvStpiohAyQ1e4OMWby6lq-zKlkFTTxyupWzB8ARcVVyr5wWbhpkWe-5FlcLEfp6DhRTpd7WfAOYFmvcNDTc512gVeeTFAFoUExi3AdNn_KCNQjBkMy6cL2Pq5WFyZTsMOb0MMLvhnEmR-srwAnFm71yCMpajuNfI');">
                    <div class="hero-overlay"></div>
                    <div class="hero-content">
                        <span class="badge">MEMBER EXCLUSIVE</span>
                        <h1 class="hero-title">Precision built for the modern engineer.</h1>
                        <p class="hero-subtitle">
                            Join the ecosystem of elite technology and curated hardware precision.
                        </p>
                    </div>
                </section>
                <section class="form-section">
                    <div class="form-container">
                        <header class="form-header">
                            <h2>Create Account</h2>
                            <p>Start your journey into precision technology today.</p>
                        </header>

                        <form action="/register" method="POST" class="registration-form">

                            <% if (locals.errorField === 'general') { %>
                                <div class="general-error">⚠ <%= locals.errorMessage %></div>
                            <% } %>

                            <div class="input-group">
                                <label for="full-name">Full Name</label>
                                <input id="full-name" name="name" placeholder="Nikola Tesla" type="text"
                                    value="<%= locals.formData?.name || '' %>"
                                     />
                                <% if (locals.errorField === 'name') { %>
                                    <p class="field-error"><%= locals.errorMessage %></p>
                                <% } %>
                            </div>

                            <div class="input-group">
                                <label for="email">Email Address</label>
                                <input id="email" name="email" placeholder="precision@luxetech.com" type="email"
                                    value="<%= locals.formData?.email || '' %>"
                                     />
                                <% if (locals.errorField === 'email') { %>
                                    <p class="field-error"><%= locals.errorMessage %></p>
                                <% } %>
                            </div>

                            <div class="grid-row">
                                <div class="input-group">
                                    <label for="password">Password</label>
                                    <div class="password-wrapper">
                                        <input id="password" name="password" placeholder="••••••••" type="password" value="<%= locals.formData?.password||''%>"/>
                                        <button type="button" class="toggle-password"
                                            onclick="toggleVisibility('password', this)"
                                            aria-label="Toggle password visibility">
                                            <svg class="eye-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24"
                                                xmlns="http://www.w3.org/2000/svg">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                                    d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                                    d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z">
                                                </path>
                                            </svg>
                                        </button>
                                    </div>
                                    <% if (locals.errorField === 'password') { %>
                                        <p class="field-error"><%= locals.errorMessage %></p>
                                    <% } %>
                                </div>
                                <div class="input-group">
                                    <label for="confirm-password">Confirm Password</label>
                                    <div class="password-wrapper">
                                        <input id="confirm-password" name="confirmPassword" placeholder="••••••••"
                                            type="password"  value="<%= locals.formData?.confirmPassword || '' %>"/>
                                        <button type="button" class="toggle-password"
                                            onclick="toggleVisibility('confirm-password', this)"
                                            aria-label="Toggle password visibility">
                                            <svg class="eye-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24"
                                                xmlns="http://www.w3.org/2000/svg">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                                    d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                                    d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z">
                                                </path>
                                            </svg>
                                        </button>
                                    </div>
                                    <% if (locals.errorField === 'confirmPassword') { %>
                                        <p class="field-error"><%= locals.errorMessage %></p>
                                    <% } %>
                                </div>
                            </div>

                            <div class="input-group">
                                <label for="referral">Referral Code</label>
                                <input id="referral" name="referral" placeholder="REF-582617-ROCK (OPTIONAL)" type="text" />
                            </div>

                            <div class="checkbox-group">
                                <input id="terms" name="terms" type="checkbox"  />
                                <label for="terms">
                                    I agree to the <a href="#">Terms and Conditions</a> and <a href="#">Privacy
                                        Policy</a>.
                                </label>
                            </div>
                            <% if (locals.errorField === 'terms') { %>
                                <p class="field-error" style="margin-top: 0; margin-bottom: 15px;"><%= locals.errorMessage %></p>
                            <% } %>
                       
                            <div class="form-actions">
                                <button type="submit" class="btn-primary">
                                    <span>Create Account</span>
                                    <svg class="arrow-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24"
                                        xmlns="http://www.w3.org/2000/svg">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                            d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
                                    </svg>
                                </button>
                            </div>
                        </form>

                        <div class="social-login-section">
                            <p class="login-link">
                                Already have an account? <a href="login">Log in here</a>
                            </p>
                            <% if (locals.googleError) { %>
                                <div class="general-error" style="margin-bottom: 12px;">⚠ <%= locals.googleError %></div>
                            <% } %>
                            <div class="divider">
                                <span>Or continue with</span>
                            </div>
                            <a href="/auth/google?source=register" style="text-decoration: none;">
                                <button type="button" class="btn-social">
                                    <svg class="google-icon" viewBox="0 0 24 24">
                                        <path
                                            d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"
                                            fill="#4285F4"></path>
                                        <path
                                            d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"
                                            fill="#34A853"></path>
                                        <path
                                            d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l3.66-2.84z"
                                            fill="#FBBC05"></path>
                                        <path
                                            d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"
                                            fill="#EA4335"></path>
                                    </svg>
                                    Continue with Google
                                </button>
                            </a>
                        </div>
                    </div>
                </section>
            </div>
        </main>
        <!-- <footer class="site-footer">
        <div class="footer-container">
            <div class="footer-brand">LUXE TECH</div>
            <div class="footer-copyright">
                © 2024 LUXE TECH PRECISION. ALL RIGHTS RESERVED.
            </div>
        </div>
    </footer> -->

        <%- include("../../partials/user/auth-footer.ejs"); %>
            <script>
                function toggleVisibility(inputId, buttonElement) {
                    const inputElement = document.getElementById(inputId);

                    // Eye Open SVG Path
                    const eyeOpen = `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                             <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path>`;

                    // Eye Closed (Slashed) SVG Path
                    const eyeClosed = `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l3.59 3.59m0 0A9.953 9.953 0 0112 5c4.478 0 8.268 2.943 9.543 7a10.025 10.025 0 01-4.132 5.411m0 0L21 21"></path>`;

                    if (inputElement.type === "password") {
                        inputElement.type = "text";
                        buttonElement.querySelector('svg').innerHTML = eyeClosed;
                    } else {
                        inputElement.type = "password";
                        buttonElement.querySelector('svg').innerHTML = eyeOpen;
                    }
                }
            </script>
</body>

</html>