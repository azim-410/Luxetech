<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>Reset Password | TechLens</title>
    
    <link rel="stylesheet" href="/User/css/auth-global.css">
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet"/>
    <link href="/User/css/reset-password.css" rel="stylesheet">
    
</head>
<body>

    <!-- <header class="top-header">
        <div class="header-container">
            <div class="logo">TechLens</div>
            <div class="header-actions">
                <button class="icon-btn">
                    <span class="material-symbols-outlined">help_outline</span>
                </button>
            </div>
        </div>
    </header> -->
    <%- include("../../partials/user/auth-header.ejs"); %>
    <main class="main-content">
        <div class="card-wrapper">
            
            <div class="accent-blob blob-top-right"></div>
            <div class="accent-blob blob-bottom-left"></div>

            <section class="reset-card animate-in">
                <div class="card-header">
                    <h1>Secure your lens.</h1>
                    <p>Update your password to maintain access to your precision tools.</p>
                </div>

                <form id="resetPasswordForm" class="reset-form">
                    
                    <div class="input-group">
                        <label for="new-password">New Password</label>
                        <div class="input-wrapper">
                            <input id="new-password" type="password" placeholder="••••••••" required/>
                            <button type="button" class="toggle-password">
                                <span class="material-symbols-outlined">visibility</span>
                            </button>
                        </div>
                    </div>

                    <div class="input-group">
                        <label for="confirm-password">Confirm New Password</label>
                        <div class="input-wrapper">
                            <input id="confirm-password" type="password" placeholder="••••••••" required/>
                            <button type="button" class="toggle-password">
                                <span class="material-symbols-outlined">visibility</span>
                            </button>
                        </div>
                    </div>

                    <!-- <div class="info-chip">
                        <span class="material-symbols-outlined">info</span>
                        <p>Minimum 12 characters, including at least one engineering symbol (!@#$%^*) and a numeric digit.</p>
                    </div> -->

                    <div class="submit-wrapper">
                        <button type="submit" class="btn-submit">Reset Password</button>
                    </div>

                </form>

                <div class="return-link-wrapper">
                    <a href="login" class="return-link">
                        <span class="material-symbols-outlined">arrow_back</span>
                        Return to login portal
                    </a>
                </div>
            </section>
        </div>

        <div class="qa-indicators">
            <div class="qa-item">
                <span class="material-symbols-outlined">verified_user</span>
                <span>Encrypted</span>
            </div>
            <div class="qa-item">
                <span class="material-symbols-outlined">shield</span>
                <span>ISO Certified</span>
            </div>
        </div>
    </main>

    <!-- <footer class="site-footer">
        <div class="footer-container">
            <div class="footer-logo">TechLens</div>
            <div class="footer-links">
                <a href="#">Privacy Policy</a>
                <a href="#">Terms of Service</a>
                <a href="#">Support</a>
            </div>
            <div class="footer-copyright">
                © 2026 TechLens Precision. All rights reserved.
            </div>
        </div>
    </footer> -->

    <%- include("../../partials/user/auth-footer.ejs"); %>

    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const toggleButtons = document.querySelectorAll('.toggle-password');
            
            toggleButtons.forEach(button => {
                button.addEventListener('click', function() {
                    // Select the input field right before the clicked button
                    const inputField = this.previousElementSibling; 
                    const icon = this.querySelector('.material-symbols-outlined');
                    
                    if (inputField.type === 'password') {
                        inputField.type = 'text';
                        icon.textContent = 'visibility_off';
                    } else {
                        inputField.type = 'password';
                        icon.textContent = 'visibility';
                    }
                });
            });
        });
    </script>
</body>
</html>