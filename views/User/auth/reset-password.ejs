<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>Reset Password | Luxe Tech</title>
    
    <link rel="stylesheet" href="/User/css/auth-global.css">
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet"/>
    <link href="/User/css/reset-password.css" rel="stylesheet">
</head>
<body>

    <%- include("../../partials/user/auth-header.ejs"); %>

    <main class="main-content">
        <div class="card-wrapper">
            
            <div class="accent-blob blob-top-right"></div>
            <div class="accent-blob blob-bottom-left"></div>

            <section class="reset-card animate-in">
                <div class="card-header">
                    <h1>Secure your lens.</h1>
                    <p>Update your password to maintain access to your precision tools.</p>
                </div>
                
                <% if (locals.errorMessage) { %>
                    <div class="error-banner">
                        <span class="material-symbols-outlined">error</span>
                        <span><%= errorMessage %></span>
                    </div>
                <% } %>

                <form class="reset-form" action="<%= locals.actionUrl || '/reset-password' %>" method="POST">
                    
                    <div class="input-group">
                        <label for="new-password">New Password</label>
                        <div class="input-wrapper">
                            <input 
                                id="new-password" 
                                name="newPassword"
                                type="password" 
                                placeholder="••••••••"
                            />
                            <button type="button" class="toggle-password">
                                <span class="material-symbols-outlined">visibility</span>
                            </button>
                        </div>
                    </div>

                    <div class="input-group">
                        <label for="confirm-password">Confirm New Password</label>
                        <div class="input-wrapper">
                            <input 
                                id="confirm-password" 
                                name="confirmPassword"
                                type="password" 
                                placeholder="••••••••"
                            />
                            <button type="button" class="toggle-password">
                                <span class="material-symbols-outlined">visibility</span>
                            </button>
                        </div>
                    </div>

                    <div class="submit-wrapper">
                        <button type="submit" class="btn-submit">Reset Password</button>
                    </div>

                </form>

                <div class="return-link-wrapper">
                    <a href="/login" class="return-link">
                        <span class="material-symbols-outlined">arrow_back</span>
                        Return to login portal
                    </a>
                </div>
            </section>
        </div>

        <div class="qa-indicators">
            <div class="qa-item">
                <span class="material-symbols-outlined">verified_user</span>
                <span>Encrypted</span>
            </div>
            <div class="qa-item">
                <span class="material-symbols-outlined">shield</span>
                <span>ISO Certified</span>
            </div>
        </div>
    </main>

    <%- include("../../partials/user/auth-footer.ejs"); %>

    <script>
        // ─── TOGGLE PASSWORD VISIBILITY ONLY ────────────────
        document.querySelectorAll('.toggle-password').forEach(button => {
            button.addEventListener('click', function () {
                const input = this.previousElementSibling;
                const icon = this.querySelector('.material-symbols-outlined');
                input.type = input.type === 'password' ? 'text' : 'password';
                icon.textContent = input.type === 'password' ? 'visibility' : 'visibility_off';
            });
        });
    </script>
</body>
</html>