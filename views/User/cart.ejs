<!DOCTYPE html>
<html class="light" lang="en">

<head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>Your Cart | LUXE TECH</title>
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link
        href="https://fonts.googleapis.com/css2?family=Manrope:wght@200;400;600;800&amp;family=Inter:wght@300;400;500;600;700&amp;display=swap"
        rel="stylesheet" />
    <link rel="stylesheet" href="/User/css/main-global.css">
    <link
        href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap"
        rel="stylesheet" />
    <script id="tailwind-config">
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    colors: {
                        "surface-container-low": "#f2f4f7",
                        "background": "#f7f9fc",
                        "surface": "#f7f9fc",
                        "on-surface-variant": "#44474c",
                        "on-surface": "#191c1e",
                        "primary": "#0D1B2A",
                    },
                    fontFamily: {
                        "headline": ["Manrope"],
                        "body": ["Inter"],
                        "label": ["Inter"]
                    },
                    borderRadius: { "DEFAULT": "0.125rem", "lg": "0.25rem", "xl": "0.5rem", "full": "0.75rem" },
                },
            },
        }
    </script>
    <style>
        .material-symbols-outlined {
            font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
            vertical-align: middle;
        }
    </style>
</head>

<body class="bg-[#F4F6F9] font-body text-on-surface antialiased min-h-screen flex flex-col justify-between">

    <%- include('../partials/user/main-header', { user }) %>

        <!-- Main Content -->
        <main class="flex-grow py-36 px-10 max-w-screen-2xl w-full mx-auto">
            <!-- Title Header -->
            <div class="mb-12">
                <h1 class="text-4xl lg:text-5xl font-extrabold font-headline tracking-tight text-[#0D1B2A] mb-3">Your
                    products are ready</h1>
                <p class="text-slate-500 text-sm font-medium">Refining <span id="cart-count">
                        <%= cart ? cart.totalItems : 0 %>
                    </span> items for final precision delivery.</p>
            </div>

            <!-- Checkout Error Banner (shown when blocked items prevent checkout) -->
            <% if (locals.cartError) { %>
            <div class="mb-6 flex items-start gap-3 bg-red-50 border border-red-200 rounded-xl px-5 py-4">
                <span class="material-symbols-outlined text-red-500 mt-0.5 flex-shrink-0">error</span>
                <div>
                    <p class="text-sm font-bold text-red-700 mb-0.5">Checkout Blocked</p>
                    <p class="text-sm text-red-600"><%= locals.cartError %></p>
                </div>
            </div>
            <% } %>

            <!-- Layout Grid -->
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
                <!-- Left Column: Cart Items -->
                <div class="lg:col-span-8 space-y-6">
                    <!-- Headers Row (Desktop) -->
                    <div
                        class="hidden sm:grid grid-cols-12 px-6 text-[10px] font-bold uppercase tracking-widest text-slate-400">
                        <div class="col-span-6">Product Details</div>
                        <div class="col-span-2 text-right">Price</div>
                        <div class="col-span-2 text-center">Quantity</div>
                        <div class="col-span-2 text-right">Subtotal</div>
                    </div>

                    <!-- Cart Items List Container -->
                    <div id="cart-items-container" class="space-y-6">
                        <% if (cart && cart.items && cart.items.length> 0) { %>
                            <% cart.items.forEach(function(item) { %>
                                <div class="cart-item bg-white border border-slate-200/60 rounded-xl p-8 relative flex flex-col sm:grid sm:grid-cols-12 items-center gap-4 sm:gap-0"
                                    data-product-id="<%= item.productId %>"
                                    data-variant-id="<%= item.variantId || '' %>"
                                    data-price="<%= item.discountedPrice %>" data-max-allowed="<%= item.maxAllowed %>">
                                    <!-- Product Info -->
                                    <div class="col-span-6 flex items-center gap-6 w-full">
                                        <div
                                            class="w-24 h-24 rounded-lg bg-slate-100 overflow-hidden flex-shrink-0 border border-slate-100">
                                            <% if (item.image) { %>
                                                <img src="<%= item.image %>" alt="<%= item.name %>"
                                                    class="w-full h-full object-cover" />
                                                <% } else { %>
                                                    <div
                                                        class="w-full h-full bg-slate-200 flex items-center justify-center text-xs text-slate-400 font-bold">
                                                        No Image</div>
                                                    <% } %>
                                        </div>
                                        <div>
                                            <h3
                                                class="font-headline font-bold text-lg <%= item.isUnavailable ? 'text-slate-400 line-through' : 'text-[#0D1B2A]' %> mb-1">
                                                <%= item.name %>
                                            </h3>
                                            <% if (item.variantName) { %>
                                                <p class="text-xs text-slate-500 mb-3">
                                                    <%= item.variantName %>
                                                </p>
                                                <% } %>
                                                    <% if (item.isUnavailable) { %>
                                                        <div class="flex flex-col gap-1 items-start mt-1">
                                                            <span
                                                                class="bg-red-50 text-red-600 text-[9px] font-extrabold px-3 py-1 rounded-full uppercase tracking-wider border border-red-100">Unavailable</span>
                                                            <p
                                                                class="text-[11px] font-semibold tracking-wide text-red-600 mt-1">
                                                                This product is currently unavailable.</p>
                                                        </div>
                                                        <% } else if (item.stock <=0) { %>
                                                            <div class="flex flex-col gap-1 items-start mt-1">
                                                                <span
                                                                    class="bg-red-50 text-red-700 text-[9px] font-extrabold px-3 py-1 rounded-full uppercase tracking-wider border border-red-100">Out
                                                                    of Stock</span>
                                                                <p
                                                                    class="text-[11px] font-semibold tracking-wide text-red-600 mt-1">
                                                                    This variant is currently sold out and unavailable.
                                                                </p>
                                                            </div>
                                                            <% } else if (item.stock <=5) { %>
                                                                <div class="flex flex-col gap-1 items-start mt-1">
                                                                    <span
                                                                        class="bg-amber-50 text-amber-700 text-[9px] font-extrabold px-3 py-1 rounded-full uppercase tracking-wider border border-amber-100">Low
                                                                        Stock</span>
                                                                    <p
                                                                        class="text-[11px] font-semibold tracking-wide text-amber-600 mt-1">
                                                                        Only <%= item.stock %> units remaining! Order
                                                                            soon.</p>
                                                                </div>
                                                                <% } else { %>
                                                                    <div class="flex flex-col gap-1 items-start mt-1">
                                                                        <span
                                                                            class="bg-green-50 text-green-700 text-[9px] font-extrabold px-3 py-1 rounded-full uppercase tracking-wider border border-green-100">In
                                                                            Stock</span>
                                                                    </div>
                                                                    <% } %>
                                        </div>
                                    </div>

                                    <!-- Price -->
                                    <div
                                        class="col-span-2 sm:text-right w-full sm:w-auto flex justify-between sm:block mt-2 sm:mt-0">
                                        <span class="sm:hidden text-xs font-bold text-slate-400 uppercase">Price:</span>
                                        <span class="font-bold text-[#0D1B2A]">
                                            <% if (item.isUnavailable) { %>
                                                —
                                                <% } else { %>
                                                    ₹<%= item.discountedPrice %>
                                                        <% } %>
                                        </span>
                                    </div>

                                    <!-- Quantity Selector -->
                                    <div class="col-span-2 flex justify-center w-full sm:w-auto my-2 sm:my-0">
                                        <div
                                            class="flex items-center border border-slate-200 rounded-lg overflow-hidden bg-white">
                                            <button
                                                class="minus-btn px-3 py-1.5 hover:bg-slate-50 text-slate-500 hover:text-[#0D1B2A] transition-colors flex items-center justify-center font-bold"
                                                <%- item.isUnavailable
                                                ? 'disabled style="cursor: not-allowed; opacity: 0.5;"'
                                                : 'onclick="changeQty(this, -1)"' %>>-</button>
                                            <input type="text"
                                                class="qty-input w-10 text-center font-bold text-sm text-[#0D1B2A] border-none focus:ring-0 p-0"
                                                value="<%= item.quantity %>" readonly />
                                            <button
                                                class="plus-btn px-3 py-1.5 hover:bg-slate-50 text-slate-500 hover:text-[#0D1B2A] transition-colors flex items-center justify-center font-bold"
                                                <%- item.isUnavailable
                                                ? 'disabled style="cursor: not-allowed; opacity: 0.5;"'
                                                : 'onclick="changeQty(this, 1)"' %>>+</button>
                                        </div>
                                    </div>

                                    <!-- Subtotal -->
                                    <div
                                        class="col-span-2 sm:text-right w-full sm:w-auto flex justify-between sm:block">
                                        <span
                                            class="sm:hidden text-xs font-bold text-slate-400 uppercase">Subtotal:</span>
                                        <span class="item-subtotal font-bold text-[#0D1B2A]">
                                            <% if (item.isUnavailable) { %>
                                                —
                                                <% } else { %>
                                                    ₹<%= item.subtotal %>
                                                        <% } %>
                                        </span>
                                    </div>

                                    <!-- Delete Button -->
                                    <button
                                        class="delete-btn absolute top-6 right-6 text-slate-400 hover:text-red-500 transition-colors flex items-center justify-center"
                                        onclick="removeCartItem(this)">
                                        <span class="material-symbols-outlined">delete</span>
                                    </button>
                                </div>
                                <% }); %>
                                    <% } else { %>
                                        <div class="text-center py-16 bg-white border border-slate-200/60 rounded-xl">
                                            <span
                                                class="material-symbols-outlined text-5xl text-slate-300 mb-4">shopping_cart</span>
                                            <p class="text-slate-500 font-medium">Your cart is currently empty.</p>
                                        </div>
                                        <% } %>
                    </div>

                    <!-- Continue Shopping -->
                    <div class="pt-6">
                        <a href="/shop"
                            class="inline-flex items-center gap-2 text-xs font-bold uppercase tracking-widest text-slate-500 hover:text-[#0D1B2A] transition-colors">
                            <span class="material-symbols-outlined text-sm">arrow_back</span> Continue Shopping
                        </a>
                    </div>
                </div>

                <!-- Right Column: Order Summary Card -->
                <div class="lg:col-span-4 bg-[#F8FAFC] border border-slate-200/60 rounded-xl p-8 space-y-6">
                    <h2 class="text-xl font-bold font-headline text-[#0D1B2A]">Order Summary</h2>

                    <div class="space-y-4 text-sm font-medium">
                        <div class="flex justify-between text-slate-500">
                            <span>Original Price</span>
                            <span id="original-price" class="text-[#0D1B2A] font-semibold">₹<%= cart ?
                                    cart.originalTotal : 0 %></span>
                        </div>
                        <div class="flex justify-between text-green-600">
                            <span>Discount</span>
                            <span id="discount-amount">-₹<%= cart ? cart.discount : 0 %></span>
                        </div>
                        <div class="flex justify-between text-slate-500 border-t border-slate-200/60 pt-4">
                            <span>Subtotal</span>
                            <span id="subtotal-amount" class="text-[#0D1B2A] font-semibold">₹<%= cart ? cart.subtotal :
                                    0 %></span>
                        </div>
                        <div class="flex justify-between text-slate-500">
                            <span>Estimated Tax (8%)</span>
                            <span id="tax-amount" class="text-[#0D1B2A] font-semibold">₹<%= cart ? cart.tax : 0 %>
                                    </span>
                        </div>
                    </div>

                    <% const hasUnavailableInCart=cart && cart.items && cart.items.some(item=> item.isUnavailable);
                        const hasStockoutInCart = cart && cart.items && cart.items.some(item => item.stock <= 0 &&
                            !item.isUnavailable); const isCheckoutBlocked=hasUnavailableInCart || hasStockoutInCart; %>
                            <div class="border-t border-slate-200 pt-6">
                                <div class="flex justify-between items-baseline mb-6">
                                    <span class="text-xs font-bold uppercase tracking-wider text-slate-400">Grand
                                        Total</span>
                                    <span id="grand-total"
                                        class="text-3xl font-extrabold font-headline text-[#0D1B2A]">₹<%= cart ?
                                            cart.grandTotal : 0 %></span>
                                </div>

                                <div id="checkout-btn-container">
                                    <% if (isCheckoutBlocked) { %>
                                        <button
                                            class="w-full py-4 bg-slate-200 text-slate-400 cursor-not-allowed font-label font-bold uppercase tracking-widest text-xs flex items-center justify-center gap-3"
                                            disabled>
                                            Proceed to Checkout <span
                                                class="material-symbols-outlined text-sm">arrow_forward</span>
                                        </button>
                                        <p class="text-red-500 text-[11px] font-semibold text-center mt-3">
                                            Please remove unavailable or out of stock items to proceed.
                                        </p>
                                        <% } else { %>
                                            <form action="/checkout" method="GET">
                                                <button type="submit"
                                                    class="w-full py-4 bg-[#0D1B2A] text-white hover:bg-slate-800 transition-all duration-300 font-label font-bold uppercase tracking-widest text-xs flex items-center justify-center gap-3">
                                                    Proceed to Checkout <span
                                                        class="material-symbols-outlined text-sm">arrow_forward</span>
                                                </button>
                                            </form>
                                            <% } %>
                                </div>
                            </div>

                            <!-- Secure Checkouts Badges -->
                            <div class="space-y-3 pt-2 text-[11px] font-semibold text-slate-500">
                                <div class="flex items-center gap-2">
                                    <span class="material-symbols-outlined text-base text-slate-400">lock</span>
                                    <span>Secure Encryption 256-bit AES</span>
                                </div>
                                <div class="flex items-center gap-2">
                                    <span
                                        class="material-symbols-outlined text-base text-slate-400">local_shipping</span>
                                    <span>Expedited Precision Logistics</span>
                                </div>
                            </div>
                </div>
            </div><!-- end grid wrapper -->
        </main>

        <!-- Beautiful Tailwind Delete Confirmation Modal -->
        <div id="delete-modal"
            class="fixed inset-0 z-50 flex items-center justify-center hidden opacity-0 transition-opacity duration-300">
            <!-- Backdrop -->
            <div class="absolute inset-0 bg-[#0D1B2A]/40 backdrop-blur-sm transition-opacity duration-300"></div>
            <!-- Modal Card -->
            <div
                class="relative bg-white rounded-2xl max-w-md w-full mx-4 p-8 shadow-2xl transform scale-95 transition-transform duration-300 border border-slate-100">
                <div class="flex items-center gap-4 mb-4">
                    <div class="w-12 h-12 rounded-full bg-red-50 flex items-center justify-center text-red-500">
                        <span class="material-symbols-outlined text-2xl">delete_forever</span>
                    </div>
                    <div>
                        <h3 class="text-xl font-bold font-headline text-[#0D1B2A]">Remove Item</h3>
                        <p class="text-xs text-slate-400 font-semibold tracking-wider uppercase mt-0.5">Confirmation
                            Required</p>
                    </div>
                </div>

                <p class="text-slate-600 text-sm leading-relaxed mb-8">
                    Are you sure you want to remove this item from your cart? This action cannot be undone.
                </p>

                <div class="flex items-center justify-end gap-3">
                    <button id="cancel-delete-btn"
                        class="px-5 py-3 rounded-lg text-slate-500 hover:bg-slate-50 font-bold text-xs uppercase tracking-wider transition-colors">
                        Cancel
                    </button>
                    <button id="confirm-delete-btn"
                        class="px-6 py-3 bg-red-600 hover:bg-red-700 text-white font-bold text-xs uppercase tracking-wider rounded-lg transition-colors shadow-lg shadow-red-600/20">
                        Remove Item
                    </button>
                </div>
            </div>
        </div>

        <!-- Beautiful Tailwind Alert/Error Modal -->
        <div id="alert-modal"
            class="fixed inset-0 z-50 flex items-center justify-center hidden opacity-0 transition-opacity duration-300">
            <!-- Backdrop -->
            <div class="absolute inset-0 bg-[#0D1B2A]/40 backdrop-blur-sm transition-opacity duration-300"></div>
            <!-- Modal Card -->
            <div
                class="relative bg-white rounded-2xl max-w-sm w-full mx-4 p-8 shadow-2xl transform scale-95 transition-transform duration-300 border border-slate-100">
                <div class="flex flex-col items-center text-center">
                    <div
                        class="w-14 h-14 rounded-full bg-amber-50 flex items-center justify-center text-amber-500 mb-4">
                        <span class="material-symbols-outlined text-3xl">warning</span>
                    </div>
                    <h3 class="text-lg font-bold font-headline text-[#0D1B2A] mb-2">Limit Reached</h3>
                    <p id="alert-modal-message" class="text-slate-600 text-sm leading-relaxed mb-6"></p>
                    <button id="alert-close-btn"
                        class="w-full py-3 bg-[#0D1B2A] hover:bg-slate-800 text-white font-bold text-xs uppercase tracking-widest rounded-lg transition-colors">
                        Got it
                    </button>
                </div>
            </div>
        </div>

        <!-- Interactive Script -->
        <script>
            // Formatter for Indian Rupees
            const formatCurrency = (val) => {
                return '₹' + parseFloat(val).toLocaleString('en-IN', {
                    maximumFractionDigits: 2,
                    minimumFractionDigits: 2
                });
            };

            // Function to show custom alert modal
            const showAlert = (message, title = "Limit Reached") => {
                const modal = document.getElementById('alert-modal');
                document.getElementById('alert-modal-message').innerText = message;
                modal.querySelector('h3').innerText = title;

                modal.classList.remove('hidden');
                setTimeout(() => {
                    modal.classList.remove('opacity-0');
                    modal.querySelector('.relative').classList.remove('scale-95');
                }, 10);
            };

            const closeAlertModal = () => {
                const modal = document.getElementById('alert-modal');
                modal.classList.add('opacity-0');
                modal.querySelector('.relative').classList.add('scale-95');
                setTimeout(() => {
                    modal.classList.add('hidden');
                }, 300);
            };

            const alertCloseBtn = document.getElementById('alert-close-btn');
            if (alertCloseBtn) {
                alertCloseBtn.addEventListener('click', closeAlertModal);
            }
            const alertModal = document.getElementById('alert-modal');
            if (alertModal) {
                const alertBackdrop = alertModal.querySelector('.absolute');
                if (alertBackdrop) {
                    alertBackdrop.addEventListener('click', closeAlertModal);
                }
            }

            // Function to update the order summary card totals
            const updateSummaryUI = (cart) => {
                document.getElementById('cart-count').innerText = cart.totalItems;
                document.getElementById('original-price').innerText = formatCurrency(cart.originalTotal);
                document.getElementById('discount-amount').innerText = `-` + formatCurrency(cart.discount);
                document.getElementById('subtotal-amount').innerText = formatCurrency(cart.subtotal);
                document.getElementById('tax-amount').innerText = formatCurrency(cart.tax);
                document.getElementById('grand-total').innerText = formatCurrency(cart.grandTotal);

                const btnContainer = document.getElementById('checkout-btn-container');
                if (btnContainer) {
                    const hasUnavailableInCart = cart.items.some(item => item.isUnavailable);
                    const hasStockoutInCart = cart.items.some(item => item.stock <= 0 && !item.isUnavailable);
                    const isCheckoutBlocked = hasUnavailableInCart || hasStockoutInCart;

                    if (isCheckoutBlocked) {
                        btnContainer.innerHTML = `
                        <button class="w-full py-4 bg-slate-200 text-slate-400 cursor-not-allowed font-label font-bold uppercase tracking-widest text-xs flex items-center justify-center gap-3" disabled>
                            Proceed to Checkout <span class="material-symbols-outlined text-sm">arrow_forward</span>
                        </button>
                        <p class="text-red-500 text-[11px] font-semibold text-center mt-3">
                            Please remove unavailable or out of stock items to proceed.
                        </p>
                    `;
                    } else {
                      btnContainer.innerHTML = `
    <form action="/checkout" method="POST">
        <button type="submit" class="w-full py-4 bg-[#0D1B2A] text-white hover:bg-slate-800 transition-all duration-300 font-label font-bold uppercase tracking-widest text-xs flex items-center justify-center gap-3">
            Proceed to Checkout <span class="material-symbols-outlined text-sm">arrow_forward</span>
        </button>
    </form>
`;
                    }
                }

                if (cart.items.length === 0) {
                    document.getElementById('cart-items-container').innerHTML = `
                    <div class="text-center py-16 bg-white border border-slate-200/60 rounded-xl">
                        <span class="material-symbols-outlined text-5xl text-slate-300 mb-4">shopping_cart</span>
                        <p class="text-slate-500 font-medium">Your cart is currently empty.</p>
                    </div>
                `;
                }
            };

            // Function to handle quantity increment/decrement with validation
            async function changeQty(button, change) {
                const cartItem = button.closest('.cart-item');
                const productId = cartItem.dataset.productId;
                const variantId = cartItem.dataset.variantId || null;
                const qtyInput = cartItem.querySelector('.qty-input');
                const subtotalEl = cartItem.querySelector('.item-subtotal');
                const price = parseFloat(cartItem.dataset.price);
                const maxAllowed = parseInt(cartItem.dataset.maxAllowed);

                let currentQty = parseInt(qtyInput.value);
                let targetQty = currentQty + change;

                // Frontend validations
                if (targetQty < 1) {
                    showAlert("Quantity cannot be less than 1. If you wish to remove the item, please click the delete icon.", "Invalid Action");
                    return;
                }

                if (targetQty > maxAllowed) {
                    showAlert(`Cannot exceed stock limit or maximum purchase limit of ${maxAllowed} units per item.`, "Limit Reached");
                    return;
                }

                // Disable buttons temporarily during request
                button.disabled = true;

                try {
                    const response = await fetch('/cart/update-quantity', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json'
                        },
                        body: JSON.stringify({ productId, variantId, quantity: targetQty })
                    });

                    const data = await response.json();

                    if (response.ok && data.success) {
                        qtyInput.value = targetQty;
                        // Update this specific item's subtotal
                        subtotalEl.innerText = formatCurrency(price * targetQty);
                        // Sync data-max-allowed from server response so future clicks use the correct limit
                        const matchingItem = data.cart.items.find(i => {
                            const sameProduct = String(i.productId) === productId;
                            const sameVariant = (!i.variantId && !variantId) ||
                                (i.variantId && variantId && String(i.variantId) === variantId);
                            return sameProduct && sameVariant;
                        });
                        if (matchingItem) {
                            cartItem.dataset.maxAllowed = matchingItem.maxAllowed;
                        }
                        // Update full summary card
                        updateSummaryUI(data.cart);
                    } else {
                        showAlert(data.message || "Failed to update quantity.", "Error");
                    }
                } catch (error) {
                    console.error("Error updating quantity:", error);
                    showAlert("An error occurred while updating quantity. Please try again.", "Error");
                } finally {
                    button.disabled = false;
                }
            }

            let itemToRemove = null;

            // Function to handle item removal from cart
            function removeCartItem(button) {
                const cartItem = button.closest('.cart-item');
                itemToRemove = {
                    element: cartItem,
                    productId: cartItem.dataset.productId,
                    variantId: cartItem.dataset.variantId || null
                };

                const modal = document.getElementById('delete-modal');
                modal.classList.remove('hidden');
                setTimeout(() => {
                    modal.classList.remove('opacity-0');
                    modal.querySelector('.relative').classList.remove('scale-95');
                }, 10);
            }

            function closeDeleteModal() {
                const modal = document.getElementById('delete-modal');
                modal.classList.add('opacity-0');
                modal.querySelector('.relative').classList.add('scale-95');
                setTimeout(() => {
                    modal.classList.add('hidden');
                    itemToRemove = null;
                }, 300);
            }

            const cancelDeleteBtn = document.getElementById('cancel-delete-btn');
            if (cancelDeleteBtn) {
                cancelDeleteBtn.addEventListener('click', closeDeleteModal);
            }

            const deleteModal = document.getElementById('delete-modal');
            if (deleteModal) {
                const deleteBackdrop = deleteModal.querySelector('.absolute');
                if (deleteBackdrop) {
                    deleteBackdrop.addEventListener('click', closeDeleteModal);
                }
            }

            const confirmDeleteBtn = document.getElementById('confirm-delete-btn');
            if (confirmDeleteBtn) {
                confirmDeleteBtn.addEventListener('click', async () => {
                    if (!itemToRemove) return;

                    const { element, productId, variantId } = itemToRemove;
                    confirmDeleteBtn.disabled = true;
                    confirmDeleteBtn.innerText = "Removing...";

                    try {
                        const response = await fetch('/cart/remove', {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/json'
                            },
                            body: JSON.stringify({ productId, variantId })
                        });

                        const data = await response.json();

                        if (response.ok && data.success) {
                            window.location.reload();
                        } else {
                            showAlert(data.message || "Failed to remove item.", "Error");
                        }
                    } catch (error) {
                        console.error("Error removing cart item:", error);
                        showAlert("An error occurred while removing the item. Please try again.", "Error");
                    } finally {
                        confirmDeleteBtn.disabled = false;
                        confirmDeleteBtn.innerText = "Remove Item";
                        closeDeleteModal();
                    }
                });
            }
        </script>

</body>

</html>