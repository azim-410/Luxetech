<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>Change Password | TechLens</title>

    <link rel="stylesheet" href="/User/css/auth-global.css">
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet"/>
    <link href="/User/css/reset-password.css" rel="stylesheet">
</head>
<body>

    <%- include("../partials/user/auth-header.ejs"); %>

    <main class="main-content">
        <div class="card-wrapper">

            <div class="accent-blob blob-top-right"></div>
            <div class="accent-blob blob-bottom-left"></div>

            <section class="reset-card animate-in">
                <div class="card-header">
                    <h1>Verify Your Identity</h1>
                    <p>Enter your current password to continue changing your password.</p>
                </div>

                <!-- Server Error -->
                <% if (locals.errorMessage) { %>
                    <div class="error-banner">
                        <span class="material-symbols-outlined">error</span>
                        <span><%= errorMessage %></span>
                    </div>
                <% } %>

                <form class="reset-form" action="<%= locals.actionUrl || '/change-password/verify-old' %>" method="POST">

                    <div class="input-group">
                        <label for="old-password">Current Password</label>
                        <div class="input-wrapper">
                            <input
                                id="old-password"
                                name="oldPassword"
                                type="password"
                                placeholder="••••••••"
                                required
                            />
                            <button type="button" class="toggle-password">
                                <span class="material-symbols-outlined">visibility</span>
                            </button>
                        </div>
                    </div>

                    <div class="submit-wrapper">
                        <button type="submit" class="btn-submit">Verify &amp; Continue</button>
                    </div>

                </form>

                <div class="return-link-wrapper">
                    <a href="/profile" class="return-link">
                        <span class="material-symbols-outlined">arrow_back</span>
                        Back to profile
                    </a>
                </div>
            </section>
        </div>

        <div class="qa-indicators">
            <div class="qa-item">
                <span class="material-symbols-outlined">verified_user</span>
                <span>Encrypted</span>
            </div>
            <div class="qa-item">
                <span class="material-symbols-outlined">shield</span>
                <span>ISO Certified</span>
            </div>
        </div>
    </main>

    <%- include("../partials/user/auth-footer.ejs"); %>

    <script>
        document.querySelectorAll('.toggle-password').forEach(button => {
            button.addEventListener('click', function () {
                const input = this.previousElementSibling;
                const icon = this.querySelector('.material-symbols-outlined');
                input.type = input.type === 'password' ? 'text' : 'password';
                icon.textContent = input.type === 'password' ? 'visibility' : 'visibility_off';
            });
        });
    </script>
</body>
</html>