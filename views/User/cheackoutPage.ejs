<!DOCTYPE html>

<html class="light" lang="en">

<head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>Checkout | Luxe Tech</title>
    <script src="https://checkout.razorpay.com/v1/checkout.js"></script>
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link
        href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&amp;family=Inter:wght@400;500;600&amp;display=swap"
        rel="stylesheet" />
    <link
        href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap"
        rel="stylesheet" />
    <script id="tailwind-config">
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    colors: {
                        "tertiary": "#000000",
                        "on-tertiary-container": "#dc5d00",
                        "surface": "#f7f9fc",
                        "inverse-primary": "#b0c6ff",
                        "tertiary-container": "#341100",
                        "on-surface-variant": "#44474c",
                        "on-error": "#ffffff",
                        "on-tertiary-fixed": "#341100",
                        "on-error-container": "#93000a",
                        "on-tertiary-fixed-variant": "#7a3000",
                        "on-primary-fixed-variant": "#00429c",
                        "surface-container-highest": "#e0e3e6",
                        "error-container": "#ffdad6",
                        "tertiary-fixed-dim": "#ffb692",
                        "surface-container-high": "#e6e8eb",
                        "surface-container": "#eceef1",
                        "error": "#ba1a1a",
                        "on-secondary-fixed": "#021f29",
                        "surface-tint": "#2b5bb5",
                        "outline-variant": "#c4c6cc",
                        "on-tertiary": "#ffffff",
                        "on-secondary-container": "#4e6874",
                        "inverse-surface": "#2d3133",
                        "secondary-container": "#cbe7f5",
                        "surface-container-low": "#f2f4f7",
                        "surface-bright": "#f7f9fc",
                        "primary-fixed-dim": "#b0c6ff",
                        "surface-variant": "#e0e3e6",
                        "on-primary": "#ffffff",
                        "secondary": "#48626e",
                        "primary-fixed": "#d9e2ff",
                        "on-surface": "#191c1e",
                        "surface-dim": "#d8dadd",
                        "on-background": "#191c1e",
                        "outline": "#74777d",
                        "on-primary-fixed": "#001945",
                        "on-primary-container": "#5781de",
                        "inverse-on-surface": "#eff1f4",
                        "background": "#f7f9fc",
                        "primary-container": "#001945",
                        "on-secondary": "#ffffff",
                        "surface-container-lowest": "#ffffff",
                        "secondary-fixed-dim": "#afcbd8",
                        "secondary-fixed": "#cbe7f5",
                        "tertiary-fixed": "#ffdbcb",
                        "primary": "#000000",
                        "on-secondary-fixed-variant": "#304a55"
                    },
                    fontFamily: {
                        "headline": ["Manrope"],
                        "body": ["Inter"],
                        "label": ["Inter"]
                    },
                    borderRadius: { "DEFAULT": "0.125rem", "lg": "0.25rem", "xl": "0.5rem", "full": "0.75rem" },
                },
            },
        }
    </script>
    <style>
        .material-symbols-outlined {
            font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
        }

        .custom-scrollbar::-webkit-scrollbar {
            width: 4px;
        }

        .custom-scrollbar::-webkit-scrollbar-track {
            background: transparent;
        }

        .custom-scrollbar::-webkit-scrollbar-thumb {
            background: #e0e3e6;
            border-radius: 10px;
        }
    </style>
</head>

<body class="bg-background text-on-surface font-body selection:bg-on-tertiary-container selection:text-white">
    <!-- Main Checkout Canvas -->
    <main class="pt-28 pb-20 px-6 max-w-7xl mx-auto">
        <!-- Back to Cart Link -->
        <div class="mb-6">
            <a href="/cart"
                class="inline-flex items-center gap-2 text-xs font-bold uppercase tracking-widest text-on-surface-variant hover:text-primary transition-colors">
                <span class="material-symbols-outlined text-sm">arrow_back</span> Back to Cart
            </a>
        </div>
        <div class="mb-12">
            <h1 class="font-headline text-4xl font-extrabold tracking-tight text-primary mb-2">Secure Checkout</h1>
            <p class="text-on-surface-variant font-body">Review your order and shipping details to complete the
                purchase.</p>
        </div>

        <!-- Order Validation Error Banner -->
        <% if (locals.checkoutError) { %>
            <div
                class="mb-10 bg-white border border-red-100 rounded-2xl p-6 shadow-md shadow-red-500/5 relative overflow-hidden text-left">
                <!-- Top premium colored accent bar -->
                <div class="absolute top-0 left-0 right-0 h-1.5 bg-error"></div>

                <div class="flex items-start gap-4">
                    <div
                        class="w-12 h-12 rounded-full bg-red-50 flex items-center justify-center text-error flex-shrink-0">
                        <span class="material-symbols-outlined text-2xl">block</span>
                    </div>
                    <div class="flex-grow">
                        <div class="flex items-center gap-2 mb-2 flex-wrap">
                            <h4 class="text-lg font-bold font-headline text-primary">Order Placement Blocked</h4>
                            <span
                                class="bg-red-50 text-error text-[9px] font-extrabold px-2.5 py-1 rounded-full uppercase tracking-wider border border-red-100">
                                Action Required
                            </span>
                        </div>
                        <p class="text-sm text-on-surface-variant leading-relaxed mb-4">
                            <%= locals.checkoutError %>
                        </p>
                        <a href="/cart"
                            class="inline-flex items-center gap-2 bg-error hover:bg-red-700 text-white px-5 py-3 rounded-lg text-xs font-bold uppercase tracking-widest transition-all shadow-lg shadow-error/20">
                            <span class="material-symbols-outlined text-sm">arrow_back</span> Return to Cart
                        </a>
                    </div>
                </div>
            </div>
            <% } %>

                <div class="grid grid-cols-1 lg:grid-cols-12 gap-16">
                    <!-- Left Column: Form Sections -->
                    <div class="lg:col-span-7 space-y-16">
                        <!-- Shipping Address Section -->
                        <section>
                            <div class="flex items-center gap-3 mb-8">
                                <span
                                    class="w-8 h-8 rounded-full bg-primary text-white flex items-center justify-center text-xs font-bold font-headline">01</span>
                                <h2 class="font-headline text-xl font-bold uppercase tracking-widest text-primary">
                                    Shipping
                                    Address</h2>
                            </div>
                            <!-- Address Selection Tabs -->
                            <div class="flex gap-4 mb-8">
                                <button id="tab-saved-addresses"
                                    class="flex-1 py-3 px-4 border-2 border-primary bg-primary text-white text-xs font-bold uppercase tracking-widest transition-all">
                                    Saved Addresses
                                </button>
                                <button id="tab-add-new-address"
                                    class="flex-1 py-3 px-4 border-2 border-outline-variant text-on-surface-variant text-xs font-bold uppercase tracking-widest hover:border-primary transition-all">
                                    Add New Address
                                </button>
                            </div>
                            <!-- Select Different Address Dropdown -->
                            <div id="address-select-container"
                                class="mb-8 <%= addresses.length === 0 ? 'hidden' : '' %>">
                                <label
                                    class="block text-xs font-bold uppercase tracking-widest text-on-surface-variant mb-2 font-label">Select
                                    Different Address</label>
                                <div class="relative">
                                    <select id="address-select"
                                        class="w-full bg-surface-container-lowest bg-none border-2 border-outline-variant focus:border-primary focus:ring-0 rounded-sm py-4 px-5 pr-12 text-xs font-bold uppercase tracking-widest text-primary appearance-none cursor-pointer transition-all">
                                        <% addresses.forEach(function(addr) { %>
                                            <option value="<%= addr._id %>" <%=defaultAddress &&
                                                String(defaultAddress._id)===String(addr._id) ? 'selected' : '' %>>
                                                <%= addr.fullName.toUpperCase() %> — <%= addr.type.toUpperCase() %>
                                                        <%= addr.isDefault ? ' (Default)' : '' %>
                                            </option>
                                            <% }); %>
                                    </select>
                                    <div
                                        class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-4 text-primary">
                                        <span class="material-symbols-outlined">expand_more</span>
                                    </div>
                                </div>
                            </div>
                            <!-- Saved Address Card -->
                            <div id="saved-address-card"
                                class="bg-surface-container-lowest p-6 border-2 border-primary relative mb-8 group cursor-pointer <%= !defaultAddress ? 'hidden' : '' %>">
                                <div class="flex justify-between items-start mb-4">
                                    <div>
                                        <h3 id="card-name"
                                            class="font-headline font-bold text-primary text-sm uppercase">
                                            <%= defaultAddress ? defaultAddress.fullName : '' %>
                                        </h3>
                                        <span id="card-tag"
                                            class="inline-block bg-surface-container text-[10px] px-2 py-0.5 rounded font-bold uppercase tracking-tighter text-on-surface-variant mt-1">
                                            <%= defaultAddress ? (defaultAddress.isDefault ? 'Default (' +
                                                defaultAddress.type.toUpperCase() + ')' :
                                                defaultAddress.type.toUpperCase()) : '' %>
                                        </span>
                                    </div>
                                    <span class="material-symbols-outlined text-primary"
                                        data-icon="check_circle">check_circle</span>
                                </div>
                                <p class="text-sm text-on-surface-variant leading-relaxed mb-4 text-left">
                                    <span id="card-street">
                                        <%= defaultAddress ? defaultAddress.streetAddress : '' %>
                                    </span><br />
                                    <span id="card-city-state-zip">
                                        <%= defaultAddress ? (defaultAddress.city + ', ' + defaultAddress.state + ' ' +
                                            defaultAddress.zipCode) : '' %>
                                    </span><br />
                                    <span id="card-country">
                                        <%= defaultAddress ? defaultAddress.country : '' %>
                                    </span>
                                </p>
                                <div class="flex gap-4">
                                    <button id="edit-address-btn" type="button"
                                        class="text-[10px] font-bold uppercase tracking-widest text-primary hover:underline">Edit
                                        Address</button>
                                </div>
                            </div>
                            <!-- Add New Address Form (Hidden by default or shown based on selection) -->
                            <form id="new-address-form" action="/checkout/address/add" method="POST"
                                class="hidden space-y-4 sm:space-y-5">

                                <% const _addErrors=locals.addErrors || {}; %>
                                    <% const _addFormData=locals.addFormData || {}; %>

                                        <% if (Object.keys(_addErrors).length> 0) { %>
                                            <div
                                                class="bg-error-container text-[11px] text-red-600 rounded-lg px-4 py-3 text-left flex items-start gap-3 border border-red-200">
                                                <span
                                                    class="material-symbols-outlined text-base shrink-0 mt-0.5">error</span>
                                                <div>
                                                    <% if (_addErrors.global) { %>
                                                        <p class="font-bold">
                                                            <%= _addErrors.global %>
                                                        </p>
                                                        <% } else { %>
                                                            <p class="font-bold">Please fix <%=
                                                                    Object.keys(_addErrors).length %> error<%=
                                                                        Object.keys(_addErrors).length> 1 ? 's' : '' %>
                                                                        below</p>
                                                            <p class="font-normal mt-0.5 opacity-80">Check the
                                                                highlighted fields and try again.</p>
                                                            <% } %>
                                                </div>
                                            </div>
                                            <% } %>

                                                <!-- Full Name -->
                                                <div class="space-y-1.5 text-left">
                                                    <label
                                                        class="text-[11px] font-bold uppercase tracking-widest text-on-surface-variant block font-label animate-pulse-slow">Full
                                                        Name</label>
                                                    <input type="text" name="fullName"
                                                        placeholder="E.g. Alexander Vance" required
                                                        value="<%= _addFormData.fullName || '' %>"
                                                        class="w-full bg-surface-container-low rounded-lg px-4 py-3 text-sm border <%= _addErrors.fullName ? 'border-red-500' : 'border-outline-variant/30' %> focus:ring-2 focus:ring-primary focus:outline-none transition-all font-body" />
                                                    <% if (_addErrors.fullName) { %>
                                                        <p class="text-[10px] text-red-500 mt-1">
                                                            <%= _addErrors.fullName %>
                                                        </p>
                                                        <% } %>
                                                </div>

                                                <!-- Street Address -->
                                                <div class="space-y-1.5 text-left">
                                                    <label
                                                        class="text-[11px] font-bold uppercase tracking-widest text-on-surface-variant block font-label">Street
                                                        Address</label>
                                                    <input type="text" name="streetAddress"
                                                        placeholder="123 Precision Way" required
                                                        value="<%= _addFormData.streetAddress || '' %>"
                                                        class="w-full bg-surface-container-low rounded-lg px-4 py-3 text-sm border <%= _addErrors.streetAddress ? 'border-red-500' : 'border-outline-variant/30' %> focus:ring-2 focus:ring-primary focus:outline-none transition-all font-body" />
                                                    <% if (_addErrors.streetAddress) { %>
                                                        <p class="text-[10px] text-red-500 mt-1">
                                                            <%= _addErrors.streetAddress %>
                                                        </p>
                                                        <% } %>
                                                </div>

                                                <!-- City + ZIP -->
                                                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-left">
                                                    <div class="space-y-1.5">
                                                        <label
                                                            class="text-[11px] font-bold uppercase tracking-widest text-on-surface-variant block font-label">City</label>
                                                        <input type="text" name="city" placeholder="San Francisco"
                                                            required value="<%= _addFormData.city || '' %>"
                                                            class="w-full bg-surface-container-low rounded-lg px-4 py-3 text-sm border <%= _addErrors.city ? 'border-red-500' : 'border-outline-variant/30' %> focus:ring-2 focus:ring-primary focus:outline-none transition-all font-body" />
                                                        <% if (_addErrors.city) { %>
                                                            <p class="text-[10px] text-red-500 mt-1">
                                                                <%= _addErrors.city %>
                                                            </p>
                                                            <% } %>
                                                    </div>
                                                    <div class="space-y-1.5">
                                                        <label
                                                            class="text-[11px] font-bold uppercase tracking-widest text-on-surface-variant block font-label">ZIP
                                                            / Postal Code</label>
                                                        <input type="text" name="zipCode" placeholder="94103" required
                                                            value="<%= _addFormData.zipCode || '' %>"
                                                            class="w-full bg-surface-container-low rounded-lg px-4 py-3 text-sm border <%= _addErrors.zipCode ? 'border-red-500' : 'border-outline-variant/30' %> focus:ring-2 focus:ring-primary focus:outline-none transition-all font-body" />
                                                        <% if (_addErrors.zipCode) { %>
                                                            <p class="text-[10px] text-red-500 mt-1">
                                                                <%= _addErrors.zipCode %>
                                                            </p>
                                                            <% } %>
                                                    </div>
                                                </div>

                                                <!-- State + Country -->
                                                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-left">
                                                    <div class="space-y-1.5">
                                                        <label
                                                            class="text-[11px] font-bold uppercase tracking-widest text-on-surface-variant block font-label">State
                                                            / Province</label>
                                                        <input type="text" name="state" placeholder="California"
                                                            required value="<%= _addFormData.state || '' %>"
                                                            class="w-full bg-surface-container-low rounded-lg px-4 py-3 text-sm border <%= _addErrors.state ? 'border-red-500' : 'border-outline-variant/30' %> focus:ring-2 focus:ring-primary focus:outline-none transition-all font-body" />
                                                        <% if (_addErrors.state) { %>
                                                            <p class="text-[10px] text-red-500 mt-1">
                                                                <%= _addErrors.state %>
                                                            </p>
                                                            <% } %>
                                                    </div>
                                                    <div class="space-y-1.5">
                                                        <label
                                                            class="text-[11px] font-bold uppercase tracking-widest text-on-surface-variant block font-label">Country</label>
                                                        <input type="text" name="country" placeholder="India" required
                                                            value="<%= _addFormData.country || '' %>"
                                                            class="w-full bg-surface-container-low rounded-lg px-4 py-3 text-sm border <%= _addErrors.country ? 'border-red-500' : 'border-outline-variant/30' %> focus:ring-2 focus:ring-primary focus:outline-none transition-all font-body" />
                                                        <% if (_addErrors.country) { %>
                                                            <p class="text-[10px] text-red-500 mt-1">
                                                                <%= _addErrors.country %>
                                                            </p>
                                                            <% } %>
                                                    </div>
                                                </div>

                                                <!-- Phone -->
                                                <div class="space-y-1.5 text-left">
                                                    <label
                                                        class="text-[11px] font-bold uppercase tracking-widest text-on-surface-variant block font-label">Phone
                                                        Number</label>
                                                    <input type="text" name="phoneNumber" placeholder="+91 0000000000"
                                                        required value="<%= _addFormData.phoneNumber || '' %>"
                                                        class="w-full bg-surface-container-low rounded-lg px-4 py-3 text-sm border <%= _addErrors.phoneNumber ? 'border-red-500' : 'border-outline-variant/30' %> focus:ring-2 focus:ring-primary focus:outline-none transition-all font-body" />
                                                    <% if (_addErrors.phoneNumber) { %>
                                                        <p class="text-[10px] text-red-500 mt-1">
                                                            <%= _addErrors.phoneNumber %>
                                                        </p>
                                                        <% } %>
                                                </div>

                                                <!-- Address Type -->
                                                <div class="space-y-1.5 text-left">
                                                    <label
                                                        class="text-[11px] font-bold uppercase tracking-widest text-on-surface-variant block font-label">Address
                                                        Type</label>
                                                    <select name="type"
                                                        class="w-full bg-surface-container-low rounded-lg px-4 py-3 text-sm border border-outline-variant/30 focus:ring-2 focus:ring-primary focus:outline-none transition-all font-body">
                                                        <option value="home" <%=_addFormData.type==='home' ? 'selected'
                                                            : '' %>>Home</option>
                                                        <option value="office" <%=_addFormData.type==='office'
                                                            ? 'selected' : '' %>>Office</option>
                                                        <option value="other" <%=_addFormData.type==='other'
                                                            ? 'selected' : '' %>>Other</option>
                                                    </select>
                                                </div>

                                                <!-- Default toggle -->
                                                <div
                                                    class="flex items-center justify-between bg-surface-container-low rounded-lg px-4 py-3 border border-outline-variant/30 text-left">
                                                    <div>
                                                        <p
                                                            class="text-xs font-bold uppercase tracking-widest font-label">
                                                            Set as Default Address</p>
                                                        <p class="text-[10px] text-on-surface-variant mt-0.5 font-body">
                                                            Used for faster checkout</p>
                                                    </div>
                                                    <label class="relative inline-flex items-center cursor-pointer">
                                                        <input type="checkbox" name="isDefault" value="true"
                                                            class="sr-only peer" <%=_addFormData.isDefault ? 'checked'
                                                            : '' %> />
                                                        <div
                                                            class="w-11 h-6 bg-outline-variant/30 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-slate-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-primary">
                                                        </div>
                                                    </label>
                                                </div>

                                                <!-- Submit Button -->
                                                <div class="pt-4">
                                                    <button type="submit"
                                                        class="w-full bg-primary text-white py-4 rounded-sm font-headline font-bold uppercase tracking-widest text-xs hover:opacity-90 transition-all shadow-md flex items-center justify-center gap-3">
                                                        <span>Save Address</span>
                                                        <span class="material-symbols-outlined text-sm">save</span>
                                                    </button>
                                                </div>
                            </form>
                        </section>
                        <!-- Shipping Method Section -->
                        <section>
                            <div class="flex items-center gap-3 mb-8">
                                <span
                                    class="w-8 h-8 rounded-full bg-primary text-white flex items-center justify-center text-xs font-bold font-headline">02</span>
                                <h2 class="font-headline text-xl font-bold uppercase tracking-widest text-primary">
                                    Shipping
                                    Method</h2>
                            </div>
                            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                                <label
                                    class="relative flex cursor-pointer rounded-sm bg-surface-container-lowest p-6 focus:outline-none border-2 border-transparent has-[:checked]:border-primary transition-all group">
                                    <input checked="" class="sr-only" name="shipping" type="radio" value="standard" />
                                    <div class="flex flex-col">
                                        <span class="block text-sm font-bold text-primary font-headline">Standard
                                            Delivery</span>
                                        <span class="mt-1 flex items-center text-xs text-on-surface-variant">3-5
                                            Business
                                            Days</span>
                                        <span class="mt-6 text-sm font-bold text-primary">₹0.00</span>
                                    </div>
                                    <span
                                        class="material-symbols-outlined absolute top-4 right-4 text-primary opacity-0 group-has-[:checked]:opacity-100"
                                        data-icon="check_circle">check_circle</span>
                                </label>
                                <label
                                    class="relative flex cursor-pointer rounded-sm bg-surface-container-lowest p-6 focus:outline-none border-2 border-transparent has-[:checked]:border-primary transition-all group">
                                    <input class="sr-only" name="shipping" type="radio" value="express" />
                                    <div class="flex flex-col">
                                        <span class="block text-sm font-bold text-primary font-headline">Express
                                            Precision</span>
                                        <span class="mt-1 flex items-center text-xs text-on-surface-variant">Next Day
                                            Delivery</span>
                                        <span class="mt-6 text-sm font-bold text-primary">₹150.00</span>
                                    </div>
                                    <span
                                        class="material-symbols-outlined absolute top-4 right-4 text-primary opacity-0 group-has-[:checked]:opacity-100"
                                        data-icon="check_circle">check_circle</span>
                                </label>
                            </div>
                        </section>
                        <!-- Payment Method Section -->
                        <section>
                            <div class="flex items-center gap-3 mb-8">
                                <span
                                    class="w-8 h-8 rounded-full bg-primary text-white flex items-center justify-center text-xs font-bold font-headline">03</span>
                                <h2 class="font-headline text-xl font-bold uppercase tracking-widest text-primary">
                                    Payment
                                    Method</h2>
                            </div>
                            <div class="space-y-4">
                                <!-- Payment Tabs / Options -->
                                <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-6">
                                    <!-- UPI (Razorpay) Tab Button -->
                                    <button type="button" id="payBtn-Razorpay" onclick="selectPaymentMethod('Razorpay')"
                                        class="flex flex-col items-center justify-center gap-2 p-4 bg-surface-container/50 text-on-surface-variant rounded-sm border-2 border-transparent hover:bg-surface-container transition-all cursor-pointer">
                                        <span class="material-symbols-outlined text-primary"
                                            data-icon="payments">payments</span>
                                        <span class="text-[10px] font-bold uppercase tracking-widest">UPI
                                            (Razorpay)</span>
                                    </button>
                                    <!-- Wallet Tab Button -->
                                    <button type="button" id="payBtn-Wallet" onclick="selectPaymentMethod('Wallet')"
                                        class="flex flex-col items-center justify-center gap-2 p-4 bg-surface-container/50 text-on-surface-variant rounded-sm border-2 border-transparent hover:bg-surface-container transition-all cursor-pointer">
                                        <span class="material-symbols-outlined text-primary"
                                            data-icon="account_balance_wallet">account_balance_wallet</span>
                                        <span class="text-[10px] font-bold uppercase tracking-widest">Wallet</span>
                                    </button>
                                    <!-- COD Tab Button -->
                                    <button type="button" id="payBtn-COD" onclick="selectPaymentMethod('COD')"
                                        class="flex flex-col items-center justify-center gap-2 p-4 bg-primary text-white rounded-sm border-2 border-primary cursor-pointer">
                                        <span class="material-symbols-outlined text-white"
                                            data-icon="local_shipping">local_shipping</span>
                                        <span class="text-[10px] font-bold uppercase tracking-widest">COD</span>
                                    </button>
                                </div>
                                <!-- Cash on Delivery Notice (Active) -->
                                <div id="payPanel-COD"
                                    class="payment-panel bg-surface-container-lowest rounded-sm p-6 border-2 border-primary text-left">
                                    <div class="flex items-center justify-between mb-4">
                                        <div class="flex items-center gap-3">
                                            <span class="material-symbols-outlined text-primary"
                                                data-icon="local_shipping">local_shipping</span>
                                            <span
                                                class="text-sm font-bold font-headline uppercase tracking-tight text-primary">Cash
                                                on Delivery (COD)</span>
                                        </div>
                                        <span
                                            class="bg-green-50 text-green-700 text-[10px] font-bold uppercase tracking-wider px-2.5 py-1 rounded border border-green-100">Eligible</span>
                                    </div>
                                    <p class="text-xs text-on-surface-variant leading-relaxed">
                                        Pay with cash or scan-and-pay digital methods upon delivery. Please ensure
                                        someone is available at the address to receive the package and complete the
                                        payment.
                                    </p>
                                </div>
                                <!-- Razorpay Payment Notice (Hidden initially) -->
                                <div id="payPanel-Razorpay"
                                    class="payment-panel bg-surface-container-lowest rounded-sm p-6 border border-outline-variant/15 text-left hidden">
                                    <div class="flex items-center justify-between mb-4">
                                        <div class="flex items-center gap-3">
                                            <span class="material-symbols-outlined text-primary"
                                                data-icon="payments">payments</span>
                                            <span
                                                class="text-sm font-bold font-headline uppercase tracking-tight text-primary">UPI
                                                & Online Payment (Razorpay)</span>
                                        </div>
                                        <span
                                            class="bg-blue-50 text-blue-700 text-[10px] font-bold uppercase tracking-wider px-2.5 py-1 rounded border border-blue-100">Fast
                                            & Secure</span>
                                    </div>
                                    <p class="text-xs text-on-surface-variant leading-relaxed">
                                        Secure online transaction via Razorpay. Pay instantly with UPI, Cards,
                                        Netbanking, or Wallets.
                                    </p>
                                </div>
                                <!-- Wallet Payment Notice (Hidden initially) -->
                                <div id="payPanel-Wallet"
                                    class="payment-panel bg-surface-container-lowest rounded-sm p-6 border border-outline-variant/15 text-left hidden">
                                    <div class="flex items-center justify-between mb-4">
                                        <div class="flex items-center gap-3">
                                            <span class="material-symbols-outlined text-primary"
                                                data-icon="account_balance_wallet">account_balance_wallet</span>
                                            <span
                                                class="text-sm font-bold font-headline uppercase tracking-tight text-primary">Luxe
                                                Wallet Payment</span>
                                        </div>
                                        <span
                                            class="bg-amber-50 text-amber-700 text-[10px] font-bold uppercase tracking-wider px-2.5 py-1 rounded border border-amber-100">Instant</span>
                                    </div>
                                    <p class="text-xs text-on-surface-variant leading-relaxed">
                                        Pay directly from your Luxe Tech wallet balance. Ensure your wallet has
                                        sufficient funds before placing the order.
                                    </p>
                                    <div class="mt-3.5 p-3.5 bg-surface-container/50 border border-outline-variant/10 rounded flex justify-between items-center text-xs">
                                        <span class="text-on-surface-variant font-medium">Available Balance:</span>
                                        <span class="font-extrabold text-primary">₹<%= (user && user.wallet || 0).toFixed(2) %></span>
                                    </div>
                                </div>
                            </div>
                        </section>
                    </div>
                    <!-- Right Column: Sticky Order Summary -->
                    <div class="lg:col-span-5">
                        <div
                            class="sticky top-28 bg-white shadow-xl shadow-slate-200/50 rounded-lg overflow-hidden border border-slate-100/50">
                            <div class="p-8">
                                <h3
                                    class="font-headline text-lg font-extrabold uppercase tracking-widest text-primary mb-8">
                                    Order Summary</h3>
                                <!-- Product List -->
                                <div class="space-y-6 mb-10">
                                    <% if (cart && cart.items && cart.items.length> 0) { %>
                                        <% cart.items.forEach(function(item) { %>
                                            <div class="flex gap-4">
                                                <div
                                                    class="w-20 h-20 bg-surface-container rounded flex-shrink-0 overflow-hidden">
                                                    <img alt="<%= item.name %>" class="w-full h-full object-cover"
                                                        src="<%= item.image || 'https://images.unsplash.com/photo-1542291026-7eec264c27ff?w=200&auto=format&fit=crop&q=60' %>" />
                                                </div>
                                                <div class="flex-grow text-left">
                                                    <h4 class="text-sm font-bold text-primary font-headline uppercase">
                                                        <%= item.name %>
                                                    </h4>
                                                    <% if (item.variantName) { %>
                                                        <p
                                                            class="text-[10px] text-on-surface-variant font-bold uppercase mt-1">
                                                            <%= item.variantName %>
                                                        </p>
                                                        <% } %>
                                                            <div class="flex justify-between items-end mt-2">
                                                                <span
                                                                    class="text-xs font-semibold text-on-surface-variant uppercase tracking-tighter">
                                                                    Qty: <%= String(item.quantity).padStart(2, '0' ) %>
                                                                        &nbsp;&nbsp;(₹<%=
                                                                            item.discountedPrice.toFixed(2) %> x <%=
                                                                                item.quantity %>)
                                                                </span>
                                                                <span class="text-sm font-bold text-primary">₹<%=
                                                                        item.subtotal.toFixed(2) %></span>
                                                            </div>
                                                </div>
                                            </div>
                                            <% }); %>
                                                <% } else { %>
                                                    <p class="text-xs text-on-surface-variant text-center py-4">No items
                                                        in your order.</p>
                                                    <% } %>
                                </div>
                                <!-- Coupon Code Section -->
                                <div class="mb-8 pt-6 border-t border-slate-100">
                                    <label
                                        class="block text-[10px] font-bold uppercase tracking-widest text-on-surface-variant mb-2 font-label">Coupon</label>
                                    <div class="relative">
                                        <select id="coupon-select"
                                            class="w-full bg-surface-container-lowest bg-none border border-slate-200 focus:border-primary focus:ring-0 rounded-sm py-4 px-5 pr-12 text-xs font-bold uppercase tracking-widest text-[#0D1B2A] appearance-none cursor-pointer transition-all">
                                            <option value="" data-type="" data-value="0" data-min="0"
                                                data-categories="">Select a Coupon</option>
                                            <% if (locals.coupons && coupons.length> 0) { %>
                                                <% const cartProductCategoryIds=(cart && cart.items) ?
                                                    cart.items.map(item=> String(item.categoryId)) : [];
                                                    %>
                                                    <% coupons.forEach(function(coupon) { %>
                                                        <% const isApplicable=(coupon.applicableCategories.length===0)
                                                            || coupon.applicableCategories.some(cat=>
                                                            cartProductCategoryIds.includes(String(cat._id || cat)));
                                                            %>
                                                            <option value="<%= coupon._id %>"
                                                                data-code="<%= coupon.code %>"
                                                                data-type="<%= coupon.discountType %>"
                                                                data-value="<%= coupon.discountValue %>"
                                                                data-min="<%= coupon.minOrderValue %>"
                                                                data-categories="<%= coupon.applicableCategories.map(c => String(c._id || c)).join(',') %>"
                                                                <% if (!isApplicable) { %>
                                                                disabled
                                                                style="opacity: 0.5; color: #94a3b8;"
                                                                <% } %>
                                                                    >
                                                                    <% if (!isApplicable) { %>
                                                                        <%= coupon.code %> — Only applicable for <%=
                                                                                coupon.applicableCategories.map(c=>
                                                                                c.categoryName).join(', ') %>
                                                                                <% } else { %>
                                                                                    <%= coupon.code %> — <%=
                                                                                            coupon.discountType==='percentage'
                                                                                            ? coupon.discountValue + '%'
                                                                                            : '₹' + coupon.discountValue
                                                                                            %> OFF
                                                                                            <% } %>
                                                            </option>
                                                            <% }); %>
                                                                <% } else { %>
                                                                    <option value="" disabled>No coupons available
                                                                    </option>
                                                                    <% } %>
                                        </select>
                                        <div
                                            class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-4 text-[#0D1B2A]">
                                            <span class="material-symbols-outlined">expand_more</span>
                                        </div>
                                    </div>
                                    <p id="coupon-message" class="text-[10px] font-semibold mt-2 hidden"></p>
                                </div>
                                <!-- Price Breakdown -->
                                <div class="space-y-4 pt-6 border-t border-slate-100">
                                    <div class="flex justify-between text-sm">
                                        <span class="text-on-surface-variant">Subtotal</span>
                                        <span class="font-medium text-primary">₹<%= (cart ? cart.subtotal :
                                                0).toFixed(2) %></span>
                                    </div>
                                    <% if (cart && cart.discount> 0) { %>
                                        <div class="flex justify-between text-sm text-green-600">
                                            <span>Discount</span>
                                            <span class="font-medium">-₹<%= cart.discount.toFixed(2) %></span>
                                        </div>
                                        <% } %>
                                            <!-- Coupon Discount -->
                                            <div id="coupon-discount-row"
                                                class="flex justify-between text-sm text-green-600 hidden">
                                                <span>Coupon Discount (<span id="coupon-discount-code"></span>)</span>
                                                <span class="font-medium">-₹<span
                                                        id="coupon-discount-amount">0.00</span></span>
                                            </div>
                                            <div class="flex justify-between text-sm">
                                                <span class="text-on-surface-variant">Shipping</span>
                                                <span id="summary-shipping" class="font-medium text-primary">FREE</span>
                                            </div>
                                            <div class="flex justify-between text-sm">
                                                <span class="text-on-surface-variant">Estimated Tax (8%)</span>
                                                <span class="font-medium text-primary">₹<%= (cart ? cart.tax :
                                                        0).toFixed(2) %></span>
                                            </div>
                                            <div
                                                class="flex justify-between items-center pt-4 mt-4 border-t border-slate-100">
                                                <span
                                                    class="font-headline font-bold text-primary uppercase tracking-widest">Grand
                                                    Total</span>
                                                <span id="summary-grand-total"
                                                    class="font-headline font-extrabold text-2xl text-primary">₹<%=
                                                        (cart ? cart.grandTotal : 0).toFixed(2) %></span>
                                            </div>
                                </div>
                                <!-- CTA -->
                                <div class="mt-10">
                                    <form id="place-order-form" action="/checkout/place-order" method="POST">
                                        <% if (locals.checkoutError) { %>
                                            <button type="button" disabled
                                                class="w-full bg-slate-200 text-slate-400 cursor-not-allowed py-5 rounded-sm font-headline font-extrabold uppercase tracking-widest text-sm flex items-center justify-center gap-3">
                                                <span>Purchase Blocked</span>
                                                <span class="material-symbols-outlined text-sm">block</span>
                                            </button>
                                            <% } else { %>
                                                <button type="submit"
                                                    class="w-full bg-gradient-to-br from-primary to-primary-container text-white py-5 rounded-sm font-headline font-extrabold uppercase tracking-widest text-sm hover:scale-[1.02] active:scale-95 transition-all shadow-lg shadow-primary/20 flex items-center justify-center gap-3">
                                                    <span>Complete Purchase</span>
                                                    <span class="material-symbols-outlined text-sm"
                                                        data-icon="lock">lock</span>
                                                </button>
                                                <% } %>
                                    </form>
                                    <p
                                        class="text-center text-[10px] text-on-surface-variant uppercase tracking-widest mt-6 font-medium">
                                        AES-256 Bit Encrypted Security Guaranteed
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>
                    <!-- Edit Address Modal -->
                    <div id="editAddressModal"
                        class="fixed inset-0 z-[300] hidden items-end sm:items-center justify-center sm:py-8 sm:px-4">
                        <div class="absolute inset-0 bg-black/40 backdrop-blur-sm"></div>
                        <div
                            class="relative bg-white rounded-t-2xl sm:rounded-2xl shadow-2xl w-full sm:w-[90%] sm:max-w-xl z-10 max-h-[92vh] sm:max-h-[85vh] overflow-y-auto modal-scroll">
                            <!-- Drag handle (mobile only) -->
                            <div class="flex justify-center pt-3 pb-1 sm:hidden">
                                <div class="w-10 h-1 bg-outline-variant rounded-full"></div>
                            </div>
                            <!-- Header -->
                            <div class="px-5 pt-3 pb-0 sm:p-8 sm:pb-0">
                                <div class="flex items-start justify-between mb-2">
                                    <div>
                                        <h2 id="editAddressModalTitle"
                                            class="font-headline text-2xl font-extrabold tracking-tight">Edit Address
                                        </h2>
                                        <p class="text-xs text-on-surface-variant mt-1 font-body">Update your delivery
                                            information below.</p>
                                    </div>
                                    <button id="closeEditAddressBtn" type="button"
                                        class="w-8 h-8 flex items-center justify-center rounded-full hover:bg-surface-container transition-colors ml-4 mt-1">
                                        <span class="material-symbols-outlined text-sm">close</span>
                                    </button>
                                </div>
                            </div>

                            <form id="editAddressForm" action="/checkout/address/edit" method="POST"
                                class="px-5 py-4 sm:p-8 space-y-4 sm:space-y-5">

                                <% const _errors=(locals.editAddressId && locals.errors) ? locals.errors : {}; %>
                                    <% const _formData=(locals.editAddressId && locals.formData) ? locals.formData : {};
                                        %>

                                        <% if (Object.keys(_errors).length> 0) { %>
                                            <div
                                                class="bg-error-container text-[11px] text-red-600 rounded-lg px-4 py-3 text-left flex items-start gap-3 border border-red-200">
                                                <span
                                                    class="material-symbols-outlined text-base shrink-0 mt-0.5">error</span>
                                                <div>
                                                    <% if (_errors.global) { %>
                                                        <p class="font-bold">
                                                            <%= _errors.global %>
                                                        </p>
                                                        <% } else { %>
                                                            <p class="font-bold">Please fix <%=
                                                                    Object.keys(_errors).length %>
                                                                    error<%= Object.keys(_errors).length> 1 ? 's' : ''
                                                                        %> below
                                                            </p>
                                                            <p class="font-normal mt-0.5 opacity-80">Check the
                                                                highlighted
                                                                fields and try again.</p>
                                                            <% } %>
                                                </div>
                                            </div>
                                            <% } %>

                                                <!-- Full Name -->
                                                <div class="space-y-1.5 text-left">
                                                    <label
                                                        class="text-[11px] font-bold uppercase tracking-widest text-on-surface-variant block font-label">Full
                                                        Name</label>
                                                    <input type="text" name="fullName"
                                                        placeholder="E.g. Alexander Vance" required
                                                        value="<%= _formData.fullName || '' %>"
                                                        class="w-full bg-surface-container-low rounded-lg px-4 py-3 text-sm border <%= _errors.fullName ? 'border-red-500' : 'border-outline-variant/30' %> focus:ring-2 focus:ring-primary focus:outline-none transition-all font-body" />
                                                    <% if (_errors.fullName) { %>
                                                        <p class="text-[10px] text-red-500 mt-1">
                                                            <%= _errors.fullName %>
                                                        </p>
                                                        <% } %>
                                                </div>

                                                <!-- Street Address -->
                                                <div class="space-y-1.5 text-left">
                                                    <label
                                                        class="text-[11px] font-bold uppercase tracking-widest text-on-surface-variant block font-label">Street
                                                        Address</label>
                                                    <input type="text" name="streetAddress"
                                                        placeholder="123 Precision Way" required
                                                        value="<%= _formData.streetAddress || '' %>"
                                                        class="w-full bg-surface-container-low rounded-lg px-4 py-3 text-sm border <%= _errors.streetAddress ? 'border-red-500' : 'border-outline-variant/30' %> focus:ring-2 focus:ring-primary focus:outline-none transition-all font-body" />
                                                    <% if (_errors.streetAddress) { %>
                                                        <p class="text-[10px] text-red-500 mt-1">
                                                            <%= _errors.streetAddress %>
                                                        </p>
                                                        <% } %>
                                                </div>

                                                <!-- City + ZIP -->
                                                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-left">
                                                    <div class="space-y-1.5">
                                                        <label
                                                            class="text-[11px] font-bold uppercase tracking-widest text-on-surface-variant block font-label">City</label>
                                                        <input type="text" name="city" placeholder="San Francisco"
                                                            required value="<%= _formData.city || '' %>"
                                                            class="w-full bg-surface-container-low rounded-lg px-4 py-3 text-sm border <%= _errors.city ? 'border-red-500' : 'border-outline-variant/30' %> focus:ring-2 focus:ring-primary focus:outline-none transition-all font-body" />
                                                        <% if (_errors.city) { %>
                                                            <p class="text-[10px] text-red-500 mt-1">
                                                                <%= _errors.city %>
                                                            </p>
                                                            <% } %>
                                                    </div>
                                                    <div class="space-y-1.5">
                                                        <label
                                                            class="text-[11px] font-bold uppercase tracking-widest text-on-surface-variant block font-label">ZIP
                                                            / Postal Code</label>
                                                        <input type="text" name="zipCode" placeholder="94103" required
                                                            value="<%= _formData.zipCode || '' %>"
                                                            class="w-full bg-surface-container-low rounded-lg px-4 py-3 text-sm border <%= _errors.zipCode ? 'border-red-500' : 'border-outline-variant/30' %> focus:ring-2 focus:ring-primary focus:outline-none transition-all font-body" />
                                                        <% if (_errors.zipCode) { %>
                                                            <p class="text-[10px] text-red-500 mt-1">
                                                                <%= _errors.zipCode %>
                                                            </p>
                                                            <% } %>
                                                    </div>
                                                </div>

                                                <!-- State + Country -->
                                                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-left">
                                                    <div class="space-y-1.5">
                                                        <label
                                                            class="text-[11px] font-bold uppercase tracking-widest text-on-surface-variant block font-label">State
                                                            / Province</label>
                                                        <input type="text" name="state" placeholder="California"
                                                            required value="<%= _formData.state || '' %>"
                                                            class="w-full bg-surface-container-low rounded-lg px-4 py-3 text-sm border <%= _errors.state ? 'border-red-500' : 'border-outline-variant/30' %> focus:ring-2 focus:ring-primary focus:outline-none transition-all font-body" />
                                                        <% if (_errors.state) { %>
                                                            <p class="text-[10px] text-red-500 mt-1">
                                                                <%= _errors.state %>
                                                            </p>
                                                            <% } %>
                                                    </div>
                                                    <div class="space-y-1.5">
                                                        <label
                                                            class="text-[11px] font-bold uppercase tracking-widest text-on-surface-variant block font-label">Country</label>
                                                        <input type="text" name="country" placeholder="India" required
                                                            value="<%= _formData.country || '' %>"
                                                            class="w-full bg-surface-container-low rounded-lg px-4 py-3 text-sm border <%= _errors.country ? 'border-red-500' : 'border-outline-variant/30' %> focus:ring-2 focus:ring-primary focus:outline-none transition-all font-body" />
                                                        <% if (_errors.country) { %>
                                                            <p class="text-[10px] text-red-500 mt-1">
                                                                <%= _errors.country %>
                                                            </p>
                                                            <% } %>
                                                    </div>
                                                </div>

                                                <!-- Phone -->
                                                <div class="space-y-1.5 text-left">
                                                    <label
                                                        class="text-[11px] font-bold uppercase tracking-widest text-on-surface-variant block font-label">Phone
                                                        Number</label>
                                                    <input type="text" name="phoneNumber" placeholder="+91 0000000000"
                                                        required value="<%= _formData.phoneNumber || '' %>"
                                                        class="w-full bg-surface-container-low rounded-lg px-4 py-3 text-sm border <%= _errors.phoneNumber ? 'border-red-500' : 'border-outline-variant/30' %> focus:ring-2 focus:ring-primary focus:outline-none transition-all font-body" />
                                                    <% if (_errors.phoneNumber) { %>
                                                        <p class="text-[10px] text-red-500 mt-1">
                                                            <%= _errors.phoneNumber %>
                                                        </p>
                                                        <% } %>
                                                </div>

                                                <!-- Address Type -->
                                                <div class="space-y-1.5 text-left">
                                                    <label
                                                        class="text-[11px] font-bold uppercase tracking-widest text-on-surface-variant block font-label">Address
                                                        Type</label>
                                                    <select id="editAddressTypeSelect" name="type"
                                                        class="w-full bg-surface-container-low rounded-lg px-4 py-3 text-sm border border-outline-variant/30 focus:ring-2 focus:ring-primary focus:outline-none transition-all font-body">
                                                        <option value="home" <%=_formData.type==='home' ? 'selected'
                                                            : '' %>
                                                            >Home</option>
                                                        <option value="office" <%=_formData.type==='office' ? 'selected'
                                                            : '' %>
                                                            >Office</option>
                                                        <option value="other" <%=_formData.type==='other' ? 'selected'
                                                            : '' %>
                                                            >Other</option>
                                                    </select>
                                                </div>

                                                <!-- Default toggle -->
                                                <div
                                                    class="flex items-center justify-between bg-surface-container-low rounded-lg px-4 py-3 border border-outline-variant/30 text-left">
                                                    <div>
                                                        <p
                                                            class="text-xs font-bold uppercase tracking-widest font-label">
                                                            Set as
                                                            Default Address
                                                        </p>
                                                        <p class="text-[10px] text-on-surface-variant mt-0.5 font-body">
                                                            Used for
                                                            faster checkout
                                                        </p>
                                                    </div>
                                                    <label class="relative inline-flex items-center cursor-pointer">
                                                        <input id="editAddressIsDefaultChk" type="checkbox"
                                                            name="isDefault" value="true" class="sr-only peer"
                                                            <%=_formData.isDefault ? 'checked' : '' %> />
                                                        <div
                                                            class="w-10 h-6 bg-outline-variant rounded-full peer peer-checked:bg-primary transition-colors">
                                                        </div>
                                                        <div
                                                            class="absolute left-1 top-1 w-4 h-4 bg-white rounded-full transition-transform peer-checked:translate-x-4">
                                                        </div>
                                                    </label>
                                                </div>

                                                <!-- Actions -->
                                                <div class="flex gap-3 pt-2">
                                                    <button id="editAddressModalSubmitBtn" type="submit"
                                                        class="flex-1 py-3 bg-primary text-white text-xs font-bold uppercase tracking-wider rounded-md hover:bg-slate-800 transition-all active:scale-95 font-label">
                                                        Save Changes
                                                    </button>
                                                    <button id="cancelEditAddressBtn" type="button"
                                                        class="flex-1 py-3 border border-outline-variant text-on-surface-variant text-xs font-bold uppercase tracking-wider rounded-md hover:bg-surface-container transition-all text-center font-label">
                                                        Cancel
                                                    </button>
                                                </div>
                            </form>

                            <!-- Footer -->
                            <div
                                class="px-5 sm:px-8 pb-6 flex items-center justify-center gap-6 text-[10px] text-on-surface-variant font-body">
                                <div class="flex items-center gap-1">
                                    <span class="material-symbols-outlined text-sm">lock</span>
                                    Secure Encryption
                                </div>
                                <div class="flex items-center gap-1">
                                    <span class="material-symbols-outlined text-sm">sync</span>
                                    Instant Sync
                                </div>
                            </div>
                        </div>
                    </div>
    </main>

    <!-- Beautiful Tailwind Alert/Error Modal -->
    <div id="alert-modal"
        class="fixed inset-0 z-50 flex items-center justify-center hidden opacity-0 transition-opacity duration-300">
        <!-- Backdrop -->
        <div id="alert-modal-backdrop"
            class="absolute inset-0 bg-[#0D1B2A]/40 backdrop-blur-sm transition-opacity duration-300"></div>
        <!-- Modal Card -->
        <div
            class="relative bg-white rounded-2xl max-w-sm w-full mx-4 p-8 shadow-2xl transform scale-95 transition-transform duration-300 border border-slate-100">
            <div class="flex flex-col items-center text-center">
                <div class="w-14 h-14 rounded-full bg-red-50 flex items-center justify-center text-red-600 mb-4">
                    <span class="material-symbols-outlined text-3xl">warning</span>
                </div>
                <h3 class="text-lg font-bold font-headline text-[#0D1B2A] mb-2">Status Notice</h3>
                <p id="alert-modal-message" class="text-slate-600 text-sm leading-relaxed mb-6"></p>
                <button id="alert-close-btn"
                    class="w-full py-3 bg-[#0D1B2A] hover:bg-slate-800 text-white font-bold text-xs uppercase tracking-widest rounded-lg transition-colors">
                    GOT IT
                </button>
            </div>
        </div>
    </div>

    <script>
        const cartItems = <%- JSON.stringify(cart ? cart.items.map(item => ({ name: item.name, categoryId: String(item.categoryId) })) : []) %>;
        // Addresses data
        const addresses = {
            <% addresses.forEach(function (addr) { %>
            "<%= addr._id %>": {
                id: "<%= addr._id %>",
                    name: "<%= addr.fullName %>",
                        fullName: "<%= addr.fullName %>",
                            streetAddress: "<%= addr.streetAddress %>",
                                city: "<%= addr.city %>",
                                    state: "<%= addr.state %>",
                                        zipCode: "<%= addr.zipCode %>",
                                            country: "<%= addr.country %>",
                                                phoneNumber: "<%= addr.phoneNumber %>",
                                                    type: "<%= addr.type %>",
                                                        isDefault: <%= addr.isDefault %>,
                                                            tag: "<%= addr.isDefault ? 'Default (' + addr.type.toUpperCase() + ')' : addr.type.toUpperCase() %>",
                                                                street: "<%= addr.streetAddress %>",
                                                                    cityStateZip: "<%= addr.city %>, <%= addr.state %> <%= addr.zipCode %>"
            },
            <% }); %>
        };

        // DOM Elements
        const tabSavedAddresses = document.getElementById('tab-saved-addresses');
        const tabAddNewAddress = document.getElementById('tab-add-new-address');
        const addressSelectContainer = document.getElementById('address-select-container');
        const addressSelect = document.getElementById('address-select');
        const savedAddressCard = document.getElementById('saved-address-card');
        const newAddressForm = document.getElementById('new-address-form');

        const cardName = document.getElementById('card-name');
        const cardTag = document.getElementById('card-tag');
        const cardStreet = document.getElementById('card-street');
        const cardCityStateZip = document.getElementById('card-city-state-zip');
        const cardCountry = document.getElementById('card-country');

        // Edit Address Modal DOM Elements
        const editAddressModal = document.getElementById('editAddressModal');
        const editAddressForm = document.getElementById('editAddressForm');
        const editAddressBtn = document.getElementById('edit-address-btn');
        const closeEditAddressBtn = document.getElementById('closeEditAddressBtn');
        const cancelEditAddressBtn = document.getElementById('cancelEditAddressBtn');
        const editAddressTypeSelect = document.getElementById('editAddressTypeSelect');
        const editAddressIsDefaultChk = document.getElementById('editAddressIsDefaultChk');

        function editField(name) { return editAddressForm.querySelector(`[name="${name}"]`); }

        function openEditModal() {
            editAddressModal.classList.remove('hidden');
            editAddressModal.classList.add('flex');
        }

        function closeEditModal() {
            editAddressModal.classList.add('hidden');
            editAddressModal.classList.remove('flex');
        }

        // Tab switching handler
        function setTab(tab) {
            if (tab === 'saved') {
                // Update tabs classes
                tabSavedAddresses.className = "flex-1 py-3 px-4 border-2 border-primary bg-primary text-white text-xs font-bold uppercase tracking-widest transition-all";
                tabAddNewAddress.className = "flex-1 py-3 px-4 border-2 border-outline-variant text-on-surface-variant text-xs font-bold uppercase tracking-widest hover:border-primary transition-all";

                // Show saved address selector and card
                addressSelectContainer.classList.remove('hidden');
                savedAddressCard.classList.remove('hidden');

                // Hide add new address form
                newAddressForm.classList.add('hidden');
            } else if (tab === 'new') {
                // Update tabs classes
                tabAddNewAddress.className = "flex-1 py-3 px-4 border-2 border-primary bg-primary text-white text-xs font-bold uppercase tracking-widest transition-all";
                tabSavedAddresses.className = "flex-1 py-3 px-4 border-2 border-outline-variant text-on-surface-variant text-xs font-bold uppercase tracking-widest hover:border-primary transition-all";

                // Hide saved address selector and card
                addressSelectContainer.classList.add('hidden');
                savedAddressCard.classList.add('hidden');

                // Show add new address form
                newAddressForm.classList.remove('hidden');
            }
        }

        // Address selection handler
        function updateAddressCard(key) {
            const address = addresses[key];
            if (address) {
                cardName.textContent = address.name;
                cardTag.textContent = address.tag;
                cardStreet.textContent = address.street;
                cardCityStateZip.textContent = address.cityStateZip;
                cardCountry.textContent = address.country;
            }
        }

        // Attach Event Listeners
        tabSavedAddresses.addEventListener('click', () => setTab('saved'));
        tabAddNewAddress.addEventListener('click', () => setTab('new'));
        addressSelect.addEventListener('change', (e) => updateAddressCard(e.target.value));

        if (editAddressBtn) {
            editAddressBtn.addEventListener('click', () => {
                // Clear any previous error indicators/texts
                const errorBanner = editAddressForm.querySelector('.bg-error-container');
                if (errorBanner) errorBanner.remove();

                editAddressForm.querySelectorAll('input, select').forEach(el => {
                    el.classList.remove('border-red-500');
                    el.classList.add('border-outline-variant/30');
                });
                editAddressForm.querySelectorAll('.text-red-500').forEach(el => el.remove());

                const currentId = addressSelect.value;
                const addr = addresses[currentId];
                if (addr) {
                    editAddressForm.action = `/checkout/address/edit/${addr.id}${window.location.search}`;

                    editField('fullName').value = addr.fullName;
                    editField('streetAddress').value = addr.streetAddress;
                    editField('city').value = addr.city;
                    editField('zipCode').value = addr.zipCode;
                    editField('state').value = addr.state;
                    editField('country').value = addr.country;
                    editField('phoneNumber').value = addr.phoneNumber;
                    editAddressTypeSelect.value = addr.type || 'home';
                    editAddressIsDefaultChk.checked = addr.isDefault;

                    openEditModal();
                }
            });
        }

        closeEditAddressBtn.addEventListener('click', closeEditModal);
        cancelEditAddressBtn.addEventListener('click', closeEditModal);

        // Close on backdrop click
        const editModalBackdrop = editAddressModal.querySelector('.absolute.inset-0');
        if (editModalBackdrop) {
            editModalBackdrop.addEventListener('click', closeEditModal);
        }

        // Close on Escape key
        document.addEventListener('keydown', (e) => {
            if (e.key === 'Escape') closeEditModal();
        });

        // Initialization
        if (newAddressForm) {
            newAddressForm.action = `/checkout/address/add${window.location.search}`;
        }

        <% if (addresses.length === 0 || locals.activeTab === 'new') { %>
            setTab('new');
            <% if (addresses.length === 0) { %>
                tabSavedAddresses.classList.add('hidden');
            <% } %>
        <% } else { %>
            setTab('saved');
            updateAddressCard(addressSelect.value);
        <% } %>

        <% if (locals.editAddressId) { %>
            // Prefill and open the edit modal immediately on validation error redirect
            editAddressForm.action = `/checkout/address/edit/<%= locals.editAddressId %>${window.location.search}`;
            openEditModal();
        <% } %>

        // Shipping Method and Coupon Dynamic pricing
        const shippingRadios = document.querySelectorAll('input[name="shipping"]');
        const summaryShippingSpan = document.getElementById('summary-shipping');
        const summaryGrandTotalSpan = document.getElementById('summary-grand-total');

        const baseSubtotal = <%= (cart ? cart.subtotal : 0) %>;
        const baseTax = <%= (cart ? cart.tax : 0) %>;
        const baseProductDiscount = <%= (cart ? cart.discount : 0) %>;

        const couponSelect = document.getElementById('coupon-select');
        const couponDiscountRow = document.getElementById('coupon-discount-row');
        const couponDiscountCode = document.getElementById('coupon-discount-code');
        const couponDiscountAmount = document.getElementById('coupon-discount-amount');
        const couponMessage = document.getElementById('coupon-message');

        function updateTotals() {
            // 1. Shipping Method
            let selectedShipping = 'standard';
            shippingRadios.forEach(radio => {
                if (radio.checked) {
                    selectedShipping = radio.value;
                }
            });
            let shippingCost = selectedShipping === 'express' ? 150 : 0;
            summaryShippingSpan.textContent = selectedShipping === 'express' ? '₹150.00' : 'FREE';

            // 2. Coupon Discount Calculation
            let couponDiscount = 0;
            if (couponSelect && couponSelect.value) {
                const selectedOption = couponSelect.options[couponSelect.selectedIndex];
                const code = selectedOption.getAttribute('data-code');
                const type = selectedOption.getAttribute('data-type');
                const value = parseFloat(selectedOption.getAttribute('data-value')) || 0;
                const minVal = parseFloat(selectedOption.getAttribute('data-min')) || 0;

                if (baseSubtotal < minVal) {
                    couponMessage.textContent = `Minimum order of ₹${minVal.toFixed(2)} required for coupon ${code}`;
                    couponMessage.className = "text-[10px] font-semibold mt-2 text-red-500 block";
                    couponSelect.value = ""; // Reset selection
                    couponDiscountRow.classList.add('hidden');
                } else {
                    if (type === 'percentage') {
                        couponDiscount = Math.round(baseSubtotal * (value / 100));
                    } else if (type === 'fixed') {
                        couponDiscount = value;
                    }

                    if (couponDiscount > baseSubtotal) {
                        couponDiscount = baseSubtotal;
                    }

                    couponMessage.textContent = `Coupon ${code} applied successfully!`;
                    couponMessage.className = "text-[10px] font-semibold mt-2 text-green-600 block";

                    couponDiscountCode.textContent = code;
                    couponDiscountAmount.textContent = couponDiscount.toFixed(2);
                    couponDiscountRow.classList.remove('hidden');
                }
            } else {
                couponMessage.classList.add('hidden');
                couponDiscountRow.classList.add('hidden');
            }

            // 3. Grand Total
            // grandTotal = subtotal + tax + shipping - couponDiscount
            const finalGrandTotal = Math.max(0, baseSubtotal + baseTax + shippingCost - couponDiscount);
            summaryGrandTotalSpan.textContent = '₹' + finalGrandTotal.toFixed(2);
        }

        shippingRadios.forEach(radio => {
            radio.addEventListener('change', updateTotals);
        });
        if (couponSelect) {
            couponSelect.addEventListener('change', updateTotals);
        }

        updateTotals();

        // Function to show custom alert modal
        const showAlert = (message, title = "Status Notice") => {
            const modal = document.getElementById('alert-modal');
            if (modal) {
                document.getElementById('alert-modal-message').innerText = message;
                modal.querySelector('h3').innerText = title;

                modal.classList.remove('hidden');
                setTimeout(() => {
                    modal.classList.remove('opacity-0');
                    modal.querySelector('.relative').classList.remove('scale-95');
                }, 10);
            }
        };

        const closeAlertModal = () => {
            const modal = document.getElementById('alert-modal');
            if (modal) {
                modal.classList.add('opacity-0');
                modal.querySelector('.relative').classList.add('scale-95');
                setTimeout(() => {
                    modal.classList.add('hidden');
                }, 300);
            }
        };

        const alertCloseBtn = document.getElementById('alert-close-btn');
        if (alertCloseBtn) {
            alertCloseBtn.addEventListener('click', closeAlertModal);
        }

        const alertModal = document.getElementById('alert-modal');
        const alertModalBackdrop = document.getElementById('alert-modal-backdrop');
        if (alertModal) {
            alertModal.addEventListener('click', (e) => {
                if (e.target === alertModal || e.target === alertModalBackdrop) {
                    closeAlertModal();
                }
            });
        }

        let activePaymentMethod = 'COD';

        function selectPaymentMethod(method) {
            activePaymentMethod = method;

            // Reset all buttons to inactive styles
            const methods = ['Razorpay', 'Wallet', 'COD'];
            methods.forEach(m => {
                const btn = document.getElementById(`payBtn-${m}`);
                const panel = document.getElementById(`payPanel-${m}`);

                if (btn) {
                    btn.className = "flex flex-col items-center justify-center gap-2 p-4 bg-surface-container/50 text-on-surface-variant rounded-sm border-2 border-transparent hover:bg-surface-container transition-all cursor-pointer";
                    // Reset icon color
                    const icon = btn.querySelector('.material-symbols-outlined');
                    if (icon) {
                        icon.className = "material-symbols-outlined text-primary";
                    }
                }
                if (panel) {
                    panel.classList.add('hidden');
                    panel.classList.remove('border-primary');
                }
            });

            // Set active button styles
            const activeBtn = document.getElementById(`payBtn-${method}`);
            const activePanel = document.getElementById(`payPanel-${method}`);

            if (activeBtn) {
                activeBtn.className = "flex flex-col items-center justify-center gap-2 p-4 bg-primary text-white rounded-sm border-2 border-primary cursor-default";
                const icon = activeBtn.querySelector('.material-symbols-outlined');
                if (icon) {
                    icon.className = "material-symbols-outlined text-white";
                }
            }
            if (activePanel) {
                activePanel.classList.remove('hidden');
                activePanel.classList.add('border-primary');
            }
        }

        const placeOrderForm = document.getElementById('place-order-form');
        if (placeOrderForm) {
            placeOrderForm.addEventListener('submit', (e) => {
                const addressSelect = document.getElementById('address-select');
                const addressId = addressSelect ? addressSelect.value : '';

                if (!addressId) {
                    e.preventDefault();
                    showAlert('Please add or select a delivery address first.', 'Address Required');
                    return;
                }

                // Validate coupon category compatibility on checkout form submission
                if (couponSelect && couponSelect.value) {
                    const selectedOption = couponSelect.options[couponSelect.selectedIndex];
                    const dataCategories = selectedOption.getAttribute('data-categories') || '';

                    if (dataCategories) {
                        const allowedCategoryIds = dataCategories.split(',');
                        const invalidProducts = [];

                        for (const item of cartItems) {
                            if (!item.categoryId || !allowedCategoryIds.includes(item.categoryId)) {
                                invalidProducts.push(item.name);
                            }
                        }

                        if (invalidProducts.length > 0) {
                            e.preventDefault();
                            showAlert(
                                `This coupon cannot be used for the following products in your checkout: (${invalidProducts.join(', ')}). Please remove them to proceed with this coupon.`,
                                "Status Notice"
                            );
                            return;
                        }
                    }
                }

                let shippingMethod = 'standard';
                const selectedShippingRadio = document.querySelector('input[name="shipping"]:checked');
                if (selectedShippingRadio) {
                    shippingMethod = selectedShippingRadio.value;
                }

                if (activePaymentMethod === 'Wallet') {
                    const grandTotalText = document.getElementById('summary-grand-total').textContent.replace(/[^\d.]/g, '');
                    const grandTotal = parseFloat(grandTotalText) || 0;
                    const walletBalance = <%= (user && user.wallet) || 0 %>;
                    
                    if (walletBalance < grandTotal) {
                        e.preventDefault();
                        showAlert('Your wallet balance is insufficient to place this order.', 'Insufficient Funds');
                        return;
                    }
                }

                if (activePaymentMethod === 'Razorpay') {
                    e.preventDefault();
                    fetch(`/checkout/place-order${window.location.search}`, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({
                            addressId: addressId,
                            shippingMethod: shippingMethod,
                            paymentMethod: 'Razorpay',
                            couponId: couponSelect ? couponSelect.value : ''
                        })
                    })
                    .then(res => res.json())
                    .then(data => {
                        if (!data.success) {
                            showAlert(data.message || 'Failed to place order.', 'Error');
                            return;
                        }
                        const options = {
                            "key": data.razorpayKeyId,
                            "amount": data.amount,
                            "currency": data.currency,
                            "name": "Luxe Tech",
                            "description": "Order Payment " + data.razorpayOrderId,
                            "order_id": data.razorpayOrderId,
                            "handler": function (response) {
                                fetch(`/checkout/verify-payment${window.location.search}`, {
                                    method: 'POST',
                                    headers: { 'Content-Type': 'application/json' },
                                    body: JSON.stringify({
                                        razorpay_order_id: response.razorpay_order_id,
                                        razorpay_payment_id: response.razorpay_payment_id,
                                        razorpay_signature: response.razorpay_signature
                                    })
                                })
                                .then(res => res.json())
                                .then(verifyData => {
                                    if (verifyData.success) {
                                        window.location.href = `/order/success?orderId=${verifyData.orderId}`;
                                    } else {
                                        showAlert(verifyData.message || 'Payment verification failed.', 'Error');
                                    }
                                })
                                .catch(err => {
                                    console.error(err);
                                    showAlert('Payment verification connection failed.', 'Error');
                                });
                            },
                            "theme": { "color": "#000000" }
                        };
                        const rzp = new Razorpay(options);
                        rzp.open();
                    })
                    .catch(err => {
                        console.error(err);
                        showAlert('Something went wrong during payment.', 'Error');
                    });
                    return;
                }

                const addressInput = document.createElement('input');
                addressInput.type = 'hidden';
                addressInput.name = 'addressId';
                addressInput.value = addressId;
                placeOrderForm.appendChild(addressInput);

                const shippingInput = document.createElement('input');
                shippingInput.type = 'hidden';
                shippingInput.name = 'shippingMethod';
                shippingInput.value = shippingMethod;
                placeOrderForm.appendChild(shippingInput);

                const paymentInput = document.createElement('input');
                paymentInput.type = 'hidden';
                paymentInput.name = 'paymentMethod';
                paymentInput.value = activePaymentMethod;
                placeOrderForm.appendChild(paymentInput);

                const couponInput = document.createElement('input');
                couponInput.type = 'hidden';
                couponInput.name = 'couponId';
                couponInput.value = couponSelect ? couponSelect.value : '';
                placeOrderForm.appendChild(couponInput);

                placeOrderForm.action = `/checkout/place-order${window.location.search}`;
            });
        }
    </script>
</body>

</html>