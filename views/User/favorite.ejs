<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Your Wishlist – Luxe Tech</title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap"
    rel="stylesheet" />
  <link rel="stylesheet" href="/User/css/main-global.css">
  <link rel="stylesheet" href="/User/css/loading-bar.css">
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0"
    rel="stylesheet">
  <style>
    *,
    *::before,
    *::after {
      box-sizing: border-box;
      margin: 0;
      padding: 0
    }

    body {
      font-family: 'Inter', sans-serif;
      background: #f8fafc;
      color: #0f172a;
      font-size: 13px
    }

    /* ── PAGE ── */
    .page {
      max-width: 1200px;
      margin: 0 auto;
      padding: 48px 24px 100px
    }

    /* ── HEADER ── */
    .header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 36px;
      border-bottom: 1px solid #e2e8f0;
      padding-bottom: 24px;
    }

    .header h1 {
      font-size: 28px;
      font-weight: 800;
      color: #0f172a;
      letter-spacing: -0.03em;
      margin-bottom: 6px
    }

    .header-desc {
      font-size: 13px;
      color: #64748b;
      max-width: 500px;
      line-height: 1.6
    }

    .items-count {
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 0.05em;
      text-transform: uppercase;
      color: #64748b;
      background: #f1f5f9;
      padding: 8px 16px;
      border-radius: 9999px;
      border: 1px solid #e2e8f0;
      white-space: nowrap;
    }

    /* ── FEATURED CARD ── */
    .featured {
      background: #ffffff;
      border: 1px solid rgba(15, 23, 42, 0.06);
      border-radius: 16px;
      overflow: hidden;
      display: flex;
      min-height: 200px;
      margin-bottom: 24px;
      box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.02), 0 2px 4px -1px rgba(0, 0, 0, 0.02), 0 10px 15px -3px rgba(0, 0, 0, 0.03);
      transition: transform 0.25s cubic-bezier(0.4, 0, 0.2, 1), box-shadow 0.25s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .featured:hover {
      transform: translateY(-4px);
      box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.05), 0 8px 10px -6px rgba(0, 0, 0, 0.03);
    }

    .feat-img {
      width: 240px;
      flex-shrink: 0;
      background: #f1f5f9;
      position: relative;
      overflow: hidden;
    }

    .feat-img img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: transform 0.5s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .featured:hover .feat-img img {
      transform: scale(1.06);
    }

    /* ── STATUS BADGES ── */
    .badge-status {
      position: absolute;
      top: 14px;
      left: 14px;
      font-size: 9px;
      font-weight: 700;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      padding: 4px 10px;
      border-radius: 6px;
      box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
      z-index: 10;
    }
    
    .badge-instock {
      background: rgba(34, 197, 94, 0.1);
      color: #166534;
      border: 1px solid rgba(34, 197, 94, 0.2);
    }

    .badge-lowstock {
      background: rgba(245, 158, 11, 0.1);
      color: #92400e;
      border: 1px solid rgba(245, 158, 11, 0.2);
    }

    .badge-stockout {
      background: rgba(234, 88, 12, 0.1);
      color: #9a3412;
      border: 1px solid rgba(234, 88, 12, 0.2);
    }

    .badge-unavailable {
      background: rgba(239, 68, 68, 0.1);
      color: #991b1b;
      border: 1px solid rgba(239, 68, 68, 0.2);
    }

    .feat-body {
      flex: 1;
      padding: 28px;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
    }

    .feat-top {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      margin-bottom: 8px;
    }

    .feat-name {
      font-size: 20px;
      font-weight: 800;
      color: #0f172a;
      letter-spacing: -0.025em;
    }
    
    .feat-name.line-through {
      color: #94a3b8;
      text-decoration: line-through;
    }

    .feat-desc {
      font-size: 13px;
      color: #64748b;
      line-height: 1.65;
      margin-bottom: 16px;
      max-width: 600px;
    }

    .feat-price {
      font-size: 22px;
      font-weight: 800;
      color: #0f172a;
      letter-spacing: -0.02em;
    }

    .icon-del {
      background: #f1f5f9;
      color: #64748b;
      border: none;
      width: 36px;
      height: 36px;
      border-radius: 9999px;
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .icon-del:hover {
      background: #fee2e2;
      color: #ef4444;
      transform: scale(1.05);
    }
    
    .icon-del .material-symbols-outlined {
      font-size: 18px;
    }

    /* ── CARD ACTIONS & BUTTONS ── */
    .feat-actions {
      display: flex;
      gap: 12px;
      width: 100%;
    }

    .btn-add {
      font-family: 'Inter', sans-serif;
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 0.05em;
      text-transform: uppercase;
      cursor: pointer;
      border-radius: 8px;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
      border: 1px solid transparent;
      padding: 12px 24px;
      flex: 1;
    }

    .btn-add.btn-primary {
      background: #0f172a;
      color: #ffffff;
    }

    .btn-add.btn-primary:hover {
      background: #1e293b;
      transform: translateY(-1px);
      box-shadow: 0 4px 12px rgba(15, 23, 42, 0.15);
    }

    .btn-add.btn-secondary {
      background: transparent;
      color: #0f172a;
      border: 1px solid #cbd5e1;
    }

    .btn-add.btn-secondary:hover {
      background: #f8fafc;
      border-color: #94a3b8;
      transform: translateY(-1px);
    }

    .btn-add.btn-disabled {
      background: #cbd5e1;
      color: #94a3b8;
      cursor: not-allowed;
    }

    /* ── LOW STOCK ALERT ── */
    .low-stock-alert {
      color: #d97706;
      font-size: 11px;
      font-weight: 600;
      margin-top: 6px;
    }

    /* ── DIVIDER ── */
    .divider {
      height: 1px;
      background: #e2e8f0;
      width: 100%;
      margin: 40px 0;
    }

    /* ── SUMMARY ── */
    .summary {
      display: flex;
      justify-content: flex-end;
      padding-top: 8px;
    }

    .summary-box {
      width: 320px;
      background: #ffffff;
      border: 1px solid rgba(15, 23, 42, 0.06);
      border-radius: 16px;
      padding: 24px;
      box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.02), 0 10px 15px -3px rgba(0, 0, 0, 0.03);
    }

    .sum-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 20px;
    }

    .sum-label {
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 0.05em;
      text-transform: uppercase;
      color: #64748b
    }

    .sum-total {
      font-size: 24px;
      font-weight: 800;
      color: #0f172a;
      letter-spacing: -0.02em;
    }

    .btn-move {
      width: 100%;
      background: #0f172a;
      color: #ffffff;
      border: none;
      padding: 14px;
      font-family: 'Inter', sans-serif;
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      cursor: pointer;
      border-radius: 8px;
      transition: all 0.2s ease;
    }

    .btn-move:hover:not(:disabled) {
      background: #1e293b;
      transform: translateY(-1px);
      box-shadow: 0 4px 12px rgba(15, 23, 42, 0.15);
    }

    .btn-move:disabled {
      background: #cbd5e1;
      color: #94a3b8;
      cursor: not-allowed;
    }

    /* ── RESPONSIVE ── */
    @media(max-width:900px) {
      .page {
        padding: 32px 16px 80px
      }

      .featured {
        flex-direction: column
      }

      .feat-img {
        width: 100%;
        height: 220px
      }

      .summary {
        justify-content: center
      }

      .summary-box {
        width: 100%
      }

      .header h1 {
        font-size: 24px
      }
    }

    @media(max-width:640px) {
      .header {
        flex-direction: column;
        align-items: flex-start;
        gap: 16px
      }

      .feat-img {
        height: 180px
      }

      .feat-name {
        font-size: 17px
      }

      .feat-price {
        font-size: 18px
      }

      .sum-total {
        font-size: 22px
      }
    }

    /* ── CUSTOM MODAL OVERLAY & CONTAINER ── */
    .modal-overlay {
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: rgba(15, 23, 42, 0.3);
      backdrop-filter: blur(4px);
      display: none;
      align-items: center;
      justify-content: center;
      z-index: 2000;
      opacity: 0;
      transition: opacity 0.3s ease;
    }

    .modal-overlay.active {
      opacity: 1;
    }

    .modal-container {
      background: #ffffff;
      border: 1px solid rgba(15, 23, 42, 0.08);
      box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04);
      border-radius: 16px;
      width: 90%;
      max-width: 400px;
      padding: 28px;
      transform: scale(0.95);
      transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
    }

    .modal-overlay.active .modal-container {
      transform: scale(1);
    }

    .modal-header {
      display: flex;
      align-items: center;
      gap: 12px;
      margin-bottom: 12px;
    }

    .modal-icon {
      color: #ea580c;
      font-size: 24px;
    }

    .modal-title {
      font-family: 'Inter', sans-serif;
      font-size: 16px;
      font-weight: 700;
      color: #0f172a;
      margin: 0;
    }

    .modal-message {
      font-family: 'Inter', sans-serif;
      font-size: 13.5px;
      line-height: 1.55;
      color: #475569;
      margin: 0 0 24px 0;
    }

    .modal-actions {
      display: flex;
      justify-content: flex-end;
      gap: 12px;
    }

    .modal-btn {
      font-family: 'Inter', sans-serif;
      font-size: 11px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      padding: 10px 20px;
      border: none;
      border-radius: 6px;
      cursor: pointer;
      transition: background 0.2s, color 0.2s;
    }

    .btn-secondary {
      background: #f1f5f9;
      color: #475569;
    }

    .btn-secondary:hover {
      background: #e2e8f0;
      color: #0f172a;
    }

    .btn-danger {
      background: #ef4444;
      color: #ffffff;
    }

    .btn-danger:hover {
      background: #dc2626;
    }

    /* ── EMPTY STATE ── */
    .empty-state {
      background: #ffffff;
      border: 1px dashed #cbd5e1;
      border-radius: 16px;
      padding: 80px 24px;
      text-align: center;
      margin: 40px auto;
      max-width: 500px;
      box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.02);
    }
    .empty-state .material-symbols-outlined {
      font-size: 56px;
      color: #94a3b8;
      margin-bottom: 20px;
      display: inline-block;
    }
    .empty-state h2 {
      font-size: 20px;
      font-weight: 800;
      color: #0f172a;
      margin-bottom: 10px;
      letter-spacing: -0.02em;
    }
    .empty-state p {
      font-size: 13.5px;
      color: #64748b;
      margin-bottom: 28px;
      line-height: 1.6;
    }
    .btn-shop {
      background: #0f172a;
      color: #ffffff;
      border: none;
      padding: 12px 28px;
      font-family: 'Inter', sans-serif;
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      cursor: pointer;
      border-radius: 8px;
      text-decoration: none;
      display: inline-block;
      transition: all 0.2s ease;
    }
    .btn-shop:hover {
      background: #1e293b;
      transform: translateY(-1px);
      box-shadow: 0 4px 12px rgba(15, 23, 42, 0.15);
    }
  </style>
</head>

<body>
  <%- include('../partials/loadingBar') %>

  <%- include('../partials/user/main-header', { user }) %>

    <!-- PAGE -->
    <div class="page">

      <!-- HEADER -->
      <div class="header">
        <div>
          <h1>Your Wishlist&nbsp; Collection</h1>
          <p class="header-desc">Refine your setup with the precision engineering you've saved. These pieces represent
            the pinnacle of our technical achievement.</p>
        </div>
        <div class="items-count"><%= wishlistItems.length %> <%= wishlistItems.length === 1 ? 'Item' : 'Items' %> Saved</div>
      </div>

      <% if (wishlistItems.length === 0) { %>
        <!-- Empty State -->
        <div class="empty-state">
          <span class="material-symbols-outlined">favorite</span>
          <h2>Your Wishlist is Empty</h2>
          <p>Explore our catalog and save your favorite gear for later.</p>
          <a href="/shop" class="btn-shop">Go to Shop</a>
        </div>
      <% } else { %>
        <%
          let subtotal = 0;
          let hasInvalidItems = false;
          for (let i = 0; i < wishlistItems.length; i++) {
              if (!wishlistItems[i].isUnavailable && !wishlistItems[i].isStockout) {
                  subtotal += wishlistItems[i].displayPrice;
              } else {
                  hasInvalidItems = true;
              }
          }
        %>

        <!-- WISHLIST ITEMS LIST -->
        <div class="wishlist-list" style="display: flex; flex-direction: column; gap: 24px;">
          <% wishlistItems.forEach(item => { %>
            <div class="featured">
              <div class="feat-img">
                <% if (item.firstImage) { %>
                  <img src="<%= item.firstImage %>" alt="<%= item.name %>" />
                <% } %>
                <% if (item.isUnavailable) { %>
                  <span class="badge-status badge-unavailable">Unavailable</span>
                <% } else if (item.isStockout) { %>
                  <span class="badge-status badge-stockout">Stockout</span>
                <% } else if (item.isLowStock) { %>
                  <span class="badge-status badge-lowstock">Low Stock</span>
                <% } else { %>
                  <span class="badge-status badge-instock">In Stock</span>
                <% } %>
              </div>
              <div class="feat-body">
                <div>
                  <div class="feat-top">
                    <div class="feat-name <%= item.isUnavailable ? 'line-through' : '' %>"><%= item.name %></div>
                    <button onclick="removeFromFavorite('<%= item.productId %>', '<%= item.variantId || '' %>')" class="icon-del" title="Remove">
                      <span class="material-symbols-outlined">delete</span>
                    </button>
                  </div>
                  <div class="feat-desc"><%= item.description %></div>
                  <% if (item.isUnavailable) { %>
                    <div class="feat-price" style="color: #ef4444; font-size: 15px;">Product Unavailable</div>
                  <% } else { %>
                    <div class="feat-price">₹<%= item.displayPrice %></div>
                    <% if (item.isLowStock) { %>
                      <p class="low-stock-alert">Only <%= item.stock %> units remaining! Order soon.</p>
                    <% } %>
                  <% } %>
                </div>
                <% if (item.isUnavailable) { %>
                  <button class="btn-add btn-disabled" disabled>Unavailable</button>
                <% } else if (item.isStockout) { %>
                  <button class="btn-add btn-disabled" disabled>Stockout</button>
                <% } else { %>
                  <div class="feat-actions">
                    <button class="btn-add btn-primary" onclick="singleAddToCart('<%= item.productId %>', '<%= item.variantId || '' %>')">
                      <span class="material-symbols-outlined" style="font-size: 16px;">shopping_cart</span> Add to Cart
                    </button>
                    <button class="btn-add btn-secondary" onclick="window.location.href='/product-details?id=<%= item.productId %><%= item.variantId ? '&variantId=' + item.variantId : '' %>'">
                      View Details
                    </button>
                  </div>
                <% } %>
              </div>
            </div>
          <% }) %>
        </div>

        <!-- DIVIDER -->
        <div class="divider"></div>

        <!-- SUMMARY -->
        <div class="summary">
          <div class="summary-box">
            <div class="sum-row">
              <span class="sum-label">Wishlist Subtotal</span>
              <span class="sum-total">₹<%= subtotal %></span>
            </div>
            <% if (hasInvalidItems) { %>
              <button class="btn-move" id="move-all" style="background: #cbd5e1; color: #94a3b8; cursor: not-allowed;" disabled>Add to Cart</button>
              <p style="color: #ef4444; font-size: 10px; margin-top: 8px; text-align: center; font-weight: 600;">
                Please remove unavailable/stockout items to proceed.
              </p>
            <% } else { %>
              <button class="btn-move" id="move-all" onclick="addAllToCart()">Add to Cart</button>
            <% } %>
          </div>
        </div>
      <% } %>

    </div><!-- /page -->

    <!-- CUSTOM REMOVE MODAL -->
    <div id="delete-modal" class="modal-overlay">
      <div class="modal-container">
        <div class="modal-header">
          <span class="material-symbols-outlined modal-icon">warning</span>
          <h3 class="modal-title">Remove Item?</h3>
        </div>
        <p class="modal-message">Are you sure you want to remove this precision gear from your wishlist collection?</p>
        <div class="modal-actions">
          <button id="modal-cancel-btn" class="modal-btn btn-secondary">Cancel</button>
          <button id="modal-confirm-btn" class="modal-btn btn-danger">Remove</button>
        </div>
      </div>
    </div>

    <!-- CUSTOM ALERT/ERROR MODAL -->
    <div id="alert-modal" class="modal-overlay">
      <div class="modal-container">
        <div class="modal-header" style="justify-content: center; flex-direction: column; text-align: center; gap: 8px; margin-bottom: 16px;">
          <span class="material-symbols-outlined modal-icon" style="color: #ea580c; font-size: 40px; margin-bottom: 4px;">warning</span>
          <h3 class="modal-title" id="alert-modal-title" style="font-size: 18px;">Attention</h3>
        </div>
        <p class="modal-message" id="alert-modal-message" style="text-align: center; font-size: 13px; margin-bottom: 20px;">Something went wrong.</p>
        <div class="modal-actions" style="justify-content: center;">
          <button id="alert-close-btn" class="modal-btn btn-secondary" style="background: #111827; color: #fff; width: 100%; border-radius: 6px; padding: 12px 24px;">Got it</button>
        </div>
      </div>
    </div>

    <script>
    let productToDelete = null;
    let variantToDelete = null;

    function removeFromFavorite(productId, variantId) {
        productToDelete = productId;
        variantToDelete = variantId || null;
        const modal = document.getElementById('delete-modal');
        modal.style.display = 'flex';
        setTimeout(() => {
            modal.classList.add('active');
        }, 10);
    }

    function closeDeleteModal() {
        const modal = document.getElementById('delete-modal');
        modal.classList.remove('active');
        setTimeout(() => {
            modal.style.display = 'none';
            productToDelete = null;
            variantToDelete = null;
        }, 300);
    }

    // Custom Alert Modal Functions
    function showAlert(message, title = "Attention") {
        document.getElementById('alert-modal-title').innerText = title;
        document.getElementById('alert-modal-message').innerText = message;
        const modal = document.getElementById('alert-modal');
        modal.style.display = 'flex';
        setTimeout(() => {
            modal.classList.add('active');
        }, 10);
    }

    function closeAlertModal() {
        const modal = document.getElementById('alert-modal');
        modal.classList.remove('active');
        setTimeout(() => {
            modal.style.display = 'none';
        }, 300);
    }

    document.getElementById('alert-close-btn').addEventListener('click', closeAlertModal);
    document.getElementById('alert-modal').addEventListener('click', function(e) {
        if (e.target === this) {
            closeAlertModal();
        }
    });

    document.getElementById('modal-cancel-btn').addEventListener('click', closeDeleteModal);

    document.getElementById('modal-confirm-btn').addEventListener('click', async function() {
        if (!productToDelete) return;
        try {
            const response = await fetch('/wishlist/remove', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({ 
                    productId: productToDelete,
                    variantId: variantToDelete
                })
            });
            const data = await response.json();
            if (data.success) {
                window.location.reload();
            } else {
                showAlert(data.message || 'Failed to remove from favorites.', 'Error');
            }
        } catch (err) {
            console.error('Error removing from favorites:', err);
            showAlert('An error occurred. Please try again.', 'Error');
        } finally {
            closeDeleteModal();
        }
    });

    document.getElementById('delete-modal').addEventListener('click', function(e) {
        if (e.target === this) {
            closeDeleteModal();
        }
    });

    async function addAllToCart() {
        const moveBtn = document.getElementById('move-all');
        const originalText = moveBtn.textContent;
        moveBtn.disabled = true;
        moveBtn.textContent = 'Adding to Cart...';

        try {
            const response = await fetch('/wishlist/add-all-to-cart', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                }
            });

            if (response.status === 401) {
                window.location.href = '/login';
                return;
            }

            const data = await response.json();
            if (data.success) {
                window.location.href = '/cart';
            } else {
                showAlert(data.message || 'Failed to add items to cart.', 'Attention');
                moveBtn.disabled = false;
                moveBtn.textContent = originalText;
            }
        } catch (err) {
            console.error('Error adding all to cart:', err);
            showAlert('An error occurred. Please try again.', 'Error');
            moveBtn.disabled = false;
            moveBtn.textContent = originalText;
        }
    }

    async function singleAddToCart(productId, variantId) {
        try {
            const response = await fetch('/cart/add', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({
                    productId: productId,
                    variantId: variantId || null,
                    quantity: 1
                })
            });

            if (response.status === 401) {
                window.location.href = '/login';
                return;
            }

            const data = await response.json();
            if (data.success) {
                // Remove from wishlist database after successful addition to cart
                try {
                    await fetch('/wishlist/remove', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json'
                        },
                        body: JSON.stringify({
                            productId: productId,
                            variantId: variantId || null
                        })
                    });
                } catch (removeErr) {
                    console.error('Error removing item from wishlist after cart add:', removeErr);
                }
                window.location.href = '/cart';
            } else {
                showAlert(data.message || 'Failed to add item to cart.', 'Attention');
            }
        } catch (err) {
            console.error('Error adding item to cart:', err);
            showAlert('An error occurred. Please try again.', 'Error');
        }
    }
    </script>
    <script src="/User/js/loading-bar.js"></script>
</body>

</html>