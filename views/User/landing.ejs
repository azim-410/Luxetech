<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description"
        content="LUXE TECH — Precision instruments for the modern creator. Premium monitors, keyboards, headsets and mice engineered for professionals.">
    <title>LUXE TECH | PRECISION REDEFINED</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
        href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=Manrope:wght@700;800&display=swap"
        rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0"
        rel="stylesheet">
    <link rel="stylesheet" href="/User/css/landing.css">
</head>

<body class="animate-in">

    <!-- Header -->
    <header>
        <a href="#" class="logo" id="header-logo">LUXE TECH</a>
        <nav id="main-nav">
            <ul>`
                <li><a href="#" class="active">HOME</a></li>
                <li><a href="#">NEW ARRIVALS</a></li>
                <li><a href="#">SHOP</a></li>
                <li><a href="#">SUPPORT</a></li>
            </ul>
        </nav>
        <div class="header-actions">
            <div class="search-bar" id="search-bar">
                <span class="material-symbols-outlined">search</span>
                <input type="text" placeholder="Search">
            </div>
            <div class="icons-group">
                <span class="material-symbols-outlined" id="icon-favorite">favorite</span>
                <span class="material-symbols-outlined" id="icon-cart">shopping_cart</span>
                <span class="material-symbols-outlined" id="icon-user">person</span>
            </div>
        </div>
    </header>

    <!-- Hero Section -->
    <section class="hero" id="hero-section">
        <div class="container">
            <div class="hero-content">
                <div class="badge">NEW ARRIVAL / TITAN SERIES</div>
                <h1>PRECISION<br>REDEFINED.</h1>
                <p>Engineering excellence for the modern creator. Experience a workstation that moves at the speed of
                    thought.</p>
                <a href="#" class="btn-primary" id="btn-explore">EXPLORE COLLECTION</a>
            </div>
        </div>
    </section>

    <!-- Categories Bento Grid -->
    <section class="categories-section" id="categories-section">
        <div class="container">
            <div class="bento-grid">
                <div class="bento-item item-monitors" id="cat-monitors">
                    <img src="/User/images/landing/bento_monitor.png" alt="Premium Monitors">
                    <div class="bento-content">
                        <h3>MONITORS</h3>
                        <p>4K • 240HZ • OLED</p>
                    </div>
                </div>
                <div class="bento-item item-headsets" id="cat-headsets">
                    <img src="/User/images/landing/bento_headset.png" alt="Premium Headphones">
                    <div class="bento-content">
                        <h3>HEADPHONES</h3>
                    </div>
                </div>
                <div class="bento-item item-keyboards" id="cat-keyboards">
                    <img src="/User/images/landing/bento_keyboard.png" alt="Mechanical Keyboards">
                    <div class="bento-content">
                        <h3>KEYBOARDS</h3>
                    </div>
                </div>
                <div class="bento-item item-mouse" id="cat-mouse">
                    <img src="/User/images/landing/bento_mouse.png" alt="Precision Mouse">
                    <div class="bento-content">
                        <h3>MOUSE</h3>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Flagship Gear Section -->
    <section class="products-section" id="products-section">
        <div class="container">
            <div class="section-header">
                <div class="section-title">
                    <span>ENGINEERED FOR PROS</span>
                    <h2>FLAGSHIP GEAR</h2>
                </div>
                <a href="#" class="view-all" id="view-catalog">VIEW FULL CATALOG</a>
            </div>

            <div class="product-grid">
                <!-- Product 1: Monitor -->
                <div class="product-card" id="product-monitor">
                    <div class="product-image">
                        <div class="product-tag">LIMITED EDITION</div>
                        <img src="/User/images/landing/prod_monitor.png" alt="LUXE-O 32 Ultra-Pro Monitor">
                    </div>
                    <div class="product-info">
                        <h3>LUXE-O 32" ULTRA-PRO</h3>
                        <span class="product-price">$1,499</span>
                    </div>
                    <div class="product-rating">
                        <span class="stars">★★★★★</span>
                        <span>(128 Reviews)</span>
                    </div>
                </div>

                <!-- Product 2: Mouse -->
                <div class="product-card" id="product-mouse">
                    <div class="product-image">
                        <img src="/User/images/landing/prod_mouse.png" alt="Precision Slate Mouse">
                    </div>
                    <div class="product-info">
                        <h3>PRECISION SLATE MOUSE</h3>
                        <span class="product-price">$189</span>
                    </div>
                    <div class="product-rating">
                        <span class="stars">★★★★★</span>
                        <span>(84 Reviews)</span>
                    </div>
                </div>

                <!-- Product 3: Keyboard -->
                <div class="product-card" id="product-keyboard">
                    <div class="product-image">
                        <img src="/User/images/landing/prod_keyboard.png" alt="Mechanical Core 80 Keyboard">
                    </div>
                    <div class="product-info">
                        <h3>MECHANICAL CORE 80</h3>
                        <span class="product-price">$249</span>
                    </div>
                    <div class="product-rating">
                        <span class="stars">★★★★★</span>
                        <span>(120 Reviews)</span>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Features Section -->
    <section class="features-section" id="features-section">
        <div class="container">
            <div class="features-grid">
                <div class="feature-item" id="feature-logistics">
                    <div class="feature-icon">
                        <span class="material-symbols-outlined">public</span>
                    </div>
                    <h4>GLOBAL LOGISTICS</h4>
                    <p>Swift, white-glove delivery to over 120 countries with real-time biometric tracking.</p>
                </div>
                <div class="feature-item" id="feature-network">
                    <div class="feature-icon">
                        <span class="material-symbols-outlined">shield</span>
                    </div>
                    <h4>SECURED NETWORK</h4>
                    <p>Enterprise-grade encryption on all smart hardware integrations and cloud sync.</p>
                </div>
                <div class="feature-item" id="feature-support">
                    <div class="feature-icon">
                        <span class="material-symbols-outlined">headset_mic</span>
                    </div>
                    <h4>CONCIERGE SUPPORT</h4>
                    <p>24/7 dedicated engineering support for high-performance workstation optimization.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- Newsletter Section -->
    <section class="newsletter-section" id="newsletter-section">
        <div class="container">
            <div class="newsletter-inner">
                <div class="newsletter-text">
                    <h2>JOIN THE INSIDER LIST.</h2>
                    <p>Receive exclusive early access to hardware drops, technical deep-dives, and limited prototype
                        releases.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- Footer -->
    <footer id="site-footer">
        <div class="footer-inner">
            <div class="footer-logo">
                LUXE TECH
                <span>PRECISION INSTRUMENTS</span>
            </div>
            <div class="footer-links">
                <a href="#">Privacy Policy</a>
                <a href="#">Terms of Service</a>
                <a href="#">Warranty</a>
                <a href="#">Global Shipping</a>
                <a href="#">Contact Us</a>
            </div>
            <div class="copyright">
                © 2024 Luxe Tech Precision. All Rights Reserved.
            </div>
        </div>
    </footer>

</body>

</html>