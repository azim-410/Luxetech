<!DOCTYPE html>

<html class="light" lang="en">

<head>
  <meta charset="utf-8" />
  <meta content="width=device-width, initial-scale=1.0" name="viewport" />
  <title>Order Confirmed | Luxe Tech</title>
  <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
  <link
    href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&amp;family=Inter:wght@400;500;600;700&amp;display=swap"
    rel="stylesheet" />
  <link
    href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap"
    rel="stylesheet" />
  <link
    href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap"
    rel="stylesheet" />
  <script id="tailwind-config">
    tailwind.config = {
      darkMode: "class",
      theme: {
        extend: {
          colors: {
            "surface-tint": "#2b5bb5",
            "on-tertiary-container": "#dc5d00",
            "on-primary-fixed": "#001945",
            "primary": "#000000",
            "inverse-on-surface": "#eff1f4",
            "on-surface": "#191c1e",
            "on-primary-fixed-variant": "#00429c",
            "on-primary": "#ffffff",
            "primary-fixed": "#d9e2ff",
            "surface-bright": "#f7f9fc",
            "secondary": "#48626e",
            "surface-container-lowest": "#ffffff",
            "on-tertiary-fixed-variant": "#7a3000",
            "error": "#ba1a1a",
            "surface-dim": "#d8dadd",
            "tertiary": "#000000",
            "on-tertiary-fixed": "#341100",
            "on-secondary-container": "#4e6874",
            "on-error-container": "#93000a",
            "primary-container": "#001945",
            "surface-container": "#eceef1",
            "surface-container-high": "#e6e8eb",
            "on-background": "#191c1e",
            "tertiary-fixed-dim": "#ffb692",
            "on-secondary-fixed": "#021f29",
            "background": "#f7f9fc",
            "on-secondary": "#ffffff",
            "surface": "#f7f9fc",
            "surface-container-highest": "#e0e3e6",
            "on-secondary-fixed-variant": "#304a55",
            "secondary-container": "#cbe7f5",
            "on-tertiary": "#ffffff",
            "error-container": "#ffdad6",
            "tertiary-fixed": "#ffdbcb",
            "outline": "#74777d",
            "on-error": "#ffffff",
            "primary-fixed-dim": "#b0c6ff",
            "tertiary-container": "#341100",
            "inverse-primary": "#b0c6ff",
            "inverse-surface": "#2d3133",
            "surface-variant": "#e0e3e6",
            "outline-variant": "#c4c6cc",
            "secondary-fixed": "#cbe7f5",
            "on-primary-container": "#5781de",
            "surface-container-low": "#f2f4f7",
            "on-surface-variant": "#44474c",
            "secondary-fixed-dim": "#afcbd8"
          },
          fontFamily: {
            "headline": ["Manrope"],
            "body": ["Inter"],
            "label": ["Inter"]
          },
          borderRadius: { "DEFAULT": "0.125rem", "lg": "0.25rem", "xl": "0.5rem", "full": "0.75rem" },
        },
      },
    }
  </script>
  <style>
    .material-symbols-outlined {
      font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
    }

    .glass-effect {
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
    }

    .signature-gradient {
      background: linear-gradient(135deg, #000000 0%, #001945 100%);
    }
  </style>
</head>

<body class="bg-surface font-body text-on-surface selection:bg-secondary-container">
  <main class="pt-8 pb-12 px-4 md:px-8 max-w-5xl mx-auto">
    <!-- Success Celebration Hero -->
    <section class="mt-4 flex flex-col items-center text-center">
      <div class="w-12 h-12 mb-2 relative">
        <div class="absolute inset-0 bg-secondary-container rounded-full animate-ping opacity-20"></div>
        <div class="relative w-full h-full bg-secondary-container rounded-full flex items-center justify-center">
          <span class="material-symbols-outlined text-on-secondary-container text-2xl"
            style="font-variation-settings: 'FILL' 1;">check_circle</span>
        </div>
      </div>
      <h1 class="font-headline text-2xl md:text-3xl font-extrabold tracking-tighter text-on-surface mb-1">Order
        Confirmed</h1>
      <p class="text-on-surface-variant max-w-sm mx-auto text-xs mb-4">
        Your order has been successfully placed and is now being prepared. You can monitor its delivery status and view
        transaction details directly below.
      </p>
      <div class="inline-flex items-center gap-1.5 px-2.5 py-1 bg-surface-container-low rounded-full mb-6">
        <span class="font-label text-[9px] uppercase tracking-widest text-on-surface-variant font-semibold">Order
          ID:</span>
        <span class="font-mono font-bold text-[10px] text-primary">
          <%= order.orderId %>
        </span>
        <button
          class="material-symbols-outlined text-[10px] text-on-surface-variant hover:text-primary transition-colors">content_copy</button>
      </div>
    </section>
    <!-- Main Content Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-5 items-start">
      <!-- Left Column: Order Summary (Asymmetric Bento) -->
      <div class="lg:col-span-8 space-y-4">
        <div class="bg-surface-container-lowest p-4 rounded-lg shadow-sm border border-outline-variant/10">
          <h2 class="font-headline text-base font-bold mb-4">Shipment Summary</h2>
          <div class="space-y-3">
            <% order.items.forEach(function(item) { %>
              <!-- Item -->
              <div class="flex flex-col md:flex-row gap-3 items-start">
                <div class="w-16 h-16 bg-surface-container rounded-md overflow-hidden flex-shrink-0">
                  <img class="w-full h-full object-cover"
                    src="<%= item.image || 'https://images.unsplash.com/photo-1542291026-7eec264c27ff?w=200&auto=format&fit=crop&q=60' %>" />
                </div>
                <div class="flex-grow w-full py-0.5">
                  <div class="flex justify-between items-start mb-0.5 w-full">
                    <div>
                      <h3 class="font-headline font-bold text-sm text-on-surface">
                        <%= item.name %>
                      </h3>
                      <% if (item.variantName) { %>
                        <p class="text-on-surface-variant text-[10px]">
                          <%= item.variantName %>
                        </p>
                        <% } %>
                    </div>
                    <span class="font-bold text-sm text-on-surface">₹<%= item.price.toFixed(2) %></span>
                  </div>
                  <div class="flex items-center gap-4 mt-1">
                    <div class="bg-surface-container-low px-2 py-0.5 rounded-full">
                      <span class="text-[9px] font-label uppercase tracking-tighter font-semibold">Qty: <%=
                          item.quantity %></span>
                    </div>
                  </div>
                </div>
              </div>
              <% }); %>
          </div>
        </div>
        <!-- Shipping & Payment Bento Cells -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div class="bg-surface-container-low p-4 rounded-lg">
            <div class="flex items-center gap-2 mb-2 text-on-surface-variant">
              <span class="material-symbols-outlined text-sm">local_shipping</span>
              <h4 class="font-label text-[10px] uppercase tracking-widest font-bold">Shipping Address</h4>
            </div>
            <p class="text-on-surface text-xs leading-relaxed">
              <%= order.shippingAddress.fullName %><br />
                <%= order.shippingAddress.streetAddress %><br />
                  <%= order.shippingAddress.city %>, <%= order.shippingAddress.state %>
                      <%= order.shippingAddress.zipCode %><br />
                        <%= order.shippingAddress.country %>
            </p>
          </div>
          <div class="bg-surface-container-low p-4 rounded-lg">
            <div class="flex items-center gap-2 mb-2 text-on-surface-variant">
              <span class="material-symbols-outlined text-sm">payments</span>
              <h4 class="font-label text-[10px] uppercase tracking-widest font-bold">Payment Method</h4>
            </div>
            <div class="flex items-center gap-2.5">
              <div class="w-8 h-5 bg-primary rounded flex items-center justify-center">
                <span class="text-[8px] text-white font-bold italic">
                  <%= order.paymentMethod %>
                </span>
              </div>
              <p class="text-on-surface text-xs leading-normal">
                Status: <%= order.paymentStatus %><br />
                  <span class="text-[10px] text-on-surface-variant font-medium">Payment Mode: <%= order.paymentMethod %>
                      </span>
              </p>
            </div>
          </div>
        </div>
      </div>
      <!-- Right Column: Totals & CTAs -->
      <aside class="lg:col-span-4 sticky top-28 space-y-4">
        <div class="bg-surface-container-lowest p-5 rounded-lg shadow-sm border border-outline-variant/10">
          <h3 class="font-headline text-base font-bold mb-4">Order Total</h3>
          <div class="space-y-2 mb-4">
            <div class="flex justify-between text-on-surface-variant text-xs">
              <span>Subtotal</span>
              <span>₹<%= order.pricing.subtotal.toFixed(2) %></span>
            </div>
            <div class="flex justify-between text-on-surface-variant text-xs">
              <span>Shipping</span>
              <span class="text-on-tertiary-container font-semibold">
                <%= order.pricing.shipping> 0 ? '₹' + order.pricing.shipping.toFixed(2) : 'FREE' %>
              </span>
            </div>
            <div class="flex justify-between text-on-surface-variant text-xs">
              <span>Tax (8%)</span>
              <span>₹<%= order.pricing.tax.toFixed(2) %></span>
            </div>
            <div class="flex justify-between text-on-surface-variant text-xs">
              <span>Coupon Redeemed</span>
              <span class="font-semibold text-primary">
                <%= order.couponCode ? order.couponCode : '-' %>
              </span>
            </div>
            <div class="flex justify-between text-on-surface-variant text-xs">
              <span>Coupon Discount</span>
              <span class="text-green-600 font-semibold">
                <%= (order.pricing && order.pricing.couponDiscount> 0) ? '-₹' + order.pricing.couponDiscount.toFixed(2)
                  : '₹0.00' %>
              </span>
            </div>
            <div class="pt-2.5 border-t border-surface-container flex justify-between items-end">
              <span class="font-headline font-bold text-sm">Total</span>
              <div class="text-right">
                <span class="block text-[9px] text-on-surface-variant mb-0.5 uppercase font-label">INR</span>
                <span class="font-headline font-extrabold text-xl tracking-tight text-primary">₹<%=
                    order.pricing.grandTotal.toFixed(2) %></span>
              </div>
            </div>
          </div>
          <div class="space-y-2">
            <a href="/shop"
              class="w-full signature-gradient text-white py-2.5 rounded-md font-label font-bold text-xs uppercase tracking-wider flex items-center justify-center gap-1.5 active:scale-95 transition-transform">
              <span class="material-symbols-outlined text-xs">shopping_bag</span>
              Continue Shopping
            </a>
            <a href="/orders/track/<%= order._id %>"
              class="w-full border border-primary text-primary py-2.5 rounded-md font-label font-bold text-xs uppercase tracking-wider flex items-center justify-center gap-1.5 active:scale-95 transition-transform hover:bg-surface-container-low">
              <span class="material-symbols-outlined text-xs">local_shipping</span>
              Track Order
            </a>
          </div>
        </div>
      </aside>
    </div>
    <!-- Order Milestone Timeline -->
    <section class="mt-8 pt-6 border-t border-surface-container">
      <h2 class="font-headline text-base font-bold mb-6 text-center">What happens next?</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="flex flex-col items-center text-center">
          <div class="w-8 h-8 rounded-full bg-secondary-container flex items-center justify-center mb-2">
            <span class="material-symbols-outlined text-on-secondary-container text-base">inventory_2</span>
          </div>
          <h3 class="font-bold text-xs mb-1 font-semibold">Quality Control</h3>
          <p class="text-[11px] text-on-surface-variant max-w-xs mx-auto">Our team performs a 12-point precision check
            on every hardware component before packaging.</p>
        </div>
        <div class="flex flex-col items-center text-center">
          <div class="w-8 h-8 rounded-full bg-surface-container flex items-center justify-center mb-2 text-outline">
            <span class="material-symbols-outlined text-base">package_2</span>
          </div>
          <h3 class="font-bold text-xs mb-1 font-semibold">Eco-Packaging</h3>
          <p class="text-[11px] text-on-surface-variant max-w-xs mx-auto">Orders are packed using 100% recyclable,
            impact-resistant materials designed for safe transit.</p>
        </div>
        <div class="flex flex-col items-center text-center">
          <div class="w-8 h-8 rounded-full bg-surface-container flex items-center justify-center mb-2 text-outline">
            <span class="material-symbols-outlined text-base">speed</span>
          </div>
          <h3 class="font-bold text-xs mb-1 font-semibold">Express Transit</h3>
          <p class="text-[11px] text-on-surface-variant max-w-xs mx-auto">We partner with tier-1 couriers to ensure your
            gear arrives within 48 hours of shipment.</p>
        </div>
      </div>
    </section>
  </main>
</body>

</html>