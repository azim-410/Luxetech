        <!-- EJS data parsed cleanly to avoid IDE syntax/parsing issues -->
        <script id="product-details-data" type="application/json">
            {
                "product": <%- locals.product ? JSON.stringify(product) : "null" %>,
                "wishlistItems": <%- locals.wishlistItems ? JSON.stringify(wishlistItems) : "[]" %>,
                "isBlocked": <%= locals.isBlocked ? "true" : "false" %>
            }
        </script>
        <script>
            const ejsData = JSON.parse(document.getElementById('product-details-data').textContent);
            const product = ejsData.product;
            const userWishlistItems = ejsData.wishlistItems;
            const isBlocked = ejsData.isBlocked;

            function updateWishlistButton(productId, variantId) {
                const btn = document.getElementById('wishlist-btn');
                if (!btn) return;
                
                if (isBlocked) {
                    btn.disabled = true;
                    btn.className = "w-full h-12 bg-slate-100 text-slate-400 cursor-not-allowed border border-slate-200 transition-all duration-300 font-label font-bold uppercase tracking-wider text-xs text-center flex items-center justify-center";
                    btn.innerHTML = "Add to Wishlist";
                    return;
                }

                const isInWishlist = userWishlistItems.some(item => {
                    const pIdMatch = item.productId && item.productId.toString() === productId.toString();
                    const vIdMatch = (!variantId && !item.variantId) || (item.variantId && variantId && item.variantId.toString() === variantId.toString());
                    return pIdMatch && vIdMatch;
                });

                if (isInWishlist) {
                    btn.innerHTML = '❤️ Already in Wishlist';
                    btn.disabled = true;
                    btn.className = "w-full h-12 bg-[#0D1B2A] text-white border-2 border-[#0D1B2A] transition-all duration-300 font-label font-bold uppercase tracking-wider text-xs text-center flex items-center justify-center cursor-default";
                } else {
                    btn.innerHTML = 'Add to Wishlist';
                    btn.disabled = false;
                    btn.className = "w-full h-12 bg-white text-[#0D1B2A] border-2 border-[#0D1B2A] hover:bg-slate-50 transition-all duration-300 font-label font-bold uppercase tracking-wider text-xs text-center flex items-center justify-center cursor-pointer";
                }
            }

            function updateVariantGallery(selectElement) {
                const selectedOption = selectElement.options[selectElement.selectedIndex];
                if (!selectedOption) return;
                const imagesAttr = selectedOption.getAttribute('data-images') || '';
                const images = imagesAttr ? imagesAttr.split(',') : [];
                const priceAdd = parseFloat(selectedOption.getAttribute('data-price-add') || '0');

                // 1. Update Price dynamically
                const priceEl = document.getElementById('product-price');
                const basePriceEl = document.getElementById('product-base-price');

                if (!product || product.isDeleted) {
                    return { success: false, message: 'This product is currently unavailable.' };
                }

                if (priceEl) {
                    const baseDiscounted = parseFloat(priceEl.getAttribute('data-base-discounted'));
                    const baseOriginal = parseFloat(priceEl.getAttribute('data-base-original'));

                    if (!isNaN(baseDiscounted)) {
                        priceEl.textContent = '₹' + (baseDiscounted + priceAdd);
                    } else if (!isNaN(baseOriginal)) {
                        priceEl.textContent = '₹' + (baseOriginal + priceAdd);
                    }
                }

                if (basePriceEl) {
                    const baseOriginal = parseFloat(basePriceEl.getAttribute('data-base-original'));
                    if (!isNaN(baseOriginal)) {
                        basePriceEl.textContent = '₹' + (baseOriginal + priceAdd);
                    }
                }

                // 2. Update Gallery images dynamically
                const mainImg = document.getElementById('main-product-img');
                const placeholder = document.getElementById('main-product-img-placeholder');
                const thumbnailsWrapper = document.getElementById('thumbnails-wrapper');

                if (images.length > 0) {
                    mainImg.src = images[0];
                    mainImg.style.display = 'block';
                    if (placeholder) placeholder.style.display = 'none';

                    // Rebuild thumbnails starting from index 0
                    thumbnailsWrapper.innerHTML = '';
                    for (let i = 0; i < Math.min(images.length, 6); i++) {
                        const thumbDiv = document.createElement('div');
                        thumbDiv.className = 'col-span-2 aspect-square bg-surface-container rounded-lg overflow-hidden border border-outline-variant/10 cursor-pointer';
                        thumbDiv.onclick = function () {
                            mainImg.src = images[i];
                        };

                        const imgEl = document.createElement('img');
                        imgEl.className = 'w-full h-full object-contain opacity-80 hover:opacity-100 transition-opacity';
                        imgEl.src = images[i];
                        imgEl.alt = 'Gallery Image';

                        thumbDiv.appendChild(imgEl);
                        thumbnailsWrapper.appendChild(thumbDiv);
                    }
                } else {
                    mainImg.src = '';
                    mainImg.style.display = 'none';
                    if (placeholder) placeholder.style.display = 'flex';
                    thumbnailsWrapper.innerHTML = '';
                }

                // 3. Update Stock Status dynamically
                const stockBadge = document.getElementById('stock-badge');
                const stockText = document.getElementById('stock-count-text');
                const addToCartBtn = document.getElementById('add-to-cart-btn');
                const buyNowBtn = document.getElementById('buy-now-btn');

                if (stockBadge && stockText) {
                    const stockAttr = selectedOption.getAttribute('data-stock');
                    const stock = stockAttr !== null ? parseInt(stockAttr) : 0;

                    if (stock <= 0) {
                        stockBadge.textContent = 'Out of Stock';
                        stockBadge.className = 'px-2.5 py-1 rounded text-[10px] font-extrabold uppercase tracking-wider bg-red-50 text-red-700 border border-red-100';
                        stockText.textContent = 'This variant is currently sold out and unavailable.';
                        stockText.className = 'text-xs font-semibold tracking-wide mt-1 text-red-600';
                        
                        if (addToCartBtn) {
                            addToCartBtn.disabled = true;
                            addToCartBtn.innerHTML = '<span class="material-symbols-outlined text-slate-400">hourglass_empty</span> Out of Stock';
                            addToCartBtn.className = 'w-full py-5 bg-slate-100 text-slate-400 cursor-not-allowed transition-all duration-300 font-label font-bold uppercase tracking-widest text-sm flex items-center justify-center gap-3';
                        }
                        if (buyNowBtn) {
                            buyNowBtn.disabled = true;
                            buyNowBtn.className = 'w-full py-5 bg-slate-100 text-slate-400 cursor-not-allowed border border-slate-255 transition-all duration-300 font-label font-bold uppercase tracking-widest text-sm flex items-center justify-center gap-3';
                        }
                    } else if (stock <= 5) {
                        stockBadge.textContent = 'Low Stock';
                        stockBadge.className = 'px-2.5 py-1 rounded text-[10px] font-extrabold uppercase tracking-wider bg-amber-50 text-amber-700 border border-amber-100';
                        stockText.textContent = `Only ${stock} units remaining! Order soon.`;
                        stockText.className = 'text-xs font-semibold tracking-wide mt-1 text-amber-600';
                        
                        if (addToCartBtn) {
                            addToCartBtn.disabled = false;
                            addToCartBtn.innerHTML = '<span class="material-symbols-outlined text-[#E65F00]">shopping_cart</span> Add to Cart';
                            addToCartBtn.className = 'w-full py-5 bg-[#3C1B04] text-[#E65F00] hover:bg-[#2A1202] transition-all duration-300 font-label font-bold uppercase tracking-widest text-sm flex items-center justify-center gap-3';
                        }
                        if (buyNowBtn) {
                            buyNowBtn.disabled = false;
                            buyNowBtn.className = 'w-full py-5 bg-white text-[#0D1B2A] border-2 border-[#0D1B2A] hover:bg-slate-50 transition-all duration-300 font-label font-bold uppercase tracking-widest text-sm flex items-center justify-center gap-3';
                        }
                    } else {
                        stockBadge.textContent = 'In Stock';
                        stockBadge.className = 'px-2.5 py-1 rounded text-[10px] font-extrabold uppercase tracking-wider bg-green-50 text-green-700 border border-green-100';
                        stockText.textContent = ''; // No need for text message since product is fully in stock
                        stockText.className = 'text-xs font-semibold tracking-wide mt-1 hidden';
                        
                        if (addToCartBtn) {
                            addToCartBtn.disabled = false;
                            addToCartBtn.innerHTML = '<span class="material-symbols-outlined text-[#E65F00]">shopping_cart</span> Add to Cart';
                            addToCartBtn.className = 'w-full py-5 bg-[#3C1B04] text-[#E65F00] hover:bg-[#2A1202] transition-all duration-300 font-label font-bold uppercase tracking-widest text-sm flex items-center justify-center gap-3';
                        }
                        if (buyNowBtn) {
                            buyNowBtn.disabled = false;
                            buyNowBtn.className = 'w-full py-5 bg-white text-[#0D1B2A] border-2 border-[#0D1B2A] hover:bg-slate-50 transition-all duration-300 font-label font-bold uppercase tracking-widest text-sm flex items-center justify-center gap-3';
                        }
                    }
                }
                if (product) {
                    updateWishlistButton(product._id, selectElement.value);
                }
            }

            function resetVariantDisplay() {
                // 1. Revert Price to base product price
                const priceEl = document.getElementById('product-price');
                const basePriceEl = document.getElementById('product-base-price');

                if (priceEl) {
                    const baseDiscounted = parseFloat(priceEl.getAttribute('data-base-discounted'));
                    const baseOriginal = parseFloat(priceEl.getAttribute('data-base-original'));

                    if (!isNaN(baseDiscounted)) {
                        priceEl.textContent = '₹' + baseDiscounted;
                    } else if (!isNaN(baseOriginal)) {
                        priceEl.textContent = '₹' + baseOriginal;
                    }
                }

                if (basePriceEl) {
                    const baseOriginal = parseFloat(basePriceEl.getAttribute('data-base-original'));
                    if (!isNaN(baseOriginal)) {
                        basePriceEl.textContent = '₹' + baseOriginal;
                    }
                }

                // 2. Disable buttons and show "Select Variant" message
                const stockBadge = document.getElementById('stock-badge');
                const stockText = document.getElementById('stock-count-text');
                const addToCartBtn = document.getElementById('add-to-cart-btn');
                const buyNowBtn = document.getElementById('buy-now-btn');

                if (stockBadge && stockText) {
                    stockBadge.textContent = 'Select Variant';
                    stockBadge.className = 'px-2.5 py-1 rounded text-[10px] font-extrabold uppercase tracking-wider bg-slate-100 text-slate-600 border border-slate-200';
                    stockText.textContent = 'Please select a variant to check availability and add to cart.';
                    stockText.className = 'text-xs font-semibold tracking-wide mt-1 text-slate-500';
                }

                if (addToCartBtn) {
                    addToCartBtn.disabled = true;
                    addToCartBtn.innerHTML = '<span class="material-symbols-outlined text-slate-400">hourglass_empty</span> Select Variant';
                    addToCartBtn.className = 'w-full py-5 bg-slate-100 text-slate-400 cursor-not-allowed transition-all duration-300 font-label font-bold uppercase tracking-widest text-sm flex items-center justify-center gap-3';
                }
                if (buyNowBtn) {
                    buyNowBtn.disabled = true;
                    buyNowBtn.className = 'w-full py-5 bg-slate-100 text-slate-400 cursor-not-allowed border border-slate-200 transition-all duration-300 font-label font-bold uppercase tracking-widest text-sm flex items-center justify-center gap-3';
                }
                if (product) {
                    updateWishlistButton(product._id, null);
                }
            }

            // This function runs whenever the user changes a select option in one of the variant dropdowns
            function handleVariantChange(selectElement) {
                // 1. Get the value of the option the user clicked (this is the selected variant ID)
                var selectedValue = selectElement.value;
                
                // 2. Get the hidden input that stores the active variant ID
                var hiddenInput = document.getElementById('variant-select');
                
                // 3. If a valid option is selected (not placeholder or empty)
                if (selectedValue) {
                    // Update the hidden input value so the form knows which variant is selected
                    if (hiddenInput) {
                        hiddenInput.value = selectedValue;
                    }

                    // Update standard form inputs too
                    const cartVarInput = document.getElementById('cart-variant-id');
                    const wishlistVarInput = document.getElementById('wishlist-variant-id');
                    if (cartVarInput) cartVarInput.value = selectedValue;
                    if (wishlistVarInput) wishlistVarInput.value = selectedValue;

                    // 4. Since only one variant can be purchased at a time, reset all other dropdowns
                    var allSelects = document.querySelectorAll('.variant-group-select');
                    for (var i = 0; i < allSelects.length; i++) {
                        var select = allSelects[i];
                        // If it is a different select element than the one clicked, reset it to its first option (index 0)
                        if (select !== selectElement) {
                            select.selectedIndex = 0;
                        }
                    }

                    // 5. Update the page's product gallery, price, and stock indicators to match the selected variant
                    updateVariantGallery(selectElement);
                }
            }

            // Image Zoom Functionality
            const mainImgContainer = document.getElementById('main-img-container');
            const mainImg = document.getElementById('main-product-img');

            if (mainImgContainer && mainImg) {
                mainImgContainer.addEventListener('mousemove', function (e) {
                    const rect = mainImgContainer.getBoundingClientRect();
                    const x = e.clientX - rect.left;
                    const y = e.clientY - rect.top;

                    const xPercent = (x / rect.width) * 100;
                    const yPercent = (y / rect.height) * 100;

                    mainImg.style.transformOrigin = `${xPercent}% ${yPercent}%`;
                    mainImg.style.transform = 'scale(2.2)';
                });

                mainImgContainer.addEventListener('mouseleave', function () {
                    mainImg.style.transform = 'scale(1)';
                    mainImg.style.transformOrigin = 'center center';
                });
            }

            // This block of code runs when the webpage has finished loading completely
            window.addEventListener('DOMContentLoaded', function () {
                var hiddenInput = document.getElementById('variant-select');
                var selectedVal = '';
                if (hiddenInput) {
                    selectedVal = hiddenInput.value;
                }
                
                var activeSelect = null;
                
                // 1. If there is a pre-selected variant (e.g. redirected with a variant selected)
                if (selectedVal) {
                    var allSelects = document.querySelectorAll('.variant-group-select');
                    // Look through all dropdowns to find which one contains the pre-selected variant value
                    for (var i = 0; i < allSelects.length; i++) {
                        var select = allSelects[i];
                        for (var j = 0; j < select.options.length; j++) {
                            if (select.options[j].value === selectedVal) {
                                select.value = selectedVal;
                                activeSelect = select;
                                break;
                            }
                        }
                        if (activeSelect) {
                            break;
                        }
                    }
                }
                
                // 2. Fallback: If no variant is pre-selected, default to the first option of the first select group
                if (!activeSelect) {
                    var firstSelect = document.querySelector('.variant-group-select');
                    if (firstSelect) {
                        if (firstSelect.options.length > 0) {
                            firstSelect.selectedIndex = 0; // Select the first actual option
                            if (hiddenInput) {
                                hiddenInput.value = firstSelect.value;
                            }
                            activeSelect = firstSelect;
                        }
                    }
                }
                
                // 3. If we have variant selects, update the gallery/price display with the active select
                var hasVariantSelects = document.querySelectorAll('.variant-group-select').length > 0;
                if (hasVariantSelects) {
                    if (activeSelect) {
                        updateVariantGallery(activeSelect);
                    } else {
                        resetVariantDisplay();
                    }
                } else {
                    if (product) {
                        updateWishlistButton(product._id, null);
                    }
                }

                // Sync the form inputs with the selected variant on load
                const currentVariantId = hiddenInput ? hiddenInput.value : '';
                const cartVarInput = document.getElementById('cart-variant-id');
                const wishlistVarInput = document.getElementById('wishlist-variant-id');
                if (cartVarInput) cartVarInput.value = currentVariantId;
                if (wishlistVarInput) wishlistVarInput.value = currentVariantId;

                // Check for error in query parameters and show alert if present
                const urlParams = new URLSearchParams(window.location.search);
                const errorMsg = urlParams.get('error');
                if (errorMsg) {
                    showAlert(decodeURIComponent(errorMsg), "Status Notice");
                }
                const successMsg = urlParams.get('success');
                if (successMsg) {
                    showAlert(decodeURIComponent(successMsg), "Success");
                }

                // Bind custom alert modal events
                const alertCloseBtn = document.getElementById('alert-close-btn');
                if (alertCloseBtn) {
                    alertCloseBtn.addEventListener('click', () => {
                        if (isBlocked) {
                            window.location.href = '/shop';
                        } else {
                            const urlParams = new URLSearchParams(window.location.search);
                            const errorMsg = urlParams.get('error');
                            if (errorMsg && errorMsg.toLowerCase().includes('login')) {
                                window.location.href = '/login';
                            } else {
                                closeAlertModal();
                            }
                        }
                    });
                }
                const alertModal = document.getElementById('alert-modal');
                if (alertModal) {
                    const alertBackdrop = alertModal.querySelector('.absolute');
                    if (alertBackdrop) {
                        alertBackdrop.addEventListener('click', () => {
                            if (isBlocked) {
                                window.location.href = '/shop';
                            } else {
                                const urlParams = new URLSearchParams(window.location.search);
                                const errorMsg = urlParams.get('error');
                                if (errorMsg && errorMsg.toLowerCase().includes('login')) {
                                    window.location.href = '/login';
                                } else {
                                    closeAlertModal();
                                }
                            }
                        });
                    }
                }

                if (isBlocked) {
                    // If product is blocked, show unavailable modal on load
                    showAlert("This product is currently unavailable. The product will be added soon.", "Product Unavailable");
                    if (alertCloseBtn) {
                        alertCloseBtn.innerText = "Browse Products";
                    }
                }
            });

            // Function to show custom alert modal
            const showAlert = (message, title = "Unavailable") => {
                const modal = document.getElementById('alert-modal');
                if (modal) {
                    document.getElementById('alert-modal-message').innerText = message;
                    modal.querySelector('h3').innerText = title;

                    // Dynamically set icon and color based on title
                    const iconContainer = modal.querySelector('.rounded-full');
                    const iconSpan = iconContainer.querySelector('.material-symbols-outlined');
                    if (iconContainer && iconSpan) {
                        if (title.toLowerCase() === 'success') {
                            iconContainer.className = "w-14 h-14 rounded-full bg-emerald-50 flex items-center justify-center text-emerald-600 mb-4";
                            iconSpan.innerText = "check_circle";
                        } else {
                            iconContainer.className = "w-14 h-14 rounded-full bg-red-50 flex items-center justify-center text-red-600 mb-4";
                            iconSpan.innerText = "warning";
                        }
                    }

                    modal.classList.remove('hidden');
                    setTimeout(() => {
                        modal.classList.remove('opacity-0');
                        modal.querySelector('.relative').classList.remove('scale-95');
                    }, 10);
                }
            };

            const closeAlertModal = () => {
                const modal = document.getElementById('alert-modal');
                if (modal) {
                    modal.classList.add('opacity-0');
                    modal.querySelector('.relative').classList.add('scale-95');
                    setTimeout(() => {
                        modal.classList.add('hidden');
                    }, 300);
                }
            };


            function buyNow(event, productId) {
                if (event) event.preventDefault();
                const variantSelect = document.getElementById('variant-select');
                const variantId = variantSelect ? variantSelect.value : '';
                window.location.href = `/checkout?productId=${productId}&variantId=${variantId}&qty=1`;
            }
        </script>

        <!-- Beautiful Tailwind Alert/Error Modal -->
        <div id="alert-modal"
            class="fixed inset-0 z-50 flex items-center justify-center hidden opacity-0 transition-opacity duration-300">
            <!-- Backdrop -->
            <div class="absolute inset-0 bg-[#0D1B2A]/40 backdrop-blur-sm transition-opacity duration-300"></div>
            <!-- Modal Card -->
            <div
                class="relative bg-white rounded-2xl max-w-sm w-full mx-4 p-8 shadow-2xl transform scale-95 transition-transform duration-300 border border-slate-100">
                <div class="flex flex-col items-center text-center">
                    <div class="w-14 h-14 rounded-full bg-red-50 flex items-center justify-center text-red-600 mb-4">
                        <span class="material-symbols-outlined text-3xl">warning</span>
                    </div>
                    <h3 class="text-lg font-bold font-headline text-[#0D1B2A] mb-2">Unavailable</h3>
                    <p id="alert-modal-message" class="text-slate-600 text-sm leading-relaxed mb-6"></p>
                    <button id="alert-close-btn"
                        class="w-full py-3 bg-[#0D1B2A] hover:bg-slate-800 text-white font-bold text-xs uppercase tracking-widest rounded-lg transition-colors">
                        Got it
                    </button>
                </div>
            </div>
        </div>
</body>

</html>