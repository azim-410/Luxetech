  <script>
    // Measure the actual rendered header height and apply as CSS variable
    (function applyNavHeight() {
      var header = document.querySelector('header');
      if (!header) return;
      var h = header.getBoundingClientRect().height;
      document.documentElement.style.setProperty('--nav-h', h + 'px');
      // Re-measure on resize (e.g. mobile hamburger changes header height)
      window.addEventListener('resize', function () {
        var newH = header.getBoundingClientRect().height;
        document.documentElement.style.setProperty('--nav-h', newH + 'px');
      });
    })();
  </script>

