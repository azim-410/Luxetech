<!DOCTYPE html>

<html class="light" lang="en">

<head>
  <meta charset="utf-8" />
  <meta content="width=device-width, initial-scale=1.0" name="viewport" />
  <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
  <link
    href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&amp;family=Inter:wght@400;500;600&amp;display=swap"
    rel="stylesheet" />
  <link
    href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap"
    rel="stylesheet" />
  <link href="/User/css/main-global.css" rel="stylesheet" />
  <script id="tailwind-config">
    tailwind.config = {
      darkMode: "class",
      theme: {
        extend: {
          colors: {
            "on-background": "#191c1e",
            "background": "#f7f9fc",
            "surface": "#f7f9fc",
            "secondary-fixed-dim": "#afcbd8",
            "tertiary-fixed": "#ffdbcb",
            "outline-variant": "#c4c6cc",
            "on-primary": "#ffffff",
            "secondary-fixed": "#cbe7f5",
            "primary-fixed": "#d9e2ff",
            "surface-container-high": "#e6e8eb",
            "surface-container": "#eceef1",
            "tertiary": "#000000",
            "secondary-container": "#cbe7f5",
            "error-container": "#ffdad6",
            "surface-dim": "#d8dadd",
            "primary-fixed-dim": "#b0c6ff",
            "on-tertiary-container": "#dc5d00",
            "on-tertiary": "#ffffff",
            "tertiary-fixed-dim": "#ffb692",
            "surface-container-low": "#f2f4f7",
            "on-secondary-fixed": "#021f29",
            "error": "#ba1a1a",
            "inverse-on-surface": "#eff1f4",
            "on-secondary-container": "#4e6874",
            "surface-tint": "#2b5bb5",
            "on-error-container": "#93000a",
            "on-primary-container": "#5781de",
            "inverse-primary": "#b0c6ff",
            "secondary": "#48626e",
            "on-secondary-fixed-variant": "#304a55",
            "primary": "#000000",
            "on-surface-variant": "#44474c",
            "surface-bright": "#f7f9fc",
            "primary-container": "#001945",
            "on-primary-fixed-variant": "#00429c",
            "on-tertiary-fixed": "#341100",
            "surface-container-lowest": "#ffffff",
            "outline": "#74777d",
            "tertiary-container": "#341100",
            "on-error": "#ffffff",
            "surface-container-highest": "#e0e3e6",
            "on-surface": "#191c1e",
            "surface-variant": "#e0e3e6",
            "on-primary-fixed": "#001945",
            "on-tertiary-fixed-variant": "#7a3000",
            "on-secondary": "#ffffff",
            "inverse-surface": "#2d3133"
          },
          fontFamily: {
            "headline": ["Manrope"],
            "body": ["Inter"],
            "label": ["Inter"]
          },
          borderRadius: { "DEFAULT": "0.125rem", "lg": "0.25rem", "xl": "0.5rem", "full": "0.75rem" },
        },
      },
    }
  </script>
  <style>
    .material-symbols-outlined {
      font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
    }

    body {
      font-family: 'Inter', sans-serif;
      background-color: #f7f9fc;
    }

    h1, h2, h3, h4 { font-family: 'Manrope', sans-serif; }

    /* ── Header: match exact height of home/cart/favorite pages ── */
    /* Tailwind preflight + forms plugin conflict with main-global.css */
    header {
      display: flex !important;
      align-items: center !important;
      justify-content: space-between !important;
      padding: 1.25rem 2rem !important;
      background: #fff !important;
      border-bottom: 1px solid #e5e7eb !important;
      position: sticky !important;
      top: 0 !important;
      z-index: 100 !important;
      flex-wrap: wrap !important;
      gap: 0.75rem !important;
    }

    @media (max-width: 1024px) {
      header { padding: 1rem 1.5rem !important; }
    }

    @media (max-width: 768px) {
      header { padding: 1rem 1.25rem !important; flex-wrap: nowrap !important; gap: 0 !important; }
    }

    @media (max-width: 480px) {
      header { padding: 0.875rem 1rem !important; }
    }

    /* Fix: Tailwind forms plugin sets font-size:1rem & padding on [type=text],
       making the search bar input taller and bloating the header height */
    .search-bar input[type="text"],
    .search-bar input {
      font-size: 0.75rem !important;
      line-height: 1.5 !important;
      padding: 0 !important;
      border: none !important;
      border-width: 0 !important;
      background: transparent !important;
      outline: none !important;
      box-shadow: none !important;
      width: 150px !important;
    }

    /* Fix: logo font size */
    header .logo, header a.logo {
      font-size: 1.5rem !important;
      font-weight: 800 !important;
      letter-spacing: -0.05em !important;
      line-height: 1.2 !important;
    }

    /* Fix: nav link sizes */
    header nav a {
      font-size: 0.75rem !important;
      font-weight: 600 !important;
      line-height: 1.5 !important;
    }

    /* Fix: icon sizes */
    header .icons-group .material-symbols-outlined {
      font-size: 1.25rem !important;
      line-height: 1 !important;
    }

    /* Sidebar positioned below the sticky header */
    :root { --nav-h: 76px; }

    aside.profile-sidebar {
      top: var(--nav-h);
      height: calc(100vh - var(--nav-h));
    }

    /* Main content bottom padding on mobile (above bottom nav) */
    @media (max-width: 1023px) {
      .profile-main { padding-bottom: 5rem !important; }
    }
  </style>
</head>

