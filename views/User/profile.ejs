<!DOCTYPE html>
<html class="light" lang="en">

<head>
  <meta charset="utf-8" />
  <meta content="width=device-width, initial-scale=1.0" name="viewport" />
  <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
  <link
    href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&amp;family=Inter:wght@400;500;600&amp;display=swap"
    rel="stylesheet" />
  <link
    href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap"
    rel="stylesheet" />
  <link href="/User/css/main-global.css" rel="stylesheet" />
  <link href="/User/css/profile.css" rel="stylesheet" />
  <script id="tailwind-config">
    tailwind.config = {
      darkMode: "class",
      theme: {
        extend: {
          colors: {
            "on-background": "#191c1e",
            "background": "#f7f9fc",
            "surface": "#f7f9fc",
            "secondary-fixed-dim": "#afcbd8",
            "tertiary-fixed": "#ffdbcb",
            "outline-variant": "#c4c6cc",
            "on-primary": "#ffffff",
            "secondary-fixed": "#cbe7f5",
            "primary-fixed": "#d9e2ff",
            "surface-container-high": "#e6e8eb",
            "surface-container": "#eceef1",
            "tertiary": "#000000",
            "secondary-container": "#cbe7f5",
            "error-container": "#ffdad6",
            "surface-dim": "#d8dadd",
            "primary-fixed-dim": "#b0c6ff",
            "on-tertiary-container": "#dc5d00",
            "on-tertiary": "#ffffff",
            "tertiary-fixed-dim": "#ffb692",
            "surface-container-low": "#f2f4f7",
            "on-secondary-fixed": "#021f29",
            "error": "#ba1a1a",
            "inverse-on-surface": "#eff1f4",
            "on-secondary-container": "#4e6874",
            "surface-tint": "#2b5bb5",
            "on-error-container": "#93000a",
            "on-primary-container": "#5781de",
            "inverse-primary": "#b0c6ff",
            "secondary": "#48626e",
            "on-secondary-fixed-variant": "#304a55",
            "primary": "#000000",
            "on-surface-variant": "#44474c",
            "surface-bright": "#f7f9fc",
            "primary-container": "#001945",
            "on-primary-fixed-variant": "#00429c",
            "on-tertiary-fixed": "#341100",
            "surface-container-lowest": "#ffffff",
            "outline": "#74777d",
            "tertiary-container": "#341100",
            "on-error": "#ffffff",
            "surface-container-highest": "#e0e3e6",
            "on-surface": "#191c1e",
            "surface-variant": "#e0e3e6",
            "on-primary-fixed": "#001945",
            "on-tertiary-fixed-variant": "#7a3000",
            "on-secondary": "#ffffff",
            "inverse-surface": "#2d3133"
          },
          fontFamily: {
            "headline": ["Manrope"],
            "body": ["Inter"],
            "label": ["Inter"]
          },
          borderRadius: { "DEFAULT": "0.125rem", "lg": "0.25rem", "xl": "0.5rem", "full": "0.75rem" },
        },
      },
    }
  </script>
</head>

<body class="text-on-surface">
  <%- include('../partials/user/main-header', { user }) %>
    <% const dummyImgUrl = 'https://lh3.googleusercontent.com/aida-public/AB6AXuCjFumsIfpKweThkz0kigWDz4L3U_MlZOYAOjJqVe_fiTnzYV-LTpbevhNkCABEs92MYz-pOz4nfaNJ_ZaH-gt9q4BgY9RjUl8a828prR07HQSp1jOu-01gXC4efDLIQQTWkL40yxC7rdOXkerc1MPXQoaKtayglB0j0wCAVLobeEwrXuTSCDjMvdBsRuuTYFfuc2Tle7m9vQt41ZLWCIXDiTNkVuMlCqY4vlUjmcXOrGqfc269b-Zh8a-6CX3Ib2OtsJuKe0UHik0'; %>

      <div class="flex min-h-screen">
        <%- include('../partials/user/profile-sidebar', { user, dummyImgUrl }) %>

        <!-- Main Content Area -->
        <main class="profile-main flex-1 lg:ml-64 p-6 md:p-12">
          <div class="max-w-5xl mx-auto space-y-16">

            <!-- Section: Personal Information -->
            <section>
              <div class="flex items-end justify-between mb-8">
                <div>
                  <span class="text-[10px] uppercase tracking-[0.2em] font-bold text-on-surface-variant">Account
                    Dashboard</span>
                  <h1 class="text-4xl font-extrabold tracking-tight mt-1">Personal Info</h1>
                </div>
                <button id="editProfileBtn" type="button"
                  class="px-6 py-2 bg-primary text-white text-xs font-bold uppercase tracking-wider rounded-md hover:bg-slate-800 transition-all active:scale-95">
                  Edit Profile
                </button>
              </div>
              <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                <!-- Read-only profile info display -->
                <div class="bg-surface-container-lowest p-8 rounded-xl shadow-sm border border-slate-100 md:col-span-3">
                  <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                    <div class="space-y-2">
                      <label class="text-[11px] font-bold uppercase tracking-widest text-on-surface-variant">Full
                        Name</label>
                      <div class="w-full bg-surface-container-low rounded-sm px-4 py-3 text-sm text-on-surface">
                        <%= user.name %>
                      </div>
                    </div>
                    <div class="space-y-2">
                      <label class="text-[11px] font-bold uppercase tracking-widest text-on-surface-variant">Email
                        Address</label>
                      <div class="w-full bg-surface-container-low rounded-sm px-4 py-3 text-sm text-on-surface">
                        <%= user.email %>
                      </div>
                    </div>
                    <% if (user.authProvider==='local' ) { %>
                      <div class="space-y-2">
                        <label
                          class="text-[11px] font-bold uppercase tracking-widest text-on-surface-variant block">Password</label>
                        <a href="/change-password" class="block w-full">
                          <button type="button"
                            class="w-full py-3 bg-[#1e3a5f] text-white text-xs font-bold uppercase tracking-wider rounded-md hover:bg-[#162d4a] active:scale-95 transition-all flex items-center justify-center gap-2">
                            <span class="material-symbols-outlined text-sm">lock_reset</span>
                            Change Password
                          </button>
                        </a>
                      </div>
                      <% } %>
                  </div>
                </div>

                <!-- Membership Card -->
                <div
                  class="bg-[#0D1B2A] text-white p-8 rounded-xl flex flex-col justify-between relative overflow-hidden group">
                  <div class="relative z-10">
                    <h3 class="font-manrope font-bold text-xl mb-1">Luxe Rewards</h3>
                    <p class="text-xs text-white/60 mb-6">Tier: Platinum Collector</p>
                    <div class="text-3xl font-black mb-1">12,450</div>
                    <p class="text-[10px] uppercase tracking-widest opacity-70">Points Available</p>
                  </div>
                  <div class="relative z-10 mt-8">
                    <button
                      class="w-full py-3 bg-white text-[#0D1B2A] text-[10px] font-black uppercase tracking-[0.2em] rounded-md hover:bg-slate-100 transition-colors">
                      Redeem Points
                    </button>
                  </div>
                  <div class="absolute -right-12 -top-12 w-48 h-48 bg-white/5 rounded-full blur-2xl"></div>
                  <div class="absolute -left-12 -bottom-12 w-48 h-48 bg-blue-500/10 rounded-full blur-2xl"></div>
                </div>
              </div>
            </section>

            <!-- Section: Wallet Dashboard -->
            <section class="bg-surface-container-lowest p-8 rounded-xl shadow-sm border border-slate-100">
              <div class="flex flex-col md:flex-row md:items-center justify-between gap-6">
                <div class="flex items-center gap-4">
                  <div class="w-12 h-12 bg-primary-container rounded-lg flex items-center justify-center">
                    <span class="material-symbols-outlined text-on-primary-fixed-variant"
                      data-icon="account_balance_wallet">account_balance_wallet</span>
                  </div>
                  <div>
                    <h2 class="text-xl font-bold tracking-tight">Wallet Balance</h2>
                    <div class="text-2xl font-black text-[#0D1B2A]">$1,240.00</div>
                  </div>
                </div>
                <div class="flex gap-3">
                  <button
                    class="px-6 py-2.5 bg-primary text-white text-xs font-bold uppercase tracking-wider rounded-md hover:bg-slate-800 transition-all flex items-center gap-2">
                    <span class="material-symbols-outlined text-sm">add_circle</span> Top Up
                  </button>
                  <button
                    class="px-6 py-2.5 border border-slate-200 text-slate-700 text-xs font-bold uppercase tracking-wider rounded-md hover:bg-slate-50 transition-all flex items-center gap-2">
                    <span class="material-symbols-outlined text-sm">history</span> History
                  </button>
                </div>
              </div>
            </section>

            <!-- Section: Recent Activity & Addresses -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-12">
              <!-- Recent Orders -->
              <section>
                <div class="flex items-center justify-between mb-6">
                  <h2 class="text-xl font-bold tracking-tight">Recent Orders</h2>
                  <a class="text-xs font-bold text-surface-tint hover:underline uppercase tracking-wider" href="/orders">View
                    All</a>
                </div>
                <div class="space-y-4">
                  <% if (locals.recentOrders && recentOrders.length > 0) { %>
                    <% recentOrders.forEach(order => { %>
                      <% const firstItem = order.items && order.items[0] ? order.items[0] : null; %>
                      <% if (firstItem) { %>
                        <div
                          class="bg-surface-container-lowest p-5 rounded-lg border border-slate-100 flex flex-col gap-4 hover:shadow-md transition-shadow">
                          <div class="flex items-center justify-between">
                            <div class="flex items-center gap-4">
                              <div class="w-16 h-16 bg-surface-container-low rounded-md overflow-hidden p-2">
                                <img alt="<%= firstItem.name %>" class="w-full h-full object-contain"
                                  src="<%= firstItem.image || 'https://via.placeholder.com/150' %>" />
                              </div>
                              <div>
                                <div class="text-sm font-bold text-[#0D1B2A]"><%= firstItem.name %><%= order.items.length > 1 ? ' ...' : '' %></div>
                                <div class="text-[10px] text-on-surface-variant">Order #<%= order.orderId %> • <%= new Date(order.createdAt).toLocaleDateString('en-US', {month: 'short', day: 'numeric'}) %></div>
                              </div>
                            </div>
                            <div class="text-right">
                              <div class="text-sm font-bold">₹<%= order.pricing.grandTotal.toFixed(2) %></div>
                              <span
                                class="inline-block px-2 py-0.5 text-[10px] font-bold uppercase rounded-full 
                                  <%= ['Delivered', 'Success'].includes(order.orderStatus) ? 'bg-green-50 text-green-700' :
                                      ['Cancelled', 'Returned'].includes(order.orderStatus) ? 'bg-red-50 text-red-700' :
                                      'bg-blue-50 text-blue-700' %>">
                                <%= order.orderStatus %>
                              </span>
                            </div>
                          </div>
                          <div class="flex justify-end pt-2 border-t border-slate-50">
                            <a href="/orders/track/<%= order._id %>"
                              class="flex items-center gap-1 text-[10px] font-bold text-slate-500 hover:text-primary uppercase tracking-widest transition-colors">
                              <span class="material-symbols-outlined text-sm">local_shipping</span> Track / View Details
                            </a>
                          </div>
                        </div>
                      <% } %>
                    <% }) %>
                  <% } else { %>
                    <div class="bg-surface-container-lowest p-8 rounded-lg border border-slate-100 text-center text-sm text-outline font-medium">
                      No recent orders found.
                    </div>
                  <% } %>
                </div>
              </section>

              <!-- Saved Addresses -->
              <section>
                <div class="flex items-center justify-between mb-6">
                  <h2 class="text-xl font-bold tracking-tight">Saved Addresses</h2>
                  <a href="/address"
                    class="flex items-center gap-1 text-xs font-bold text-surface-tint hover:underline uppercase tracking-wider">
                    <span class="material-symbols-outlined text-xs">add</span> Add New
                  </a>
                </div>
                <div class="space-y-4">
                  <% if (locals.savedAddresses && savedAddresses.length > 0) { %>
                    <% savedAddresses.forEach(address => { %>
                      <div class="<%= address.isDefault ? 'bg-surface-container-lowest border-2 border-primary' : 'bg-surface-container border border-transparent' %> p-6 rounded-lg relative">
                        <% if (address.isDefault) { %>
                          <div
                            class="absolute top-4 right-4 text-[10px] font-black uppercase text-primary-container tracking-tighter flex items-center gap-1">
                            <span class="material-symbols-outlined text-sm"
                              style="font-variation-settings: 'FILL' 1;">check_circle</span> Default
                          </div>
                        <% } %>
                        <div class="flex items-start gap-3">
                          <span class="material-symbols-outlined text-on-surface-variant mt-0.5">
                            <%= address.type === 'home' ? 'home' : address.type === 'office' ? 'business' : 'location_on' %>
                          </span>
                          <div>
                            <div class="text-sm font-bold mb-1"><%= address.fullName %> (<%= address.type.charAt(0).toUpperCase() + address.type.slice(1) %>)</div>
                            <p class="text-xs text-on-surface-variant leading-relaxed">
                              <%= address.streetAddress %><br />
                              <%= address.city %>, <%= address.state %> <%= address.zipCode %><br />
                              <%= address.country %>
                            </p>
                          </div>
                        </div>
                      </div>
                    <% }) %>
                  <% } else { %>
                    <div class="bg-surface-container-lowest p-8 rounded-lg border border-slate-100 text-center text-sm text-outline font-medium">
                      No saved addresses found.
                    </div>
                  <% } %>
                </div>
              </section>
            </div>

            <!-- Section: Payment Methods -->
            <section class="pb-24">
              <div class="flex items-center justify-between mb-8">
                <div>
                  <h2 class="text-xl font-bold tracking-tight">Payment Methods</h2>
                  <p class="text-xs text-on-surface-variant mt-1">Manage your secure transactions</p>
                </div>
              </div>
              <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                <div
                  class="aspect-[1.58/1] bg-gradient-to-br from-[#0D1B2A] to-[#1B263B] p-6 rounded-xl text-white shadow-xl relative flex flex-col justify-between overflow-hidden">
                  <div class="flex justify-between items-start relative z-10">
                    <div class="text-lg font-bold">Luxe Card</div>
                    <div class="w-10 h-6 bg-white/20 rounded-sm"></div>
                  </div>
                  <div class="relative z-10">
                    <div class="text-lg tracking-[0.2em] font-mono mb-4">•••• •••• •••• 4242</div>
                    <div class="flex justify-between items-end">
                      <div>
                        <div class="text-[8px] uppercase tracking-widest opacity-50">Card Holder</div>
                        <div class="text-xs font-bold">ALEX RIVERA</div>
                      </div>
                      <div>
                        <div class="text-[8px] uppercase tracking-widest opacity-50">Expires</div>
                        <div class="text-xs font-bold">12/26</div>
                      </div>
                    </div>
                  </div>
                  <div
                    class="absolute bottom-0 right-0 w-32 h-32 bg-on-primary-container opacity-20 blur-3xl rounded-full">
                  </div>
                </div>
                <div
                  class="aspect-[1.58/1] bg-surface-container-high p-6 rounded-xl shadow-sm border border-slate-200 flex flex-col justify-between">
                  <div class="flex justify-between items-start">
                    <div class="text-sm font-bold text-[#0D1B2A]">Travel Mastercard</div>
                    <span class="material-symbols-outlined text-on-surface-variant">contactless</span>
                  </div>
                  <div>
                    <div class="text-lg tracking-[0.2em] font-mono mb-4 text-[#0D1B2A]">•••• •••• •••• 8812</div>
                    <div class="flex justify-between items-end">
                      <div>
                        <div class="text-[8px] uppercase tracking-widest text-on-surface-variant">Card Holder</div>
                        <div class="text-xs font-bold text-[#0D1B2A]">ALEX RIVERA</div>
                      </div>
                      <div class="text-right">
                        <div class="text-[8px] uppercase tracking-widest text-on-surface-variant">Expires</div>
                        <div class="text-xs font-bold text-[#0D1B2A]">09/25</div>
                      </div>
                    </div>
                  </div>
                </div>
                <button
                  class="aspect-[1.58/1] border-2 border-dashed border-slate-200 rounded-xl flex flex-col items-center justify-center gap-2 hover:bg-slate-50 transition-colors group">
                  <div
                    class="w-10 h-10 rounded-full bg-slate-100 flex items-center justify-center group-hover:scale-110 transition-transform">
                    <span class="material-symbols-outlined text-on-surface-variant">add</span>
                  </div>
                  <span class="text-xs font-bold text-on-surface-variant uppercase tracking-widest">Add New Card</span>
                </button>
              </div>
            </section>
          </div>
        </main>
      </div>

      <%- include('../partials/user/profile-mobile-nav') %>

      <!-- Edit Profile Modal -->
      <div id="editProfileModal" class="fixed inset-0 z-[200] hidden items-center justify-center p-4">
        <div id="modalBackdrop" class="absolute inset-0 bg-black/40 backdrop-blur-sm"></div>
        <div class="relative bg-white rounded-2xl shadow-2xl w-full max-w-md p-8 z-10">

          <div class="flex items-center justify-between mb-6">
            <div>
              <h2 class="text-xl font-extrabold tracking-tight">Edit Profile</h2>
              <p class="text-xs text-on-surface-variant mt-1">Update your personal information</p>
            </div>
            <button id="closeModalBtn" type="button"
              class="w-8 h-8 flex items-center justify-center rounded-full hover:bg-slate-100 transition-colors">
              <span class="material-symbols-outlined text-sm">close</span>
            </button>
          </div>

          <form id="editProfileForm" action="/profile/update" method="POST" enctype="multipart/form-data">

            <% if (locals.successMessage) { %>
              <div class="mb-4 p-3 rounded-md bg-green-50 text-green-800 flex items-center gap-2 text-xs">
                <span class="material-symbols-outlined text-sm">check_circle</span>
                <%= locals.successMessage %>
              </div>
              <% } %>
                <% if (locals.errorMessage) { %>
                  <div class="mb-4 p-3 rounded-md bg-red-50 text-red-800 flex items-center gap-2 text-xs">
                    <span class="material-symbols-outlined text-sm">error</span>
                    <%= locals.errorMessage %>
                  </div>
                  <% } %>

                    <!-- Avatar Upload -->
                    <div class="flex flex-col items-center mb-6">
                      <div class="relative">
                        <div class="w-24 h-24 rounded-xl overflow-hidden border-2 border-slate-200">
                          <img id="avatarPreview" src="<%= user.profileImage || dummyImgUrl %>" alt="<%= user.name %>"
                            class="w-full h-full object-cover" />
                        </div>
                        <label for="avatarInput"
                          class="absolute bottom-1 right-1 w-7 h-7 bg-primary rounded-full flex items-center justify-center cursor-pointer hover:bg-slate-800 transition-colors shadow-md">
                          <span class="material-symbols-outlined text-white" style="font-size:14px">photo_camera</span>
                        </label>
                        <input id="avatarInput" type="file" name="avatar" accept="image/*" class="hidden" />
                        <!-- delete icon — top right, only if custom image exists -->
                        <% if (user.profileImage) { %>
                          <button type="button" id="deleteAvatarBtn"
                            class="absolute top-1 right-1 w-7 h-7 bg-black rounded-full flex items-center justify-center hover:bg-gray-800 transition-colors shadow-md">
                            <span class="material-symbols-outlined text-white" style="font-size:14px">delete</span>
                          </button>
                          <% } %>
                      </div>
                      <p class="text-[10px] text-on-surface-variant mt-2 uppercase tracking-widest">Avatar</p>
                      <p class="text-[10px] text-slate-400">JPG, PNG or GIF. Max size 2MB.</p>
                    </div>

                    <!-- Name -->
                    <div class="space-y-2 mb-4">
                      <label class="text-[11px] font-bold uppercase tracking-widest text-on-surface-variant">Full
                        Name</label>
                      <input type="text" name="name" value="<%= user.name %>"
                        class="w-full bg-surface-container-low rounded-lg px-4 py-3 text-sm border border-slate-200 focus:ring-2 focus:ring-primary focus:outline-none transition-all" />
                    </div>

                    <!-- Email -->
                    <div class="space-y-2 mb-6">
                      <label class="text-[11px] font-bold uppercase tracking-widest text-on-surface-variant">Email
                        Address</label>
                      <input type="email" name="email" value="<%= user.email %>" <%=user.authProvider !=='local'
                        ? 'disabled' : '' %>
                      class="w-full bg-surface-container-low rounded-lg px-4 py-3 text-sm border border-slate-200
                      focus:ring-2 focus:ring-primary focus:outline-none disabled:opacity-50 disabled:cursor-not-allowed
                      transition-all" />
                      <% if (user.authProvider !=='local' ) { %>
                        <p class="text-[11px] text-slate-400">Email cannot be changed for Google accounts.</p>
                        <% } %>
                    </div>

                    <!-- Actions -->
                    <div class="flex gap-3 justify-end pt-4 border-t border-slate-100">
                      <button type="button" id="modalCancelBtn"
                        class="px-6 py-2 border border-slate-300 text-slate-700 text-xs font-bold uppercase tracking-wider rounded-md hover:bg-slate-50 transition-all">
                        Cancel
                      </button>
                      <button type="submit"
                        class="px-6 py-2 bg-primary text-white text-xs font-bold uppercase tracking-wider rounded-md hover:bg-slate-800 transition-all active:scale-95">
                        Save Changes
                      </button>
                    </div>
          </form>
        </div>
      </div>
      <!-- Delete Image Confirmation Modal -->
      <div id="deleteConfirmModal" class="fixed inset-0 z-[300] hidden items-center justify-center p-4">
        <div class="absolute inset-0 bg-black/40 backdrop-blur-sm"></div>
        <div class="relative bg-white rounded-2xl shadow-2xl w-full max-w-sm p-8 z-10 text-center">

          <!-- Icon -->
          <div class="w-14 h-14 bg-slate-100 rounded-full flex items-center justify-center mx-auto mb-4">
            <span class="material-symbols-outlined text-2xl text-slate-600">photo_camera</span>
          </div>

          <h3 class="text-lg font-extrabold tracking-tight mb-2">Remove Profile Image?</h3>
          <p class="text-xs text-on-surface-variant mb-8">Your profile image will be removed and replaced with the
            default avatar.</p>

          <div class="flex gap-3">
            <button type="button" id="cancelDeleteBtn"
              class="flex-1 px-6 py-2.5 border border-slate-300 text-slate-700 text-xs font-bold uppercase tracking-wider rounded-md hover:bg-slate-50 transition-all">
              Cancel
            </button>
            <button type="button" id="confirmDeleteBtn"
              class="flex-1 px-6 py-2.5 bg-black text-white text-xs font-bold uppercase tracking-wider rounded-md hover:bg-slate-800 transition-all active:scale-95">
              Remove
            </button>
          </div>

        </div>
      </div>
      <script>

        document.addEventListener('DOMContentLoaded', () => {
          const editProfileBtn = document.getElementById('editProfileBtn');
          const modal = document.getElementById('editProfileModal');
          const backdrop = document.getElementById('modalBackdrop');
          const closeModalBtn = document.getElementById('closeModalBtn');
          const modalCancelBtn = document.getElementById('modalCancelBtn');
          const avatarInput = document.getElementById('avatarInput');
          const avatarPreview = document.getElementById('avatarPreview');
          const editProfileForm = document.getElementById('editProfileForm');

          function openModal() {
            modal.classList.remove('hidden');
            modal.classList.add('flex');
          }

          function closeModal() {
            modal.classList.add('hidden');
            modal.classList.remove('flex');
            // Clear success and error messages when modal closes
            const successMsg = editProfileForm.querySelector('.bg-green-50');
            const errorMsg = editProfileForm.querySelector('.bg-red-50');
            if (successMsg) successMsg.remove();
            if (errorMsg) errorMsg.remove();
          }

          editProfileBtn.addEventListener('click', openModal);
          closeModalBtn.addEventListener('click', closeModal);
          modalCancelBtn.addEventListener('click', closeModal);
          backdrop.addEventListener('click', closeModal);

          document.addEventListener('keydown', (e) => {
            if (e.key === 'Escape') closeModal();
          });

          // Avatar preview
          avatarInput.addEventListener('change', (e) => {
            const file = e.target.files[0];
            if (!file) return;
            if (file.size > 2 * 1024 * 1024) {
              alert('Image size must be under 2MB');
              avatarInput.value = '';
              return;
            }
            const reader = new FileReader();
            reader.onload = (ev) => avatarPreview.src = ev.target.result;
            reader.readAsDataURL(file);
          });

          const deleteAvatarBtn = document.getElementById('deleteAvatarBtn');
          const deleteConfirmModal = document.getElementById('deleteConfirmModal');
          const cancelDeleteBtn = document.getElementById('cancelDeleteBtn');
          const confirmDeleteBtn = document.getElementById('confirmDeleteBtn');

          if (deleteAvatarBtn) {
            deleteAvatarBtn.addEventListener('click', () => {
              deleteConfirmModal.classList.remove('hidden');
              deleteConfirmModal.classList.add('flex');
            });
          }

          cancelDeleteBtn.addEventListener('click', () => {
            deleteConfirmModal.classList.add('hidden');
            deleteConfirmModal.classList.remove('flex');
          });

          confirmDeleteBtn.addEventListener('click', () => {
            const form = document.createElement('form');
            form.method = 'POST';
            form.action = '/profile/delete-image';
            document.body.appendChild(form);
            form.submit();
          });

          // Auto open modal if server returned error or success message
          const hasMessage = document.querySelector('#editProfileForm .bg-green-50, #editProfileForm .bg-red-50');
          if (hasMessage) openModal();
        });
      </script>
</body>

</html>