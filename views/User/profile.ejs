<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Profile - LUXE TECH</title>
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0" rel="stylesheet">
    <link rel="stylesheet" href="/User/css/main-global.css">
</head>
<body>
    <%- include('../partials/user/main-header') %>
    <div class="container" style="padding: 5rem 2rem; text-align: center;">
        <h1>Your Profile</h1>
        <p>Welcome, <%= user ? user.name : 'User' %></p>
        <form action="/logout" method="POST">
            <button type="submit" class="auth-btn" style="margin-top: 1rem; cursor: pointer;">Logout</button>
        </form>
    </div>
</body> 
</html>
