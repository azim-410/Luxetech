<!DOCTYPE html>
<html class="light" lang="en">

<head>
  <meta charset="utf-8" />
  <meta content="width=device-width, initial-scale=1.0" name="viewport" />
  <title>Luxe Tech | Refer a Friend</title>
  <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
  <link
    href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&amp;family=Inter:wght@400;500;600&amp;display=swap"
    rel="stylesheet" />
  <link
    href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap"
    rel="stylesheet" />
  <link href="/User/css/main-global.css" rel="stylesheet" />
  <link href="/User/css/loading-bar.css" rel="stylesheet" />
  <link href="/User/css/profile.css" rel="stylesheet" />
  <script id="tailwind-config">
    tailwind.config = {
      darkMode: "class",
      theme: {
        extend: {
          colors: {
            "on-background": "#191c1e",
            "background": "#f7f9fc",
            "surface": "#f7f9fc",
            "secondary-fixed-dim": "#afcbd8",
            "tertiary-fixed": "#ffdbcb",
            "outline-variant": "#c4c6cc",
            "on-primary": "#ffffff",
            "secondary-fixed": "#cbe7f5",
            "primary-fixed": "#d9e2ff",
            "surface-container-high": "#e6e8eb",
            "surface-container": "#eceef1",
            "tertiary": "#000000",
            "secondary-container": "#cbe7f5",
            "error-container": "#ffdad6",
            "surface-dim": "#d8dadd",
            "primary-fixed-dim": "#b0c6ff",
            "on-tertiary-container": "#dc5d00",
            "on-tertiary": "#ffffff",
            "tertiary-fixed-dim": "#ffb692",
            "surface-container-low": "#f2f4f7",
            "on-secondary-fixed": "#021f29",
            "error": "#ba1a1a",
            "inverse-on-surface": "#eff1f4",
            "on-secondary-container": "#4e6874",
            "surface-tint": "#2b5bb5",
            "on-error-container": "#93000a",
            "on-primary-container": "#5781de",
            "inverse-primary": "#b0c6ff",
            "secondary": "#48626e",
            "on-secondary-fixed-variant": "#304a55",
            "primary": "#000000",
            "on-surface-variant": "#44474c",
            "surface-bright": "#f7f9fc",
            "primary-container": "#001945",
            "on-primary-fixed-variant": "#00429c",
            "on-tertiary-fixed": "#341100",
            "surface-container-lowest": "#ffffff",
            "outline": "#74777d",
            "tertiary-container": "#341100",
            "on-error": "#ffffff",
            "surface-container-highest": "#e0e3e6",
            "on-surface": "#191c1e",
            "surface-variant": "#e0e3e6",
            "on-primary-fixed": "#001945",
            "on-tertiary-fixed-variant": "#7a3000",
            "on-secondary": "#ffffff",
            "inverse-surface": "#2d3133"
          },
          fontFamily: {
            "headline": ["Manrope"],
            "body": ["Inter"],
            "label": ["Inter"]
          },
          borderRadius: { "DEFAULT": "0.125rem", "lg": "0.25rem", "xl": "0.5rem", "full": "0.75rem" },
        },
      },
    }
  </script>
  <style>
    .material-symbols-outlined {
      font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
    }
    .gradient-primary {
      background: linear-gradient(135deg, #000000 0%, #001945 100%);
    }
    .hero-pattern {
      background-image: url("data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Cg fill='%23ffffff' fill-opacity='0.05'%3E%3Cpath d='M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2v-4h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2v-4h4V4H6z'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E");
    }
  </style>
</head>

<body class="text-on-surface">
  <%- include('../partials/loadingBar') %>
  <%- include('../partials/user/main-header', { user }) %>
  <% const dummyImgUrl = 'https://lh3.googleusercontent.com/aida-public/AB6AXuCjFumsIfpKweThkz0kigWDz4L3U_MlZOYAOjJqVe_fiTnzYV-LTpbevhNkCABEs92MYz-pOz4nfaNJ_ZaH-gt9q4BgY9RjUl8a828prR07HQSp1jOu-01gXC4efDLIQQTWkL40yxC7rdOXkerc1MPXQoaKtayglB0j0wCAVLobeEwrXuTSCDjMvdBsRuuTYFfuc2Tle7m9vQt41ZLWCIXDiTNkVuMlCqY4vlUjmcXOrGqfc269b-Zh8a-6CX3Ib2OtsJuKe0UHik0'; %>

  <div class="flex min-h-screen">
    <%- include('../partials/user/profile-sidebar', { user, dummyImgUrl }) %>

    <!-- Main Content Canvas -->
    <main class="profile-main flex-1 lg:ml-64 p-6 lg:p-12 bg-surface">
      <!-- Breadcrumbs & Header -->
      <div class="mb-12">
        <div class="flex items-center gap-2 text-[10px] font-bold uppercase tracking-[0.2em] text-on-surface-variant mb-4">
          <span>Account</span>
          <span class="material-symbols-outlined text-xs">chevron_right</span>
          <span class="text-primary">Referral</span>
        </div>
        <h1 class="text-4xl md:text-5xl font-extrabold tracking-tighter text-slate-900 mb-2">Refer a Friend</h1>
        <p class="text-on-surface-variant max-w-xl font-body">Invite your inner circle to the future of high-end engineering. You earn rewards, they get exclusivity.</p>
      </div>

      <!-- Hero Section -->
      <section class="relative overflow-hidden rounded-xl gradient-primary text-on-primary mb-16 h-[300px] flex items-center">
        <div class="absolute inset-0 hero-pattern opacity-50"></div>
        <div class="relative z-10 grid md:grid-cols-2 gap-12 items-center px-12 w-full">
          <div>
            <span class="inline-block py-1 px-3 bg-white/10 text-white text-[10px] font-bold tracking-widest uppercase mb-4 rounded-full">Referral Program</span>
            <h2 class="font-headline text-3xl md:text-4xl font-extrabold tracking-tighter leading-tight mb-4">
              Share Precision.<br/>Get Rewarded.
            </h2>
            <p class="text-slate-300 text-sm max-w-md font-medium">
              Share your custom code with friends. They get a ₹500 welcome bonus upon verification, and you get ₹300 added directly to your wallet!
            </p>
          </div>
          <div class="hidden md:block relative h-[300px] overflow-hidden">
            <img alt="Premium Tech" class="absolute top-1/2 -translate-y-1/2 right-0 w-[380px] object-cover rounded-xl shadow-2xl rotate-3 scale-110" src="https://lh3.googleusercontent.com/aida-public/AB6AXuDwGnPEI5cuIEIzUGMkwJwv7rjSD0yAd_mn7TJeW4uhy9euXeQguiOf7ybLVcnmElj2EOvhOlkM4rFJ_8caxazZqIFV5eH5BKlwGww9ghg0k6LM10gLMCoT1pi7cppjsNXkopvCmxKFt4DK-PHhFEjS3sunD7jOkLoE4_vwqnxRtABlN97RxV6p4Ga5A30TE3s0nHhhNGEcAnYvM1LG06uqgzfm6pQVil9KLsU1ovtvKhbyT4lS2GnOxgX8fErJCAyaLKPuT0HOkIs"/>
          </div>
        </div>
      </section>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
        <!-- Left Column: Sharing & Invites -->
        <div class="lg:col-span-8 space-y-8">
          <!-- Referral Link Card -->
          <div class="bg-surface-container-lowest p-8 rounded-xl border border-outline-variant/10 shadow-sm">
            <h2 class="font-headline text-2xl font-bold mb-6 flex items-center gap-3">
              <span class="material-symbols-outlined text-primary">share</span>
              Your Referral Info
            </h2>
            <div class="flex flex-col gap-6 mb-8">
              <!-- Referral Link -->
              <div>
                <label class="block text-xs font-bold uppercase tracking-widest text-on-surface-variant mb-2">Referral Link</label>
                <div class="flex gap-2">
                  <div class="flex-grow flex items-center bg-surface-container-low px-4 py-3 rounded-lg border border-outline-variant/20 overflow-hidden">
                    <span id="referral-link" class="text-on-surface font-mono text-xs overflow-hidden text-ellipsis whitespace-nowrap">http://<%= host %>/register?refer=<%= user.myReferralCode %></span>
                  </div>
                  <button onclick="copyReferralLink()" class="bg-primary text-on-primary px-6 py-3 rounded-lg font-bold text-xs uppercase tracking-wider hover:opacity-90 transition-all flex items-center justify-center gap-1.5 whitespace-nowrap">
                    <span class="material-symbols-outlined text-xs">content_copy</span>
                    <span id="copy-link-btn-text">Copy Link</span>
                  </button>
                </div>
              </div>

              <!-- Referral Code -->
              <div>
                <label class="block text-xs font-bold uppercase tracking-widest text-on-surface-variant mb-2">Referral Code</label>
                <div class="flex gap-2">
                  <div class="flex-grow flex items-center bg-surface-container-low px-4 py-3 rounded-lg border border-outline-variant/20 overflow-hidden">
                    <span id="referral-code" class="text-on-surface font-mono text-sm font-bold tracking-wider"><%= user.myReferralCode %></span>
                  </div>
                  <button onclick="copyReferralCode()" class="bg-primary text-on-primary px-6 py-3 rounded-lg font-bold text-xs uppercase tracking-wider hover:opacity-90 transition-all flex items-center justify-center gap-1.5 whitespace-nowrap">
                    <span class="material-symbols-outlined text-xs">content_copy</span>
                    <span id="copy-code-btn-text">Copy Code</span>
                  </button>
                </div>
              </div>
            </div>
            <div class="flex flex-wrap gap-4">
              <span class="text-on-surface-variant text-xs font-bold uppercase tracking-widest w-full mb-1">Quick Share Link</span>
              <a href="https://api.whatsapp.com/send?text=Get a ₹500 welcome bonus at Luxe Tech using my referral link: http://<%= host %>/register?refer=<%= user.myReferralCode %>" target="_blank" class="flex items-center gap-2 px-4 py-2 bg-[#25D366]/10 text-[#25D366] rounded-full text-xs font-bold hover:bg-[#25D366]/20 transition-all">
                WhatsApp
              </a>
              <a href="https://twitter.com/intent/tweet?text=Get%20a%20%E2%82%B9500%20welcome%20bonus%20at%20Luxe%20Tech%20using%20my%20referral%20link:%20http://<%= host %>/register?refer=<%= user.myReferralCode %>" target="_blank" class="flex items-center gap-2 px-4 py-2 bg-primary/10 text-primary rounded-full text-xs font-bold hover:bg-primary/20 transition-all">
                Twitter
              </a>
            </div>
          </div>

          <!-- 3-Step Guide (Asymmetric Bento) -->
          <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            <div class="bg-surface-container-low p-6 rounded-xl border-l-4 border-primary">
              <span class="text-4xl font-black text-primary/10 block mb-2 font-headline leading-none">01</span>
              <h3 class="font-headline font-bold text-lg mb-2">Invite Friends</h3>
              <p class="text-on-surface-variant text-sm leading-relaxed">Share your unique link or copy the code for them.</p>
            </div>
            <div class="bg-surface-container-low p-6 rounded-xl border-l-4 border-on-primary-container">
              <span class="text-4xl font-black text-on-primary-container/10 block mb-2 font-headline leading-none">02</span>
              <h3 class="font-headline font-bold text-lg mb-2">They Get ₹500</h3>
              <p class="text-on-surface-variant text-sm leading-relaxed">Friends get a ₹500 welcome bonus added instantly to their wallet.</p>
            </div>
            <div class="bg-tertiary-container p-6 rounded-xl border-l-4 border-on-tertiary-container">
              <span class="text-4xl font-black text-on-tertiary-container/10 block mb-2 font-headline leading-none">03</span>
              <h3 class="font-headline font-bold text-lg mb-2 text-on-tertiary-fixed">You Get ₹300</h3>
              <p class="text-on-tertiary-fixed-variant text-sm leading-relaxed">Receive ₹300 directly into your wallet for every successful sign up.</p>
            </div>
          </div>

          <!-- Referral Activity Table -->
          <div class="bg-surface-container-lowest rounded-xl border border-outline-variant/10 shadow-sm overflow-hidden">
            <div class="p-6 border-b border-surface-container">
              <h2 class="font-headline text-xl font-bold">Referral Activity</h2>
            </div>
            <div class="overflow-x-auto">
              <table class="w-full text-left">
                <thead class="bg-surface-container-low">
                  <tr>
                    <th class="px-6 py-4 text-xs font-bold uppercase tracking-widest text-on-surface-variant">Friend</th>
                    <th class="px-6 py-4 text-xs font-bold uppercase tracking-widest text-on-surface-variant">Status</th>
                    <th class="px-6 py-4 text-xs font-bold uppercase tracking-widest text-on-surface-variant">Date</th>
                    <th class="px-6 py-4 text-xs font-bold uppercase tracking-widest text-on-surface-variant text-right">Reward</th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-surface-container">
                  <% if (referredUsers && referredUsers.length > 0) { %>
                    <% referredUsers.forEach(referred => { %>
                      <tr class="hover:bg-surface-container-low/30 transition-colors">
                        <td class="px-6 py-5">
                          <div class="flex items-center gap-3">
                            <div class="w-8 h-8 rounded-full bg-primary-container text-on-primary-container flex items-center justify-center font-bold text-xs">
                              <%= referred.name.split(' ').map(n => n[0]).join('').substring(0, 2).toUpperCase() %>
                            </div>
                            <span class="font-medium text-sm"><%= referred.name %></span>
                          </div>
                        </td>
                        <td class="px-6 py-5">
                          <% if (referred.isVerified) { %>
                            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-green-100 text-green-800">Completed</span>
                          <% } else { %>
                            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-amber-100 text-amber-800">Pending</span>
                          <% } %>
                        </td>
                        <td class="px-6 py-5 text-sm text-on-surface-variant">
                          <%= new Date(referred.createdAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) %>
                        </td>
                        <td class="px-6 py-5 text-sm font-bold text-right text-on-surface">
                          ₹<%= referred.isVerified ? '300.00' : '0.00' %>
                        </td>
                      </tr>
                    <% }) %>
                  <% } else { %>
                    <tr>
                      <td colspan="4" class="px-6 py-10 text-center text-sm text-on-surface-variant">
                        No referral activity yet. Share your link to start earning!
                      </td>
                    </tr>
                  <% } %>
                </tbody>
              </table>
            </div>
          </div>
        </div>

        <!-- Right Column: Rewards Summary -->
        <div class="lg:col-span-4 space-y-8">
          <!-- Rewards Card -->
          <div class="bg-primary text-on-primary p-8 rounded-xl shadow-xl sticky top-28">
            <h2 class="font-headline text-xl font-bold mb-8 flex items-center gap-3">
              <span class="material-symbols-outlined">payments</span>
              Rewards Summary
            </h2>
            <div class="space-y-8">
              <% 
                const successfulCount = referredUsers.filter(u => u.isVerified).length;
                const totalEarned = successfulCount * 300;
                const conversionRate = referredCount > 0 ? Math.round((successfulCount / referredCount) * 100) : 0;
              %>
              <div>
                <p class="text-on-primary/60 text-xs font-bold uppercase tracking-widest mb-1">Total Earned</p>
                <p class="text-4xl font-headline font-extrabold">₹<%= totalEarned.toFixed(2) %></p>
              </div>
              <div class="grid grid-cols-2 gap-6 pt-6 border-t border-white/10">
                <div>
                  <p class="text-on-primary/60 text-[10px] font-bold uppercase tracking-widest mb-1">Available Wallet</p>
                  <p class="text-xl font-bold text-white">₹<%= (user.wallet || 0).toFixed(2) %></p>
                </div>
                <div>
                  <p class="text-on-primary/60 text-[10px] font-bold uppercase tracking-widest mb-1">Invited</p>
                  <p class="text-xl font-bold"><%= referredCount %></p>
                </div>
                <div>
                  <p class="text-on-primary/60 text-[10px] font-bold uppercase tracking-widest mb-1">Successful</p>
                  <p class="text-xl font-bold"><%= successfulCount %></p>
                </div>
                <div>
                  <p class="text-on-primary/60 text-[10px] font-bold uppercase tracking-widest mb-1">Conversion</p>
                  <p class="text-xl font-bold"><%= conversionRate %>%</p>
                </div>
              </div>
              <a href="/wallet" class="block w-full text-center bg-white text-primary py-4 rounded-lg font-bold text-sm uppercase tracking-wider hover:bg-surface-container-low transition-all shadow-lg">
                View Wallet
              </a>
            </div>
            <!-- Promotion Chip -->
            <div class="mt-8 p-4 bg-white/5 rounded-lg border border-white/10">
              <p class="text-xs italic text-on-primary/80">
                "Keep sharing! Referrals are added directly to your wallet once they verify their email."
              </p>
            </div>
          </div>
        </div>
      </div>
    </main>
  </div>

  <script>
    function copyReferralLink() {
      const linkText = document.getElementById('referral-link').innerText;
      navigator.clipboard.writeText(linkText).then(() => {
        const copyBtnText = document.getElementById('copy-link-btn-text');
        copyBtnText.innerText = 'Copied!';
        setTimeout(() => {
          copyBtnText.innerText = 'Copy Link';
        }, 2000);
      }).catch(err => {
        console.error('Failed to copy text: ', err);
      });
    }

    function copyReferralCode() {
      const codeText = document.getElementById('referral-code').innerText;
      navigator.clipboard.writeText(codeText).then(() => {
        const copyBtnText = document.getElementById('copy-code-btn-text');
        copyBtnText.innerText = 'Copied!';
        setTimeout(() => {
          copyBtnText.innerText = 'Copy Code';
        }, 2000);
      }).catch(err => {
        console.error('Failed to copy text: ', err);
      });
    }
  </script>

  <%- include('../partials/user/profile-mobile-nav') %>
  <script src="/User/js/loading-bar.js"></script>
</body>

</html>
