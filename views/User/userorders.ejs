<!DOCTYPE html>
<html class="light" lang="en">

<head>
  <meta charset="utf-8" />
  <meta content="width=device-width, initial-scale=1.0" name="viewport" />
  <title>Recent Orders | Luxe Tech</title>
  <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
  <!-- html2pdf.js for exporting PDF -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>
  <link
    href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&amp;family=Inter:wght@400;500;600&amp;display=swap"
    rel="stylesheet" />
  <link
    href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap"
    rel="stylesheet" />
  <link href="/User/css/main-global.css" rel="stylesheet" />
  <link href="/User/css/loading-bar.css" rel="stylesheet" />
  <link href="/User/css/profile.css" rel="stylesheet" />
  <script id="tailwind-config">
    tailwind.config = {
      darkMode: "class",
      theme: {
        extend: {
          colors: {
            "on-background": "#191c1e",
            "background": "#f7f9fc",
            "surface": "#f7f9fc",
            "secondary-fixed-dim": "#afcbd8",
            "tertiary-fixed": "#ffdbcb",
            "outline-variant": "#c4c6cc",
            "on-primary": "#ffffff",
            "secondary-fixed": "#cbe7f5",
            "primary-fixed": "#d9e2ff",
            "surface-container-high": "#e6e8eb",
            "surface-container": "#eceef1",
            "tertiary": "#000000",
            "secondary-container": "#cbe7f5",
            "error-container": "#ffdad6",
            "surface-dim": "#d8dadd",
            "primary-fixed-dim": "#b0c6ff",
            "on-tertiary-container": "#dc5d00",
            "on-tertiary": "#ffffff",
            "tertiary-fixed-dim": "#ffb692",
            "surface-container-low": "#f2f4f7",
            "on-secondary-fixed": "#021f29",
            "error": "#ba1a1a",
            "inverse-on-surface": "#eff1f4",
            "on-secondary-container": "#4e6874",
            "surface-tint": "#2b5bb5",
            "on-error-container": "#93000a",
            "on-primary-container": "#5781de",
            "inverse-primary": "#b0c6ff",
            "secondary": "#48626e",
            "on-secondary-fixed-variant": "#304a55",
            "primary": "#000000",
            "on-surface-variant": "#44474c",
            "surface-bright": "#f7f9fc",
            "primary-container": "#001945",
            "on-primary-fixed-variant": "#00429c",
            "on-tertiary-fixed": "#341100",
            "surface-container-lowest": "#ffffff",
            "outline": "#74777d",
            "tertiary-container": "#341100",
            "on-error": "#ffffff",
            "surface-container-highest": "#e0e3e6",
            "on-surface": "#191c1e",
            "surface-variant": "#e0e3e6",
            "on-primary-fixed": "#001945",
            "on-tertiary-fixed-variant": "#7a3000",
            "on-secondary": "#ffffff",
            "inverse-surface": "#2d3133"
          },
          fontFamily: {
            "headline": ["Manrope"],
            "body": ["Inter"],
            "label": ["Inter"]
          },
          borderRadius: { "DEFAULT": "0.125rem", "lg": "0.25rem", "xl": "0.5rem", "full": "0.75rem" },
        },
      },
    }
  </script>
</head>

<body class="text-on-surface bg-background">
  <%- include('../partials/loadingBar') %>
  <%- include('../partials/user/main-header', { user }) %>
    <% const
      dummyImgUrl='https://lh3.googleusercontent.com/aida-public/AB6AXuCjFumsIfpKweThkz0kigWDz4L3U_MlZOYAOjJqVe_fiTnzYV-LTpbevhNkCABEs92MYz-pOz4nfaNJ_ZaH-gt9q4BgY9RjUl8a828prR07HQSp1jOu-01gXC4efDLIQQTWkL40yxC7rdOXkerc1MPXQoaKtayglB0j0wCAVLobeEwrXuTSCDjMvdBsRuuTYFfuc2Tle7m9vQt41ZLWCIXDiTNkVuMlCqY4vlUjmcXOrGqfc269b-Zh8a-6CX3Ib2OtsJuKe0UHik0'
      ; %>

      <div class="flex min-h-screen">
        <%- include('../partials/user/profile-sidebar', { user, dummyImgUrl }) %>

          <!-- Main Content Area -->
          <main class="profile-main flex-1 lg:ml-64 p-6 md:p-12">
            <div class="max-w-[1400px]">
              <!-- Breadcrumbs -->
              <nav
                class="flex items-center gap-2 mb-8 text-[11px] text-on-surface-variant font-label tracking-widest uppercase">
                <a class="hover:text-primary transition-colors" href="/profile">Home</a>
                <span class="material-symbols-outlined text-[10px]">chevron_right</span>
                <a class="hover:text-primary transition-colors" href="/profile">Account</a>
                <span class="material-symbols-outlined text-[10px]">chevron_right</span>
                <span class="text-primary font-bold">Orders</span>
              </nav>

              <div class="mb-12">
                <span class="text-[10px] uppercase tracking-[0.2em] font-bold text-on-surface-variant">Purchase
                  History</span>
                <h1 class="text-4xl font-extrabold font-headline tracking-tight mt-1 mb-3">Recent Orders</h1>
                <p class="text-on-surface-variant max-w-2xl text-sm">Track your engineering marvels, manage returns, and
                  re-experience precision.</p>
              </div>

              <!-- Orders Grid Container -->
              <div class="lg:ml-24">
                <div class="space-y-12">
                  <% if (locals.orders && orders.length> 0) { %>
                    <% orders.forEach(order=> { %>
                      <!-- Order Card -->
                      <div class="bg-white border border-outline-variant/30 rounded-xl overflow-hidden shadow-sm">
                        <div
                          class="p-5 bg-surface-container-low border-b border-outline-variant/30 flex flex-col md:flex-row justify-between items-start md:items-center gap-4">
                          <div class="flex flex-wrap gap-x-10 gap-y-2">
                            <div>
                              <p class="text-[10px] uppercase tracking-widest font-bold text-on-surface-variant mb-1">
                                Order ID</p>
                              <p class="font-headline font-bold text-base text-[#0D1B2A]">#<%= order.orderId %>
                              </p>
                            </div>
                            <div>
                              <p class="text-[10px] uppercase tracking-widest font-bold text-on-surface-variant mb-1">
                                Date Placed</p>
                              <p class="text-sm">
                                <%= new Date(order.createdAt).toLocaleDateString('en-US', { year: 'numeric' ,
                                  month: 'short' , day: 'numeric' }) %>
                              </p>
                            </div>
                            <div>
                              <p class="text-[10px] uppercase tracking-widest font-bold text-on-surface-variant mb-1">
                                Total Amount</p>
                              <p class="text-sm font-semibold">₹<%= order.pricing.grandTotal.toFixed(2) %>
                              </p>
                            </div>
                            <div>
                              <p class="text-[10px] uppercase tracking-widest font-bold text-on-surface-variant mb-1">
                                Payment Status</p>
                              <p class="text-sm">
                                <% if (order.paymentStatus==='Paid' ) { %>
                                  <span
                                    class="text-green-600 font-bold uppercase tracking-wider text-[11px]">Paid</span>
                                <% } else if (order.paymentStatus==='Refunded' ) { %>
                                  <span
                                    class="text-blue-600 font-bold uppercase tracking-wider text-[11px]">Refunded</span>
                                <% } else { %>
                                  <span
                                    class="text-amber-600 font-bold uppercase tracking-wider text-[11px]">Unpaid</span>
                                <% } %>
                              </p>
                            </div>
                          </div>

                          <% if (order.orderStatus==='Delivered' ) { %>
                            <div
                              class="inline-flex items-center gap-2 px-3 py-1 bg-green-50 text-green-700 font-bold text-[10px] uppercase tracking-wider rounded-md">
                              <span class="material-symbols-outlined text-sm">check_circle</span>
                              Delivered
                            </div>
                            <% } else if (order.orderStatus==='Cancelled' ) { %>
                              <div
                                class="inline-flex items-center gap-2 px-3 py-1 bg-red-50 text-red-700 font-bold text-[10px] uppercase tracking-wider rounded-md">
                                <span class="material-symbols-outlined text-sm">cancel</span>
                                Cancelled
                              </div>
                            <% } else if (order.orderStatus==='Return Requested') { %>
                              <div
                                class="inline-flex items-center gap-2 px-3 py-1 bg-amber-50 text-amber-700 font-bold text-[10px] uppercase tracking-wider rounded-md">
                                <span class="material-symbols-outlined text-sm">assignment_return</span>
                                Return Requested
                              </div>
                            <% } else if (order.orderStatus==='Returned') { %>
                              <div
                                class="inline-flex items-center gap-2 px-3 py-1 bg-green-50 text-green-700 font-bold text-[10px] uppercase tracking-wider rounded-md">
                                <span class="material-symbols-outlined text-sm">check_circle</span>
                                Returned
                              </div>
                            <% } else if (order.orderStatus==='Return Confirmed') { %>
                              <div
                                class="inline-flex items-center gap-2 px-3 py-1 bg-orange-50 text-orange-700 font-bold text-[10px] uppercase tracking-wider rounded-md">
                                <span class="material-symbols-outlined text-sm">keyboard_return</span>
                                Return Confirmed
                              </div>
                            <% } else if (order.orderStatus==='Replacement Confirmed') { %>
                              <div
                                class="inline-flex items-center gap-2 px-3 py-1 bg-blue-50 text-blue-700 font-bold text-[10px] uppercase tracking-wider rounded-md">
                                <span class="material-symbols-outlined text-sm">autorenew</span>
                                Replacement Confirmed
                              </div>
                            <% } else { %>
                              <div
                                class="inline-flex items-center gap-2 px-3 py-1 bg-black text-white font-bold text-[10px] uppercase tracking-wider rounded-md">
                                <span class="w-1.5 h-1.5 rounded-full bg-white animate-pulse"></span>
                                In Transit
                              </div>
                              <% } %>
                        </div>
                        <div class="p-8" style="cursor: pointer;">
                          <div class="flex flex-col lg:flex-row gap-10 items-center">
                            <div class="grid grid-cols-2 gap-2 shrink-0">
                              <% order.items.forEach((item, index)=> { %>
                                <div
                                  class="w-28 h-28 bg-white border border-outline-variant/30 p-4 flex items-center justify-center relative rounded-lg">
                                  <img alt="<%= item.name %>" class="w-full h-full object-contain"
                                    src="<%= item.image || 'https://via.placeholder.com/150' %>" />
                                </div>
                                <% }) %>
                            </div>
                            <div class="flex-grow min-w-0 lg:max-w-[50%]">
                              <h3 class="font-headline font-bold text-lg mb-1 break-words">
                                <%= order.items.map(item=> item.name).join(' & ') %>
                              </h3>
                              <p class="text-on-surface-variant text-sm">
                                <%= order.items.reduce((total, item)=> total + item.quantity, 0) %> items in this
                                  shipment • Ships from Central Hub
                              </p>
                              <div class="mt-4 flex flex-wrap gap-4">
                                <% if (['Delivered', 'Return Requested', 'Return Confirmed', 'Replacement Confirmed', 'Returned', 'Replaced'].includes(order.orderStatus)) { %>
                                  <button onclick="downloadInvoicePDF(this, '<%= order._id %>')"
                                    class="text-[11px] font-bold uppercase tracking-widest border-b border-black text-black pb-0.5 hover:text-slate-700 hover:border-slate-400 transition-colors flex items-center gap-1">
                                    <span class="material-symbols-outlined text-sm">description</span>
                                    Download Invoice
                                  </button>
                                <% } else { %>
                                  <button disabled style="opacity: 0.5; pointer-events: none; cursor: not-allowed;" title="Invoice available after delivery"
                                    class="text-[11px] font-bold uppercase tracking-widest border-b border-gray-400 text-gray-400 pb-0.5 flex items-center gap-1">
                                    <span class="material-symbols-outlined text-sm">description</span>
                                    Download Invoice
                                  </button>
                                <% } %>
                              </div>
                            </div>
                            <div class="flex flex-col gap-3 w-full lg:w-auto lg:items-end lg:shrink-0">
                              <!-- Track Order & View Details Row -->
                              <div class="flex flex-wrap lg:flex-nowrap gap-3 w-full lg:w-auto justify-end">
                                <a href="/orders/track/<%= order._id %>" class="flex-1 lg:flex-none">
                                  <button
                                    class="w-full px-6 py-3 bg-primary text-white font-bold text-[11px] uppercase tracking-widest hover:bg-slate-800 transition-all flex items-center justify-center gap-2 rounded-md">
                                    <span class="material-symbols-outlined text-sm">local_shipping</span>
                                    Track Order
                                  </button>
                                </a>
                                <a href="/orders/track/<%= order._id %>" class="flex-1 lg:flex-none">
                                  <button
                                    class="w-full px-6 py-3 border border-outline text-on-surface font-bold text-[11px] uppercase tracking-widest hover:bg-slate-50 transition-all rounded-md">
                                    View Details
                                  </button>
                                </a>
                              </div>

                              <!-- Return Product Row (Below) -->
                              <% if (['Delivered', 'Return Requested', 'Return Confirmed', 'Returned', 'Replaced', 'Replacement Confirmed'].includes(order.orderStatus) && order.items.some(item => !['Cancelled', 'Return Requested', 'Return Confirmed', 'Replacement Confirmed', 'Returned', 'Replaced'].includes(item.status))) { %>
                                <a href="/orders/return/<%= order._id %>" class="w-full lg:w-auto">
                                  <button
                                    class="w-full px-6 py-3 bg-error-container text-on-error-container font-bold text-[11px] uppercase tracking-widest hover:bg-error-container/85 transition-all flex items-center justify-center gap-2 rounded-md">
                                    <span class="material-symbols-outlined text-sm">keyboard_return</span>
                                    Return Product
                                  </button>
                                </a>
                              <% } %>
                            </div>
                          </div>
                        </div>
                      </div>
                      <% }) %>
                        <% } else { %>
                          <!-- No Orders Fallback -->
                          <div class="bg-white border border-outline-variant/30 rounded-xl p-16 text-center shadow-sm">
                            <span
                              class="material-symbols-outlined text-5xl text-on-surface-variant mb-4">shopping_bag</span>
                            <h3 class="font-headline font-bold text-xl mb-2">No orders placed yet</h3>
                            <p class="text-on-surface-variant text-sm mb-6">Explore our curated collections of precision
                              engineering marvels.</p>
                            <a href="/shop">
                              <button
                                class="px-8 py-3 bg-primary text-white text-xs font-bold uppercase tracking-wider rounded-md hover:bg-slate-800 transition-all">
                                Shop Now
                              </button>
                            </a>
                          </div>
                          <% } %>
                </div>

                <!-- Pagination
        <div class="mt-16 flex justify-center">
          <button class="px-12 py-4 border border-outline text-on-surface font-headline font-bold text-[11px] uppercase tracking-widest hover:bg-slate-50 transition-all rounded-md">
            Load Older Orders
          </button>
        </div> -->
              </div>
            </div>
          </main>
      </div>

      <script>
          async function downloadInvoicePDF(btn, orderId) {
              const originalText = btn.innerHTML;
              btn.disabled = true;
              btn.innerHTML = `
                  <span class="material-symbols-outlined text-sm animate-spin">sync</span>
                  Generating...
              `;

              try {
                  const response = await fetch(`/orders/invoice-data/${orderId}`);
                  const result = await response.json();
                  if (!result.success) {
                      throw new Error(result.message || 'Failed to fetch invoice details.');
                  }
                  const order = result.order;
                  const userEmail = '<%= user.email %>';

                  // Create virtual element for PDF rendering
                  const container = document.createElement('div');
                  container.style.fontFamily = "'Inter', sans-serif";
                  container.style.color = '#1e293b';
                  container.style.padding = '40px';
                  container.style.backgroundColor = '#ffffff';

                  const downloadDateTime = new Date().toLocaleString('en-US', {
                      month: 'long',
                      day: 'numeric',
                      year: 'numeric',
                      hour: '2-digit',
                      minute: '2-digit',
                      second: '2-digit',
                      hour12: true
                  });

                  // Retrieve pricing information from order object
                  const subtotal = order.pricing.subtotal || 0;
                  const shipping = order.pricing.shipping || 0;
                  const tax = order.pricing.tax || 0;
                  const grandTotal = order.pricing.grandTotal || 0;
                  const couponCode = order.couponCode || "";
                  const refundedAmount = order.pricing.refundedAmount || 0;
                  const finalGrandTotal = grandTotal - refundedAmount;

                  let couponDiscount = 0;
                  let offerDiscount = 0;
                  if (typeof order.pricing.couponDiscount !== 'undefined') {
                      couponDiscount = order.pricing.couponDiscount || 0;
                      offerDiscount = order.pricing.productDiscount || 0;
                  } else if (order.couponCode) {
                      couponDiscount = order.pricing.discount || 0;
                  } else {
                      offerDiscount = order.pricing.discount || 0;
                  }

                  let itemsRowsHtml = '';
                  order.items.forEach(function(item) {
                      const isCancelledOrReturned = item.status === 'Cancelled' || item.status === 'Returned' || item.status === 'Return Confirmed';
                      itemsRowsHtml += `
                      <tr style="border-bottom: 1px solid #f0f0f0;">
                          <td style="padding: 12px 0;">
                              <div style="font-size: 11px; font-weight: 600; color: ${isCancelledOrReturned ? '#bbb' : '#111'}; ${isCancelledOrReturned ? 'text-decoration: line-through;' : ''} word-break: break-word;">
                                  ${item.name}
                              </div>
                              ${item.variantName ? `
                              <div style="font-size: 9px; color: #aaa; margin-top: 2px; ${isCancelledOrReturned ? 'text-decoration: line-through;' : ''}">
                                  ${item.variantName}
                              </div>
                              ` : ''}
                              ${isCancelledOrReturned ? `
                              <span style="display: inline-block; font-size: 8px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.06em; color: #e05555; margin-top: 3px; border: 1px solid #e05555; padding: 1px 5px; border-radius: 2px;">
                                  ${item.status}
                              </span>
                              ` : ''}
                          </td>
                          <td style="padding: 12px 0; font-size: 10px; color: ${isCancelledOrReturned ? '#ccc' : '#555'}; text-align: center; ${isCancelledOrReturned ? 'text-decoration: line-through;' : ''}">
                              ₹${item.price.toFixed(2)}
                          </td>
                          <td style="padding: 12px 0; font-size: 10px; color: ${isCancelledOrReturned ? '#ccc' : '#555'}; text-align: center; ${isCancelledOrReturned ? 'text-decoration: line-through;' : ''}">
                              ${item.quantity}
                          </td>
                          <td style="padding: 12px 0; font-size: 11px; font-weight: 600; color: ${isCancelledOrReturned ? '#ccc' : '#111'}; text-align: right; ${isCancelledOrReturned ? 'text-decoration: line-through;' : ''}">
                              ₹${item.subtotal.toFixed(2)}
                          </td>
                      </tr>
                      `;
                  });

                  container.innerHTML = `
                  <div style="font-family: 'Inter', 'Helvetica Neue', sans-serif; color: #1a1a1a; max-width: 700px; margin: 0 auto;">

                      <!-- Header -->
                      <div style="display: flex; justify-content: space-between; align-items: flex-start; padding-bottom: 24px; border-bottom: 1px solid #e5e5e5; margin-bottom: 32px;">
                          <div>
                              <div style="font-size: 22px; font-weight: 700; letter-spacing: -0.04em; color: #111;">LUXE TECH</div>
                              <div style="font-size: 10px; color: #999; margin-top: 3px; letter-spacing: 0.08em; text-transform: uppercase;">Invoice</div>
                          </div>
                          <div style="text-align: right;">
                              <div style="font-size: 10px; color: #999; margin-bottom: 4px;">Order</div>
                              <div style="font-size: 12px; font-weight: 600; color: #111;">#${order.orderId}</div>
                              <div style="font-size: 10px; color: #999; margin-top: 6px;">${new Date(order.createdAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}</div>
                              <div style="font-size: 10px; color: #bbb;">${downloadDateTime}</div>
                          </div>
                      </div>

                      <!-- Billing & Payment Row -->
                      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 32px; margin-bottom: 36px; font-size: 11px; line-height: 1.9;">
                          <div>
                              <div style="font-size: 9px; text-transform: uppercase; letter-spacing: 0.1em; color: #aaa; margin-bottom: 8px;">Bill To</div>
                              <div style="font-weight: 600; color: #111; margin-bottom: 2px;">${order.shippingAddress.fullName}</div>
                              <div style="color: #555;">${order.shippingAddress.streetAddress}</div>
                              <div style="color: #555;">${order.shippingAddress.city}, ${order.shippingAddress.state} ${order.shippingAddress.zipCode}</div>
                              <div style="color: #555;">${order.shippingAddress.country}</div>
                              <div style="color: #777; margin-top: 6px;">${order.shippingAddress.phoneNumber}</div>
                          </div>
                          <div>
                              <div style="font-size: 9px; text-transform: uppercase; letter-spacing: 0.1em; color: #aaa; margin-bottom: 8px;">Details</div>
                              <div style="display: flex; justify-content: space-between; border-bottom: 1px solid #f0f0f0; padding: 4px 0;">
                                  <span style="color: #888;">Payment</span>
                                  <span style="font-weight: 500; color: #111; text-transform: uppercase;">${order.paymentMethod}</span>
                              </div>
                              <div style="display: flex; justify-content: space-between; border-bottom: 1px solid #f0f0f0; padding: 4px 0;">
                                  <span style="color: #888;">Status</span>
                                  <span style="font-weight: 500; color: #111;">${order.paymentStatus}</span>
                              </div>
                              <div style="display: flex; justify-content: space-between; padding: 4px 0;">
                                  <span style="color: #888;">Order</span>
                                  <span style="font-weight: 500; color: #111;">${order.orderStatus}</span>
                              </div>
                              ${order.estimateDate ? `
                              <div style="display: flex; justify-content: space-between; padding: 4px 0;">
                                  <span style="color: #888;">Est. Delivery</span>
                                  <span style="font-weight: 500; color: #111;">${order.estimateDate}</span>
                              </div>
                              ` : ''}
                          </div>
                      </div>

                      <!-- Items Table -->
                      <table style="width: 100%; border-collapse: collapse; margin-bottom: 28px; table-layout: fixed;">
                          <thead>
                              <tr style="border-bottom: 1px solid #111;">
                                  <th style="padding: 8px 0; font-size: 9px; text-transform: uppercase; letter-spacing: 0.08em; color: #555; font-weight: 600; text-align: left; width: 48%;">Item</th>
                                  <th style="padding: 8px 0; font-size: 9px; text-transform: uppercase; letter-spacing: 0.08em; color: #555; font-weight: 600; text-align: center; width: 18%;">Unit</th>
                                  <th style="padding: 8px 0; font-size: 9px; text-transform: uppercase; letter-spacing: 0.08em; color: #555; font-weight: 600; text-align: center; width: 12%;">Qty</th>
                                  <th style="padding: 8px 0; font-size: 9px; text-transform: uppercase; letter-spacing: 0.08em; color: #555; font-weight: 600; text-align: right; width: 22%;">Amount</th>
                              </tr>
                          </thead>
                          <tbody>
                              ${itemsRowsHtml}
                          </tbody>
                      </table>

                      <!-- Pricing Summary -->
                      <div style="display: flex; justify-content: flex-end; margin-bottom: 40px;">
                          <div style="width: 220px; font-size: 11px;">
                              <div style="display: flex; justify-content: space-between; padding: 5px 0; color: #777;">
                                  <span>Subtotal</span>
                                  <span style="color: #111;">₹${subtotal.toFixed(2)}</span>
                              </div>
                              ${offerDiscount > 0 ? '<div style="display: flex; justify-content: space-between; padding: 5px 0; color: #777;"><span>Offer Discount</span><span style="color: #22a86b;">−₹' + offerDiscount.toFixed(2) + '</span></div>' : ''}
                              ${couponCode ? '<div style="display: flex; justify-content: space-between; padding: 5px 0; color: #777;"><span>Coupon (' + couponCode + ')</span><span style="color: #22a86b;">−₹' + couponDiscount.toFixed(2) + '</span></div>' : ''}
                              <div style="display: flex; justify-content: space-between; padding: 5px 0; color: #777;">
                                  <span>Shipping</span>
                                  <span style="color: #111;">${shipping === 0 ? 'FREE' : '₹' + shipping.toFixed(2)}</span>
                              </div>
                              <div style="display: flex; justify-content: space-between; padding: 5px 0; color: #777;">
                                  <span>Tax (8%)</span>
                                  <span style="color: #111;">₹${tax.toFixed(2)}</span>
                              </div>
                              <div style="display: flex; justify-content: space-between; padding: 8px 0; margin-top: 4px; border-top: 1px solid #e5e5e5; color: #555; font-weight: 600;">
                                  <span>Total</span>
                                  <span>₹${grandTotal.toFixed(2)}</span>
                              </div>
                              ${refundedAmount > 0 ? '<div style="display: flex; justify-content: space-between; padding: 5px 0; color: #e05555; font-weight: 600;"><span>Refunded</span><span>−₹' + refundedAmount.toFixed(2) + '</span></div>' : ''}
                              <div style="display: flex; justify-content: space-between; padding: 10px 0; margin-top: 4px; border-top: 1px solid #111; font-size: 13px; font-weight: 700; color: #111;">
                                  <span>Grand Total</span>
                                  <span>₹${finalGrandTotal.toFixed(2)}</span>
                              </div>
                          </div>
                      </div>

                      <!-- Footer -->
                      <div style="border-top: 1px solid #e5e5e5; padding-top: 16px; text-align: center;">
                          <p style="font-size: 9px; color: #bbb; margin: 0;">Thank you for shopping with Luxe Tech. For support, contact support@luxetech.com.</p>
                          <p style="font-size: 9px; color: #ccc; margin: 4px 0 0 0;">Luxe Tech Inc. &nbsp;·&nbsp; Computer generated invoice — no signature required.</p>
                      </div>

                  </div>
                  `;

                  const opt = {
                      margin: [15, 15, 20, 15],
                      filename: `LuxeTech_Invoice_#${order.orderId}.pdf`,
                      image: { type: 'jpeg', quality: 0.98 },
                      html2canvas: { scale: 2, useCORS: true, letterRendering: true },
                      jsPDF: { unit: 'mm', format: 'a4', orientation: 'portrait' }
                  };

                  await html2pdf().set(opt).from(container).save();

              } catch (err) {
                  console.error('Error generating PDF:', err);
                  showToast(err.message || 'An error occurred while generating the invoice PDF.', 'error');
              } finally {
                  btn.disabled = false;
                  btn.innerHTML = originalText;
              }
          }

          function showToast(message, type = 'error') {
              let container = document.getElementById('toast-container');
              if (!container) {
                  container = document.createElement('div');
                  container.id = 'toast-container';
                  container.style.position = 'fixed';
                  container.style.top = '24px';
                  container.style.right = '24px';
                  container.style.zIndex = '9999';
                  container.style.display = 'flex';
                  container.style.flexDirection = 'column';
                  container.style.gap = '8px';
                  document.body.appendChild(container);
              }

              const toast = document.createElement('div');
              toast.style.padding = '12px 20px';
              toast.style.borderRadius = '8px';
              toast.style.color = '#ffffff';
              toast.style.fontSize = '13px';
              toast.style.fontWeight = '500';
              toast.style.fontFamily = "'Inter', sans-serif";
              toast.style.boxShadow = '0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -2px rgba(0, 0, 0, 0.05)';
              toast.style.transition = 'all 0.3s cubic-bezier(0.4, 0, 0.2, 1)';
              toast.style.opacity = '0';
              toast.style.transform = 'translateY(-20px)';

              if (type === 'error') {
                  toast.style.backgroundColor = '#ef4444';
              } else {
                  toast.style.backgroundColor = '#10b981';
              }

              toast.innerText = message;
              container.appendChild(toast);

              setTimeout(() => {
                  toast.style.opacity = '1';
                  toast.style.transform = 'translateY(0)';
              }, 10);

              setTimeout(() => {
                  toast.style.opacity = '0';
                  toast.style.transform = 'translateY(-20px)';
                  setTimeout(() => {
                      toast.remove();
                  }, 300);
              }, 4000);
          }
      </script>

      <%- include('../partials/user/profile-mobile-nav') %>
      <script src="/User/js/loading-bar.js"></script>
</body>

</html>