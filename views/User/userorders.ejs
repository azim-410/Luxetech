<!DOCTYPE html>
<html class="light" lang="en">

<head>
  <meta charset="utf-8" />
  <meta content="width=device-width, initial-scale=1.0" name="viewport" />
  <title>Recent Orders | Luxe Tech</title>
  <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
  <link
    href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&amp;family=Inter:wght@400;500;600&amp;display=swap"
    rel="stylesheet" />
  <link
    href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap"
    rel="stylesheet" />
  <link href="/User/css/main-global.css" rel="stylesheet" />
  <link href="/User/css/loading-bar.css" rel="stylesheet" />
  <link href="/User/css/profile.css" rel="stylesheet" />
  <script id="tailwind-config">
    tailwind.config = {
      darkMode: "class",
      theme: {
        extend: {
          colors: {
            "on-background": "#191c1e",
            "background": "#f7f9fc",
            "surface": "#f7f9fc",
            "secondary-fixed-dim": "#afcbd8",
            "tertiary-fixed": "#ffdbcb",
            "outline-variant": "#c4c6cc",
            "on-primary": "#ffffff",
            "secondary-fixed": "#cbe7f5",
            "primary-fixed": "#d9e2ff",
            "surface-container-high": "#e6e8eb",
            "surface-container": "#eceef1",
            "tertiary": "#000000",
            "secondary-container": "#cbe7f5",
            "error-container": "#ffdad6",
            "surface-dim": "#d8dadd",
            "primary-fixed-dim": "#b0c6ff",
            "on-tertiary-container": "#dc5d00",
            "on-tertiary": "#ffffff",
            "tertiary-fixed-dim": "#ffb692",
            "surface-container-low": "#f2f4f7",
            "on-secondary-fixed": "#021f29",
            "error": "#ba1a1a",
            "inverse-on-surface": "#eff1f4",
            "on-secondary-container": "#4e6874",
            "surface-tint": "#2b5bb5",
            "on-error-container": "#93000a",
            "on-primary-container": "#5781de",
            "inverse-primary": "#b0c6ff",
            "secondary": "#48626e",
            "on-secondary-fixed-variant": "#304a55",
            "primary": "#000000",
            "on-surface-variant": "#44474c",
            "surface-bright": "#f7f9fc",
            "primary-container": "#001945",
            "on-primary-fixed-variant": "#00429c",
            "on-tertiary-fixed": "#341100",
            "surface-container-lowest": "#ffffff",
            "outline": "#74777d",
            "tertiary-container": "#341100",
            "on-error": "#ffffff",
            "surface-container-highest": "#e0e3e6",
            "on-surface": "#191c1e",
            "surface-variant": "#e0e3e6",
            "on-primary-fixed": "#001945",
            "on-tertiary-fixed-variant": "#7a3000",
            "on-secondary": "#ffffff",
            "inverse-surface": "#2d3133"
          },
          fontFamily: {
            "headline": ["Manrope"],
            "body": ["Inter"],
            "label": ["Inter"]
          },
          borderRadius: { "DEFAULT": "0.125rem", "lg": "0.25rem", "xl": "0.5rem", "full": "0.75rem" },
        },
      },
    }
  </script>
</head>

<body class="text-on-surface bg-background">
  <%- include('../partials/loadingBar') %>
  <%- include('../partials/user/main-header', { user }) %>
    <% const
      dummyImgUrl='https://lh3.googleusercontent.com/aida-public/AB6AXuCjFumsIfpKweThkz0kigWDz4L3U_MlZOYAOjJqVe_fiTnzYV-LTpbevhNkCABEs92MYz-pOz4nfaNJ_ZaH-gt9q4BgY9RjUl8a828prR07HQSp1jOu-01gXC4efDLIQQTWkL40yxC7rdOXkerc1MPXQoaKtayglB0j0wCAVLobeEwrXuTSCDjMvdBsRuuTYFfuc2Tle7m9vQt41ZLWCIXDiTNkVuMlCqY4vlUjmcXOrGqfc269b-Zh8a-6CX3Ib2OtsJuKe0UHik0'
      ; %>

      <div class="flex min-h-screen">
        <%- include('../partials/user/profile-sidebar', { user, dummyImgUrl }) %>

          <!-- Main Content Area -->
          <main class="profile-main flex-1 lg:ml-64 p-4 sm:p-6 md:p-12 pt-24 lg:pt-24">
            <div class="max-w-[1400px]">
              <!-- Breadcrumbs -->
              <nav
                class="flex items-center gap-2 mb-8 text-[11px] text-on-surface-variant font-label tracking-widest uppercase">
                <a class="hover:text-primary transition-colors" href="/profile">Home</a>
                <span class="material-symbols-outlined text-[10px]">chevron_right</span>
                <a class="hover:text-primary transition-colors" href="/profile">Account</a>
                <span class="material-symbols-outlined text-[10px]">chevron_right</span>
                <span class="text-primary font-bold">Orders</span>
              </nav>

              <div class="mb-8 md:mb-12">
                <span class="text-[10px] uppercase tracking-[0.2em] font-bold text-on-surface-variant">Purchase
                  History</span>
                <h1 class="text-3xl sm:text-4xl font-extrabold font-headline tracking-tight mt-1 mb-3">Recent Orders</h1>
                <p class="text-on-surface-variant max-w-2xl text-xs sm:text-sm">Track your engineering marvels, manage returns, and
                  re-experience precision.</p>
              </div>

              <!-- Orders Grid Container -->
              <div class="lg:ml-24">
                <div class="space-y-12">
                  <% if (locals.orders && orders.length> 0) { %>
                    <% orders.forEach(order=> { %>
                      <!-- Order Card -->
                      <div class="bg-white border border-outline-variant/30 rounded-xl overflow-hidden shadow-sm">
                        <div
                          class="p-5 bg-surface-container-low border-b border-outline-variant/30 flex flex-col md:flex-row justify-between items-start md:items-center gap-4">
                          <div class="flex flex-wrap gap-x-10 gap-y-2">
                            <div>
                              <p class="text-[10px] uppercase tracking-widest font-bold text-on-surface-variant mb-1">
                                Order ID</p>
                              <p class="font-headline font-bold text-base text-[#0D1B2A]">#<%= order.orderId %>
                              </p>
                            </div>
                            <div>
                              <p class="text-[10px] uppercase tracking-widest font-bold text-on-surface-variant mb-1">
                                Date Placed</p>
                              <p class="text-sm">
                                <%= new Date(order.createdAt).toLocaleDateString('en-US', { year: 'numeric' ,
                                  month: 'short' , day: 'numeric' }) %>
                              </p>
                            </div>
                            <div>
                              <p class="text-[10px] uppercase tracking-widest font-bold text-on-surface-variant mb-1">
                                Total Amount</p>
                              <p class="text-sm font-semibold">₹<%= order.pricing.grandTotal.toFixed(2) %>
                              </p>
                            </div>
                            <div>
                              <p class="text-[10px] uppercase tracking-widest font-bold text-on-surface-variant mb-1">
                                Payment Status</p>
                              <p class="text-sm">
                                <% if (order.paymentStatus==='Paid' ) { %>
                                  <span
                                    class="text-green-600 font-bold uppercase tracking-wider text-[11px]">Paid</span>
                                <% } else if (order.paymentStatus==='Refunded' ) { %>
                                  <span
                                    class="text-blue-600 font-bold uppercase tracking-wider text-[11px]">Refunded</span>
                                <% } else { %>
                                  <span
                                    class="text-amber-600 font-bold uppercase tracking-wider text-[11px]">Unpaid</span>
                                <% } %>
                              </p>
                            </div>
                          </div>

                          <% if (order.orderStatus==='Delivered' ) { %>
                            <div
                              class="inline-flex items-center gap-2 px-3 py-1 bg-green-50 text-green-700 font-bold text-[10px] uppercase tracking-wider rounded-md">
                              <span class="material-symbols-outlined text-sm">check_circle</span>
                              Delivered
                            </div>
                            <% } else if (order.orderStatus==='Cancelled' ) { %>
                              <div
                                class="inline-flex items-center gap-2 px-3 py-1 bg-red-50 text-red-700 font-bold text-[10px] uppercase tracking-wider rounded-md">
                                <span class="material-symbols-outlined text-sm">cancel</span>
                                Cancelled
                              </div>
                            <% } else if (order.orderStatus==='Return Requested') { %>
                              <div
                                class="inline-flex items-center gap-2 px-3 py-1 bg-amber-50 text-amber-700 font-bold text-[10px] uppercase tracking-wider rounded-md">
                                <span class="material-symbols-outlined text-sm">assignment_return</span>
                                Return Requested
                              </div>
                            <% } else if (order.orderStatus==='Returned') { %>
                              <div
                                class="inline-flex items-center gap-2 px-3 py-1 bg-green-50 text-green-700 font-bold text-[10px] uppercase tracking-wider rounded-md">
                                <span class="material-symbols-outlined text-sm">check_circle</span>
                                Returned
                              </div>
                            <% } else if (order.orderStatus==='Return Confirmed') { %>
                              <div
                                class="inline-flex items-center gap-2 px-3 py-1 bg-orange-50 text-orange-700 font-bold text-[10px] uppercase tracking-wider rounded-md">
                                <span class="material-symbols-outlined text-sm">keyboard_return</span>
                                Return Confirmed
                              </div>
                            <% } else if (order.orderStatus==='Replacement Confirmed') { %>
                              <div
                                class="inline-flex items-center gap-2 px-3 py-1 bg-blue-50 text-blue-700 font-bold text-[10px] uppercase tracking-wider rounded-md">
                                <span class="material-symbols-outlined text-sm">autorenew</span>
                                Replacement Confirmed
                              </div>
                            <% } else { %>
                              <div
                                class="inline-flex items-center gap-2 px-3 py-1 bg-black text-white font-bold text-[10px] uppercase tracking-wider rounded-md">
                                <span class="w-1.5 h-1.5 rounded-full bg-white animate-pulse"></span>
                                In Transit
                              </div>
                              <% } %>
                        </div>
                        <div class="p-4 sm:p-8" style="cursor: pointer;">
                          <div class="flex flex-col lg:flex-row gap-6 lg:gap-10 items-start lg:items-center">
                            <div class="grid grid-cols-2 gap-2 shrink-0">
                              <% order.items.forEach((item, index)=> { %>
                                <div
                                  class="w-24 h-24 sm:w-28 sm:h-28 bg-white border border-outline-variant/30 p-2 sm:p-4 flex items-center justify-center relative rounded-lg">
                                  <img alt="<%= item.name %>" class="w-full h-full object-contain"
                                    src="<%= item.image || 'https://via.placeholder.com/150' %>" />
                                </div>
                                <% }) %>
                            </div>
                            <div class="flex-grow min-w-0 lg:max-w-[50%]">
                              <h3 class="font-headline font-bold text-base sm:text-lg mb-1 break-words">
                                <%= order.items.map(item=> item.name).join(' & ') %>
                              </h3>
                              <p class="text-on-surface-variant text-xs sm:text-sm">
                                <%= order.items.reduce((total, item)=> total + item.quantity, 0) %> items in this
                                  shipment • Ships from Central Hub
                              </p>
                              <div class="mt-4 flex flex-wrap gap-4">
                                <% if (['Delivered', 'Return Requested', 'Return Confirmed', 'Replacement Confirmed', 'Returned', 'Replaced'].includes(order.orderStatus)) { %>
                                  <button onclick="downloadInvoicePDF(this, '<%= order._id %>')"
                                    class="text-[11px] font-bold uppercase tracking-widest border-b border-black text-black pb-0.5 hover:text-slate-700 hover:border-slate-400 transition-colors flex items-center gap-1">
                                    <span class="material-symbols-outlined text-sm">description</span>
                                    Download Invoice
                                  </button>
                                <% } else { %>
                                  <button disabled style="opacity: 0.5; pointer-events: none; cursor: not-allowed;" title="Invoice available after delivery"
                                    class="text-[11px] font-bold uppercase tracking-widest border-b border-gray-400 text-gray-400 pb-0.5 flex items-center gap-1">
                                    <span class="material-symbols-outlined text-sm">description</span>
                                    Download Invoice
                                  </button>
                                <% } %>
                              </div>
                            </div>
                            <div class="flex flex-col gap-3 w-full lg:w-auto lg:items-end lg:shrink-0">
                              <!-- Track Order & View Details Row -->
                              <div class="flex flex-col sm:flex-row lg:flex-nowrap gap-3 w-full lg:w-auto justify-end">
                                <a href="/orders/track/<%= order._id %>" class="flex-1 lg:flex-none">
                                  <button
                                    class="w-full px-6 py-3 bg-primary text-white font-bold text-[11px] uppercase tracking-widest hover:bg-slate-800 transition-all flex items-center justify-center gap-2 rounded-md">
                                    <span class="material-symbols-outlined text-sm">local_shipping</span>
                                    Track Order
                                  </button>
                                </a>
                                <a href="/orders/track/<%= order._id %>" class="flex-1 lg:flex-none">
                                  <button
                                    class="w-full px-6 py-3 border border-outline text-on-surface font-bold text-[11px] uppercase tracking-widest hover:bg-slate-50 transition-all rounded-md">
                                    View Details
                                  </button>
                                </a>
                              </div>

                              <!-- Return Product Row (Below) -->
                              <% if (['Delivered', 'Return Requested', 'Return Confirmed', 'Returned', 'Replaced', 'Replacement Confirmed'].includes(order.orderStatus) && order.items.some(item => !['Cancelled', 'Return Requested', 'Return Confirmed', 'Replacement Confirmed', 'Returned', 'Replaced'].includes(item.status))) { %>
                                <a href="/orders/return/<%= order._id %>" class="w-full lg:w-auto">
                                  <button
                                    class="w-full px-6 py-3 bg-error-container text-on-error-container font-bold text-[11px] uppercase tracking-widest hover:bg-error-container/85 transition-all flex items-center justify-center gap-2 rounded-md">
                                    <span class="material-symbols-outlined text-sm">keyboard_return</span>
                                    Return Product
                                  </button>
                                </a>
                              <% } %>
                            </div>
                          </div>
                        </div>
                      </div>
                      <% }) %>
                        <% } else { %>
                          <!-- No Orders Fallback -->
                          <div class="bg-white border border-outline-variant/30 rounded-xl p-16 text-center shadow-sm">
                            <span
                              class="material-symbols-outlined text-5xl text-on-surface-variant mb-4">shopping_bag</span>
                            <h3 class="font-headline font-bold text-xl mb-2">No orders placed yet</h3>
                            <p class="text-on-surface-variant text-sm mb-6">Explore our curated collections of precision
                              engineering marvels.</p>
                            <a href="/shop">
                              <button
                                class="px-8 py-3 bg-primary text-white text-xs font-bold uppercase tracking-wider rounded-md hover:bg-slate-800 transition-all">
                                Shop Now
                              </button>
                            </a>
                          </div>
                          <% } %>
                </div>

                <!-- Pagination
        <div class="mt-16 flex justify-center">
          <button class="px-12 py-4 border border-outline text-on-surface font-headline font-bold text-[11px] uppercase tracking-widest hover:bg-slate-50 transition-all rounded-md">
            Load Older Orders
          </button>
        </div> -->
              </div>
            </div>
          </main>
      </div>

      <script>
          async function downloadInvoicePDF(btn, orderId) {
              const originalText = btn.innerHTML;
              btn.disabled = true;
              btn.innerHTML = `
                  <span class="material-symbols-outlined text-sm animate-spin">sync</span>
                  Downloading...
              `;

              try {
                  window.location.href = `/orders/invoice/${orderId}/pdf`;
              } catch (err) {
                  console.error('Error downloading PDF:', err);
                  showToast(err.message || 'An error occurred while downloading the invoice PDF.', 'error');
              } finally {
                  setTimeout(() => {
                      btn.disabled = false;
                      btn.innerHTML = originalText;
                  }, 2000);
              }
          }

          function showToast(message, type = 'error') {
              let container = document.getElementById('toast-container');
              if (!container) {
                  container = document.createElement('div');
                  container.id = 'toast-container';
                  container.style.position = 'fixed';
                  container.style.top = '24px';
                  container.style.right = '24px';
                  container.style.zIndex = '9999';
                  container.style.display = 'flex';
                  container.style.flexDirection = 'column';
                  container.style.gap = '8px';
                  document.body.appendChild(container);
              }

              const toast = document.createElement('div');
              toast.style.padding = '12px 20px';
              toast.style.borderRadius = '8px';
              toast.style.color = '#ffffff';
              toast.style.fontSize = '13px';
              toast.style.fontWeight = '500';
              toast.style.fontFamily = "'Inter', sans-serif";
              toast.style.boxShadow = '0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -2px rgba(0, 0, 0, 0.05)';
              toast.style.transition = 'all 0.3s cubic-bezier(0.4, 0, 0.2, 1)';
              toast.style.opacity = '0';
              toast.style.transform = 'translateY(-20px)';

              if (type === 'error') {
                  toast.style.backgroundColor = '#ef4444';
              } else {
                  toast.style.backgroundColor = '#10b981';
              }

              toast.innerText = message;
              container.appendChild(toast);

              setTimeout(() => {
                  toast.style.opacity = '1';
                  toast.style.transform = 'translateY(0)';
              }, 10);

              setTimeout(() => {
                  toast.style.opacity = '0';
                  toast.style.transform = 'translateY(-20px)';
                  setTimeout(() => {
                      toast.remove();
                  }, 300);
              }, 4000);
          }
      </script>

      <%- include('../partials/user/profile-mobile-nav') %>
      <script src="/User/js/loading-bar.js"></script>
</body>

</html>