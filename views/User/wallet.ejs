<!DOCTYPE html>
<html class="light" lang="en">

<head>
  <meta charset="utf-8" />
  <meta content="width=device-width, initial-scale=1.0" name="viewport" />
  <title>Luxe Tech | Wallet</title>
  <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>
  <link
    href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&amp;family=Inter:wght@400;500;600&amp;display=swap"
    rel="stylesheet" />
  <link
    href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap"
    rel="stylesheet" />
  <link href="/User/css/main-global.css" rel="stylesheet" />
  <link href="/User/css/loading-bar.css" rel="stylesheet" />
  <link href="/User/css/profile.css" rel="stylesheet" />
  <script id="tailwind-config">
    tailwind.config = {
      darkMode: "class",
      theme: {
        extend: {
          colors: {
            "on-background": "#191c1e",
            "background": "#f7f9fc",
            "surface": "#f7f9fc",
            "secondary-fixed-dim": "#afcbd8",
            "tertiary-fixed": "#ffdbcb",
            "outline-variant": "#c4c6cc",
            "on-primary": "#ffffff",
            "secondary-fixed": "#cbe7f5",
            "primary-fixed": "#d9e2ff",
            "surface-container-high": "#e6e8eb",
            "surface-container": "#eceef1",
            "tertiary": "#000000",
            "secondary-container": "#cbe7f5",
            "error-container": "#ffdad6",
            "surface-dim": "#d8dadd",
            "primary-fixed-dim": "#b0c6ff",
            "on-tertiary-container": "#dc5d00",
            "on-tertiary": "#ffffff",
            "tertiary-fixed-dim": "#ffb692",
            "surface-container-low": "#f2f4f7",
            "on-secondary-fixed": "#021f29",
            "error": "#ba1a1a",
            "inverse-on-surface": "#eff1f4",
            "on-secondary-container": "#4e6874",
            "surface-tint": "#2b5bb5",
            "on-error-container": "#93000a",
            "on-primary-container": "#5781de",
            "inverse-primary": "#b0c6ff",
            "secondary": "#48626e",
            "on-secondary-fixed-variant": "#304a55",
            "primary": "#000000",
            "on-surface-variant": "#44474c",
            "surface-bright": "#f7f9fc",
            "primary-container": "#001945",
            "on-primary-fixed-variant": "#00429c",
            "on-tertiary-fixed": "#341100",
            "surface-container-lowest": "#ffffff",
            "outline": "#74777d",
            "tertiary-container": "#341100",
            "on-error": "#ffffff",
            "surface-container-highest": "#e0e3e6",
            "on-surface": "#191c1e",
            "surface-variant": "#e0e3e6",
            "on-primary-fixed": "#001945",
            "on-tertiary-fixed-variant": "#7a3000",
            "on-secondary": "#ffffff",
            "inverse-surface": "#2d3133"
          },
          fontFamily: {
            "headline": ["Manrope"],
            "body": ["Inter"],
            "label": ["Inter"]
          },
          borderRadius: { "DEFAULT": "0.125rem", "lg": "0.25rem", "xl": "0.5rem", "full": "0.75rem" },
        },
      },
    }
  </script>
  <style>
    .material-symbols-outlined {
      font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
    }

    .precision-gradient {
      background: linear-gradient(135deg, #000000 0%, #001945 100%);
    }
  </style>
</head>

<body class="text-on-surface">
  <%- include('../partials/loadingBar') %>
  <%- include('../partials/user/main-header', { user }) %>
  <% const dummyImgUrl = 'https://lh3.googleusercontent.com/aida-public/AB6AXuCjFumsIfpKweThkz0kigWDz4L3U_MlZOYAOjJqVe_fiTnzYV-LTpbevhNkCABEs92MYz-pOz4nfaNJ_ZaH-gt9q4BgY9RjUl8a828prR07HQSp1jOu-01gXC4efDLIQQTWkL40yxC7rdOXkerc1MPXQoaKtayglB0j0wCAVLobeEwrXuTSCDjMvdBsRuuTYFfuc2Tle7m9vQt41ZLWCIXDiTNkVuMlCqY4vlUjmcXOrGqfc269b-Zh8a-6CX3Ib2OtsJuKe0UHik0'; %>

  <div class="flex min-h-screen">
    <%- include('../partials/user/profile-sidebar', { user, dummyImgUrl }) %>

    <!-- Main Content Canvas -->
    <main class="profile-main flex-1 lg:ml-64 p-6 lg:p-12 bg-surface">
      <!-- Breadcrumbs & Header -->
      <div class="mb-12">
        <div class="flex items-center gap-2 text-[10px] font-bold uppercase tracking-[0.2em] text-on-surface-variant mb-4">
          <span>Account</span>
          <span class="material-symbols-outlined text-xs">chevron_right</span>
          <span class="text-primary">Financial Assets</span>
        </div>
        <h1 class="text-4xl md:text-5xl font-extrabold tracking-tighter text-slate-900 mb-2">My Wallet</h1>
        <p class="text-on-surface-variant max-w-xl font-body">Manage your stored value, payment methods, and precision-engineered transaction history.</p>
      </div>

      <!-- Bento Grid Layout -->
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        <!-- Wallet Balance Card (Featured) -->
        <div class="lg:col-span-2 relative overflow-hidden rounded-2xl bg-gradient-to-br from-slate-950 via-[#0a1128] to-[#1e293b] p-8 text-white border border-slate-800 shadow-2xl min-h-[240px] flex flex-col justify-between group">
          <!-- Background decorative glowing circles -->
          <div class="absolute -right-16 -top-16 w-48 h-48 bg-blue-600/20 rounded-full blur-[80px] group-hover:bg-blue-600/30 transition-all duration-700"></div>
          <div class="absolute -left-16 -bottom-16 w-48 h-48 bg-indigo-500/10 rounded-full blur-[80px] group-hover:bg-indigo-500/20 transition-all duration-700"></div>
          
          <div class="relative z-10 flex flex-col justify-between h-full w-full">
            <div class="flex items-start justify-between">
              <div>
                <p class="text-[10px] uppercase tracking-[0.25em] text-slate-400 font-semibold mb-1">Available Funds</p>
                <div class="text-4xl md:text-5xl font-black tracking-tight text-white font-headline mt-1 select-none drop-shadow-[0_2px_10px_rgba(255,255,255,0.05)]">
                  ₹<%= (user.wallet || 0).toFixed(2) %>
                </div>
              </div>
              <div class="w-12 h-12 rounded-xl bg-white/[0.03] border border-white/10 flex items-center justify-center backdrop-blur-md shadow-inner">
                <span class="material-symbols-outlined text-2xl text-blue-400 select-none">account_balance_wallet</span>
              </div>
            </div>
            
            <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 border-t border-white/5 pt-6 mt-6">
              <div>
                <span class="text-[9px] uppercase tracking-[0.2em] text-slate-500 block mb-1">Wallet Owner</span>
                <span class="text-sm font-bold text-slate-200 tracking-tight font-headline"><%= user.name %></span>
              </div>
              <div class="flex items-center gap-2">
                <div class="text-right hidden sm:block">
                  <span class="text-[9px] text-slate-500 uppercase tracking-widest block">Status</span>
                  <span class="text-[10px] text-emerald-400 font-semibold uppercase tracking-wider block">Ready for Checkout</span>
                </div>
                <div class="flex items-center gap-1.5 px-3 py-1 bg-emerald-500/10 text-emerald-400 rounded-full text-[10px] font-bold uppercase tracking-wider border border-emerald-500/10">
                  <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-ping"></span>
                  Active
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Quick Actions Section -->
        <div class="bg-surface-container-lowest rounded-2xl p-8 shadow-sm flex flex-col justify-center gap-6 border border-outline-variant/10">
          <h3 class="text-xs font-black uppercase tracking-[0.2em] text-on-surface-variant">Asset Management</h3>
          <div class="grid grid-cols-1 gap-4">
            <button onclick="exportWalletPDF()" class="flex items-center justify-between p-4 bg-surface-container-low text-primary rounded-xl font-bold transition-transform hover:scale-[1.02] active:scale-[0.98]">
              <div class="flex items-center gap-3">
                <span class="material-symbols-outlined">receipt_long</span>
                <span>Export Report</span>
              </div>
              <span class="material-symbols-outlined text-sm">download</span>
            </button>
          </div>
        </div>

        <!-- Recent Transactions Table Section -->
        <div class="lg:col-span-3 bg-surface-container-lowest rounded-2xl shadow-sm border border-outline-variant/10 overflow-hidden">
          <div class="p-8 flex flex-col sm:flex-row justify-between items-center gap-4">
            <h3 class="text-xs font-black uppercase tracking-[0.2em] text-on-surface-variant">Transaction Ledger</h3>
            <div class="flex gap-2">
              <button onclick="filterTransactions('all', this)" class="tx-filter-btn px-4 py-2 bg-surface-container-low rounded-lg text-[10px] font-bold uppercase tracking-wider hover:bg-surface-container-high transition-colors">All</button>
              <button onclick="filterTransactions('credit', this)" class="tx-filter-btn px-4 py-2 bg-white border border-outline-variant/10 rounded-lg text-[10px] font-bold uppercase tracking-wider text-outline hover:text-primary transition-colors">Credit</button>
              <button onclick="filterTransactions('debit', this)" class="tx-filter-btn px-4 py-2 bg-white border border-outline-variant/10 rounded-lg text-[10px] font-bold uppercase tracking-wider text-outline hover:text-primary transition-colors">Debit</button>
            </div>
          </div>
          <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse">
              <thead>
                <tr class="bg-surface-container-low/50">
                  <th class="px-8 py-4 text-[10px] font-black uppercase tracking-widest text-on-surface-variant">Date</th>
                  <th class="px-8 py-4 text-[10px] font-black uppercase tracking-widest text-on-surface-variant">Description</th>
                  <th class="px-8 py-4 text-[10px] font-black uppercase tracking-widest text-on-surface-variant text-center">Status</th>
                  <th class="px-8 py-4 text-[10px] font-black uppercase tracking-widest text-on-surface-variant text-right">Amount</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-outline-variant/10 font-body">
                <% if (typeof transactions !== 'undefined' && transactions && transactions.length > 0) { %>
                  <% transactions.forEach(tx => { %>
                    <tr data-type="<%= tx.type %>" class="hover:bg-slate-50/50 transition-colors">
                      <td class="px-8 py-4 text-xs font-medium text-on-surface-variant">
                        <%= new Date(tx.createdAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) %>
                      </td>
                      <td class="px-8 py-4">
                        <div class="text-xs font-bold text-on-surface"><%= tx.description %></div>
                        <% if (tx.orderId) { %>
                          <div class="text-[9px] text-on-surface-variant font-mono mt-0.5">Order #<%= tx.orderId %></div>
                        <% } %>
                      </td>
                      <td class="px-8 py-4 text-center">
                        <span class="inline-block px-2.5 py-0.5 rounded-full text-[9px] font-bold uppercase tracking-wider <%= tx.status === 'completed' ? 'bg-green-50 text-green-700' : tx.status === 'failed' ? 'bg-red-50 text-red-700' : 'bg-amber-50 text-amber-700' %>">
                          <%= tx.status %>
                        </span>
                      </td>
                      <td class="px-8 py-4 text-right text-xs font-extrabold <%= tx.type === 'credit' ? 'text-green-600' : 'text-red-600' %>">
                        <%= tx.type === 'credit' ? '+' : '-' %>₹<%= tx.amount.toFixed(2) %>
                      </td>
                    </tr>
                  <% }) %>
                <% } else { %>
                  <tr>
                    <td colspan="4" class="px-8 py-16 text-center text-on-surface-variant">
                      <div class="flex flex-col items-center justify-center gap-2">
                        <span class="material-symbols-outlined text-4xl text-slate-350 select-none">history_toggle_off</span>
                        <p class="font-bold text-slate-700">No transactions yet</p>
                        <p class="text-xs text-slate-400">Your wallet transaction activity history will be listed here.</p>
                      </div>
                    </td>
                  </tr>
                <% } %>
              </tbody>
            </table>
          </div>
          <% if (!showAll && totalTransactions > 5) { %>
            <div class="p-6 text-center border-t border-outline-variant/10">
              <a href="/wallet?showAll=true<%= typeof sortBy !== 'undefined' && sortBy ? '&sortBy=' + sortBy : '' %>" class="inline-flex items-center gap-2 px-6 py-2.5 bg-slate-900 hover:bg-slate-800 text-white font-bold text-xs uppercase tracking-widest rounded-xl transition-all shadow-sm">
                <span>View Full Report</span>
                <span class="material-symbols-outlined text-sm">keyboard_arrow_down</span>
              </a>
            </div>
          <% } else if (showAll) { %>
            <div class="p-6 text-center border-t border-outline-variant/10">
              <a href="/wallet?showAll=false<%= typeof sortBy !== 'undefined' && sortBy ? '&sortBy=' + sortBy : '' %>" class="inline-flex items-center gap-2 px-6 py-2.5 bg-white border border-slate-200 hover:bg-slate-50 text-slate-700 font-bold text-xs uppercase tracking-widest rounded-xl transition-all shadow-sm">
                <span>Collapse Report</span>
                <span class="material-symbols-outlined text-sm">keyboard_arrow_up</span>
              </a>
            </div>
          <% } %>
        </div>
      </div>
    </main>
  </div>

  <script>
    function filterTransactions(type, btn) {
      // Update button styles
      document.querySelectorAll('.tx-filter-btn').forEach(b => {
        b.classList.remove('bg-surface-container-low');
        b.classList.add('bg-white', 'text-outline');
      });
      btn.classList.add('bg-surface-container-low');
      btn.classList.remove('bg-white', 'text-outline');

      // Filter rows
      const rows = document.querySelectorAll('tbody tr[data-type]');
      rows.forEach(row => {
        if (type === 'all' || row.getAttribute('data-type') === type) {
          row.style.display = '';
        } else {
          row.style.display = 'none';
        }
      });
    }

    async function exportWalletPDF() {
      const exportBtn = document.querySelector('button[onclick="exportWalletPDF()"]');
      const originalText = exportBtn.innerHTML;
      exportBtn.disabled = true;
      exportBtn.innerHTML = `
        <div class="flex items-center gap-3">
          <span class="material-symbols-outlined animate-spin">sync</span>
          <span>Generating...</span>
        </div>
      `;

      try {
        const response = await fetch('/wallet/history');
        const data = await response.json();
        
        if (!data.success) {
          alert(data.message || 'Failed to fetch transaction history.');
          return;
        }

        const transactions = data.transactions;
        if (transactions.length === 0) {
          alert('No transactions found to export.');
          return;
        }

        // Create virtual element for PDF rendering
        const container = document.createElement('div');
        container.style.fontFamily = "'Inter', sans-serif";
        container.style.color = '#334155';
        container.style.padding = '40px';
        container.style.backgroundColor = '#ffffff';

        container.innerHTML = `
          <div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 2px solid #e2e8f0; padding-bottom: 20px; margin-bottom: 30px;">
            <div>
              <h1 style="font-family: 'Manrope', sans-serif; font-size: 24px; font-weight: 855; color: #0f172a; margin: 0; letter-spacing: -0.02em;">LUXE TECH</h1>
              <p style="font-size: 9px; text-transform: uppercase; tracking-wider; color: #64748b; margin: 4px 0 0 0; font-weight: 600;">Official Wallet Statement</p>
            </div>
            <div style="text-align: right;">
              <p style="font-size: 11px; font-weight: 700; color: #0f172a; margin: 0;">Date: ${new Date().toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })}</p>
              <p style="font-size: 9px; color: #64748b; margin: 4px 0 0 0;">Statement ID: #LTW-${Math.floor(100000 + Math.random() * 900000)}</p>
            </div>
          </div>

          <div style="background-color: #f8fafc; border: 1px solid #f1f5f9; border-radius: 12px; padding: 20px; margin-bottom: 30px; display: flex; justify-content: space-between;">
            <div>
              <span style="font-size: 9px; text-transform: uppercase; color: #64748b; font-weight: 700; display: block; margin-bottom: 4px;">Account Holder</span>
              <span style="font-size: 14px; font-weight: 700; color: #0f172a;"><%= user.name %></span>
              <span style="font-size: 11px; color: #64748b; display: block; margin-top: 2px;"><%= user.email %></span>
            </div>
            <div style="text-align: right;">
              <span style="font-size: 9px; text-transform: uppercase; color: #64748b; font-weight: 700; display: block; margin-bottom: 4px;">Wallet Balance</span>
              <span style="font-size: 20px; font-weight: 900; color: #0f172a;">₹<%= (user.wallet || 0).toFixed(2) %></span>
            </div>
          </div>

          <h3 style="font-family: 'Manrope', sans-serif; font-size: 12px; font-weight: 800; color: #0f172a; margin: 0 0 15px 0; text-transform: uppercase; letter-spacing: 0.05em;">Transaction History</h3>
          
          <table style="width: 100%; border-collapse: collapse; text-align: left;">
            <thead>
              <tr style="background-color: #f1f5f9; border-bottom: 1px solid #cbd5e1;">
                <th style="padding: 10px 12px; font-size: 9px; font-weight: 700; text-transform: uppercase; color: #475569;">Date</th>
                <th style="padding: 10px 12px; font-size: 9px; font-weight: 700; text-transform: uppercase; color: #475569;">Description</th>
                <th style="padding: 10px 12px; font-size: 9px; font-weight: 700; text-transform: uppercase; color: #475569; text-align: center;">Status</th>
                <th style="padding: 10px 12px; font-size: 9px; font-weight: 700; text-transform: uppercase; color: #475569; text-align: right;">Amount</th>
              </tr>
            </thead>
            <tbody>
              ${transactions.map(tx => `
                <tr style="border-bottom: 1px solid #f1f5f9;">
                  <td style="padding: 12px; font-size: 10px; color: #64748b;">
                    ${new Date(tx.createdAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}
                  </td>
                  <td style="padding: 12px;">
                    <div style="font-size: 11px; font-weight: 700; color: #0f172a;">${tx.description}</div>
                    ${tx.orderId ? `<div style="font-size: 9px; color: #64748b; font-family: monospace; margin-top: 2px;">Order #${tx.orderId}</div>` : ''}
                  </td>
                  <td style="padding: 12px; text-align: center;">
                    <span style="display: inline-block; padding: 2px 8px; border-radius: 9999px; font-size: 8px; font-weight: 700; text-transform: uppercase; 
                      ${tx.status === 'completed' ? 'background-color: #dcfce7; color: #15803d;' : tx.status === 'failed' ? 'background-color: #fee2e2; color: #b91c1c;' : 'background-color: #fef3c7; color: #b45309;'}">
                      ${tx.status}
                    </span>
                  </td>
                  <td style="padding: 12px; text-align: right; font-size: 10px; font-weight: 700; ${tx.type === 'credit' ? 'color: #16a34a;' : 'color: #dc2626;'}">
                    ${tx.type === 'credit' ? '+' : '-'}₹${tx.amount.toFixed(2)}
                  </td>
                </tr>
              `).join('')}
            </tbody>
          </table>

          <div style="margin-top: 40px; border-top: 1px dashed #cbd5e1; padding-top: 20px; text-align: center;">
            <p style="font-size: 9px; color: #94a3b8; margin: 0;">This is a system generated report and does not require a physical signature.</p>
            <p style="font-size: 9px; color: #94a3b8; margin: 4px 0 0 0;">Luxe Tech Support: support@luxetech.com | © ${new Date().getFullYear()} Luxe Tech Inc.</p>
          </div>
        `;

        const opt = {
          margin:       [15, 15, 20, 15],
          filename:     'LuxeTech_Wallet_Statement.pdf',
          image:        { type: 'jpeg', quality: 0.98 },
          html2canvas:  { scale: 2, useCORS: true, letterRendering: true },
          jsPDF:        { unit: 'mm', format: 'a4', orientation: 'portrait' }
        };

        await html2pdf().set(opt).from(container).save();

      } catch (err) {
        console.error('Error generating PDF:', err);
        alert('An error occurred while generating the statement PDF.');
      } finally {
        exportBtn.disabled = false;
        exportBtn.innerHTML = originalText;
      }
    }
  </script>

  <%- include('../partials/user/profile-mobile-nav') %>
  <script src="/User/js/loading-bar.js"></script>
</body>

</html>
