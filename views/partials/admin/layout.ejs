<link rel="stylesheet" href="/User/css/loading-bar.css">
<%- include('../loadingBar') %>

<!--
  Admin Layout Partial - Top Nav + Side Nav
  Include at the top of every admin page (inside body, before main).
  Pass activePage from the controller to highlight the active nav item.
  Accepted values: 'dashboard', 'customers', 'products', 'categories', 'orders', 'analytics'
-->

<style>
  /* ── Admin Nav Shared Styles ────────────────────────────── */
  .admin-topbar {
    position: fixed;
    top: 0;
    width: 100%;
    z-index: 50;
    background: rgba(241, 244, 246, 0.85);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0 2rem;
    height: 4rem;
    box-shadow: 0 1px 0 rgba(171, 179, 183, 0.2);
    border-bottom: 1px solid rgba(171, 179, 183, 0.15);
  }

  .admin-topbar__hamburger {
    display: none;
    background: none;
    border: none;
    cursor: pointer;
    color: #5d5e61;
    align-items: center;
    justify-content: center;
    padding: 0.375rem;
    border-radius: 0.5rem;
    transition: color 0.15s, background 0.15s;
    margin-right: 0.75rem;
  }

  .admin-topbar__hamburger:hover {
    color: #2b3437;
    background: rgba(43, 52, 55, 0.06);
  }

  @media (max-width: 1023px) {
    .admin-topbar__hamburger {
      display: flex;
    }
  }

  .admin-topbar__brand {
    font-family: 'Manrope', sans-serif;
    font-size: 1.2rem;
    font-weight: 800;
    letter-spacing: -0.03em;
    color: #2b3437;
    text-decoration: none;
  }

  .admin-topbar__actions {
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }

  .admin-topbar__icon-btn {
    background: none;
    border: none;
    cursor: pointer;
    color: #5d5e61;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0.375rem;
    border-radius: 0.5rem;
    transition: color 0.15s, background 0.15s;
  }

  .admin-topbar__icon-btn:hover {
    color: #2b3437;
    background: rgba(43, 52, 55, 0.06);
  }

  .admin-topbar__avatar {
    width: 2rem;
    height: 2rem;
    border-radius: 50%;
    background: #cae6fd;
    overflow: hidden;
    flex-shrink: 0;
  }

  .admin-topbar__avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* ── Sidebar ────────────────────────────────────────────── */
  .admin-sidebar {
    position: fixed;
    left: 0;
    top: 0;
    height: 100vh;
    width: 16rem;
    background: #eaeff1;
    display: flex;
    flex-direction: column;
    padding: 1.5rem;
    padding-top: 5.5rem;
    gap: 0.25rem;
    z-index: 40;
    border-right: 1px solid rgba(171, 179, 183, 0.15);
    transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .admin-sidebar__header {
    margin-bottom: 1.5rem;
    padding: 0 0.5rem;
  }

  .admin-sidebar__title {
    font-family: 'Manrope', sans-serif;
    font-size: 1rem;
    font-weight: 700;
    color: #2b3437;
    margin: 0 0 0.2rem;
  }

  .admin-sidebar__subtitle {
    font-size: 0.625rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: #5d5e61;
    margin: 0;
  }

  .admin-sidebar__nav {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
    flex: 1;
  }

  .admin-sidebar__link {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.75rem 1rem;
    border-radius: 0.5rem;
    font-family: 'Inter', sans-serif;
    font-size: 0.75rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    color: #5d5e61;
    text-decoration: none;
    transition: background 0.15s, color 0.15s, transform 0.15s;
  }

  .admin-sidebar__link:hover {
    background: rgba(248, 249, 250, 0.9);
    color: #2b3437;
  }

  .admin-sidebar__link.active {
    background: #f8f9fa;
    color: #2b3437;
    font-weight: 700;
  }

  .admin-sidebar__link.active .material-symbols-outlined {
    font-variation-settings: 'FILL' 1, 'wght' 400, 'GRAD' 0, 'opsz' 24;
  }

  .admin-sidebar__footer {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
    border-top: 1px solid rgba(171, 179, 183, 0.2);
    padding-top: 1rem;
    margin-top: auto;
  }

  /* Responsive main container override */
  main {
    margin-left: 16rem !important;
    padding-top: 5.5rem !important;
    transition: margin-left 0.3s ease, padding 0.3s ease;
  }

  @media (max-width: 1023px) {
    .admin-sidebar {
      transform: translateX(-100%);
      z-index: 100;
      padding-top: 2rem;
    }
    .admin-sidebar.open {
      transform: translateX(0);
      box-shadow: 10px 0 30px rgba(0, 0, 0, 0.15);
    }
    main {
      margin-left: 0 !important;
      padding-left: 1.25rem !important;
      padding-right: 1.25rem !important;
      padding-top: 5rem !important;
    }
  }
</style>

<!-- ══ Top Navigation Bar ════════════════════════════════════════ -->
<nav class="admin-topbar">
  <div style="display: flex; align-items: center;">
    <button class="admin-topbar__hamburger" id="sidebar-toggle" aria-label="Toggle Sidebar">
      <span class="material-symbols-outlined">menu</span>
    </button>
    <a class="admin-topbar__brand" href="/admin/dashboard">Luxe Tech</a>
  </div>
  <div class="admin-topbar__actions">
    <button class="admin-topbar__icon-btn" title="Notifications" aria-label="Notifications">
      <span class="material-symbols-outlined">notifications</span>
    </button>
    <button class="admin-topbar__icon-btn" title="Settings" aria-label="Settings">
      <span class="material-symbols-outlined">settings</span>
    </button>
    <div class="admin-topbar__avatar">
      <img
        src="https://lh3.googleusercontent.com/aida-public/AB6AXuBXLtr6eZ2C7WQgF-rgHK35yDUS7uCUJrEJeUPJtMD8LJnsnMOIGGcIxDgD7h6ihjitM0hFSacWmZ8CvjOA-B5ECnBcW3W1cvZlKRfViMcUHWwLyAbwucJMlG0jnVVMVA6cawHlG2a29dgV133zWmFbo08BMsWmlO8b7POrZdKPiCAGY5LxVdAt-TiCdWXG8Fz_MmNFv3fJZZeJqxgX40TwGSGE-i8_r4KvzMkJe67up7yLxq1cxfMcsxRJ6gMn9PTDu886dZpusnKw"
        alt="Admin profile"
      />
    </div>
  </div>
</nav>

<!-- ══ Side Navigation Bar ═══════════════════════════════════════ -->
<aside class="admin-sidebar">
  <div class="admin-sidebar__header">
    <h2 class="admin-sidebar__title">Admin Portal</h2>
    <p class="admin-sidebar__subtitle">Luxury Curator</p>
  </div>

  <nav class="admin-sidebar__nav">
    <a
      class="admin-sidebar__link <%= (typeof activePage !== 'undefined' && activePage === 'dashboard') ? 'active' : '' %>"
      href="/admin/dashboard"
    >
      <span class="material-symbols-outlined">dashboard</span>
      Dashboard
    </a>

    <a
      class="admin-sidebar__link <%= (typeof activePage !== 'undefined' && activePage === 'customers') ? 'active' : '' %>"
      href="/admin/user-management"
    >
      <span class="material-symbols-outlined">group</span>
      Customers
    </a>

    <a
      class="admin-sidebar__link <%= (typeof activePage !== 'undefined' && activePage === 'products') ? 'active' : '' %>"
      href="/admin/product-management"
    >
      <span class="material-symbols-outlined">inventory_2</span>
      Products
    </a>

    <a
      class="admin-sidebar__link <%= (typeof activePage !== 'undefined' && activePage === 'categories') ? 'active' : '' %>"
      href="/admin/category-management"
    >
      <span class="material-symbols-outlined">category</span>
      Categories
    </a>

    <a
      class="admin-sidebar__link <%= (typeof activePage !== 'undefined' && activePage === 'orders') ? 'active' : '' %>"
      href="/admin/order-management"
    >
      <span class="material-symbols-outlined">shopping_cart</span>
      Orders
    </a>

    <a
      class="admin-sidebar__link <%= (typeof activePage !== 'undefined' && activePage === 'coupons') ? 'active' : '' %>"
      href="/admin/coupon-management"
    >
      <span class="material-symbols-outlined">confirmation_number</span>
      Coupons
    </a>

    <a
      class="admin-sidebar__link <%= (typeof activePage !== 'undefined' && activePage === 'analytics') ? 'active' : '' %>"
      href="/admin/analytics"
    >
      <span class="material-symbols-outlined">analytics</span>
      Analytics
    </a>
  </nav>

  <div class="admin-sidebar__footer">
    <a class="admin-sidebar__link" href="#">
      <span class="material-symbols-outlined">help</span>
      Support
    </a>
    <a class="admin-sidebar__link" href="/admin/logout">
      <span class="material-symbols-outlined">logout</span>
      Logout
    </a>
  </div>
</aside>

<!-- Mobile Sidebar Backdrop Overlay -->
<div id="sidebar-overlay" style="position: fixed; inset: 0; background-color: rgba(0, 0, 0, 0.35); z-index: 90; display: none;" onclick="toggleAdminSidebar()"></div>

<script>
  function toggleAdminSidebar() {
    const sidebar = document.querySelector('.admin-sidebar');
    const overlay = document.getElementById('sidebar-overlay');
    if (sidebar.classList.contains('open')) {
      sidebar.classList.remove('open');
      overlay.style.display = 'none';
    } else {
      sidebar.classList.add('open');
      overlay.style.display = 'block';
    }
  }

  document.addEventListener('DOMContentLoaded', () => {
    const toggleBtn = document.getElementById('sidebar-toggle');
    if (toggleBtn) {
      toggleBtn.addEventListener('click', toggleAdminSidebar);
    }
  });
</script>

<script src="/User/js/loading-bar.js"></script>
