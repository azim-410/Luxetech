<style>
    :root {
        --border: #e5e7eb;
        --text-main: #111827;
        --text-muted: #6b7280;
        --accent: #ea580c;
        --nav-h: 72px;
    }

    .site-header {
        display: flex !important;
        align-items: center !important;
        justify-content: space-between !important;
        padding: 0 1.25rem !important;
        height: var(--nav-h) !important;
        background: #fff !important;
        border-bottom: 1px solid var(--border) !important;
        position: sticky !important;
        top: 0 !important;
        z-index: 100 !important;
    }

    .header-left {
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .logo {
        font-size: 1.5rem;
        font-weight: 800;
        letter-spacing: -0.05em;
        text-decoration: none;
        color: var(--text-main);
    }

    .auth-btn {
        background: var(--text-main);
        color: #fff;
        padding: 0.35rem 0.8rem;
        font-size: 0.7rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        border: 1px solid var(--text-main);
        border-radius: 0.25rem;
        transition: all 0.3s ease;
        cursor: pointer;
    }

    /* Desktop Navigation styling */
    #main-nav {
        display: flex;
    }

    #main-nav ul {
        display: flex;
        gap: 2.5rem;
        list-style: none;
        padding: 0;
        margin: 0;
    }

    #main-nav a {
        font-size: 0.75rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: var(--text-muted);
        transition: color 0.2s;
        text-decoration: none;
    }

    #main-nav a:hover, #main-nav a.active {
        color: var(--text-main);
    }

    .drawer-footer {
        display: none;
    }

    .header-actions {
        display: flex;
        align-items: center;
        gap: 1.5rem;
    }

    .icons-group {
        display: flex;
        gap: 1.25rem;
        color: var(--text-main);
        align-items: center;
    }

    .icons-group .material-symbols-outlined {
        font-size: 1.35rem;
    }

    .icon-container {
        position: relative;
        display: inline-flex;
        color: inherit;
        padding: 4px;
        text-decoration: none;
    }

    .count-badge {
        position: absolute;
        top: -5px;
        right: -5px;
        background-color: #ef4444;
        color: #fff;
        font-size: 10px;
        font-weight: 700;
        min-width: 18px;
        height: 18px;
        border-radius: 9999px;
        display: flex;
        align-items: center;
        justify-content: center;
        border: 1.5px solid #fff;
    }

    #hamburger-btn {
        display: none;
        background: none;
        border: none;
        cursor: pointer;
        padding: 4px;
        color: var(--text-main);
    }

    #hamburger-btn .material-symbols-outlined {
        font-size: 1.5rem;
    }

    /* Backdrop overlay styling */
    .nav-backdrop {
        position: fixed;
        top: var(--nav-h);
        left: 0;
        right: 0;
        bottom: 0;
        background: rgba(0, 0, 0, 0.3);
        backdrop-filter: blur(2px);
        z-index: 90;
        opacity: 0;
        visibility: hidden;
        transition: opacity 0.3s ease;
    }

    .nav-backdrop.active {
        opacity: 1;
        visibility: visible;
    }

    /* ── Mobile Responsive Style ────────────────────────────── */
    @media (max-width: 768px) {
        #hamburger-btn {
            display: block !important;
        }

        .header-actions > a[href="/login"] {
            display: none !important;
        }

        /* Slide drawer starts below header */
        #main-nav {
            position: fixed !important;
            left: 0 !important;
            top: var(--nav-h) !important;
            height: calc(100vh - var(--nav-h)) !important;
            width: 16rem !important;
            background: #eaeff1 !important;
            display: flex !important;
            flex-direction: column !important;
            padding: 2rem 1.5rem !important;
            z-index: 95 !important;
            transform: translateX(-100%) !important;
            transition: transform 0.3s ease !important;
            box-sizing: border-box !important;
            border-right: 1px solid var(--border) !important;
        }

        #main-nav.nav-open {
            transform: translateX(0) !important;
        }

        #main-nav ul {
            flex-direction: column !important;
            gap: 1.5rem !important;
        }

        #main-nav a {
            font-size: 0.9rem !important;
            font-weight: 700 !important;
            color: #2b3437 !important;
        }

        #main-nav a:hover, #main-nav a.active {
            color: var(--accent) !important;
        }

        .drawer-footer {
            display: block !important;
            margin-top: auto !important;
            border-top: 1px solid rgba(0,0,0,0.1) !important;
            padding-top: 1.5rem !important;
        }

        .mobile-auth-link {
            font-size: 0.9rem !important;
            font-weight: 700 !important;
            color: #2b3437 !important;
            text-decoration: none !important;
            display: block;
        }

        .mobile-auth-link:hover {
            color: var(--accent) !important;
        }
    }
</style>

<div class="nav-backdrop" id="nav-backdrop"></div>

<header class="site-header">
    <div class="header-left">
        <button class="hamburger-btn" id="hamburger-btn" aria-label="Toggle navigation">
            <i class="material-symbols-outlined">menu</i>
        </button>
        <a href="/" class="logo">LUXE TECH</a>
    </div>

    <nav id="main-nav">
        <ul>
            <li><a href="/" class="active">HOME</a></li>
            <li><a href="/offers">OFFERS</a></li>
            <li><a href="/shop">SHOP</a></li>
            <li><a href="/support">SUPPORT</a></li>
        </ul>
        <div class="drawer-footer">
            <% if(user){ %>
                <a href="/logout" class="mobile-auth-link">LOGOUT</a>
            <% } else { %>
                <a href="/login" class="mobile-auth-link">LOGIN</a>
            <% } %>
        </div>
    </nav>

    <div class="header-actions">
        <% if(!user){ %>
             <a href="/login"><button class="auth-btn">login</button></a>
        <% } %>
        <div class="icons-group">
            <a href="/favorite" class="icon-container">
                <span class="material-symbols-outlined">favorite</span>
                <% if (locals.wishlistCount > 0) { %>
                    <span class="count-badge"><%= locals.wishlistCount %></span>
                <% } %>
            </a>
            <a href="/cart" class="icon-container">
                <span class="material-symbols-outlined">shopping_cart</span>
                <% if (locals.cartCount > 0) { %>
                    <span class="count-badge"><%= locals.cartCount %></span>
                <% } %>
            </a>
            <a href="/profile" class="icon-container">
                <span class="material-symbols-outlined">person</span>
            </a>  
        </div>
    </div>
</header>

<script>
    (function() {
        const hamburger = document.getElementById('hamburger-btn');
        const nav = document.getElementById('main-nav');
        const backdrop = document.getElementById('nav-backdrop');
        
        function toggleMenu(forceClose = false) {
            const isOpen = forceClose ? false : !nav.classList.contains('nav-open');
            
            nav.classList.toggle('nav-open', isOpen);
            hamburger.querySelector('.material-symbols-outlined').textContent = isOpen ? 'close' : 'menu';
            if (backdrop) backdrop.classList.toggle('active', isOpen);
            document.body.style.overflow = isOpen ? 'hidden' : '';
        }

        if (hamburger && nav) {
            hamburger.addEventListener('click', function(e) {
                e.stopPropagation();
                toggleMenu();
            });
            
            if (backdrop) {
                backdrop.addEventListener('click', function() {
                    toggleMenu(true);
                });
            }
            
            // Close on nav link click
            nav.querySelectorAll('a').forEach(function(link) {
                link.addEventListener('click', function() {
                    toggleMenu(true);
                });
            });
        }
    })();

    window.addEventListener("pageshow", function (event) {
        if (event.persisted) {
            window.location.reload();
        }
    });
</script>
